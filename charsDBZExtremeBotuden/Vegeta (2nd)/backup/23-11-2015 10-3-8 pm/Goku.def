

; Player information
[Info]
name = "Goku"        ;Name of character
displayname = "Goku" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "HIDDENSAGE121"         ;Character author name
pal.defaults = 1    ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = Goku.cmd           ;Command set
cns     = Goku.cns           ;Constants
st      = Goku.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = Goku.sff           ;Sprite
anim    = Goku.air           ;Animation
sound   = Goku.snd           ;Sound


; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 


; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = 
