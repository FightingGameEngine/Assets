; Player information
[Info]
name = "DEFAULT BASE"        ;Name of character
displayname = "DEFAULT BASE" ;Name of character to display
versiondate = 12/20/2015    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "HIDDENSAGE121"         ;Character author name
pal.defaults = 1    ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = DEFAULT BASE.cmd           ;Command set
cns     = DEFAULT BASE.cns           ;Constants
st      = DEFAULT BASE.cns           ;States
st2      = Normals.cns  
st3      = Specials.cns 
st4      = Supers.cns
st5      = Custom States.cns
st6      = Misc.cns
st7      = Mechanics.cns
st8      = Transform.cns
stcommon = common1.cns     ;Common states (from data/ or motif)
sprite  = DEFAULT BASE.sff           ;Sprite
anim    = DEFAULT BASE.air           ;Animation
sound   = DEFAULT BASE.snd           ;Sound


; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 


; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = 
