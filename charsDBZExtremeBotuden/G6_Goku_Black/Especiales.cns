; Trueno FX
[Statedef 3255]
type    = S
movetype= A
physics = N
juggle  = 1
velset = 0,0
ctrl = 0
anim = 3255
sprpriority = 10

[State 0, PosSet]
type = PosSet
trigger1 = time = 0
y = 50

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
scale = .2+time*.4,9

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
v = 1
value = 0

[State 0, VarAdd]
type = VarAdd
trigger1 = time > 5
v = 1
value = 25

[State 0, Trans]
type = Trans
trigger1 = time > 5
trans = addalpha
alpha = 256-var(1),256
ignorehitpause = 1

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 200, End]
type = Destroyself
trigger1 = time = 10

