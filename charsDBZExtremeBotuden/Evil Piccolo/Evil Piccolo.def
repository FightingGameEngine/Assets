
[Info]
name = "Evil Piccolo"        ;Name of character
displayname = "Evil Piccolo" ;Name of character to display
versiondate = 08,15,2015    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Ironjw" 
edited = "AntiJosh"        ;Character author name
pal.defaults = 1      ;Default palettes in order of preference (up to 4)
localcoord = 320,240        ;Local coordinate space width and height


[Files]
cmd     = Evil Piccolo.cmd           ;Command set
cns     = Evil Piccolo.cns           ;Constants
st      = Evil Piccolo.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = Evil Piccolo.sff           ;Sprite
anim    = Evil Piccolo.air           ;Animation
sound   = Evil Piccolo.snd           ;Sound
ai      = Evil Piccolo.ai            ;AI hints data (not used)

[Palette Keymap]
x = 4 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 1
b = 5
c = 6

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
