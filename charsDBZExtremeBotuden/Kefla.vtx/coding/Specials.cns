; Ki Blast Hit
[Statedef 1006]
type    = A
movetype= A
physics = N
ctrl = 0
anim = 1006
velset = 0,0
sprpriority = 5

[State 0, Trans]
type = Trans
trigger1 = 1
trans = add
ignorehitpause = 1

[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = !time
time = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S9000,0
volumescale = 100
channel = -1

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
value = -(vel y)*5

[State 0, DestroySelf]
type = DestroySelf
trigger1 = !animtime