;以下AI記述

[State -3,12P]
type = ChangeState
value = 800+random%13
Triggerall = StateType != A
Triggerall = RoundState = 2
Triggerall = Alive
Triggerall = Ctrl
Trigger1 = var(59) != 0
trigger1 = palno = 12
trigger1 = power >= 3000

[State -3,12P]
type = ChangeState
value = 800+random%11
Triggerall = StateType != A
Triggerall = RoundState = 2
Triggerall = Alive
Triggerall = Ctrl
Trigger1 = var(59) != 0
trigger1 = palno = 12
trigger1 = power < 3000

[State -3,チャージ]
Type = ChangeState
value = ifelse(random<=600,1300,ifelse(random<=400,1000+(random%3)*100,200+(random%6)*10))
TriggerAll=var(59) != 0
TriggerAll=RoundState = 2
TriggerAll=StateType != A
TriggerAll=!InGuardDist
triggerall=power < 3000
triggerall=palno!=12
Triggerall = Alive
Triggerall = Ctrl
triggerall = enemynear,stateno=[5000,5199]
Trigger1=P2BodyDist X = [150,500]
Trigger2=P2BodyDist Y >= -100

[State -3,]
type = ChangeState
value = ifelse(random<=300,ifelse(random%2,3000,3100),ifelse(random<=300,ifelse(random%2,2000,2001),ifelse(random<=400,1000+(random%3)*100,200+(random%6)*10)))
Triggerall = StateType != A
Triggerall = RoundState = 2
Triggerall = Alive
Triggerall = Ctrl
Trigger1 = var(59) != 0
trigger1 = power >= 3000
trigger1 = palno = [7,11]

[State -3,]
type = ChangeState
value = ifelse(random<=300,2001,ifelse(random<=300,2000,ifelse(random<=400,1000+(random%3)*100,200+(random%6)*10)))
Triggerall = StateType != A
Triggerall = RoundState = 2
Triggerall = Alive
Triggerall = Ctrl
