;---------------------------------------------------------------------------
; 常時監視ステ
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, デバッグ表示]
type = null
trigger1 = 1
text = "Var(5)-Button=%d,Pos X=%d,Y=%d"
params = var(5),floor(Pos X),floor(Pos Y)

;---------------------------------------------------------------------------
;演出系

[State -2,覇気]
type=helper
trigger1=palno=12
trigger1=!IsHelper
trigger1=!numhelper(77)
helpertype=player
stateno=77
ID=77
name="Holiness"
postype=p1
pausemovetime=65535
supermovetime=65535

[State -2];保護
type = SelfState
trigger1 = Ishelper(77)
value = 77
IgnoreHitPause = 1

[State 2200, sparking]
type = Explod
triggerall = gametime%100 = 1
triggerall = stateno != 183
trigger1 = PalNo = 12
trigger2 = stateno = 1300
anim = 4600
ID = 4600
pos = 0,-55
postype = p1
facing = ifelse(random<500,-1,1)
vfacing = ifelse(random<500,-1,1)
bindtime = -1
random = 0,80
scale = 1.3,1.3
sprpriority = 5
ownpal = 1
removeongethit = 1
supermove = 1
supermovetime = 9999999999
pausemovetime = 9999999999

[state ]
type=playsnd
triggerall=gametime%100=1
triggerall=stateno!=183
trigger1=palno=12
trigger2=stateno=1300
value=190,6

