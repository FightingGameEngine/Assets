
; Player information
[Info]
name = "Vegeta Super Saiyan God"        ;Name of character
displayname = "Vegeta God" ;Name of character to display
;displayname = "Vegeta Period"
;displayname = "The_Will_Of_Vegetable"
versiondate = 04,01,2016    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "SUSTINA, Editted by(GOD984)"         ;Character author name
pal.defaults = 1,12,7      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = vegeta.cmd   ;Command set
cns     = vegeta.cns   ;Constants
st      = vegeta.cns   ;States
st2     = -2&-3.cns
st3     = null.txt
stcommon = common1.cns ;Common states
sprite  = vegeta.sff   ;Sprite
anim    = vegeta.air   ;Animation
sound   = vegeta.snd   ;Sound
pal1    = vegeta.act  ;Palettes (can have up to 12)
pal2    = vegeta.act
pal3    = vegeta.act
pal4    = vegeta.act
pal5    = vegeta.act
pal6    = vegeta.act
pal7    = vegeta-ssgss.act
pal8    = vegeta-ssgss.act
pal9    = vegeta-ssgss.act
pal10    = vegeta-ssgss.act
pal11    = vegeta-ssgss.act
