;---------------------------------------------------------------------------
; 勝利
; CNS レベル: 基本
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1=palno!=12
trigger1 = Time = 0
trigger1 = !matchover
value = ifelse(random<=700,181,182)

[State 180, 1]
type = ChangeState
trigger1=palno!=12
trigger1 = Time = 0
trigger1 = matchover
value = ifelse(random<=400,1800,ifelse(random<=700,181,182))

[state ]
type=changestate
trigger1=palno=12
value=183

