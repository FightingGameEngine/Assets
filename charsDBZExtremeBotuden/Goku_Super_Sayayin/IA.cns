; Movimientos Basicos:

[State 0, Correr/Air Dash Adelante]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && (ctrl = 1)
trigger1 = p2bodydist x > 100 && random < 100
value = ifelse(statetype = A,110,100)

[State 0, Correr Fin]
type = ChangeState
Triggerall = (ailevel > 0) && (stateno = 100)
trigger1 = p2bodydist x < 50 && random < 400
value = 101

[State 0, Hop/Air Dash Back]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && (ctrl = 1)
triggerall = stateno != [100,101]
trigger1 = p2bodydist x < 100 && random < 50
value = ifelse(statetype = A,111,105)

; Golpes Normales:

; Stand:

[State 0, A]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && (ctrl = 1)
triggerall = statetype != A
trigger1 = p2bodydist x < 50 && random < 800
value = 220

[State 0, B]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && ((ctrl = 1)||(stateno = 220||stateno = 430) && movecontact)
triggerall = statetype != A
trigger1 = p2bodydist x < 50 && random < 800
value = 230

[State 0, C]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && ((ctrl = 1)||(stateno = 230||stateno = 420) && movecontact)
triggerall = statetype != A
trigger1 = p2bodydist x < 50 && random < 800
value = 240

