; Conector
[State 0, Conector]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && ((ctrl = 1)||(stateno = 450) && movecontact)
triggerall = statetype != A
trigger1 = p2bodydist x < 60 && random < 1000
value = 470

; Air

[State 0, A]
type = ChangeState
Triggerall = (roundstate = 2) && (ctrl = 1)||(stateno = 470) && (movecontact) && (enemy,statetype = A)
triggerall = (ailevel > 0) &&  statetype = A
trigger1 = p2bodydist x < 50 && random < 1000
value = 630

[State 0, B]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && (ctrl = 1)||(stateno = 630) && (movecontact) &&  (enemy,statetype = A)
triggerall = (ailevel > 0) &&  statetype = A
trigger1 = p2bodydist x < 50 && random < 900
value = 640

[State 0, C]
type = ChangeState
Triggerall = (ailevel > 0) && (roundstate = 2) && (ctrl = 1)||(stateno = 640) && (movecontact) &&  (enemy,statetype = A)
triggerall = (ailevel > 0) &&  statetype = A
trigger1 = p2bodydist x < 50 && random < 800
value = 650

[State -1, Power Charge]
type = changestate
triggerall = power < 7000
triggerall = RoundState = 2 && ailevel > 0
triggerall = StateType != A
triggerall = Ctrl
triggerall = P2BodyDist X >= 100
trigger1 = power < 1000 && Random = [600,800]
trigger2 = power < 2000 && power > 1000 && Random = [300,500]
trigger3 = power < 3000 && power > 2000 && Random = [100,200]
value = 500

[State 0, Power Charge End]
type = ChangeState
triggerall = time >= 12
triggerall = stateno = 500
triggerall = ailevel > 0
trigger1 = (p2bodydist x < 50) || (enemy,numproj > 0)
trigger2 = power = 7000
value = 501

[State 0, Super Ki Liberation]
type = ChangeState
triggerall = power >= 500
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x = [-50,50]
trigger1 = random < (ailevel * 100)/4
value = 1000

