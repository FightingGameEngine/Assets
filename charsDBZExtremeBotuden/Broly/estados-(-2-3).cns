;-Estados especiales -2 -3
;-Aquí se encuentran ctrls para varios sonidos y
;-y códigos especiales para varias cosas.
;================================================================================================
;================================================================================================
;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State 1000, ]
type = Varset
trigger1 = Enemy,Stateno = 5100
var(10) = 0

[State 0, StopSnd]
type = StopSnd
trigger1 = Movetype = H
trigger2 = Stateno != 2100
channel = 5

[State 701]
type = Explod
triggerall = animelem = 2
trigger1 = Statetype != S
trigger2 = Movetype = I
anim = 112
scale = 1.6,1.6
ID = 110
bindtime = -1
removetime = -1
postype = P1
pos = 85,-88
removeongethit= 1
sprpriority = 5
ownpal = -1


[State 1002]
type = RemoveExplod
trigger1 = Statetype = S
trigger2 = MoveType != I
trigger3 = Anim = [113,9999]
trigger4 = Anim = [0,109]
;trigger4 = StateNo = [180,194]
;trigger4 = StateNo = [700,710]
;trigger5 = Anim = 700
;trigger6 = Anim = 700
ID = 110

