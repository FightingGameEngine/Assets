;===============================================================================
 ;-Limitación de esquinas estilo kof.
 ; :------Código de Iron y modificado por shammahomega1-------:
;===============================================================================
;-Limite de pasar a la esquina estando el enemigo allí,
;-funciona perfecto,poniendo este código en el estado 100 y 20.
[State -2, VelSet]
type = VelSet
trigger1 = movetype!=H
trigger1 = RoundState =2
trigger1 = FrontEdgeDist <10 && vel x > 0.1;const(velocity.jump.fwd.x)
x = 0.1
;-Se desactiva por un tiempo sino se cumplen los triggers
[State -2,Null; VelSet]
type =Null; VelSet
trigger1 = movetype!=H
trigger1 = RoundState =2
trigger1 = FrontEdgeDist <10 && vel x > 0.1;const(velocity.jump.fwd.x)
x = 0.1
;===============================================================================
;-Sin barras estilo kof.
;:------Código por shammahomega1-------:
;===============================================================================
;-Sin barras de vida y de poder estilo kof,
;-en intros y al final de cada raund.
[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = RoundState = [0,1 ]
trigger2 = RoundState = [3,4]
flag = nobardisplay

;================================================================================
;- Limitación de agarres
;:-----Código por OrochiKOF97---------:
;===============================================================================
;-Varset para limitar agarres en estados que
;el sistema kof no permite.
[State -2, Guard Var]
type = VarSet
trigger1 = stateno = [200,299] ; Non-Air basic moves states.
trigger1 = moveguarded > 0 ; This is the key : checks if opponent has guarded a basic attack
trigger2 = stateno = [600,699] ; Air Basic Moves
trigger2 = movecontact > 0 ; This includes both moveguarded & movehit as well
v = 15
value = 30
persistent = 0
ignorehitpause = 1

[State -2, Guard Var 2]
type = VarAdd
trigger1 = var(15) > 0
var(15) = -1
ignorehitpause = 1

[State -2, Guard Var 3]
type = VarSet
trigger1 = var(15) < 0
var(15) = 0
persistent = 0
ignorehitpause = 1

;End of Throw Limitation===========================================================
;================================================================================
; COUNTER HIT (Based on Sander's Method, Stolen from Vans, Adapted by thedge)
;===============================================================================
[State -2, VarSet];Checks if opponent is in attack state
type = VarSet
triggerall = numenemy
trigger1 = enemy, movetype = a
var(56) = 1
ignorehitpause = 1

[State -2, VarSet];This resets the condition if counter not succesful and succesful
type = VarSet
triggerall = numenemy
trigger1 = enemy, movetype = i || var(57) >= 1  ;Enemy is Idle | Counter was Succesful
trigger2 = var(57) > var(55) && enemy, movetype = h  ; ticks passed & enemy is on gethit state
var(56) = 0
ignorehitpause = 1

[State -2, VarSet];Counter Hit Succesful
type = VarSet
trigger1 = var(56) = 1 && movehit ;Counter Check Ok, Move Hit Succesfully.
trigger1 = stateno != [800,999] ;Does not activate during throws.
trigger2 = var(56) = 1 && projhit = 1  ;Counter Check Ok, Projectile Hit Succesfully.
var(57) = 1
ignorehitpause = 1

[State -2, VarAdd];Counter Hit Timer
type = VarAdd
trigger1 = var(57) >= 1 ;Counter was succesful
var(57) = 1
ignorehitpause = 1

[State -2, VarSet];Counter Hit Reset
type = VarSet
trigger1 = var(57) >= var(55) && movehit ;Reset if 22 ticks passed and move hit
trigger2 = p2movetype != h ;Reset if P2 is no longer in gethit state
trigger3 = movetype = h ;Reset if P1 is getting hit
trigger4 = var(57) >= var(55) && projhit = 1 ;Reset if 22 ticks passed and projectile hit
var(57) = 0
ignorehitpause = 1


[State -2, Explod 1];Counter Explod for P1 Side.
type = Explod
triggerall =enemy,GetHitVar(hittime) =[0,17]
triggerall = numenemy
triggerall = var(56)=1  && numexplod(7280) <= 0 && teamside = 1 ;Counter Ok, Explod has not played, P1 Side
triggerall =enemy,movetype = h  ;Enemy was indeed HIT, otherwise this'd be retarded.
triggerall = stateno != [800,999] ;Does not activate during throws.
trigger1 = movehit=1
trigger2 = projhit = 1 ;Projectile Hits
anim = 7280
scale = 0.5,0.5
id = 7280
pos =-420,87; 160,234
postype = right
bindtime = -1
supermove = 1
facing = 1
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 1
;scale = 0.5,0.5



[State -2, Explod 2];Counter Explod for P2 Side.
type = Explod
triggerall =enemy,GetHitVar(hittime) =[0,17 ]
triggerall = numenemy
triggerall = var(56)=1  && numexplod(7281) <= 0 && teamside = 2 ;Counter Ok, Explod has not played, P2 Side
triggerall =enemy,movetype = h  ;Enemy was indeed HIT, otherwise this'd be retarded.
triggerall = stateno != [800,999] ;Does not activate during throws.
trigger1 = movehit=1
trigger2 = projhit = 1 ;Projectile Hits
anim = 7281
scale = 0.5,0.5
id = 7281
pos =330,87; 160,234
postype = left
bindtime = -1
supermove = 1
facing = 1
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 1


; End of Counter System ===================================================

