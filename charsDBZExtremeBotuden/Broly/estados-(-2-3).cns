;================================================================================
;>>>>>>>>>>>>>Cheap K.O. system By Warusaki3<<<<<<<<<<<<<:
 ;:------Código por Warusaki3 y modificado por shammahomega1-------:
;===============================================================================
;-Este ctrl te manda al estado de colapso k.o.
;-estando en los estados 5000 al 5050,allí en
;esos estados e codificado como prohibidas las
;-animaciones de back en el aire y también para up
;-al haber k.o.,y deje las normales,asi funciona mejor el código,
;-como en el juego svc-chaos,importante no removerlo.


[State -2,selfState 1]
type =selfState
triggerall =loseko
triggerall = Alive=0
trigger1 = PrevStateNo =130 ||PrevStateNo =120 || PrevStateNo =[150,151]
trigger1 =stateno= [5000,5050]
value = 5400
ignorehitpause = 1


[State -2, selfState 2]
type =selfState
triggerall =loseko
triggerall = Alive=0
trigger1 = PrevStateNo =131 ||PrevStateNo =120 || PrevStateNo =[152,153]
trigger1 =stateno=[5000,5050]
value = 5401
ignorehitpause = 1


[State -2,KO,1]
type = Varset
triggerall = StateNo = [120,159]
trigger1 = StateType = S
ignorehitpause = 1
fvar(1) = 0


[State -2,KO,2]
type = Varset
triggerall = StateNo = [120,159]
trigger1 = StateType = C
ignorehitpause = 1
fvar(1) = 1


[State -2,KO,3]
type = Varset
triggerall = StateNo = [120,159]
trigger1 = StateType = A
ignorehitpause = 1
fvar(1) = 2

