; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20,VelSet 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20,VelSet 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20,ChangeAnim 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20,ChangeAnim 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21


;-Este ctrl ayuda a eliminar un bug con agarres,cuando el
;enemigo esta cayendo en el aire, podía pasar corriendo al otro lado
;-de la esquina,y junto con los ctrls del -2 de limitación de esquinas
;-se evita todo bug,importante no quitar.
[State 20,VelSet limitación de ezquina]
type = VelSet
trigger1 = FrontEdgeDist < 10
x =0.0
