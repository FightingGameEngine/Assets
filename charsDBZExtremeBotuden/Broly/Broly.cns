;================================================================================================
;================================================================================================
;*********Del autor shammahomega1****************************************************************
;================================================================================================
;================================================================================================
;-Esta plantilla esta hecha en base a mi personaje Ryu de svc-chaos,
;-trae por defaul ya integrados los movimientos clásicos especiales
;-del sistema del juego kof tales como:

;-Correr adelante.
;-Saltos cortos en tierra de escape hacia atrás.
;-Saltos cortos y super  saltos aéreos al frente y atrás.
;-Evasión de rodar en tierra hacia adelante y atrás.
;-Recobrarte antes de tocar tierra de una caída aérea.
;-Golpe de rechaze violento y estando en defensa gastando una barra de poder.
;-Agarres.
;-Escape de agarre.
;-Romper defensa del enemigo.
;-Marear al enemigo por combos.
;-Recobrarte estando mareado.
;-Sistema de counter.
;-Sistema de Cornerpush.
;-Colapso k.o estando de pie o agachado.
;-Sistema de quemas de sprites originales kof(amarilla y morada).
;-Compatibilidad Mbliss con Demitri.
;-Poses de perder vs  Athena y Red Adremer .
;-Poses de ganar vs enemigos especiales.
;-Pantalla de ganador estilo svc-chaos.

;-No tiene barra de time,ni super canceles,espero mas adelante
;-incluir eso en esta plantilla.

;-Si usas esta plantilla tendrás que cambiar los sprites y sonidos
;-de acuerdo a tu personaje que vas a crear,pero sin duda sera mas
;-fácil con todos los códigos arriba descritos ya integrados aquí,
;-ahora en la mayoría de los cns dejo comentarios para que te guíes
;-y que entiendas como esta programado esto,pero la verdad no creo
;-que batalles tanto para programar tu personaje,pues solo tendrás
;-que editar valores de algunos códigos,asi como el cambio de imagenes
;-y sonidos.
;-Claro que tendrás que usar tu nivel de programacion para programar
;-tus poderes especiales y supers smds,pero la practica hace al maestro,
;-o igual usa códigos ya hechos por autores open,en mi caso todo el código es open
;-salvo las imagenes y sonidos.
;-Pues a empezar a crear tu personaje estilo kof.


;================================================================================================
;================================================================================================
;-Cns principal con todos los movimientos básicos
;-del personaje,evasión adelante y atrás y hidef
;-básicos,y agarres.
;================================================================================================
;================================================================================================


;================================================================================================
;================================================================================================
;-Aquí tendrás que editar varios valores mas que nada
;-en [Velocity],de acuerdo a tu personaje que vas a programar
;-porque es bien sabido que no todos los personajes tienen la
;-misma velocidad al caminar,correr y saltar.
;================================================================================================
;================================================================================================
[Data]
life              = 3350 ;--vida del personaje.
power             = 8000 ;--3 barras de poder del personaje.
attack            = 410  ;--fuerza de ataque al golpear el personaje.
defence           = 810  ;--nivel de defensa del personaje.
fall.defence_up   = 50   ;--porcentaje de aumento de defensa mientras cae el personaje.
liedown.time      = 50   ;--tiempo que dura el personaje en el suelo tirado.
airjuggle         = 15   ;--puntos de juggle en el aire,se comienza con 15.
sparkno           = 2    ;--sparks de ataque,usadas por defaul del "fighfx" sino pones en los hidef las tuyas.
guard.sparkno     = 40   ;--sparks de defensa,usadas por defaul del "fighfx" sino pones en los hidef las tuyas.
KO.echo           = 0    ;--pon el valor 1 si quieres escuchar el grito de k.o con eco.
volume            = 420  ;--puedes subir el volumen de tu snd, 100 es normal después de 100 aumentalo a tu gusto.
IntPersistIndex   = 20   ;--si existe una variable 61 su valor no volverá a 0 cuando el round acabe.
FloatPersistIndex = 40   ;--si el valor de una variable,cualquiera que fuera es mayor de 40,el valor no vuelve a 0 cuando se termine el round.
;================================================================================================
[Size]
xscale = 1 ;--para cambiar el tamaño horizontal de tu personaje(opcional).
yscale = 1  ;--para cambiar el tamaño vertical de tu personaje(opcional).
ground.back      = 30   ;--área del personaje(atrás en el suelo).
ground.front     = 31    ;--área del personaje(frente en el suelo).
air.back         = 20    ;--área del personaje(atrás en el aire).
air.front        = 20    ;--área del personaje(frente en el aire).
height           = 60    ;--altura
attack.dist      = 160   ;--standar de distancia de ataque(no cambiar).
proj.attack.dist = 90    ;--standar de distancia para proyectiles(no cambiar).
proj.doscale     = 0     ;--cambia el valor a 1 si quieres cambiar el tamaño del proyectil.
head.pos         =0, -130;--posición aproximada de la cabeza.
mid.pos          =0, -80;--posición aproximada del estomago.
;shadowoffset     = 0    ;--numero de pixeles que la sombra se separa del personaje(opcional).
;draw.offset      = 0,0  ;--(no cambiar el valor)sirve para cambiar la posición del personaje(opcional).
;================================================================================================
[Velocity];-regular la velocidad del personaje.
walk.fwd        = 10    ;--caminando al frente.
walk.back       = -9.0   ;--caminando atrás.
run.fwd         = 11, 0 ;--corriendo al frente(x,y).
run.back        = -8,-4;--corriendo atrás(x,y).
jump.neu        = 8,-10;--velocidad de salto neutral(x,y).
jump.fwd        = 2.0   ;--velocidad de salto al frente(x,y).
jump.back       = -2.20  ;--velocidad de salto atrás(x,y).
runjump.fwd     = 9,-10    ;--velocidad de salto aéreo corriendo al frente(x,y).
runjump.back    = -9,-10, ;--velocidad de salto aéreo corriendo atrás(x,y).
airjump.neu     = 0,-9.1;--(opcional).
airjump.back    = -4 ;--(opcional).
airjump.fwd     = 4   ;--(opcional).

;================================================================================================
[Movement]
airjump.num     = 3     ;--números de saltos estando en el aire tu personaje(opcional).
airjump.height  = 35    ;--mínima distancia a la que debe estar tu personaje antes de hacer un salto aéreo(opcional).
yaccel          = .65;.44;--aceleración al bajar a tierra del personaje.
stand.friction  = .85    ;--coeficiente de fricción cuando está de pie el personaje.
crouch.friction = .82    ;--coeficiente de fricción cuando está agachado el personaje.
;================================================================================================

[Quotes]
;Broly
victory1 = ¿Qué crees que estás haciendo? ¿Por qué no dejas de quejarte como un bebé y peleas como un hombre?
victory2 = ¡Te elijo para que seas la primera de mis víctimas!
victory3 = Puedes decir adios!
victory4 = Has durado más de lo esperado, pero tu hora final ha llegado.
victory5 = Soy mas fuerte que un dios.
victory6 = Yo no soy un monstruo .....Soy el mismo demonio
victory7 = Hago lo que se necesita hacer. ¿Qué esperas de un fenómeno?
;===========================================================================
; Formato:
; [Statedef STATENO]
; type = ?      S/C/A/L  de pie/agachado/en el aire/tirado en el suelo
; movetype = ?  I/A/H    ocioso/atacando/hiper
; physics = ?   S/C/A/N  de pie/agachado/en el aire/ninguno
; juggle = ?             air juggle points requeridos
;
; [State STATENO, ?]     ? -ponles un numero a tus estados
; type = ?
; ...
;===========================================================================
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, HitBy]
type = HitBy
trigger1 =1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT

[State 0,ChangeAnim 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 1
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 260,PlaySnd 1]
type = PlaySnd
trigger1 = AnimElem = 264
value = S0,45
volume=130

[State 0, StopSnd]
type = StopSnd
trigger1 = time= 0
channel = 1

[State 0, ChangeANIM]
type = Changeanim
triggerall=anim!=1
trigger1= Life <=500
value = 1

[State 0, ChangeANIM]
type = Changeanim
triggerall=anim!=0
trigger1= Life >=500
value = 0

[State 0,VelSet 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0,VelSet 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0,ChangeState 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;===========================================================================
; Stand
[Statedef 1]
type = S
physics = S
sprpriority = 0

[State 1, 1]
type = ChangeAnim
trigger1 = Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 1

[State 1, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 1, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 1, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

