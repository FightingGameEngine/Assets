;================================================================================================
;================================================================================================
;-Movimientos especiales.

;================================================================================================
;================================================================================================
;-Este es un ejemplo de un estado de movimiento
;-especial,puedes usarlo,o has uno a tu gusto.
;-El par·metro  juggle  = 8+(P2StateType = A)*8
;-nos indica que ser·n 8 de jugle,pero si el enemigo
;-esta en el aire (= A) y antes fue conectado ya
;-por un golpe que tambiÈn tenia este valor juggle  = 8+(P2StateType = A)*8
;-y tambiÈn aÒadimos el par·metro:air.juggle = 8
;-en los hidef o alg˙n proyectil "especial",no se le podr· conectar si ya esta cayendo,
;- asi evitamos lopps infinitos de juggles.

; Z-Buster 1
[statedef 1000]
type = S
movetype = A
physics = S
juggle = 2
ctrl = 0
anim = 1000
velset = 0,0
poweradd = 50

[State 1000, 1]
type = PlaySnd
trigger1 = AnimElem = 3
value = 1000, 4

[State 1000, 1]
type = PlaySnd
triggerall = Time < 10
trigger1 = AnimElem = 3
value = 3, 1
channel = 0

[State 1000,]
type = null
trigger1 = AnimElem = 4
anim = 1003
postype = P1
pos = -10, -55
persistent = 0
scale= 1,0.5
sprpriority = 10
ownpal = 1
bindtime = 10
supermove = 1
ignorehitpause = 0
removeongethit = 1

[State 3000]
