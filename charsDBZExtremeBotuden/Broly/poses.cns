ctrl = 0
anim = 170
velset = 0,0

;-Este ctrl es para volverte invisible,es para cuando
;-tu personaje pierde contra el mismo,sirve para que se
;-vea bien el winner escreen o anuncio del ganador como
;-en el juego kof.
[State 170,AssertSpecial ]
type = AssertSpecial
;-Cambia este triggerall de acuerdo al nombre de tu personaje y tu nombre de autor.
;-Ejemplo:
;triggerALL =ENEMYNEAR,Name = "loquito" && AuthorName = "spammer"
triggerALL =ENEMYNEAR,Name = "kof" && AuthorName = "shammahomega1"
triggerall = Matchover = 1
trigger1 = Time >=190
flag = invisible

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = Time <= 230
flag= roundnotover

