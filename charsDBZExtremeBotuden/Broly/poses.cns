trigger1 =1
flag = Intro
flag2 = nobardisplay

;-Este ctrl es para cambiarte a una intro especial,puedes
;-hacer varios intros especiales contra ciertos personajes enemigos,
;-debes de cambiarlo de acuerdo al nombre del personaje enemigo
;-que tu elijas ,asi como el autor de esos personajes,
;-e igual las imagenes en el air.
