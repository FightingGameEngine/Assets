[Info]
name = "Songoku"
displayname = "Goku Blue"
versiondate = 07,23,2009
mugenversion =
author = "Heal The World":edit by Buzzard1
pal.defaults = 1

; Files for the player
[Files]
cmd      = ssjgss.cmd	        ;Other config
