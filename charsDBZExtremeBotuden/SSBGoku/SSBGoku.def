sprite   = ssjgss.sff	;Sprite
anim     = ssjgss.air	;Animation
sound    = ssjgss.snd	;Sound

pal1     = ssjgss01.act		;ノーマルカラー
pal2     = ssjgss02.act		;ベジットカラー
pal3     = ssjgss03.act		;界王拳カラー
pal4     = ssjgss04.act		;ピッコロカラー
pal5     = ssjgss05.act		;界王カラー
pal6     = ssjgss06.act		;黄色カラー
pal7     = ssjgss07.act		;スーパーサイヤ人カラー
pal8     = ssjgss08.act		;ゴッドSSカラー

