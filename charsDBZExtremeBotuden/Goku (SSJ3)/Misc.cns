;Camera for Win Pose
[Statedef 8131]
type = S
physics  = S
anim = 0
ctrl = 0

[state 8131,TURN]
type=turn
trigger1=ishelper(8131)
trigger1=facing!=root,facing
ignorehitpause=1

[State 8131,vel]
type = VelSet
trigger1 = parent,pos X > 0
x = ifelse(facing = 1,4,-4)

[State 8131,vel]
type = VelSet
trigger1 = parent,pos X < 0
x = ifelse(facing = 1,-4,4)

[State 8131,vel]
type = VelSet
trigger1 = parent,pos X = [-5,5]
x = 0

[State 8131, WIDTH]
type = Width
trigger1 = 1
value = 1,1

[State 8131, NHB]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 8131,AS]
type = AssertSpecial
Trigger1 = 1
flag = invisible
flag2 = noshadow

[State 8131,Bound]
type = ScreenBound
trigger1 =1
value =1
movecamera = 320,0

[State 8131,push]
type = PlayerPush
trigger1 =1
value = 0

[State 8131, Destroyself]
type = destroyself
trigger1 = Time = 50
trigger1 = enemy, Life >= 1
trigger2=numhelper(8131)>=2

