trigger1 = animtime = 0
trigger1 = var(3) = 1
value = s0,18
channel = 0

[state 40, 13]
type = varset
trigger1 = time = 0
var(12) = 0

[state 40, 14]
type = changestate
trigger1 = animtime = 0
value = 50
ctrl = 1

