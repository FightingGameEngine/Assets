type = ctrlset
trigger1 = time = 20
value = 1
ctrl = 1

[State 4520, 0]
type = PosSet
trigger1 = AnimElem = 2, < 0
x = -243*Facing
y = 0

[State 4520, 1]
type = VelSet
trigger1 = AnimElem = 2, = 0
x = 4 ;.5
y = -8.75

[State 4520, 2]
type = NotHitBy
trigger1 = time < 20
value = SCA
time = 6

[State 4520, 8]
type = screenbound
trigger1 = time < 20
value = 0

[State 4520, 8]
type = Gravity
trigger1 = AnimElem = 2, >= 0

[State 4520, 9]
type = VelSet
trigger1 = Vel Y >= 0
trigger1 = Pos Y > 0
trigger1 = AnimElem = 2, >= 0
x = 0
y = 0

[State 4520, 10]
type = ChangeState
trigger1 = Vel Y >= 0
trigger1 = Pos Y > 0
trigger1 = AnimElem = 2, >= 0
value = 4521

