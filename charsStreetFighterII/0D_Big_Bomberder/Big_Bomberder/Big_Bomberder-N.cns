;****コマンド判定****************************************

[State 1001, 強弱]
type = VarSet
triggerall = !var(59)
trigger1 = Time = 0
var(1) = ifelse(command="c",2,ifelse(command="b",1,0))
IgnoreHitPause = 1
Persistent = 1

[State -3, ]
type = VarSet
triggerall = var(59) && roundstate = 2
trigger1 = Time = 0
v = 1
value = ifelse(power >= 3000,2,ifelse(power >= 2000,1,0))
IgnoreHitPause = 1
Persistent = 1
;***********************普通*******************************************

[State 1000, 3]
type = PowerAdd
trigger1 = Time = 0
value = ifelse(var(1) = 2,-3000,ifelse(var(1) = 1,-2000,-1000))

