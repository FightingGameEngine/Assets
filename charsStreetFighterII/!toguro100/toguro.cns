;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(1)  - Used in kfm.cmd for combo condition (updated every tick)
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).


;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS ?ベ?: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 181, 1]
type = changeanim
trigger1 = 1
value = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS ?ベ?: 基本
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = matchover = 0
value = 181

[State 180, 1]
type = ChangeState
trigger1 = matchover = 1
trigger1 = time >= 60
value = 182

;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
; CNS ?ベ?: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 181, 1]
type = changeanim
trigger1 = 1
value = 181

[State 181, 1]
type = explod
trigger1 = time = 64
anim = 191
postype = left
pos = 160,80
scale = 1.25,1.25
removetime = -1
bindtime = -1
ontop = 1

[State 181, 1]
type = playsnd
trigger1 = time = 64
value = 0,0
[State 181, 1]
type = playsnd
trigger1 = time = 128
value = 0,1

[State 181, 1]
type = BGpalfx
trigger1 = time >= 64
add = -48,-48,-48
time = 1

[State 191, Snd 1]
type = assertspecial
trigger1 = Time =[0,240]
flag = roundnotover


[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

