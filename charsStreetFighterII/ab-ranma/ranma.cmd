name = "upper_x"
command = ~D, DB, B, x

[Command]
name = "upper_y"
command = ~D, DB, B, y

[Command]
name = "QCF_x"
command = ~D, DF, F, x

[Command]
name = "QCF_y"
command = ~D, DF, F, y

[Command]
