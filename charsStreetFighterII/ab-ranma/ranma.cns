;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Voice]
type = PlaySnd
triggerall = alive = 1
triggerall = Time = 0
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020)
trigger1 = random < 200
trigger2 = (stateno = 5001) || (stateno = 5011) || (stateno = 5021)
trigger2 = random < 400
trigger3 = (stateno = 5002) || (stateno = 5012) || (stateno = 5022) || (stateno = 5030)
trigger3 = random < 800
value = 700, 7


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 101 ;Run-forward land
trigger3 = stateno = 106 ;Run-back land
value = 40, 0

