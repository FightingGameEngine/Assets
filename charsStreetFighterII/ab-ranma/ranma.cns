type = PlaySnd
trigger1 = Time = 3
value = 700, 2

[State 195, 2]
type = poweradd
trigger1 = AnimTime = -2
value = 435

[State 195, Flash0]
type = PalFX
trigger1 = AnimTime = -3
time = 1
add = 10, 30, 30

[State 195, Flash]
type = PalFX
trigger1 = AnimTime = -2
time = 1
add = 20, 50, 50

[State 195, Flash2]
type = PalFX
trigger1 = AnimTime = -1
time = 1
add = 10, 30, 30

[State 195, Sound]
