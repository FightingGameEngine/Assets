[Statedef 210]
type     = S
movetype = A
physics  = S
juggle   = 4
poweradd = 80
ctrl     = 0
velset   = 0,0
anim     = ifelse(p2bodydist X <30,211,210)

[State 600, 音を鳴らす]
type = PlaySnd
trigger1 =AnimElem = 2
value = ifelse((var(15) = 1),6,ifelse((var(15) = 2),7,5)),ifelse((var(15) = 1),1,ifelse((var(15) = 2),1,16))
channel = 0

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = anim = 210&&animelem = 3
trigger2 = anim = 211&&animelem = 2
value = 0, 3
channel = 1

[State 210, ヒット定義]
type = HitDef
trigger1 = time = 0
attr = S, NA
animtype  = Medium
ground.type = High
damage    = 100
guardflag = M
pausetime = 14, 14
priority = 4, Hit
sparkno = S30001
guard.sparkno = S30021
sparkxy = ceil(-14*const(size.xscale)),ceil(-50*const(size.yscale))
hitsound   = S1,2
guardsound = S2,0
ground.slidetime = 10
ground.hittime  = 15
ground.velocity = -16
air.velocity = -5,-4
envshake.time = 10
envshake.freq = 5
envshake.ampl = 5
envshake.phase = 5
getpower = 60
givepower = 20

[State 210, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

