; 立ち弱パンチ

[Statedef 200]
type     = S 
movetype = A 
physics  = S
juggle   = 1
velset   = 0,0
ctrl     = 0
sprpriority = 2

[State -3,ヒット確認]
Type = Varset
trigger1 = anim = 201
Trigger1 = time = 0
var(2) = 0
IgNoreHitPause = 1

[State -3,ヒット確認]
Type = Varadd
trigger1 = anim = 201
trigger1 =movecontact = 1
var(2) = 1

[State 40, 3]
type = ChangeAnim
trigger1 =PrevStateNo =200
trigger1 = Time = 0
value = 200

[State 40, 3]
type = ChangeAnim
trigger1 =PrevStateNo !=200
trigger1 = Time = 0
value = ifelse(p2bodydist X <30,201,200)

[State 600, 音を鳴らす]
type = PlaySnd
trigger1 =AnimElem = 2
value = ifelse((var(15) = 1),6,ifelse((var(15) = 2),7,5)),ifelse((var(15) = 1),0,ifelse((var(15) = 2),0,15))
channel = 0

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = animelem = 3
value = 0, 0
channel = 1

[State 200, ヒット定義]
type = HitDef 
trigger1 = anim = 200
trigger1 = time = 0
attr = S, NA 
damage = 40
animtype = Light
ground.type = High
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 10, 10
sparkno = S30000
guard.sparkno = S30021
sparkxy = ceil(0*const(size.xscale)),ceil(ifelse(anim = 200,-60,-40)*const(size.yscale))
hitsound = S1,1
guardsound = S2,0
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -6,0
air.velocity = -4,-2
air.type = High
air.velocity = -1.4,-3
air.hittime = 12
getpower = 20
givepower = 5

[State 200, ヒット定義]
type = HitDef 
trigger1 = anim = 201
trigger1 = animelem = 2
attr = S, NA 
damage = 40
animtype = Light
ground.type = High
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 10, 10
sparkno = S30000
guard.sparkno = S30021
sparkxy = ceil(0*const(size.xscale)),ceil(ifelse(anim = 200,-60,-40)*const(size.yscale))
hitsound = S1,1
guardsound = S2,0
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -6,0
air.velocity = -2,-2
air.type = High
air.velocity = -1.4,-3
air.hittime = 12
getpower = 10
givepower = 2

[State 200, ヒット定義]
type = HitDef 
trigger1 = anim = 201
trigger1 = animelem = 3
attr = S, NA 
damage = 40
animtype = Light
ground.type = High
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 10, 10
sparkno = S30000
guard.sparkno = S30021
sparkxy = ceil(0*const(size.xscale)),ceil(ifelse(anim = 200,-60,-40)*const(size.yscale))
