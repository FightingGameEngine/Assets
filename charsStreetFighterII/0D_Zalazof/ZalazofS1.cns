;ヘルパーアーマー
[Statedef 2906]
type=S
movetype=I

[state 2906,本体対策]
type=selfstate
trigger1=!ishelper
value=50
ctrl=1

[state 2906,影、透明]
type=assertspecial
trigger1=ishelper(2906)
flag=invisible
flag2=noshadow
ignorehitpause=1

[state 2906,本体に追従]
type=bindtoroot
trigger1=ishelper(2906)
ignorehitpause=1

[State 3000, NotHitby]
type = NotHitBy
trigger1=ishelper(2906)
value = ,AA,AT

[state 2906,攻撃を受けた後の処理]
type=hitoverride
trigger1=ishelper(2906)
time=-1
attr=SCA,AP
slot=0
stateno=2906
ignorehitpause=1

[state 2906,アニメ]
type=changeanim
triggerall=root,movetype != H
trigger1=ishelper(2906)
trigger1=anim!=root,anim
value=root,anim
ignorehitpause=1

[state 2906,押す]
type=playerpush
trigger1=ishelper(2906)
value=1
ignorehitpause=1

[state 2906,本体の向きに追従]
type=turn
trigger1=ishelper(2906)
trigger1=facing!=root,facing
ignorehitpause=1

[state 2906,デストローイ]
type=destroyself
triggerall=ishelper
trigger1=name!="Zalazof"
trigger2=roundstate>2
trigger3=root,stateno != 2905
trigger4=root,movetype = H
ignorehitpause=1
