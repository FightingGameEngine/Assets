trigger1 = command = "hold_x"
value = 181

[State 180, 4]
type = ChangeState
trigger1 = command = "hold_a"
value = 182

[State 180, 3]
type = ChangeState
trigger1 = Time = 0
trigger1 = Var(8) = [0,1]
value = 181

[State 180, 4]
type = ChangeState
trigger1 = Time = 0
trigger1 = Var(8) = [0,2]
value = 182

