;Andy's constants.

[Data]
life = 1000          
attack = 100    
defence = 100;000    
fall.defence_up = 50 
liedown.time = 30    
airjuggle = 15       
sparkno = 2        
guard.sparkno = 40 
KO.echo = 0         
volume = 100         

[Size]
xscale = 1          
yscale = 1           
ground.back = 9     
ground.front = 15;9    
air.back = 12        
air.front = 12       
z.width = 3          
height = 60	     
attack.width = 4,4   
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0 
shadowoffset = -1
draw.offset = 0,1

[Velocity]
walk.fwd  = 2.6     
walk.back = -2.1   
run.fwd  = 5, 0    
run.back = -4,-4.4 
jump.neu = 0, -10
jump.back = -3   
jump.fwd = 3      
runjump.back = -2.55,-8.1 
runjump.fwd = 4,-8.1      
airjump.neu = 0,-8.1      
airjump.back = -2.55,-8.1 
airjump.fwd = 2.5,-8.1    

[Movement]
airjump.num = 0     
airjump.height = 35  
yaccel = .5 ;.43
stand.friction = .85           
crouch.friction = .82

;-----------
;Crouch Walk
;-----------
[Statedef 13]
type = C
physics = C
ctrl = 1
anim = 13

[State 30, 1]
type = velset
trigger1 = 1
x = 0

[State 30, 2]
type = velset
trigger1 = command = "Downfwd"
x = 1.2

[State 30, 2]
type = velset
trigger1 = P2BodyDist X <= 5 && P2Dist Y = 0
x = 0

[State 30, 2]
type = velset
trigger1 = P2BodyDist X < -40
x = 0

[State 30, 3]
type = Changeanim
trigger1 = P2BodyDist X < -40
value = 6

[State 30, 3]
type = ChangeState
trigger1 = P2BodyDist X < -40
value = 11
ctrl = 1

[State 30, 3]
type = ChangeState
trigger1 = command != "Downfwd"
value = 11
ctrl = 1

;-------------
; Hop_BACK
;-------------
[Statedef 105]
type = A
movetype = I
physics = A
anim = 105
ctrl = 0
velset = 0,0

[State 200, 2] 
type = PlaySnd
trigger1 = AnimElem = 1
value = S200,1

[State 105, Shadows]
type = Afterimage
trigger1 = time = 0
time = 30
length = 8
PalBright   =   0,  0,  0
PalContrast = 128,128,128
PalAdd      =   0,  0,  40
PalMul      =  1,1,1
FrameGap = 2
Trans = Add1

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;106

;--------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

