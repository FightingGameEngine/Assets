;(「パワー溜め」用にコマンドを追加してます)
[Command]
name = "hold_c"
command = /c

;------------------------------------------------------------------------------
;-| 方向キー |-----------------------------------------------------------------

[Command]
name = "holdfwd"   ;必須コマンド名
command = /$F
time = 1

[Command]
name = "holdback"  ;必須コマンド名
command = /$B
time = 1

[Command]
name = "holdup"    ;必須コマンド名
command = /$U
time = 1

[Command]
name = "holddown"  ;必須コマンド名
command = /$D
time = 1

;============================================================================== 
; ステートエントリーパート（技などを出せるようにするための条件を設定）
;==============================================================================

[Statedef -1] ;←この行は絶対に消さないでね。必須項目です。

;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------超必殺-----------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

;------------------------------------------------------------------------------

[State -1, Come On Baby!てかぁー]
type = ChangeState
value = 2300
triggerall = !var(59)
triggerall = power >=1000
triggerall = command = "Come On Baby!てかぁー"
triggerall = statetype != A
triggerall =NumHelper(2310)&&!Helper(2310),var(1)
trigger1 = ctrl
trigger2 = (stateno = 200)||(stateno = 400)
trigger2 = (time > 5) || movecontact
trigger3 = (stateno = [200,499])
trigger3 = movecontact
;------------------------------------------------------------------------------

[State -1, キャプテン・ニトロスマッシャー]
type = ChangeState
value = 2200
triggerall = !var(59)
triggerall = power >=1000
triggerall = command = "キャプテン・ニトロスマッシャー"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = 200)||(stateno = 400)
trigger2 = (time > 5) || movecontact
trigger3 = (stateno = [200,499])
trigger3 = movecontact
;------------------------------------------------------------------------------

[State -1, キャプテン・ソーサリー]
type = ChangeState
value = 2100
triggerall = !var(59)
triggerall = power >=1000
triggerall = command = "キャプテン・ソーサリー"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = 200)||(stateno = 400)
trigger2 = (time > 5) || movecontact
trigger3 = (stateno = [200,499])
trigger3 = movecontact
;------------------------------------------------------------------------------

[State -1, キャプテン・スプラッシュサイクロン]
type = ChangeState
value = 2000
triggerall = !var(59)
triggerall = power >=1000
triggerall = command = "キャプテン・スプラッシュサイクロン"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = 200)||(stateno = 400)
trigger2 = (time > 5) || movecontact
trigger3 = (stateno = [200,499])
trigger3 = movecontact

;***************************************************************************
