
;---------------------------------------------------------------------------
; 基本データ
;---------------------------------------------------------------------------
[Data]
life              = 1000   ;?イフ（体力ゲージ）最大値
power             = 3000   ;パ?ーゲージ最大値（オプシ??・デフォ?トは3000=Lv.3）
attack            = 100    ;攻?力（デフォ?トは１００?）
defence           = 100    ;防御力（デフォ?トは１００?）
fall.defence_up   = 50     ;横に倒れている?に一?的に加える防御力（?）
liedown.time      = 60     ;横に倒れている?間（フ?ー?）
airjuggle         = 15     ;ジ?グ?ポイ?ト限界値（「小ネタ.txt」参照）
sparkno           = 2      ;デフォ?トのヒットスパーク（fightfxから）
guard.sparkno     = 40     ;デフォ?トのガードスパーク（fightfxから）
KO.echo           = 0      ;ＫＯ?の音声（11,0）にエコーを掛けるか否か（0=掛けない,1=掛ける）
volume            = 120      ;キ??の標?の音量（最小-255・最大255）
IntPersistIndex   = 1     ;?の?ウ?ドへ?ち越せる「Var」のアド?スの範囲を?める（※１）
FloatPersistIndex = 1     ;?の?ウ?ドへ?ち越せる「FVar」のアド?スの範囲を?める（※１）

;---------------------------------------------------------------------------
; サイズ
;---------------------------------------------------------------------------
[Size]
xscale           = 1      ;キ??の横の大きさ（絶対値・float）
yscale           = 0.8       ;キ??の縦の大きさ（絶対値・float）
ground.back      = 15      ;地上にいる?の「後方の物?的な?」
ground.front     = 16      ;地上にいる?の「前方の物?的な?」
air.back         = 12      ;空?にいる?の「後方の物?的な?」
air.front        = 12      ;空?にいる?の「前方の物?的な?」
height           = 60      ;キ??の物?的な?さ（?いほど?手は飛び越しにくくなる）
attack.dist      = 160     ;?手がガード態勢に入る最低の?離
proj.attack.dist = 90      ;自分の「Projectile」に対して?手がガード態勢に入る最低の?離
proj.doscale     = 1       ;xscaleとyscaleを「Projectile」にも影響させるか否か（0=させない・1=させる）
head.pos         = 5,-130  ;キ??の標?の頭の座標（Bind系で適用される）
mid.pos          = 5,-85  ;キ??の標?の体?心の座標（Bind系で適用される）
shadowoffset     = 0       ;影のＹ軸方向の位置座標
draw.offset      = 0,0     ;キ??の表示座標（Ｘ軸,Ｙ軸）

;---------------------------------------------------------------------------
; 移動速度
;---------------------------------------------------------------------------
[Velocity]
walk.fwd  = 2      ;前進の速度
walk.back = -1.5     ;後退の速度
run.fwd  = 6, 0    ;前ダッシ?の速度（ホップする?はyを-にする）
run.back = -6,-3.8 ;後ダッシ?の速度（ホップする?はyを-にする）
jump.neu = 0,-10    ;?直ジ??プの速度
jump.back = -2.7    ;後ジ??プの速度
jump.fwd = 2.7       ;前ジ??プの速度
runjump.back = -2.55,-8.1 ;後ダッシ?しながらのジ??プ速度(オプシ??)
runjump.fwd = 4,-8.1      ;前ダッシ?しながらのジ??プ速度(オプシ??)
airjump.neu = 0,-8.1      ;２段ジ??プ以降の?直ジ??プの速度(オプシ??)
airjump.back = -2.55      ;２段ジ??プ以降の後ジ??プの速度(オプシ??)
airjump.fwd = 2.5         ;２段ジ??プ以降の前ジ??プの速度

;---------------------------------------------------------------------------
; 運動関係
;---------------------------------------------------------------------------
[Movement]
airjump.num     = 0        ;空?ジ??プが出?る回?
airjump.height  = 35       ;空?ジ??プが出?る最低の?度（Ｙ軸）
yaccel          = .44      ;Ｙ軸加速度（重力）
stand.friction  = .85      ;立っている?の?擦係?（ステートのPhysicsが「S」の?）
crouch.friction = .82      ;しゃがんでいる?の?擦係?（ステートのPhysicsが「C」の?）

