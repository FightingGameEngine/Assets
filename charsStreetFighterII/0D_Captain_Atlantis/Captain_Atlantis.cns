;===========================================================================
; ステート
;===========================================================================
;===========================================================================
; 基本行動
;===========================================================================

;---------------------------------------------------------------------------
; ?ウ?ド開始前?期化専用ステート
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = 1
value = 9999

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = !RoundsExisted;roundno = 1
value = 190

;---------------------------------------------------------------------------
; ジ??プ開始
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 6]
type = ChangeState
trigger1 = var(59)
value = 0
ctrl = 1

[State 40, ハイジ??プ]
type = VarSet
trigger1 = !var(59)
trigger1 = (command = "jump")
var(1) = 1

[State 40, 1]
type = VarSet
trigger1 = !var(59)
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 移動速度]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*ifelse(var(1) = 1,1.7,1), const(velocity.jump.back.x)*ifelse(var(1) = 1,1.7,1)))
y = const(velocity.jump.y)*ifelse(var(1) = 1,1.5,1)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; ジ??プ
[Statedef 50]
type    = A
physics = A

[State 40, ハイジ??プ音]
type = PlaySnd
trigger1 = var(1) = 1
trigger1 = Time = 0
value = 40,3

[State 40, ハイジ??プ残?]
type = AfterImage
trigger1 = var(1) = 1
trigger1 = Time = 0
time = 30
trans = add1

[State 50, 1]
type = VarSet
trigger1 = Time = 5
var(1) = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))
;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 1

[State 450, 音を鳴らす]
type = PlaySnd
trigger1 = time = 0
value = 5, 10
channel = 0

[State 200, 4]
type = CtrlSet
trigger1 = var(59)
trigger1 = time<= 5
value = 0

[State 200, 4]
type = CtrlSet
trigger1 = var(59)
trigger1 = time>= 5
value = 1

[State -2,ダウ?エフェクト]
type = Explod
trigger1 = Time = 0
trigger2 = Time = 4
trigger3 = Time = 8
anim = 30040
id = 30040
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = P1
sprpriority = 3
bindtime = 1
ownpal = 1
Facing = -1
scale = 0.2,0.2
vel = -0.5,-1

[State 701,ダッシ?エフェクト]
type = Explod
trigger1 = time = 0
anim = 30020
id = 30020
pos = ceil(0*const(size.xscale)),ceil(-90*const(size.yscale))
postype = P1
sprpriority = -2
bindtime = 1
ownpal = 1
facing = 1

[State 52, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 40,1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)+ifelse(PrevStateno=107,1.8,0)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = time > 20
value = 101
ctrl = 0

