; 投げ掴みモーション

[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
ctrl = 0
anim = 800
sprpriority = 2

;****コマンド判定****************************************

[State 1001, 強弱]
type = VarSet
triggerall = !var(59)
trigger1 = Time = 0
var(1) = ifelse((command = "holdback"),1,0)
IgnoreHitPause = 1
Persistent = 1

[State -3, ]
type = VarSet
triggerall = var(59) && roundstate = 2
trigger1 = Time = 0
v = 1
value = ifelse(BackEdgeBodyDist <= 80,1,0)
IgnoreHitPause = 1
Persistent = 1

