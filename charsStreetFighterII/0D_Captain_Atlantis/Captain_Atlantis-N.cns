

;===========================================================================
; 通常攻撃技
;===========================================================================
;---------------------------------------------------------------------------
;立ち弱
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 1
ctrl = 0
sprpriority = 2
facep2 = 1

[State 40, 3]
type = ChangeAnim
trigger1 =PrevStateNo =200
trigger1 = Time = 0
value = 200

[State 40, 3]
type = ChangeAnim
trigger1 =PrevStateNo !=200
trigger1 = Time = 0
value = ifelse(p2bodydist X <30,201,200)

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = anim = 200
trigger1 = animelem = 3
trigger2 = anim = 201
trigger2 = animelem = 2
value = 0, 1
channel = 1

[State 200, 弱ヒット定義];空中ガードあり
type = HitDef 
trigger1 = var(25) = 2
trigger1 = time = 0
attr = S, NA 
damage = 60
animtype = Light
ground.type = High
guardflag = MA
pausetime = 6, 6
sparkno = -1
guard.sparkno = -1
hitsound = -1
guardsound = S2,0
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -10
air.velocity = -4,-2
getpower = 20
givepower = 0

[State 200, 弱ヒット定義];空中ガードなし
type = HitDef 
trigger1 = var(25) <= 1
trigger1 = time = 0
attr = S, NA 
damage = 60
animtype = Light
ground.type = High
guardflag = M
pausetime = 6, 6
sparkno = -1
guard.sparkno = -1
hitsound = -1
guardsound = S2,0
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -10
air.velocity = -4,-2
getpower = 20
givepower = 0

[state -2, エフェクトX軸]
type = VarSet
trigger1 = movecontact
var(15) = ceil(50*const(size.xscale))
ignorehitpause = 1
Persistent = 1

[state -2, エフェクトY軸]
type = VarSet
trigger1 = movecontact
var(16) = ceil(ifelse(anim = 200,-120,-40)*const(size.yscale))
ignorehitpause = 1
Persistent = 1

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

