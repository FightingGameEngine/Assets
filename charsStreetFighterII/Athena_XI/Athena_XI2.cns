;(HELPER)ビット・消滅
[Statedef 2022]
type = A
ctrl = 0
;anim = 2020
velset = 0,0
movetype = I
physics = N
sprpriority = 1

[state a]
type = AssertSpecial
trigger1 = 1
flag = noshadow

;---------------------[変数指定]
[state a]
type = varset
trigger1 = time = 0
fvar(1) = 0

[state a]
type = varadd
trigger1 = time >= 10
fvar(1) = 0.04

;---------------------[速度]

;---------------------[]
[state a]
type = angledraw
trigger1 = 1
scale = 1-fvar(1),1-fvar(1)


;---------------------[消滅]
[state a]
type = destroyself
trigger1 = fvar(1) >= 1.0


;---------------------------------------------------------------------------
;(HELPER)ビット・クリスタルシュート移動
[Statedef 2023]
type = A
ctrl = 0
;anim = 2020
velset = 0,0
movetype = I
physics = N
sprpriority = 1

[state a]
type = AssertSpecial
trigger1 = 1
flag = noshadow



;---------------------[速度]
[state a]
type = velset
trigger1 = 1
x = 7*((parentdist x -19)/(abs(parentdist x -19) + abs(parentdist y - 130) + 0.0000001))
y = 7*((parentdist y - 130)/(abs(parentdist x -19) + abs(parentdist y - 130) + 0.0000001))


;---------------------[消滅]
[state a]
type = destroyself
trigger1 = parentdist x >= 12 && parentdist x <= 26
trigger1 = parentdist y >= 123 && parentdist y <= 137
trigger2 = root,movetype = H



