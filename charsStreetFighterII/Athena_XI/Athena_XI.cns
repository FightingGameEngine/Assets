;ゲー??に常にいつでも開始したいステート、ここでは「?地音」に使用しています
;下の条?は「52か106のステートに移動して１フ?ー?目に」と言う?です。
;52と106はバックステップとジ??プの?地のステートです。
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 
trigger2 = stateno = 107 
trigger3 = stateno = 103 
value = 40, 0


[State -3, 2];ジ??プ音
type = PlaySnd
triggerall = time = 1
trigger1 = stateno = 40 
trigger1 = var(15) <= 0
value = 40, 1
channel = 3

[State -3, 2];ジ??プ音
type = PlaySnd
triggerall = time = 1
trigger1 = stateno = 40 
trigger1 = var(15) > 1
value = 40, 2
channel = 3

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
;trigger1 = stateno = 100 
trigger1 = stateno = 105 
value = 105, 0

;ダ?ージ?のエフェクトの消?
[State 1]
type = removeexplod
trigger1 = MoveType = H
ID = 2405

;ダ?ージ?のエフェクトの消?
[State 1]
type = removeexplod
trigger1 = MoveType = H
ID = 1000

[state a];残?消?
type = afterimagetime
trigger1 = movetype = H
time = 0


[State 210, Width];画面端の?し戻し判定
type = Width
trigger1 = 1
edge = 5,0



[State 1010,1];テ?ポート・ダ?ージ
type = posset
trigger1 = prevstateno = 1300 || prevstateno = 1350
trigger1 = time = 0
trigger1 = movetype = H
trigger1 = numhelper(1300) = 1
x = helper(1300),pos x
y = helper(1300),pos y


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ハイジ??プ??
[State -3, 5];ハイジ??プ判定
type = varset
trigger1 = stateno = 10
trigger1 = time = 0
trigger2 = stateno = 100
v = 15
value = 20

[State -3, 5];ハイジ??プ消?
type = varset
trigger1 = stateno = 52
trigger1 = time = 0
v = 15
value = 0

; 小ジ??プ??
[State -3, 5];小ジ??プ判定
type = varset
trigger1 = stateno = 40
trigger1 = command != "holdup"
v = 16
value = 1

[State -3, 5];小ジ??プ消?
type = varset
trigger1 = stateno = 40
trigger1 = command = "holdup"
v = 16
value = 0

[State -3, 5]
type = velset
trigger1 = stateno = 50
trigger1 = anim = 42
trigger1 = time = 1
trigger1 = var(15) >= 1
x = 5
;y = -9


[State -3, 5]
type = velset
trigger1 = stateno = 50
trigger1 = anim = 43
trigger1 = time = 1
trigger1 = var(15) >= 1
x = -5
;y = -9

[State -3, 5];小ジ??プ
type = veladd
trigger1 = stateno = 50
trigger1 = time = 1
trigger1 = var(16) = 1
y = 3

[State -3, 5]
type = AfterImage
trigger1 = stateno = 50
trigger1 = time = 1
trigger1 = var(15) >= 1
time = 10
trans = add1
timegap = 1
framegap = 2
length = 8
palbright = 12,12,12
palcontrast = 225,225,225
palpostbright = 0,0,0
paladd = 0,0,0
palmul = 1,1,1


;-------------------------------
; ?ーダー超必殺技背景エフェクト
[Statedef 6050]
type = A
movetype = I
physics = N
anim = 6050+root,var(25)
velset = 0, 17
ctrl = 0

[State 3020, 1]
type = AssertSpecial
trigger1 = 1
;flag = NoBG
;flag2 = NoFG
flag = noshadow
ignorehitpause = 1

[State 2000, 6];背景
type = helper
trigger1 = pos y >= 0;time = 15
id = 6050
persistent = 0
name = "MAX2"
pos = 0,-508-254
postype = p1
stateno = 6050
helpertype = normal
keyctrl = 0
persistent = 0

[state a]
type = posset
trigger1 = 1
x = -160

[state a];透過
type = Trans
trigger1 = 1
trans = addalpha
alpha = 306-40, 40

[State 3020, 1]
type = RemoveExplod
triggerall = Time > 0
trigger1 = root,StateNo != [2200,2299]
trigger2 = time = 60
ID = 6022

[State 3020, 1]
type = DestroySelf
triggerall = Time > 0
trigger1 = root,StateNo != [2200,2299]
trigger2 = time = 60

