;---------------------------------------------------------------------------
; ??離立ち・弱・パ?チ・の動作
[Statedef 200]
type    = S                      
movetype= A                      
physics = S                      
juggle  = 8                      
;Commonly-used controllers:
velset = 0,0                     ;このステートが始まった?に移動するか（0,0で動かない）
ctrl = 0                         ;このステート?に他のコマ?ドを受け付けるか(1で受け付ける)
anim = 200                       ;このステートで表示するスプ?イトステート番?(0で変化無し)
poweradd = 0                    ;このステートを使った?のパ?ー?加量(0で変化無し)

[State 200, 1]
type = HitDef
trigger1 = animelem = 3
attr = S, NA                     ;立ち状態で、通常の攻?(?は立ち、?は通常、aは攻?を表す)
damage = 36 + var(8)*9, 0                   ;ダ?ージ量（左が?たった?、右はガードした?）
getpower = 81,81
animtype = Light                 ;?てた?の?手のポーズ（light/midium/hard/back）から選択
guardflag = MA                   ;ガードできる状態（?aは全ての状態でガード可能）
hitflag = MAF                    ;?てる?のできる条?
priority = 3, Hit                ;攻?の優先?（0弱い　4通常　7強い
pausetime = 8, 9                 ;攻?が?たった?の硬直?間（左が自分、右が?手）
sparkno = s7000                      ;ヒットエフェクトのスプ?イトステート（無ければ0）
sparkxy = -5, -71               ;ヒットエフェクトを表示する場?（?手の座標で）
hitsound = s400, 0                 ;ヒットした?の音（?*,*にすると自分の音を使う）
guard.sparkno = s7010
guardsound = s120, 0                ;ガードした?の音（同上）
ground.type = high               ;?手のくらった場?（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 9             ;?手が後にすべる?間
ground.hittime  = 9             ;コ?ボが繋がる?間（?くしすぎない?）
ground.velocity = -6             ;地上で攻?をくらった場?の?手の移動状況（?と?で小?点可）
airguard.velocity = -1.9,-2     ;空?で攻?をくらった場?の?手の移動状況（?と?で小?点可）
air.type = high                 ;空?で?手がくらった場?（上と同じ）
air.velocity = -1.4,-3           ;空?で攻?をくらった場?の?手の移動状況（?と?で小?点可）
air.hittime = 12                 ;空?でコ?ボが繋がる?間
ID = 200
nochainID = 1100

[State 200, 1];
type = PlaySnd
trigger1 = animelem = 2
value = 300, 0

[State 200, 5]
type = PlaySnd
trigger1 = AnimElem = 2
value = 200,0

[State 200, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

