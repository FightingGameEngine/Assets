;変?使用表
;　1 = 
;　2 = ??ポーズ変更
;　3 = 
;　4 = ス?ー??
;　5 = 強弱ボタ?判定
;　6 = 通常攻?ボイス、??指定
;　7 = 透過??
;　8 = 
;　9 = 特殊イ?ト?用変?（0.ノーマ?・1.）
; 10 = プ?イ?ーの向き設定
; 11 = 暗転用変?
; 12 = KOサウ?ド
; 13 = ??判定
; 14 = 攻?力
; 15 = ハイジ??プ
; 16 = 小ジ??プ
; 17 = ダ?ージ補正に使用
; 18 = 攻?値の保存
; 19 = タイマ???
; 20 = テ?ポート、ポジシ??X
; 21 = テ?ポート、ポジシ??Y
; 22 = ビットヒット判定？
; 23 = 
; 24 = 
; 25 = ?超背景変更
; 26 = ネバ?補正
;
; 30 = AI判定(にしたいな…)

; f(1) = 攻?補正
; f(2) = 
; f(3) = ビットの回転？

; channel = 4	ビット
; channel = 5	イ?ト?



[Data]
  ;体力ゲージの?期値
life = 1000
  ;攻?力（これ以上に設定すると強くなる）
attack = 100
  ;防御力（これ以上に設定すると強くなる）
defence = 100
  ;コ?ボをくらっている?に?がる防御力
fall.defence_up = 50
  ;倒れてから起上がるまでのフ?ー??
liedown.time = 11
  ;空?でどれだけコ?ボが繋がるか（?くすると無限コ?ボになるので?意）
airjuggle = 15
  ;hitdefで設定していない?の基本ヒットスパークナ?バー
sparkno = 2
  ;設定してない?のガードナ?バー
guard.sparkno = 40
  ;KOした?に声にエコーをかけるか（１でＯＮ）
KO.echo = 0
 volume = 5
  IntPersistIndex = 0
FloatPersistIndex = 40

[Size]
xscale = 1           ;?平方向の縮尺（通常１）
yscale = 0.95           ;?直方向の縮尺（通常１）
ground.back = 15     ;キ??の?(後方,地上)
ground.front = 16    ;キ??の?(前方,地上)
air.back = 12        ;キ??の?(後方,空?)
air.front = 12       ;キ??の?(前方,空?)
height = 102          ;キ??の?さ
attack.dist = 320    ;攻?をした??手がガード体制に入る最低?離
proj.attack.dist = 320;攻?をした??手がガード体制に入る最低?離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = 0, -100   ;頭の大体の座標
mid.pos = -11, -60    ;体の?心の大体の座標
shadowoffset = 0     ;影の?直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.3      ;前進の速度
walk.back = -2.3     ;後退の速度
run.fwd  = 6.0130434, 0    ;前ダッシ?の速度（ホップする?はyを-にする）
run.back = -5.5,-2.1 ;後ダッシ?の速度（ホップする?はyを-にする）
jump.neu = 0,-11.2    ;?直ジ??プの速度
jump.back = -3.55,1    ;後ジ??プの速度
jump.fwd = 3.5,1       ;前ジ??プの速度
runjump.back = -2.55,-8.1 ;後ダッシ?しながらのジ??プ速度(オプシ??)
runjump.fwd = 4,-8.1      ;前ダッシ?しながらのジ??プ速度(オプシ??)
airjump.neu = 0,-8.1      ;２段ジ??プ以降の?直ジ??プの速度(オプシ??)
airjump.back = -2.55      ;２段ジ??プ以降の後ジ??プの速度(オプシ??)
airjump.fwd = 2.5         ;２段ジ??プ以降の前ジ??プの速度

[Movement]
airjump.num = 0      ;空?でジ??プする回?
airjump.height = 35  ;空?でジ??プする最低限の?さ
yaccel = .60         ;重力
stand.friction = .85  ;立ち状態の?擦係?
crouch.friction = .82 ;屈み状態の?擦係?


;---------------------------------------------------------------------------
; commonより ダッシ?
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 1

[State 00]
type = PlaySnd
trigger1 = Time= 0
value = 100, 0
loop = 1
channel = 1

[State 01]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 02] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 03] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 04]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0


