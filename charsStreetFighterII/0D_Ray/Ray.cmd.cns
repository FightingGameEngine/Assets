;---------------------------
;(パ?ー溜めステート用にコマ?ドを追加しています)
[Command]
name = "hold_c"
command = /c

;------------------------------------------------------------------------------
;-| 方向キー?しっぱなし |-----------------------------------------------------
[Command]
name = "holdfwd"   ;要?済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$F
time = 1

[Command]
name = "holdback"  ;要?済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$B
time = 1

[Command]
name = "holdup"    ;要?済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$U
time = 1

[Command]
name = "holddown"  ;要?済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$D
time = 1
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1];←この行は絶対に消さないでください。必須の?目です。

;==============================================================================

;------------------------------------------------------------------------------
;ダイナマイトDDT
[State -1, Stand Light Kick]
type = ChangeState
value = 2200
triggerall = power >=1000
triggerall = command = "ダイナマイトDDT"
triggerall = statetype != A
TriggerAll = var(59) = 0
trigger1 = ctrl||stateno = 100
trigger2 = (stateno = [200,440]) && movecontact
trigger3 = (stateno = 200 && time >= 3)||(anim = 235 && time >= 3)||(stateno = 400 && time >= 5)||(stateno = 430 && time >= 3)
;------------------------------------------------------------------------------
;サイク??ホイー?
[State -1, Stand Light Kick]
type = ChangeState
value = 2100
triggerall = power >=1000
triggerall = command = "サイク??ホイー?"
triggerall = statetype != A
TriggerAll = var(59) = 0
trigger1 = ctrl||stateno = 100
trigger2 = (stateno = [200,440]) && movecontact
trigger3 = (stateno = 200 && time >= 3)||(anim = 235 && time >= 3)||(stateno = 400 && time >= 5)||(stateno = 430 && time >= 3)

;------------------------------------------------------------------------------
;F5
[State -1, Stand Light Kick]
type = ChangeState
value = 2000
triggerall = power >=1000
triggerall = command = "オーバート?ネード"
triggerall = statetype = A
TriggerAll = var(59) = 0
trigger1 = ctrl
trigger2 = (stateno = [600,640]) && movecontact
trigger3 = stateno = 2000 && time >= 15


;------------------------------------------------------------------------------
