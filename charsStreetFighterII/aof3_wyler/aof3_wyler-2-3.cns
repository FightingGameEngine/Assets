;AI

[State -3, A.I. Activation]
type = helper
triggerall = var(59) = 0
triggerall = !NumHelper(20000)
triggerall = alive
Triggerall = PrevStateNo = 190 || PrevStateNo = 5900
Triggerall = stateno = 0; && ctrl
trigger1 = RoundState = [1,2]
trigger1 = Time <= 1
helpertype = normal
name = "AI"
stateno = 20000
ID = 20000
pos = 99999,99999
keyctrl = 1
pausemovetime = 99999
supermovetime = 99999
persistent = 0

[State -3,]
type = changestate
trigger1 = ishelper(20000)
trigger1 = stateno != 20000
value = 20000

