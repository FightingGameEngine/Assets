
;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

[State -2, display]
type = displaytoclipboard
trigger1 = 1
text = "werewood - A.I. var(59) = %d"
;text = "P2BodyDistX = %d, P2BodyDist Y = %d, FrontEdgeBodyDist = %d"
;params = P2BodyDist X, P2BodyDist Y, FrontEdgeBodyDist
params = var(59)

;---OPTION--------------------------------------------------------------------

;画面フラッシュ
[State -2, Flash]
type = varset
Trigger1 = 1
var(6) = 1	; 1:ON  0:OFF

;誕生日強化システム
[State -2, birthday Special]
type = varset
Trigger1 = 1
var(7) = 0	; 1:ON  0:OFF

;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------

[State -2, 画面全体の色合い]
type = EnvColor
triggerall = NumTarget(1001)
triggerall = var(6) = 1
trigger1 = MoveHit = 1
value = 0,0,255
time = 1
under = 1
pausemovetime = 999
ignorehitpause = 0
persistent = 0

[State -2, 画面全体の色合い]
type = EnvColor
triggerall = NumTarget(3110)
triggerall = var(6) = 1
trigger1 = MoveHit = 1
value = 255,255,255
time = 1
under = 1
pausemovetime = 999
ignorehitpause = 0
persistent = 0

;-----------------------------------------------------------------------------

;-----------------------------------------------------------------------------
;スプライトを消滅

[State -2, 裏足スプライトを消す]
type = RemoveExplod
trigger1 = stateno != 440
ID = 441

[State -2, 裏足スプライトを消す]
type = RemoveExplod
trigger1 = stateno != 450
ID = 451

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(360) > 0
trigger1 = StateNo != 350
trigger2 = MoveType != I
ID = 360

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(1052) > 0
trigger1 = StateNo != 1051
ID = 1052

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(1053) > 0
trigger1 = StateNo != 1051
ID = 1053

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(1054) > 0
trigger1 = StateNo != 1051
ID = 1054

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(1055) > 0
trigger1 = StateNo != 1051
ID = 1055

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(1056) > 0
trigger1 = StateNo != 1051
ID = 1056

[State -2, エフェクトを消す]
type = RemoveExplod
triggerall = NumExplod(1057) > 0
trigger1 = StateNo != 1051
ID = 1057

;---------------------------------------------------------------------------
;カウンター判断

[State -2, VarSet]
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype = A
var(5) = 1
persistent = 1
ignorehitpause = 1

[State -2, VarSet];カウンター判定初期化
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype != A
trigger2 = Movehit
var(5) = 0

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
;点滅

[State -2, 体力1/4時に点滅]
type = PalFX
trigger1 = (((Life*100)/LifeMax) <= 25 || var(7) = 1) && (GameTime % 2) = 0
trigger1 = roundstate = 2
trigger1 = Alive
time = 1
add = 160, 20, -90
ignorehitpause = 1

;---------------------------------------------------------------------------
;攻撃力

[State -2, 攻撃力変更]
type = varset
trigger1 = ((Life*100)/LifeMax) > 25
fvar(0) = 100.0;(%) 
ignorehitpause = 1

[State -2, 攻撃力変更]
type = varset
trigger1 = ((Life*100)/LifeMax) <= 25 || var(7) = 1
fvar(0) = 120.0;(%) 
ignorehitpause = 1

;カウンター
[State -2, 攻撃力変更]
type = varset
trigger1 = ((Life*100)/LifeMax) > 25
trigger1 = var(5) = 1
fvar(0) = 120.0;(%) 
ignorehitpause = 1

;カウンター
[State -2, 攻撃力変更]
type = varset
trigger1 = ((Life*100)/LifeMax) <= 25 || var(7) = 1
trigger1 = var(5) = 1
fvar(0) = 144.0;(%) 
ignorehitpause = 1

;相手空中
[State -2, 攻撃力変更]
type = varset
trigger1 = numenemy
trigger1 = ((Life*100)/LifeMax) > 25
trigger1 = enemynear,statetype = A
fvar(0) = 120.0;(%) 
ignorehitpause = 1

;相手空中
[State -2, 攻撃力変更]
type = varset
trigger1 = numenemy
trigger1 = ((Life*100)/LifeMax) <= 25 || var(7) = 1
trigger1 = enemynear,statetype = A
fvar(0) = 144.0;(%) 
ignorehitpause = 1

;---------------------------------------------------------------------------
;小ジャンプVerリセット

[State -2, VarSet]
type = VarSet
trigger1 = statetype = S
var(4) = 0

;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
;StateNo 5900について
;
;5900番のステートは、2試合目以降のラウンドコール中に呼び出されます。
;このステートでVarやFVarを初期化しています。
;なのでTurn Modeでは、初登場でも2試合目なのでイントロがありません。

[State -2, 二人目のイントロ]
type = ChangeState             ;二人目でもイントロを作る
value = 190                    ;イントロへ
triggerall = RoundsExisted = 0 ;自分が初参戦時
triggerall = TeamMode = Turns  ;ターンモード
trigger1 = stateno = 5900      ;5900番

[State -2, 勝利バグ解消]
type = CtrlSet                 ;歩きバグ対策
trigger1 = RoundState = 4      ;勝利ポーズ時
trigger1 = Win && Ctrl = 1     ;動ける場合
value = 0                      ;制御不能に

;----------------------------------------------------------------------------
;未完成な相手キャラによって、不具合が起きても自己解決するシステム(仮)
[State -2, Y座標自己修復]
type = PosSet
triggerall = RoundState = 2
trigger1 = stateno = [0,12]      ;立ち＆屈み時
trigger1 = floor(Pos Y) = [-2,3] ;立ち位置が僅かにずれていたらすぐ修正
y = 0

[State -2, Y座標自動修正]
type = PosAdd
triggerall = RoundState = 2
triggerall = Life < LifeMax  ;トレーニングでCtrl+Iを使うときに配慮
trigger1 = stateno = [0,30]  ;歩きも含める
trigger1 = floor(Pos Y) < -2 ;立ち位置が大きくずれていたら移動する
y = 2

[State -2, Y座標自動修正]
type = PosAdd
triggerall = RoundState = 2
triggerall = Life < LifeMax
trigger1 = stateno = [0,30]
trigger1 = floor(Pos Y) > 2 ;同じく
y = -2

;----------------------------------------------------------------------------
;♪
;----------------------------------------------------------------------------

;---------------------------------------------------------------------------------
[Statedef -3];常時監視ステート(p2statenoなどで相手に行動を制御された時は実行しない)
;---------------------------------------------------------------------------------
;パワーゲージ

[State -3, Prevent Crossup]
type = width
trigger1 = 1
edge = 4,0
ignorehitpause = 1

[State -3, ReversalDef]
type = hitoverride
triggerall = stateno != 3000
triggerall = P2Name != "Wyler"
trigger1 = P2BodyDist X < 30
time = -1
attr = SCA, NT, ST, HT
stateno = 850
ignorehitpause = 1

[State -3, ReversalDef]
type = changestate
triggerall = stateno != 3000
triggerall = P2Name != "Wyler"
trigger1 = P2BodyDist X < 30
trigger1 = enemynear, HitDefAttr = SCA, NT, ST, HT
value = 850
ctrl = 0

[State 270, 受け止め定義]
type = null;ReversalDef
trigger1 = 1
attr = SCA, NT, ST
reversal.attr = SCA, NT, ST, HT
pausetime = 0,0
sprpriority = -1
numhits   = 0
sparkno   = -1
sparkxy   = 0,0
hitsound  = -1,-1
p1facing  = 1
p2facing  = 1
p1stateno = 850
p2stateno = 5976

[State -3, velset]
type = velset
trigger1 = anim = 5300
x = const(velocity.walk.fwd.x)
y = 0
persistent = 0
ignorehitpause = 1

[State -3, PowerSet]
type = PowerSet
trigger1 = roundstate = [0,1]
value = 3000

[State -3, パワーゲージ増加]
type = PowerAdd
triggerall = roundstate = 2
triggerall = power < 3000
trigger1 = time%100
value = 1
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = stateno != [200,349]
triggerall = statetype != A
trigger1 = command = "気力溜め"
var(12) = 1

[State -3, varset]
type = VarSet
trigger1 = command != "気力溜め"
trigger2 = stateno = 350
trigger3 = movetype != I
trigger4 = statetype = A
trigger5 = stateno = [100,105]
var(12) = 0

;気力溜め
[State -3, Power Gauge Charge]
type = ChangeState
value = 350
triggerall = var(12) >= 21
triggerall = stateno != [200,349]
triggerall = power < 3000 ;ゲージが満タンの時は出せない
trigger1 = statetype != A
trigger1 = ctrl

;----------------------------------------------------------------

[State -3, 着地音]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = 40, 4

[State -3, Shake Screen]
type = EnvShake
triggerall = Time = 1
trigger1 = stateno = 52
time = 8
ampl = 2
freq = 170   ;A frequency of less than 180 causes a dampening effect

[State -3, ダメージボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
trigger2 = stateno = 5070 || stateno = 5080 || stateno = 5100
value = 6,random/500 
channel = 0

[State -3, 気合の声を止める]
type = StopSnd
trigger1 = stateno != 350
channel = 1

;----------------------------------------------------------------
;フィニッシュ音

[State -3, varset]
type = varset
trigger1 = RoundState = [0,2]
var(13) = 0

[State -3, varset]
type = varset
triggerall = var(13) = 0
trigger1 = RoundState = 3
var(13) = 1
ignorehitpause = 1
persistent = 0

[State -3, フィニッシュ音]
type = PlaySnd
trigger1 = var(13) = 1
trigger1 = !(P2Name = "aof3_ryo" || P4Name = "aof3_ryo")
value = 2, 12
ignorehitpause = 1
persistent = 0

[State -3, varset]
type = varset
triggerall = var(13) = 1
trigger1 = RoundState = 3 && Time > 0
var(13) = 2
ignorehitpause = 1
persistent = 0

;----------------------------------------------------------------

;---------------------------------------------------------------------------
; タッグ判別

[State -3, Check Partner]
type = VarSet
trigger1 = NumPartner
trigger1 = fvar(1) = 0
fvar(1) = 1

