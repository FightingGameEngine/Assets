;;;;;;;;;;;;; A.I. command ;;;;;;;;;;;;;;;;

[State -3, guard]
Type = ChangeState
Value = 100
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = MatchOver = 0
triggerall = movetype != H
triggerall = statetype != A
triggerall = stateno != [100,105]
triggerall = p2stateno != 271
triggerall = ((Life*100)/LifeMax) > 25
trigger1 = stateno = 40
trigger2 = stateno = [20,21]
trigger3 = stateno = [10,11]
trigger4 = ctrl

[State -3, guard]
Type = ChangeState
Value = 120
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = MatchOver = 0
triggerall = movetype != H
triggerall = statetype != A
TriggerAll = StateNo != [120,155]
TriggerAll = inguarddist
Trigger1 = (ctrl) && (P2BodyDist X = [200,240]) && (EnemyNear,HitDefAttr = SCA, HA, HP, HT) && (Random <= 499)
Trigger2 = (stateno = [100,105]) && (EnemyNear,HitDefAttr = SCA, HA, HP, HT) && (Random <= 499)

[State -3, GolfReflect2]
type = ChangeState
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = MatchOver = 0
triggerall = movetype != H
triggerall = statetype != A
triggerall = enemynear, numproj != 0
triggerall = stateno != [350,351]
triggerall = stateno != [1000,1100]
trigger1 =  (ctrl && inguarddist && P2BodyDist X = [200,240]) || (ctrl && inguarddist && stateno = 100)
Trigger1 = Random <= 999
value = ifelse(power >= 2000 && power <= 3000, ifelse(random<=499,1000,1100), 350)
ignorehitpause = 1

[State -3, GolfReflect2]
type = ChangeState
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = MatchOver = 0
triggerall = movetype != H
triggerall = statetype != A
triggerall = enemynear, vel x=0 && P2MoveType = A && enemynear, NumHelper != 0
triggerall = stateno != [350,351]
triggerall = stateno != [1000,1100]
trigger1 =  (ctrl && inguarddist && P2BodyDist X = [200,240]) || (ctrl && inguarddist && stateno = 100)
Trigger1 = Random <= 999
value = ifelse(power >= 2000 && power <= 3000, ifelse(random<=499,1000,1100), 350)
ignorehitpause = 1

[State -3, 投げ]
type  = ChangeState
value = ifelse(p2statetype = A,400,800)
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = MatchOver = 0
triggerall = movetype != H
triggerall = statetype != A
triggerall = p2movetype != H && p2statetype != L
triggerall = p2stateno != 271
trigger1 = stateno = 100
trigger1 = P2BodyDist X <= 50
trigger1 = Random <= 999
trigger2 = ctrl && Random <= 60

[State -3, super1]
type = ChangeState
value = 3000
triggerall = var(59) != 0
triggerall = roundstate = 2
triggerall = MatchOver = 0
triggerall = movetype != H
triggerall = statetype != A
triggerall = power >= 2000
triggerall = ((Life*100)/LifeMax) <= 25
triggerall = p2stateno != 271
trigger1 = ctrl
Trigger1 = Random <= 999

