Author: " Falchion22 "


; Ending cutscene for Retsu

[SceneDef]
spr = ending.sff
startscene = 0         ;Starting scene number (for debugging)


;------------------------------------
[Scene 0]
; Fade
fadein.time = 60       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 50
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 160,40   ;Default position for all layers

layer0.anim =  0     
layer0.offset = -250,-45    ;Position sky
layer0.starttime = 0
end.time = 2100

layer1.anim =  1     
layer1.offset = -380,-30    ;Position bckgrd
layer1.starttime = 0
end.time = 2100

layer2.anim =  2    
layer2.offset = 0,180    ;Retsu
layer2.starttime = 0
end.time = 2100

layer3.anim =  3    
layer3.offset = -140,-25    ;text
layer3.starttime = 0
end.time = 2100

; Music
bgm = sound/retsu.mp3 
bgvolume = 0
bgm.loop = 9999
; Total time
end.time = 2000

