airjump.height = 35  
yaccel = .5 ;.43
stand.friction = .85           
crouch.friction = .82

;-----------
;Crouch Walk
;-----------
[Statedef 13]
type = C
physics = C
ctrl = 1
anim = 13

[State 30, 1]
type = velset
trigger1 = 1
x = 0

[State 30, 2]
type = velset
trigger1 = command = "Downfwd"
x = 1.2

[State 30, 2]
type = velset
trigger1 = P2BodyDist X <= 5 && P2Dist Y = 0
x = 0

[State 30, 2]
type = velset
trigger1 = P2BodyDist X < -15
x = 0

[State 30, 3]
type = Changeanim
trigger1 = P2BodyDist X < -15
value = 6

[State 30, 3]
type = ChangeState
trigger1 = P2BodyDist X < -15
value = 11
ctrl = 1

[State 30, 3]
type = ChangeState
trigger1 = command != "Downfwd"
value = 11
ctrl = 1

