hitflag = MA        ;HLAFD+-
guardflag = HA         ;HLA
animtype = hard          ;light,medium,hard,back,up,diagup
priority = 4,Hit   ;Hit,Miss,Dodge
damage = 40,0
pausetime = 10,10
sparkno = 2
sparkxy = -10,ifelse((var(2)),-65,-35)
hitsound = 5,2
guardsound = 6,0
ground.type = High      ;Low,Trip,None
ground.slidetime = 5
ground.hittime = 12
air.hittime = 20
ground.velocity = -4,0
air.velocity = -2,-3

[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

