;; DAMN, ANDORE SUCKS
[Statedef -2]
[state -2, AI Charging]
type = VarSet
triggerall = (AILevel > 0)
trigger1 = 1
var(1) = IfElse((stateno = (41||42||100||299||819||799||399) && time = 0),0,(var(1) + 1))

[state -2, AI nocheat]
type = VarSet
triggerall = (AILevel > 0)
trigger1 = stateno = (0||20)
var(1) = 0

[state -2, AI Charged]
type = VarSet
triggerall = (AILevel > 0)
trigger1 = 1
var(2) = IfElse((var(1) >= 45),1,0)

[state -2, AI LP]
type = ChangeState
value = 200
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = enemynear, statetype != L
triggerall = random < ((AILevel * 12) + ifelse(movehit||moveguarded && (p2bodydist x < 70),100,50))
triggerall = p2bodydist x < 70
triggerall = (((pos y) * -1) + 80) <= ((enemynear, pos y) * -1) + ((enemynear, Const(size.height)) * IfElse(enemynear, statetype = S,1,0.5))
triggerall = (((pos y) * -1) + 80) >= ((enemynear, pos y) * -1)
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 204 || stateno = 206
trigger2 = (time >= 11 || movehit||moveguarded)

