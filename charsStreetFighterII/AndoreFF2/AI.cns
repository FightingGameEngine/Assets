[state -2, AI Crash]
type = ChangeState
value = 399
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = statetype != A
triggerall = enemynear, statetype != L
triggerall = p2bodydist x < 110
triggerall = random < ((AILevel * (AILevel / 1.75)) + (2/(110 - (p2bodydist x))) + (ifelse(movehit,100,0)))
trigger1 = ctrl
trigger1 = var(2) = 1
trigger2 = stateno = 200 || stateno = 204 || stateno = 206
trigger2 = movehit

[state -2, AI Ass]
type = ChangeState
value = 299
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = statetype != A
triggerall = random < ((AILevel * (AILevel / 2.75)) + (ifelse((enemynear, statetype = L),100,0)) + (2/(110 - (p2bodydist x))) + (ifelse(movehit,100,0)))
trigger1 = ctrl
trigger2 = stateno = [200,400]
trigger2 = movehit

;Choke Throw
[State -1, Throw]
type = ChangeState
value = 799
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = enemynear, statetype != L
triggerall = random < (AILevel * 20) + ((-30 + (p2dist x)) * 5)
trigger1 = statetype = S
trigger1 = ctrl
trigger1 = p2bodydist x <= 13

;SPD
[State -1, SPD]
type = ChangeState
value = 819
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = enemynear, statetype != L
triggerall = random < (AILevel * 30) + ((-30 + (p2dist x)) * 5)
trigger1 = statetype != A || stateno = 40
trigger1 = ctrl || stateno = 40
trigger1 = p2bodydist x <= 13


[state -2, AI Encroach]
type = ChangeState
value = 20
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = statetype = S
triggerall = p2bodydist x >= 160
triggerall = random < ((AILevel * 10) + Ifelse((enemynear, statetype = L),150,40))
trigger1 = stateno = 0
trigger1 = ctrl

[state -2, AI Anti-Projectile]
type = ChangeState
value = 399
triggerall = (AILevel > 0) && (roundstate = 2)
triggerall = statetype != A
triggerall = random < IfElse((InGuardDist && (stateno = 130 || stateno = 131) && (time >= 35)),(150 + (AILevel * 10)),0)
trigger1 = ctrl
trigger1 = var(2) = 1
trigger2 = stateno = 200 || stateno = 204 || stateno = 206
trigger2 = movehit