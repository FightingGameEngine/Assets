;------------------------------------------------------------------------------
;-| 方向キー押しっぱなし |-----------------------------------------------------
[Command]
name = "holdfwd"   ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$F
time = 1

[Command]
name = "holdback"  ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$B
time = 1

[Command]
name = "holdup"    ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$U
time = 1

[Command]
name = "holddown"  ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = /$D
time = 1

;------------------------------------------------------------------------------
;==============================================================================
; 技を実行するための条件の設定（ステートエントリーパート）
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1];←この行は絶対に消さないでください。必須の項目です。

;==============================================================================


;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------超必殺-----------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

;砲神連波
[State -1, 砲神連波]
type = ChangeState
value = 2000
triggerall = !var(59)
triggerall = command = "砲神連波"||(var(8) = [200000,200099])
triggerall = power >=1000
TriggerAll = !NumprojID(2000)
TriggerAll = !NumprojID(1000)
triggerall = statetype != A
trigger1 = ctrl||Var(20) = 1||((Stateno = [200,599])&&time <= 3&&statetype != A)
trigger2 = stateno = 200&&Animelem = 2,>= 0
trigger3 = anim = 211&&MoveContact
trigger4 = anim = 220&&MoveContact
trigger5 = anim = 230&&Animelem = 3,>= 0
trigger6 = anim = 241&&Animelem = 3,>= 0&&Animelem = 4,<= 0
trigger7 = anim = 400&&Animelem = 2,>= 0
trigger8 = anim = 410&&MoveContact
trigger9 = anim = 430&&Animelem = 3,>= 0
trigger10 = anim = 440&&Animelem = 4,>= 0&&Animelem = 5,<= 0

;神極乱舞
[State -1, 神極乱舞]
type = ChangeState
value = 2100
triggerall = !var(59)
triggerall = command = "神極乱舞"||(var(8) = [210000,210099])
triggerall = power >=1000
triggerall = statetype != A
trigger1 = ctrl||Var(20) = 1||((Stateno = [200,599])&&time <= 3&&statetype != A)
trigger2 = stateno = 200&&Animelem = 2,>= 0
trigger3 = anim = 211&&MoveContact
trigger4 = anim = 220&&MoveContact
trigger5 = anim = 230&&Animelem = 3,>= 0
trigger6 = anim = 241&&Animelem = 3,>= 0&&Animelem = 4,<= 0
trigger7 = anim = 400&&Animelem = 2,>= 0
trigger8 = anim = 410&&MoveContact
trigger9 = anim = 430&&Animelem = 3,>= 0
trigger10 = anim = 440&&Animelem = 4,>= 0&&Animelem = 5,<= 0

;練弓腿
[State -1, 練弓腿]
type = ChangeState
value = 2200
triggerall = !var(59)
triggerall = command = "練弓腿"||(var(8) = [220000,220099])
triggerall = power >=1000
triggerall = statetype != L
triggerall = statetype != A
trigger1 = ctrl||(anim = 40)||((anim = 52)&&Pos Y >= 0)||Var(20) = 1||((Stateno = [200,599])&&time <= 3&&statetype != A)
trigger2 = stateno = 200&&Animelem = 2,>= 0
trigger3 = anim = 211&&MoveContact
trigger4 = anim = 220&&MoveContact
trigger5 = anim = 230&&Animelem = 3,>= 0
trigger6 = anim = 241&&Animelem = 3,>= 0&&Animelem = 4,<= 0
trigger7 = anim = 400&&Animelem = 2,>= 0
trigger8 = anim = 410&&MoveContact
trigger9 = anim = 430&&Animelem = 3,>= 0
trigger10 = anim = 440&&Animelem = 4,>= 0&&Animelem = 5,<= 0

