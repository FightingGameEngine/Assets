command = x+y
time = 15

[Command]
name = "上段回し蹴り"
command = a+b
time = 15

[Command]
name = "肘落とし"
command = a+y
time = 15

[Command]
name = "recovery"
command = c
time = 1

[Command]
name = "recovery"
command = z
time = 1

