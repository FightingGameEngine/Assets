;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------行動-----------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

[State -1,立ちガード]
Type = ChangeState
Value = 120
triggerall = !var(59)
triggerall = statetype != A
triggerall = MoveType != H
Triggerall = InGuardDist
triggerall = command = "holdback"
trigger1 = stateno=100

;ジャンプ
[State -1, Dash]
type = ChangeState
value = 40
triggerall = !var(59)
triggerall = command = "holdup"
triggerall = statetype != A
trigger1 = ctrl

;ダッシュ
[State -1, Dash]
type = ChangeState
value = 100
triggerall = !var(59)
trigger1 = command = "FF"
trigger1 = StateType != A
trigger1 = ctrl

;バックステップ
[State -1, Back Step]
type = ChangeState
value = 105
triggerall = !var(59)
triggerall = command = "BB"
triggerall = StateType != A
trigger1 = ctrl||Var(20) = 1


;------------------------------------------------------------------------------
;投げ
[State -1, Kung Fu Throw]
type = ChangeState
value = 211
triggerall = !var(59)
triggerall = command = "y"
triggerall = statetype != A
triggerall = ctrl||Var(20) = 1
trigger1 = command = "holdfwd"||command = "holdback"
trigger1 = p2bodydist X = (-5,10)
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H

;==============================================================================

