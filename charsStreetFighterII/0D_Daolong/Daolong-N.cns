
;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------通常攻撃---------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************
; 立ち弱パンチ

[Statedef 200]
type     = S
movetype = A
physics  = S
juggle   = 1
poweradd = 0
ctrl     = 0
sprpriority = -1


[State 40, 3]
type = ChangeAnim
trigger1 =PrevStateNo =200
trigger1 = Time = 0
value = 200

[State 40, 3]
type = ChangeAnim
trigger1 =PrevStateNo !=200
trigger1 = Time = 0
value = ifelse(p2bodydist X <15,201,200)

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = animelem = 2
value = 0, 0


[State 240, ヒット定義]
type = HitDef
trigger1 = Time = 0
attr = S, NA
animtype  = Light
damage    = ifelse(anim = 201,25,16)
guardflag = M
pausetime = 10,10
sparkno = S10000
guard.sparkno = S10080
sparkxy = ceil(-10*const(size.xscale)),ceil(-80*const(size.yscale))
hitsound   = S2,0
guardsound = S3,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 11
guard.hittime = 11
ground.velocity = -6
air.velocity = -3,-4
getpower = 20
givepower = 0


[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

