; 立ち強パンチ

[Statedef 211]
type     = S
movetype = A
physics  = S
ctrl     = 0
anim     = 215
sprpriority = 2

[State -2, リセット]
type = Varset
trigger1 = Time = 0
v = 20
value = 0
ignorehitpause = 1

[State -2,キャンセルエフェクト]
type = Explod
triggerall = NumExplod(10089) = 0
triggerall = Prevstateno = 5001||Prevstateno = 5011|| Prevstateno = 151||Prevstateno = 153
trigger1 = time = 0
anim = 10089
id = 10089
pos = 0,0
postype = P1
sprpriority = -1
bindtime = 1
ownpal = 1
ignorehitpause = 1

;****コマンド判定****************************************

[State 1001, 強弱]
type = VarSet
triggerall = !var(59)
trigger1 = Time = 0
var(1) = ifelse((command = "holdback"),1,0)
IgnoreHitPause = 1
Persistent = 1

[State -3, ]
type = VarSet
triggerall = var(59) && roundstate = 2
trigger1 = Time = 0
v = 1
value = ifelse(BackEdgeBodyDist <= 80,1,0)
IgnoreHitPause = 1
Persistent = 1

;***********************普通*******************************************
