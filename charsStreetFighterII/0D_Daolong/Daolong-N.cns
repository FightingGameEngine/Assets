attr = S, NT
hitflag = M-
priority = 1, Miss
sparkno = -1
p1sprpriority = 1
p2sprpriority = 0
p1stateno = 800
guard.dist = 0
fall = 1
down.bounce = 1
id = 800

[State 220, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 210
