ownpal = 1

;-------------
; Spinning Hat
;-------------
[Statedef 182]
type = A
movetype = A
physics = N
ctrl = 0
anim = 182
velset = 2,-2.5

[State 195, 9]   ;slow down
type = Velset
trigger1 = animelem = 4
x = 1.2
y = -1.7

[State 195, 9]   ;slow down
type = Velset
trigger1 = animelem = 5
x = .9
y = -1.4

[State 195, 9]   ;highest point
type = Velset
trigger1 = animelem = 6
x = .9 ;.6
y = -.5

[State 195, 9]   ;Start to descend *Slow*
type = Velset
trigger1 = animelem = 8
x = .9 ;.6
y = .5

[State 195, 9]   ;Start to descend *Fast*
type = Velset
trigger1 = animelem = 10
x = .9
y = 1.4

[State 195, 9] 
type = Velset
trigger1 = animelem = 11
x = 1.2
y = 1.7

[State 195, 11]
type = Veladd
trigger1 = animelem = 12
x = .5
y = 1.5

[State 195, 11]
type = Velset
trigger1 = animelem = 13
x = 1

[State 195, 11]
