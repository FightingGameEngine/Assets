trigger1 = AnimElemNo(0) = 1 
value = 0 
movecamera = 1, 1 

[State 4600,PlayerPush] 
type = PlayerPush 
trigger1 = AnimElemNo(0) = 1 
value = 0 

[State 4600,PosSet] 
type = PosSet 
trigger1 = Time = 0 
x = IfElse(Facing = 1,-135,135) 

[State 4600,PosFreeze] 
type = PosFreeze 
trigger1 = Time > 0 && AnimElemNo(0) = 2 

[State 4600,VelSet] 
type = VelSet 
trigger1 = AnimTime = 0 
x = Const(velocity.jump.fwd.x)+1
y = Const(velocity.jump.y) 

[State 4600,ChangeState] 
type = ChangeState 
trigger1 = AnimTime = 0 
value = 50 
ctrl = 1 


