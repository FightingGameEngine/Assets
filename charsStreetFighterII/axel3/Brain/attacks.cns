trigger1 = time = 0
attr = S, NA
animtype  = Medium
damage    = 42
getpower  = 100,100
hitflag = MAF
guardflag = MA
pausetime = 10,10
sparkno = -1 * (var(10):=7000)**0
guard.sparkno=s7050
sparkxy = -10 + 0*(var(12):=ceil(169*.5)), var(13):=ceil(-160*.5)
hitsound   = s2,2
guardsound = s6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 13
ground.velocity = -5.5
air.velocity = -2.5,-4

[State AttackDone]
