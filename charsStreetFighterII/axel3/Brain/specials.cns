;==================================================================
;Special Attacks
;==================================================================
; Kung Fu Palm
; CNS difficulty: medium
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 6
poweradd= 100
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2

[State -2, burn]
type = Helper
triggerall = !NumHelper(6050)
trigger1 = numtarget
trigger1 = movehit
name = "Burn FX"
ID = 6050
pos = target, const(size.mid.pos.x), target, const(size.mid.pos.y)
stateno = 6050
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1

[State 1100, Explod]
type = Explod
trigger1 = animelem = 2
anim = 1030
ID = 1030
pos = ceil(0*.715), ceil(0*.715)
scale = .5 ,.5
postype = p1  ;p2,front,back,left,right
facing = 1
bindtime = -1
removetime = 6
sprpriority = 4
removeongethit = 1
trans=addalpha
alpha=256,256
ignorehitpause = 0

[State 1100, Explod]
type = Explod
trigger1 = animelem = 4
anim = 1031
ID = 1031
pos = ceil(0*.5), ceil(0*.5)
