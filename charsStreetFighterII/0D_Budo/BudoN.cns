
;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------通常攻撃---------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************
; 立ち弱パンチ

[Statedef 200]
type     = S 
movetype = A 
physics  = S
juggle   = 1
velset   = 0,0
ctrl     = 0
anim = 200
sprpriority = 2

[State 40, 3]
type = ChangeAnim
trigger1 = anim = 200&&movehit
value = ifelse(p2bodydist X <30,202,201)

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = animelem = 2
value = 0, 0
channel = 1

[State 200, ヒット定義]
type = HitDef 
trigger1 = animelem = 2||animelem = 4
attr = S, NA 
damage = 20
animtype = Light
ground.type = High
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 10, 10
sparkno = S30000
guard.sparkno = S30021
sparkxy = ceil(0*const(size.xscale)),ceil(-70*const(size.yscale))
hitsound = S1,0
guardsound = S2,0
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -6,0
air.velocity = -4,-2
air.type = High
air.velocity = -1.4,-3
air.hittime = 12
getpower = 20
givepower = 5

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1 
