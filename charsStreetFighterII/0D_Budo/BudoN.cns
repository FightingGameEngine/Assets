trigger1 = (AnimElemTime(1) >= 0)
y = .33

[State 1995, アニメ変更]
type = ChangeAnim2
trigger1 = Time = 0
value = 705

[State 1995, 相手ステートに戻す]
type = SelfState
trigger1 = (Vel Y > 0) && (Pos Y >= 0)
value = 5100

[State 10000, 画面]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 120,0
