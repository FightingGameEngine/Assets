envshake.freq = 5
envshake.ampl = 5
envshake.phase = 5
getpower = 60
givepower = 20
fall = 1
air.fall = 1
fall.recover = 0

[State 4];速度を与える
type = VelSet
trigger1 = Animelem = 1
x = 4
y = -4

[state 3];属性変更
type = StatetypeSet
trigger1 = Animelem = 1
statetype = A

[State 1000, 3]
type = Gravity
trigger1 = statetype = A
trigger1 = (AnimElemTime(2) >= 0)

[State 200, ステート変更]
type = ChangeState
triggerall = (AnimElemTime(2) >= 0)
trigger1 = statetype = A
trigger1 = Vel Y > 0 && Pos Y > 0
value = 52

