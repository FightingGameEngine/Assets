[State 600, 音を鳴らす]
type = PlaySnd
trigger1 =AnimElem = 2
value = 5,0
channel = 0

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = animelem = 3
value = 0, 4
channel = 1

[State 210, ヒット定義]
type = HitDef
trigger1 = time = 0
attr = S, NA
animtype  = H
ground.type = High
damage    = 60
guardflag = M
pausetime = 14, 14
priority = 4, Hit
sparkno = S30002
guard.sparkno = S30021
sparkxy = ceil(0*const(size.xscale)),ceil(-90*const(size.yscale))
hitsound   = S1,1
guardsound = S2,0
ground.slidetime = 10
ground.hittime  = 15
ground.velocity = -7
air.velocity = -3,-4
