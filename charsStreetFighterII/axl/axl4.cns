;仮面ひっかけ相手投げられ
[Statedef 1110]
type = A
movetype= H
physics = N
velset = 0,0
sprpriority = 1

[State 1110, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 1110

[State 1110, 2]
type = VelSet
trigger1 = animtime = 20
x = 3.8
y = -2

[State 1110,3];空中になるので、重力を与える
type = gravity
trigger1 = Animtime = 20

[State 1110,4]
type = EnvShake
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
time = 10
ampl = -8

[State 1110,5]
type = Lifeadd
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = -95

[State 1110, end]
Type = SelfState
Trigger1 = (Vel Y > 0 && Pos Y >= 0) || !Alive
Value = 5100
