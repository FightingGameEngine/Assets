;NAOKの最後のCNSファイルです。長くなってしまう場合に、CNSを10個まで分割できます。

;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

;----------------------------------------------------------------------------
;デバッグ支援記述集

; ※ この一連の記述は、キャラが完成したら消すか";"を付けて無効化しましょう。
;　　僅かにでも処理が重くなることが理由です。（ちなみにNullではダメです）


;デバッグモードに白い文字の表示を加える
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "FV38-f=%f,FV13-f=%f,FV20-f=%f,V1-D=%d,PrevStateno=%d"
params = fVar(38),fvar(13),fvar(20),var(1),PrevStateno
ignorehitpause = 1

;表示を下に加える
[State -2, デバッグ表示その3]
type = AppendToClipboard
trigger1 = 1
text = "\nDist X=%d,Y=%d, Vel X=%d/10,Y=%d/10 : Power=%d"
params = floor(P2BodyDist X),ceil(P2BodyDist Y),ceil(Vel X*10),floor(Vel Y*10),Power
ignorehitpause = 1
;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------ヘルパーアーマー-------------------------------
;---------------------------------------------------------------------------
;***************************************************************************
[state -2,ダメージ]
type=lifeadd
triggerall=!ishelper
triggerall=numhelper(2906)
trigger1=roundstate=2
trigger1=helper(2906),gethitvar(damage)
value=-helper(2906),GetHitVar(Damage)
absolute=1
ignorehitpause=1

[state -2,デストローイ]
type=destroyself
triggerall=numhelper(2906)
trigger1=ishelper(2906)
trigger1=stateno!=2910
ignorehitpause=1

[State -2, 画像の色]
type = PalFX
triggerall=numhelper(2906)
trigger1=helper(2906),gethitvar(damage)
time = 5
add = 200,200,200
pausemovetime = 99999999
IgnoreHitPause = 1


;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------補正云々---------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

[State -2, 空中ガード不可]
Type = AssertSpecial
Trigger1 = 1
trigger2 = roundstate = 2
flag = NoAirGuard
ignorehitpause = 1

[State -2, スクロール];負けて倒れたらカメラワークを相手に移す処理
type = ScreenBound
triggerall = (Life <= 0) || (!Alive) || (Lose)
trigger1 = (StateNo = 5150) && (RoundState = 4)
value = 0
MoveCamera = 0,0
IgnoreHitPause = 1
;---------------------------------------------------------------------------
;変数管理

[state -2, コマンドリセット]
type = VarSet
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = StateNo = [5000,5210]
trigger4 = MoveType = H
var(1) = 0
ignorehitpause = 1
Persistent = 1

[State -2, 投げぬけリセット]
type = VarSet
trigger1 = stateno != 2980
var(11) = 0

[State -2, アピール]
type = VarSet
trigger1 = stateno = 190
var(12) = 1

[State -2, アピール]
type = VarSet
trigger1 =(stateno = 3001)&&animelem = 2
trigger2 =(stateno = 3010)&&animelem = 5
trigger3 =(stateno = 3020)&&AnimTime = 0
trigger4 =(stateno = 3031)&&animelem = 2
trigger5 =(anim = 3101)&&animelem = 2
var(12) = 0

[State -2, 3]
type = VarSet
trigger1 = RoundState = 2
fvar(0) = ifelse(var(12),1.1,1)

[State -2, ダッシュ]
type = VarSet
trigger1 = stateno = 100
trigger2 = stateno = 107
var(13) = 1

[State -2, ダッシュリセット]
type = VarSet
trigger1 = stateno = 0||stateno = 52||stateno = 101
trigger2 = movetype = H
trigger3 = stateno = [700,769]
trigger3 = animtime = 0
var(13) = 0
ignorehitpause = 1
Persistent = 0

[State -2, アピール]
type = VarSet
trigger1 = RoundState = 2
fvar(0) = ifelse(var(12),1.1,1)

[State -2, タッグ用生死判別]
Type = VarSet
trigger1 = RoundState = 2
var(30) = 0 + (NumEnemy = 2 && EnemyNear(0),life <= 0)
IgnoreHitPause = 1

;***************************************************************************
;--------------------------補正---------------------------------------------
;***************************************************************************


;******************補正合計******************************************************
;---------------補正合計----------------------------------------

[State -2, アタック]
type = AttackMulSet
trigger1 = roundstate = 2
value = fVar(10)
ignorehitpause = 1

[State -2, 補正合計]
type = VarSet
trigger1 = roundstate = 2
fv = 10
value = fVar(11)*fVar(20)+fVar(12)
ignorehitpause = 1
;******************補正合計******************************************************

;******************コンボ補正******************************************************
;---------------------------------------------------------------------------
;******************コンボ補正******************************************************
;---------------------------------------------------------------------------
; コンボ補正

[State -2, ヒットカウント(コンボ補正用)]
type = Varadd
triggerall = roundstate = 2
triggerall = EnemyNear(Var(30)),movetype = H
triggerall = movehit = 1
trigger1 = (stateno = [200,799])
trigger2 = stateno = 1000
trigger3 = stateno = 1100&&var(2) <= 0
trigger4 = stateno = 1200&&var(2) <= 0
trigger5 = stateno = 1220&&var(2) <= 0
trigger6 = stateno = 2000&&var(2) <= 0
trigger7 = stateno = 2920&&var(2) <= 0
trigger8 = (stateno = [2900,2999])&&(stateno != 2920)
v = 15 
value = 1

[State -2, 飛び道具・ヘルパーヒットカウント(コンボ補正用)]
type = Varadd
triggerall = roundstate = 2
triggerall = EnemyNear(Var(30)),movetype = H
trigger1 = ProjHit1000 = 1||ProjHit1010 = 1||ProjHit1020 = 1
v = 15
value = 1

[State -2, ヒットカウントリセット(コンボ補正用)]
type = Varset
trigger1 = p2movetype != H
trigger2 = EnemyNear(Var(30)),GethitVar(hitcount) = 0
v = 15
value = 0

[State -2, 補正]
type = VarSet
triggerall = roundstate = 2
triggerall = EnemyNear(Var(30)),movetype = H
triggerall = stateno != [800,899]
trigger1 = EnemyNear(Var(30)),GethitVar(hitcount) >= 1
fv = 11
value = 1.0 - (Var(15) * 0.15)
ignorehitpause = 1

[State -2, 補正リセット]
type = VarSet
trigger1 = p2movetype != H
trigger2 = EnemyNear(Var(30)),GethitVar(hitcount) = 0
fv = 11
value = 1

[State -2, 補正限度(現0.1)]
type = VarSet
trigger1 = fVar(11) < 0
fv = 11
value = 0.1
ignorehitpause = 1
;******************コンボ補正******************************************************

;******************我慢補正******************************************************
;----------------------我慢補正(暫定版)-----------------------------------------
[State -2, 我慢補正カウント]
type = Varadd
triggerall = roundstate = 2
trigger1 = EnemyNear,movetype != H
trigger1 = !movehit
v = 21
value = ifelse((Gametime %60) = 0,1,0)
ignorehitpause = 1

[State -2, 我慢補正リセット]
type = VarSet
triggerall = roundstate = 2
trigger1 =(stateno = [200,799])&&movehit
trigger2 = ProjHit1020 = 1||ProjHit2020 = 1
trigger3 =(stateno = 1100)&&animelem = 22&&movehit
trigger4 =(stateno = 1200)&&movehit
trigger5 =(stateno = 1220)&&movehit
trigger6 =(stateno = 2000)&&movehit
trigger7 =(stateno = 2103)&&animelem = 5&&EnemyNear,movetype = H
trigger8 =(stateno = 3001)&&animelem = 2
trigger9 =(stateno = 3010)&&animelem = 5
trigger10 =(stateno = 3020)&&AnimTime = 0
trigger11 =(stateno = 3031)&&animelem = 2
trigger12 =(anim = 3101)&&animelem = 2
trigger13 =(stateno = 4010)&&animelem = 3
v = 21
value = 0
ignorehitpause = 1

[State -2, 我慢補正リセット]
type = VarSet
trigger1 = roundstate != 2
v = 21
value = 0
ignorehitpause = 1


[State -2, 体力差通常・不利]
type = VarSet
triggerall = roundstate = 2
trigger1 =fVar(13)< 2
fv = 12
value = 0.06*Var(21)
ignorehitpause = 1

[State -2, 体力差やや有利]
type = VarSet
triggerall = roundstate = 2
trigger1 = fVar(13) = 2
fv = 12
value = 0.03*Var(21)
ignorehitpause = 1

[State -2, 体力差有利]
type = VarSet
triggerall = roundstate = 2
trigger1 = fVar(13) = 3
fv = 12
value = 0.015*Var(21)
ignorehitpause = 1

[State -2, 体力差超有利]
type = VarSet
triggerall = roundstate = 2
trigger1 = fVar(13)> 4
fv = 12
value = 0
ignorehitpause = 1

[State -2, 我慢補正計算]
type = VarSet
triggerall = roundstate = 2
triggerall = fVar(13)> 1&&fVar(13)< 4
trigger1 = fVar(12) > 0.9/fVar(13)
fv = 12
value = 0.9/fVar(13)
ignorehitpause = 1

[State -2, 我慢補正上限(現0.9)]
type = VarSet
triggerall = roundstate = 2
trigger1 = fVar(12) > 0.9
fv = 12
value = 0.9
ignorehitpause = 1

[State -2, ガードキャンセル時我慢補正制限]
type = VarSet
triggerall = roundstate = 2
triggerall = fVar(12) > 0.5
trigger1 =(stateno = [780,789])
fv = 12
value = 0.5
ignorehitpause = 1

[State -2, 体力差チェック]
type = VarSet
triggerall = roundstate = 2
trigger1 = (100*life/const(data.life)) != 0&&(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) != 0
fv = 13
value = (100*life/const(data.life))/(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life))
ignorehitpause = 1
;******************我慢補正******************************************************

;---------------------------------------------------------------------------
; 根性値


[State -2, 通常]
type = VarSet
triggerall = roundstate = 2
triggerall = (100*life/const(data.life)) != 0&&(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) != 0
trigger1 = (100*life/const(data.life))/(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) < 2
fv = 20
value = 1

[State -2, 逆根性値]
type = VarSet
triggerall = roundstate = 2
triggerall = (100*life/const(data.life)) != 0&&(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) != 0
trigger1 = (100*life/const(data.life))/(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) >= 2
fv = 20
value = 0.85

[State -2, 根性値]
type = VarSet
triggerall = roundstate = 2
triggerall = (100*life/const(data.life)) != 0&&(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) != 0
trigger1 = (100*life/const(data.life))/(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) < 2
trigger1 = (100*life/const(data.life)) < 25
fv = 20
value = 1.15

[State -2, 根性]
type = PalFX
triggerall = RoundState = 2
trigger1 = fvar(20) > 1
time =  1
mul = 256,200,200
sinadd = 20,0,0,20
ignorehitpause = 1
;******************パレット・残像消去******************************************************

[State -2, 残像]
type = AfterImage
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = StateNo = [5000,5210]
trigger4 = MoveType = H
Time = 0
;******************パレット・残像消去******************************************************

;******************ヘルパー******************************************************

;************************************************************************
[state -2,右飛ばしエフェ]
type=Helper
triggerall=!ishelper
triggerall=!numhelper(5603)
triggerall = NumTarget(1000)
triggerall = target(1000),Pos X >= 0
trigger1 = target(1000),stateno = 5601
trigger2 = target(1000),stateno = 4006
helpertype=normal
name="right_edge"
ID=5603
pos=0,ceil(target(1000),Pos Y)
postype=right
facing=1
stateno=5603
ownpal=1
;*************************
[state -2,左飛ばしエフェ]
type=Helper
triggerall=!ishelper
triggerall=!numhelper(5603)
triggerall = NumTarget(1000)
triggerall = target(1000),Pos X <= 0
trigger1 = target(1000),stateno = 5601
trigger2 = target(1000),stateno = 4006
helpertype=normal
name="right_edge"
ID=5603
pos=0,ceil(target(1000),Pos Y)
postype=left
facing=1
stateno=5604
ownpal=1
;************************************************************************
