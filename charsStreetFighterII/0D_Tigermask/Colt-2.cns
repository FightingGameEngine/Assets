;#################################################

[State -2, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = 40, 0

[State -2, ボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive && GameTime % 3 = 0
trigger1 = stateno=[210,215]
trigger2 = stateno=[240,245]
trigger3 = stateno=410
trigger4 = stateno=440
value = 6,1
channel = 0

[State -2, ダメージボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive && GameTime % 3 = 0
trigger1 = stateno=5000 || stateno=5010 || stateno=5020
trigger2 = stateno = 5070 || stateno = 5080 
value = 8,random/250
channel = 0
