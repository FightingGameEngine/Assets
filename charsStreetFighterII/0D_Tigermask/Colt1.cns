trigger1 = 1
flag = Intro
flag2 =nomusic

[State 1000,BGM停止]
type = AssertSpecial
trigger1 = 1
flag = nomusic

[State -2, 入場曲]
type = PlaySnd
trigger1 = time = 0
value = 2000, 0
channel = 5

[State -2, 歓声]
type = PlaySnd
trigger1 = time = 0
value = 3000, 0
channel = 6
loop = 1

[State -2, 曲停止]
type = StopSnd
trigger1 = time = 1400
channel = 5

[State -2, 歓声停止]
type = StopSnd
trigger1 = time = 1400
channel = 6

[State 192, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 192, ヘルパーを出す]
type = Helper
triggerall = NumHelper(20001) = 0
trigger1 = Time > 600
name = "(^o^)"
stateno = 20001
ID = 20001
pos = -200, 0

[State 192, ステート変更]
type = ChangeState
trigger1 = var(5) = 0
value = 20030

