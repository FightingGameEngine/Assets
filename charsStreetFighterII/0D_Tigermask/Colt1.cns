trigger1 = P2Stateno = 20000
trigger1 = Facing = -1
trigger1 = var(5) = 0
value = 20020

[State 190, 入場 2p側 先]
type = ChangeState
trigger1 = Facing = -1
trigger1 = var(5) = 0
value = 20000

[State 190, 通常イントロ]
