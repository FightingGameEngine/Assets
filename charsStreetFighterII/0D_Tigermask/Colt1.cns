add =  -200,-200,-200
sinadd = -60, -60, -60,60
time = 1400

[State 801, 入場切り替え]
type = Varadd
trigger1 = time = 0
var(5) = 1

[State 111, 入場切り替え]
type = VarSet
triggerall = NumHelper(20001)
trigger1 = Helper(20001),Var(1) = 1
var(5) = 0

[State 192, 透明化]
