type = velset
trigger1 = time >= 0
x = 0
y = 0
ignorehitpause = 1

[state 8150,5];-X	0じゃなければ改めて設定X10
type = velset
triggerall = time >= 0
triggerall = fvar(14) != 0
trigger1 = rootdist x < -8
trigger2 = rootdist x > 8
x = 12 / fvar(14) * ifelse(rootdist x < 0,-1,1) 
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = time >= 0
triggerall = fvar(15) != 0
trigger1 = rootdist y < -8
trigger2 = rootdist y > 8
y = 12 / fvar(15) * ifelse(rootdist y > 0,1,-1)
ignorehitpause = 1
