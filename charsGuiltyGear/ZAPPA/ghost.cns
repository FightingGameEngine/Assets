[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "psx=%f,psy=%f,vlx=%f,vly=%f,R10=%d\n"
params =pos x,pos y,vel x,vel y,root,var(10)
ignorehitpause = 1
[state -2, displayb];ヒット関係
type = appendtoclipboard
trigger1 = 1
text = "EDX=%f,EBDX=%f,EDY=%f,EDBY=%f,v5=%d"
params = p2dist x,p2bodydist x,p2dist y ,p2bodydist y,var(5)
ignorehitpause = 1

