[State 3100, 1];LV3	X13 AX6,14 FA9,7
type = HitDef
triggerall = !var(34) && (var(1) = 1 || vaR(1) = 2)
trigger1 = animelemtime(5) >= 0
attr = A, SA                   
damage = ceil(root,fvar(0) * 24) ,1           
guardflag = MA                  
hitflag = MAF                  
priority = 4,hit           
animtype = medium
ground.type = High
pausetime = 0, 13 + root,var(47) * 4
guard.pausetime = 0, 13          
hitsound   = s205, 3
guardsound = s150, 4
ground.slidetime = 14 + root,var(45)
ground.hittime  = 14 + root,var(45)
guard.hittime  = 13	
guard.slidetime  = 13
airguard.ctrltime = 13 
ground.velocity = -6.5 * root,fvar(5)   
air.velocity = -3 * root,fvar(5), -7 * root,fvar(6)              
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)
guard.velocity = -6.5
airguard.velocity = -4.5 ,-3.5  
yaccel = 0.5           
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (14 + 14 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 13 + 4 * root,var(47) + (!root,var(46)) * 7 
getpower = ifelse(root,Var(40),0, 24 + (root,var(2) = 1 && root,life <= 250) * 24) 
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = 0
air.cornerpush.veloff    = 0
guard.cornerpush.veloff  = 0
airguard.cornerpush.veloff= 0
ignorehitpause = 0

