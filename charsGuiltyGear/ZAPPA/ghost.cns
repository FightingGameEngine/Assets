;--------------------壁判定  Xを０にするだけでいい  サマー、突進、ばく転
;----飛び道具は、へるぱで出そうがＲＯＯＴのものである。ので判断にはroot,projID()になる
;---このへるぱと速度などを同期。
;---地面でも消えるので、りむーぶは-1でいける
;---projedgeboundを極限まで多くし、画面端では消えなくする。ループするステージもある。
;---projstageboundですてーじ端では消えるようにする。
[State 9000,wall];----動きはじめと同じタイミングにしておく？
type = projectile
triggerall = 1
trigger1 = time = 0
projanim = 5999
projid = 9000 + const(size.proj.doscale)
attr = a,np
animtype = light
velocity = vel x, vel y
postype = p1
offset = 0,0
accel = 0,0.35
remvelocity = 0, 0
projedgebound = 320 * 100
projstagebound = -20
projscale = 1,1
persistent = 0

[state 3140,];消えたら反転
type = velset
trigger1 = root,NumProjID(9000 + const(size.proj.doscale)) = 0
x = 0
persistent = 0

