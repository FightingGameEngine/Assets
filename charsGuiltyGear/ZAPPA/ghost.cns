trigger1 = rootdist x = [-65,65]
trigger1 = rootdist y = [-40,40]
fvar(9) = 4.5

[State 3660,];あにめ低速時は固定
type = changeanim
trigger1 = fvar(9) = 4.5
trigger1 = anim != 2600
trigger2 = fvar(9) != 4.5
value = 2600

