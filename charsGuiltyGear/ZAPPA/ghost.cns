;----本体へのヒットバックをどう考慮するか。VARたりないね
;--SLはさらに横上に伸びて、連打すると離れてく
;--剣しゃがみHSLV5,SLは２HIｔ  E7-22
;----X17 AX6,14
[State 200, 1];LV5
type = HitDef
triggerall = !var(34)
trigger1 = !movecontact
trigger2 = vaR(1) = 3 || var(1) = 4; || !var(1) 
trigger2 = !var(35) && time >= 21
attr = C, NA                   
damage = ceil(40 * root,fvar(0))                
guardflag = M                  
hitflag = MAFD                  
priority = 5,miss           
animtype = back 
ground.type = High
pausetime = 15, 15 + root,var(47) * 12
guard.pausetime = 15, 15          
hitsound   = s205, 5
guardsound = s150,3            
ground.slidetime = 19 + root,var(45) 
ground.hittime  = 19 + root,var(45) 
guard.hittime  = 18	
guard.slidetime  = 18
airguard.ctrltime = 19   
ground.velocity = -8.5 * root,fvar(5)
air.velocity = -3 * root,fvar(5), -7 * root,fvar(6)
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)       
guard.velocity = -9 
airguard.velocity = -5, -4
yaccel = 0.5        
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (18 + 18 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 15 + 12 * root,var(47) + (!root,var(46)) * 7
getpower = 0
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = -19
air.cornerpush.veloff    = -19
guard.cornerpush.veloff  = -20
airguard.cornerpush.veloff= -20
ignorehitpause = 0

