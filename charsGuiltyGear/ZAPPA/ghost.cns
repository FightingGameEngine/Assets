trigger1 = root,var(10) = 100
value = 4000
[State 3660,];攻撃移動	必殺技系110 おちとけ 120いきます 130痛そう 140通ります
type = changestate
trigger1 = root,var(10) = [110,190]
value = 2200 + root,var(10) - 10
ignorehitpause = 0
[State 3660,];攻撃移動	通常技系
type = changestate
trigger1 = root,var(10) = [20,65]
value = 2200 + root,var(10)
ignorehitpause = 0

;---------------本体通常攻撃など戻しフラグ
