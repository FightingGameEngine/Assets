;----------------ひとすとぷ中先行予約入力ガトリングなど8HSすたーと空中だよ
[State -1, sike];憑依空中 接触フラグV34,HSTOPV32 相殺時も赤ろまOK（ゲージの無駄）FR15-17		SL以降
type = parentvarset
triggerall = !var(1) || var(1) >= 3
triggerall = power >= 500 && !root,var(40) && !root,var(5) && time > 0 && root,stateno = 630
triggerall = (root,command = "ALL" && root,command != "holdback") || root,command = "roma"
trigger1 = time = [14,16]
trigger1 = HITPAUSETIME
trigger1 = var(35) <= 1
trigger2 = time = [14,16]
trigger2 = !HITPAUSETIME
var(5) = 985
[State -1, sike];憑依空中上 接触フラグV34,HSTOPV32 相殺時も赤ろまOK（ゲージの無駄）
type = parentvarset
triggerall = power >= 1000 && !root,var(40) && var(34) && !root,var(5) && time > 0 && root,stateno = 630
trigger1 = (root,command = "ALL" && root,command != "holdback") || root,command = "roma"
var(5) = ifelse(hitpausetime,980,982)
ignorehitpause = 1
[state -3,jump cancel];DUSTJ  CJのときは29るーる
type = parentvarset
triggerall = !root,var(5) && root,var(4) && root,var(11)
triggerall = playerID(root,var(4)),sysvar(0) <= 30 
trigger1 = root,command = "holdup" && movehit && root,stateno = 630
var(5) = 55
ignorehitpause = 1
[State 3660,];実験：憑依共通必殺キャンセル－さっきまでいたんだよ P  RE以外
type = parentvarset
triggerall = !root,var(5) && movecontact && root,stateno = 630 && var(1) != 1
trigger1 = root,command = "236P"
var(5) =  ifelse(root,statetype = A,1160,1150)
ignorehitpause = 1
[State 3660,];実験：剣共通必殺キャンセル－通りますS
type = parentvarset
triggerall = !root,var(5) && movecontact && root,stateno = 630
trigger1 = 0;root,command = "236S"
var(5) =  1600
ignorehitpause = 1

