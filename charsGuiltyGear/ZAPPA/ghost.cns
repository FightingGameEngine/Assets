;-------空中奪取などするとよくわかるが、幽霊もずれている
;---いたんだよ爆発が見た目の位置になるため、どうやるかー
;---さらに１ひきめとかが欠番になるとずずっと動く、もどうやろうか
[statedef 2700];固定位置まで動く	よよ移動応用して
type    = A
movetype= i
physics = N
ctrl = 0
velset = 0,0

[State 3660,]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = noautoturn
ignorehitpause = 1

;-------------------みつごだーこれは一回のみ
;----攻撃など経由？停滞時はどうだっけ
[State -3, recove voice]
type = PlaySnd
triggerall = prevstateno != 2600
trigger1 = time = 0
trigger1 = fvar(9) = 4.5
value = s2600,ifelse(root,var(54) < 6, root,var(54),ifelse(root,var(54) = 8,random % 6,random % 3)) + (root,var(54) = 7) * 3
parsistent = 0
channel = 0

[state 1200,help];席順3が実行	位置決め用へるぱ
type = Helper
triggerall = var(21) = 3
trigger1 = !numhelper(const(size.height) + 10)
name = "GHOST4 POSSET"
ID = const(size.height) + 10
pos = 0,0 
postype = p1
stateno = 2605
ownpal = 1
size.height = const(size.height) + 10
size.xscale = 0.5
size.yscale = 0.5
supermovetime = 9999

[state 8150,2];表示優先度は常時変化後ろほど前・・席順V21
type = sprpriority 
trigger1 = 1
value = var(21) - 4
ignorehitpause = 1

[State 3660,];透明化幽霊基本180,120,停滞100,100
type = trans
trigger1 = 1
trans = addalpha
alpha = ifelse(fvar(9) = 4.5,180,100),ifelse(fvar(9) = 4.5,120,100)
ignorehitpause = 1

;--------------------攻撃後などでずらす
;---0にしてあれば０だからいいかな
[state 8150,2];
type = posadd
trigger1 = time = 0
x = fvar(11)
y = fvar(12)
persistent = 0
[state 8150,2];
type = varrangeset
trigger1 = time = 0
first = 11
last = 12
fvalue = 0

[state 7000,];---------------ロマキャンフラグリセット　ガトリング経由時time=0でやるための
