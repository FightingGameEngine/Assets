[state 1540,helper partner];----スパーク	切り系
type = Helper
trigger1 = root,var(34) 
name = "HIT SPARK"
ID = 8000 + stateno 
pos = 0,-60
postype = p2
stateno = ifelse(root,var(34) = 2,8004,8005)
ownpal = 1
persistent = 0
ignorehitpause = 1
size.height = -50;Y座標
size.ground.front = 0;相殺時X座標
size.ground.back = 11;持続
size.head.pos = 8002,8003

;----本体へのヒットバックをどう考慮するか。VARたりないね
;---これ、自分でなく相手が、端のときこっちにかかる、と
;--VELではとれない、ヒット後、相手が端なら下げるような処理がいる
;--剣空中HS	LV3
;----X13 AX6,14		GA9,8
[State 200, 1];LV3
type = HitDef
triggerall = root,stateno = 630
triggerall = !root,var(34)
trigger1 = animelemtime(9) >= 0
trigger1 = animelemtime(17) < 0
attr = A, NA                   
damage = ceil(32 * root,fvar(0))                
guardflag = HA                  
hitflag = MAFD                  
priority = 4,miss           
animtype = medium 
ground.type = High
air.type = low
pausetime = 13, 13 + root,var(47) * 4
guard.pausetime = 13, 13          
hitsound   = s205, 4
guardsound = s150, 2             
ground.slidetime = 14 + root,var(45)
ground.hittime  = 14 + root,var(45)
guard.hittime  = 13	
guard.slidetime  = 13
airguard.ctrltime = 13 
ground.velocity = -6.5 * root,fvar(5)          
air.velocity = -3 * root,fvar(5), -7 * root,fvar(6)          
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)            
guard.velocity = -6.5 
airguard.velocity = -4.5, -4
yaccel = 0.5       
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (14 + 14 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 13 + 4 * root,var(47) + (!root,var(46)) * 7 
getpower = ifelse(root,Var(40),0,52 + (root,var(2) = 1 && root,life <= 250) * 52)
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = -12
air.cornerpush.veloff    = -12
guard.cornerpush.veloff  = -13
airguard.cornerpush.veloff= -13
ignorehitpause = 0

;--------------------ダストほうりこみ  有効中へるぱに当たる可能性は０ではない
;---チーム時、もう片方に当たる可能性もあるのでは？
[State 2500x, ];きりもみのアレは、29F以内の判断は1スタートなので30
type = TargetState
triggerall = numtarget && root,var(4)
triggerall = playerID(root,var(4)),stateno != [5850,5855]
triggerall = playerID(root,var(4)),sysvar(0) <= 30
triggerall = target,ishelper = 0
triggerall = target,ID = root,var(4) 
trigger1 = movehit
trigger1 = HITPAUSETIME
value = 5855
ID = -1
ignorehitpause = 1
persistent = 15

