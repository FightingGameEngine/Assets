triggerall = fvar(14) != 0
trigger1 = rootdist x < -5
trigger2 = rootdist x > 5
x = 5 / fvar(14) * ifelse(rootdist x < 0,-1,1) 
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = time >= 0
triggerall = fvar(15) != 0
trigger1 = rootdist y < -5
trigger2 = rootdist y > 5
y = 5 / fvar(15) * ifelse(rootdist y > 0,1,-1)
ignorehitpause = 1
