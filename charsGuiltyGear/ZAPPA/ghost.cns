;----本体へのヒットバックをどう考慮するか。VARたりないね
;-----------全共通LV4
;--幽霊6HS X15  AX6,14
[State 200, 1];LV4
type = HitDef
triggerall = root,stateno = 235
trigger1 = !var(34)
trigger1 = !movecontact
attr = s, NA                   
damage = ceil(36 * root,fvar(0))                            
guardflag = H                  
hitflag = MAFD                  
priority = 7,miss           
animtype = hard 
ground.type = High
air.type = low
pausetime = 14, 14 + root,var(47) * 8
guard.pausetime = 14, 14          
hitsound   = s205, 1
guardsound = s150, 1             
ground.slidetime = 17 + root,var(45)
ground.hittime  = 17 + root,var(45)
guard.hittime  = 16	
guard.slidetime  = 16
airguard.ctrltime = 16  
ground.velocity = -7.5 * root,fvar(5)        
air.velocity = -3 * root,fvar(5), -7 * root,fvar(6) 
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)          
guard.velocity = -7.5  
airguard.velocity = -2 , -3 
yaccel = 0.5          
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (16 + 16 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 14 + 8 * root,var(47) + (!root,var(46)) * 7
getpower = ifelse(root,Var(40),0,76 + (root,var(2) = 1 && root,life <= 250) * 76)
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = -15
air.cornerpush.veloff    = -15
guard.cornerpush.veloff  = -16
airguard.cornerpush.veloff= -16
ignorehitpause = 0

