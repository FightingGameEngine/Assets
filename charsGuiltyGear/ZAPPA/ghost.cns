;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time >= 0
fvalue = 0
first = 14
last = 15
ignorehitpause = 1

;-------------席順１、本体依存
[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = var(21) = 1
triggerall = abs(rootdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1
[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = var(21) = 1
triggerall = abs(rootdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

;-------------席順2、親へるぱ300依存
[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = var(21) = 2
triggerall = abs(parentdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(parentdist x) >= ABS(parentdist y), 1,ABS(parentdist y) / ABS(parentdist x))
ignorehitpause = 1
[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = var(21) = 2
triggerall = abs(parentdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(parentdist y) >= ABS(parentdist x),1,ABS(parentdist x) / ABS(parentdist y))
ignorehitpause = 1

;-------------席順３、各自で出した孫 Id+10=311,312,313のどれか
[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = var(21) = 3
triggerall = numhelper(const(size.height) + 10)
triggerall = abs(helper(const(size.height) + 10),parentdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(helper(const(size.height) + 10),parentdist x) >= ABS(helper(const(size.height) + 10),parentdist y), 1,ABS(helper(const(size.height) + 10),parentdist y) / ABS(helper(const(size.height) + 10),parentdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = var(21) = 3
triggerall = numhelper(const(size.height) + 10)
triggerall = abs(helper(const(size.height) + 10),parentdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(helper(const(size.height) + 10),parentdist y) >= ABS(helper(const(size.height) + 10),parentdist x),1,ABS(helper(const(size.height) + 10),parentdist x) / ABS(helper(const(size.height) + 10),parentdist y))
ignorehitpause = 1

;----------------------基本移動量＝14dotなので7
;--まとめるとどうしても０除算になる、なんでだろうね
[state 8150,5];-YX	一度0に設定して真横真縦に対応
type = velset
trigger1 = time >= 0
x = 0
y = 0
ignorehitpause = 1

;---------------------本体近くいったらそのまま
;----------------１ひきめは本体基準
[state 8150,5];-X	0じゃなければ改めて設定
type = velset
triggerall = var(21) = 1
triggerall = fvar(14) != 0
trigger1 = rootdist x <= -5
trigger2 = rootdist x >= 5
x = 8 / fvar(14) * ifelse(rootdist x < 0,-1,1) 
[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = var(21) = 1
triggerall = fvar(15) != 0
trigger1 = rootdist y <= -5
trigger2 = rootdist y >= 5
y = 8 / fvar(15) * ifelse(rootdist y > 0,1,-1)

;-------------------------2蟇目は親300基準
[state 8150,5];-X	0じゃなければ改めて設定
type = velset
triggerall = var(21) = 2
triggerall = fvar(14) != 0
trigger1 = parentdist x <= -5
trigger2 = parentdist x >= 5
x = 8 / fvar(14) * ifelse(parentdist x < 0,-1,1) 
[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = var(21) = 2
triggerall = fvar(15) != 0
trigger1 = parentdist y <= -5
trigger2 = parentdist y >= 5
y = 8 / fvar(15) * ifelse(parentdist y > 0,1,-1)

;-----------------3蟇目は孫Id+10
[state 8150,5];-X	0じゃなければ改めて設定
type = velset
triggerall = var(21) = 3
triggerall = numhelper(const(size.height) + 10)
triggerall = fvar(14) != 0
trigger1 = helper(const(size.height) + 10),parentdist x <= -5
trigger2 = helper(const(size.height) + 10),parentdist x >= 5
x = 8 / fvar(14) * var(28)
[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = var(21) = 3
triggerall = numhelper(const(size.height) + 10)
triggerall = fvar(15) != 0
trigger1 = helper(const(size.height) + 10),parentdist y <= -5
trigger2 = helper(const(size.height) + 10),parentdist y >= 5
y = 8 / fvar(15) * ifelse(helper(const(size.height) + 10),parentdist y > 0,-1,1)
