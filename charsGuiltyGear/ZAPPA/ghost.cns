trigger1 = helper(const(size.height) + 10),facing = facing 
trigger1 = helper(const(size.height) + 10),parentdist x <= 0
trigger2 = helper(const(size.height) + 10),facing != facing 
trigger2 = helper(const(size.height) + 10),parentdist x > 0
var(28) = 1
[state 8150,2]
type = varset
