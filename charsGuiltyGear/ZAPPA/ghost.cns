;--ID		剣100	わんこ200	３つ300		らお400		100倍
;STARTSTA	剣2200　わんこ2400	３つ2600	らお2800	200倍＋2000

;--そーど一覧
;--2200初期化,2205=ループ待機 2220=近S,2225=遠S,2230=HS,2235=6HS
;--2250=屈S,2255=屈HS,2260=8S,2265=8HS

;-----------------------------つくもがみの剣？
;--------------------------S2200
[statedef 2200];INITステート
type    = A
movetype= i
physics = N
ctrl = 0
velset = 0,0
sprpriority = -2
anim = 2200

[State 3660,];
type = varrangeset
trigger1 = time = 0
value = 0
first = 0
last = 59

[State 3660,];
type = varrangeset
trigger1 = time = 0
fvalue = 0
first = 0
last = 39

;--------------------もーどを代入する
[State 3660,];OR<RE<SL<EX<AC
type = varset
trigger1 = time = 0
var(1) = root,var(1)
[State 3660,];GG<GGX
type = varset
trigger1 = time = 0
var(2) = root,var(2)
[State 3660,];VOICE　TYPE
type = varset
trigger1 = time = 0
var(54) = root,var(54)
[State 3660,];命令をリセット
type = parentvarset
trigger1 = time = 0
var(10) = 0

[state 8110,vel];いちは下のほう
type = bindtoroot
trigger1 = time = 0
pos = 30,80
time = 1
ignorehitpause = 0

[state 8110,vel];動き開始へ
type = changestate
trigger1 = time = 0
value = 2205
ignorehitpause = 0

;-------------------------
;-------空中奪取などするとよくわかるが、剣本体固定ではない、特定地点目指すように
;---いたんだよ爆発が見た目の位置になるため、どうやるかー
;---たーんしたときもちょとずれるねえ
;---剣はガトリングなどで位置はそのままから。必殺は基準点に戻る。
[statedef 2205];固定位置まで動く	よよ移動応用して
type    = A
movetype= i
physics = N
ctrl = 0
velset = 0,0
sprpriority = -2

[State 3660,]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = noautoturn
ignorehitpause = 1

[state 7000,];---------------ロマキャンフラグリセット　ガトリング経由時time=0でやるための
type = varrangeset
trigger1 = time = 0
first = 34
last = 41
value = 0

[state 7000,];---------------すとっぷ強制解除
type = parentvarset
trigger1 = time = 0
var(32) = 0

;--------------殴られると本体も連動、保留　剣
[State 8000x, ride];テスト結果:P2stateno無効？すりぬける
type = HitOverride
trigger1 = 1 
attr = sca,na,np,sa,sp,ha,hp
slot = 0
stateno = -1;剣over
time = 1
ignorehitpause = 1
[State 3660,];投げには当たらないようにしておく
type = nothitby
trigger1 = 1
value = ,nt,st,ht
time = 1
ignorehitpause = 1

;------------はものだ		これるーとのV54da!!!
[State -3, recove voice]
type = PlaySnd
triggerall = prevstateno != 2200
trigger1 = time = 0
value = s2200,ifelse(root,var(54) < 6, root,var(54),ifelse(root,var(54) = 8,random % 6,random % 3)) + (root,var(54) = 7) * 3
parsistent = 0
channel = 0

;--------------------攻撃後などでずらす
[state 8150,2];
type = posadd
trigger1 = time = 0
x = fvar(11)
y = fvar(12)
persistent = 0
[state 8150,2];
type = varrangeset
trigger1 = time = 0
first = 11
last = 12
fvalue = 0
[state 8150,2];たーんはOKのはず
type = turn
trigger1 = root,facing != facing

;-------------新新移動00基準 el.ver2	よよ基本編
;distが０以外のとき、０除算注意
;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time >= 0
fvalue = 0
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

;----------------------基本移動量＝14dotなので7
;--まとめるとどうしても０除算になる、なんでだろうね
[state 8150,5];-YX	一度0に設定して真横真縦に対応
type = velset
trigger1 = time >= 0
x = 0
y = 0
ignorehitpause = 1

[state 8150,5];-X	0じゃなければ改めて設定X10
type = velset
triggerall = time >= 0
triggerall = fvar(14) != 0
trigger1 = rootdist x < -5
trigger2 = rootdist x > 5
x = 5 / fvar(14) * ifelse(rootdist x < 0,-1,1) 
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = time >= 0
triggerall = fvar(15) != 0
trigger1 = rootdist y < -5
trigger2 = rootdist y > 5
y = 5 / fvar(15) * ifelse(rootdist y > 0,1,-1)
ignorehitpause = 1
;-----------new移動ここまで
;------------------------------ここまで共通？

[state 8150,5];-本体固定？
type = posset
trigger1 = rootdist x = [-5,5]
trigger1 = rootdist y = [-5,5]
trigger1 = root,stateno = [0,20]
x = root,pos x
y = root,pos y
ignorehitpause = 1

[State 3660,];あにめ
type = changeanim
trigger1 = anim != 2200
trigger1 = animtime = 0
value = 2200
ignorehitpause = 0

[State 3660,];攻撃移動	必殺技共通さっきまでV1=100
