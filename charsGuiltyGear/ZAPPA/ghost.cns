triggerall = playerID(root,var(4)),sysvar(0) <= 30
triggerall = target,ishelper = 0
triggerall = target,ID = root,var(4) 
trigger1 = movehit
trigger1 = HITPAUSETIME
value = 5855
ID = -1
ignorehitpause = 1
persistent = 15

