value = 4000
ignorehitpause = 0

;-----2700たす	50系は透明待機
;---10=NS 15=FS,20=HS,25=6HS,30=CS,35=CHS,40=AS,45=AHS
;--60=さP 65=さK 70=さS 75=さH 80=さD
;---ガトリングは同じのが攻撃するので受付不可とかいみなくない
