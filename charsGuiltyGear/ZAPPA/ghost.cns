hitflag = MAFD                  
priority = 4,hit           
animtype = UP 
ground.type = High
air.type = high           
pausetime = 14, 14 + root,var(47) * 8
guard.pausetime = 14, 14          
hitsound   = s205, 3
guardsound = s150, 4             
ground.slidetime = 17 + root,var(45) 
ground.hittime  = 17 + root,var(45) 
guard.hittime  = 16	
guard.slidetime  = 16
airguard.ctrltime = 16 
ground.velocity = -4 * root,fvar(5),-10 * root,fvar(6) 
air.velocity = -4 * root,fvar(5),-10 * root,fvar(6)       
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5) ,ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)
guard.velocity = -7.5 
airguard.velocity = -2 , -4  
yaccel = 0.5          
fall = 1
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (26 + 26 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 14 + 8 * root,var(47) + (!root,var(46)) * 7
getpower = ifelse(root,Var(40),0, 120 + (root,var(2) = 1 && root,life <= 250) * 120)
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = -15
air.cornerpush.veloff    = -15
guard.cornerpush.veloff  = -16
airguard.cornerpush.veloff= -16
ignorehitpause = 0

;-------------新新移動00基準 el.ver2	よよ基本編
;distが０以外のとき、０除算注意
;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time >= 0
fvalue = 0
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

;----------------------基本移動量＝14dotなので7
;--まとめるとどうしても０除算になる、なんでだろうね
