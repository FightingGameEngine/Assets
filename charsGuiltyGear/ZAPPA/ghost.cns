;----本体へのヒットバックをどう考慮するか。VARたりないね
;---これ、自分でなく相手が、端のときこっちにかかる、と
;--VELではとれない、ヒット後、相手が端なら下げるような処理がいる
;--5HS 2HITする	X17 AX6,13?
;---2HIT目 X17	AX6,13?
[State 200, 1];LV5
type = HitDef
trigger1 = !root,var(34)
trigger1 = animelem = 7 || animelem = 7
trigger2 = !var(35)
trigger2 = animelem = 18 || animelem = 19 || animelem = 20
attr = S, NA                   
damage = ceil(35 * root,fvar(0))                
guardflag = MA                  
hitflag = MAFD                  
priority = 7,miss           
animtype = hard 
ground.type = High
pausetime = 15, 15 + root,var(47) * 12
guard.pausetime = 15, 15          
hitsound   = s205, 5
guardsound = s150, 3              
ground.slidetime = 19 + root,var(45) 
ground.hittime  = 19 + root,var(45) 
guard.hittime  = 18	
guard.slidetime  = 18
airguard.ctrltime = 19   
ground.velocity = -9  * root,fvar(5)
air.velocity = -3  * root,fvar(5), -6.5 * root,fvar(6)
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)       
guard.velocity = -9 
airguard.velocity = -5 , -4
yaccel = 0.5        
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (18 + 18 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 15 + 12 * root,var(47) + (!root,var(46)) * 7
getpower = ifelse(root,Var(40),0,76 + (root,var(2) = 1 && root,life <= 250) * 76)
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = -19
air.cornerpush.veloff    = -19
guard.cornerpush.veloff  = -20
airguard.cornerpush.veloff= -20
ignorehitpause = 0

