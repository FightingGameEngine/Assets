triggerall = 1
trigger1 = animelem = 3
projanim = 5999
projid = 9000 + const(size.proj.doscale)
attr = a,np
animtype = light
velocity = vel x, vel y
postype = p1
offset = 0,0
accel = 0,0.35
remvelocity = 0, 0
projedgebound = 320 * 100
projstagebound = -20
projscale = 1,1
persistent = 0

[state 3140,];消えたら反転
