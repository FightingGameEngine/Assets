airguard.velocity = -4.5 * var(31) , -4.5         
yaccel = 0.5   
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (12 + 12 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 6 + 2 * root,var(47) + (!root,var(46)) * 7
