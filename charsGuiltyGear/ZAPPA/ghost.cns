var(39) = 0
[state 7000,];---ひっとばっくようをりせっと
type = parentvarset
trigger1 = time = 0
trigger1 = ishelper(302)
var(40) = 0
[state 7000,];---ひっとばっくようをりせっと
type = parentvarset
trigger1 = time = 0
trigger1 = ishelper(303)
var(41) = 0

;-----------------たーんは本体ではなく敵依存である・・！
