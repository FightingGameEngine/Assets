;----本体へのヒットバックをどう考慮するか。VARたりないね
;---これ、自分でなく相手が、端のときこっちにかかる、と
;--VELではとれない、ヒット後、相手が端なら下げるような処理がいる
;--近距離S　X13 AX6,14
[State 200, 1];LV3  強制立たせ
type = HitDef
triggerall = !var(34)
trigger1 = !movecontact
attr = S, NA                   
damage = ceil(36 * root,fvar(0))    
guardflag = M                  
hitflag = MAFD                 
priority = 4,miss           
animtype = medium 
ground.type = High
pausetime = 13, 13 + root,var(47) * 4
guard.pausetime = 13, 13          
hitsound   = s205, 4;軽めきり
guardsound = s150, 2              
ground.slidetime = 14 + root,var(45)
ground.hittime  = 14 + root,var(45)
guard.hittime  = 13	
guard.slidetime  = 13
airguard.ctrltime = 13   
ground.velocity = -6.5 * root,fvar(5)               
air.velocity = -3 * root,fvar(5), -7 * root,fvar(6)
down.velocity = ifelse(root,var(2) = 2,-3,-8) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)            
guard.velocity = -6.5
airguard.velocity = -4.5 , -4.5  
yaccel = 0.5     
fall = 0
air.fall = 1                 
fall.recover = 1
