;ざっぱっぱ必殺技関連 
;s1000 ご利用 1100むかで 1150いたんだよ s1200 礼儀作法
;--s1300落ち  s1400 いきます 1500痛そう 1600通る 1700帰ってくるな
;s1800 エドガイ s1900アンセム 

;----らおう憑依時は、計画的にはだせないぽい
;-----デバック時の条件変更してるのを注意
[Statedef 1000];P	けん憑依
type = s
movetype = i
physics = n
ctrl = 0
hitcountpersist = 1
anim = 1000
velset = ifelse(prevstateno < 99,0,vel x ),0 

;----------------ダッシュ抵抗
[State 99,];1.05%?=0.0105 では少なすぎ
type = Velmul
trigger1 = 1
x = 1 - 0.105

[State 1100, ad];だげきむてき
type = nothitby
trigger1 = time <= 6
value = ,na,sa,ha,np,sp,hp
time = 1

[State 1100, ad]
type = playerpush
trigger1 = 1
value = 1

;------------------剣１　犬２　幽霊３　ラオウ８
[State 1100, ad];強制お祓い
type = varset
trigger1 = time = 0
var(20) = 0

;----たりなかったら失敗あにめ
[State 1100, ad]
type = changeanim
triggerall = var(30) < 1
trigger1 = time = 0
value = 1010

;----------------------------ぐちゃぐちゃ
;----------失敗時のぐちゃぐちゃおと
[State 1100, sound];5階ぐらい聞こえるが
type = PlaySnd
trigger1 = time = 0
trigger2 = animelem = 10
trigger3 = animelem = 15
trigger4 = animelem = 24
trigger5 = animelem = 30
value = s80,8
channel = 3

[State 2050,  voice];ご利用は計画的に！	失敗時のみっぽい
type = PlaySnd
triggerall = anim = 1010
trigger1 = time = 0
value = s1000,ifelse(var(54) < 6, var(54),random % 3 + 3) + (var(54) <= 2) * 3
channel = 0

;-------------------------------------ここまでご利用共通でいいはず

[State 1100, ad];デバック時注意5で憑依
