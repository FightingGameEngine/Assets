;---Gx4y10,AX6y13
[State 200, 1];LV2 x12		ダウン追い討ち以外ダウンね
type = HitDef
triggerall = !var(34)
triggerall = !movecontact
trigger1 = animelemtime(5) >= 0
trigger1 = animelemtime(6) < 0
attr = S, SA                   
damage = ceil(20 * fvar(0)),1                
guardflag = M                  
hitflag = MAFD                  
priority = 4,hit         
animtype = medium 
ground.type = low          
pausetime = 12, 12
guard.pausetime = 12, 12 + var(47) * 2          
hitsound   = s205, 3
guardsound = s150, 4             
ground.slidetime = 12 + var(45)
ground.hittime  = 12 + var(45)
guard.hittime  = 11	
guard.slidetime  = 11
airguard.ctrltime = 11 
ground.velocity = -2 * fvar(5),-5 * fvar(6)           
air.velocity = -3 * fvar(5), -7.5 * fvar(6)          
down.velocity = ifelse(var(2) = 2,-3,-8) * fvar(5),ifelse(var(2) = 2,-2,-2.5) * fvar(6)
guard.velocity = -6.5 
airguard.velocity = -2, -4
yaccel = 0.5
fall = 1
air.fall = 1                 
fall.recover = ifelse(var(46),0,1)
fall.recovertime = ceil( (12 + 12 * var(47) ) * var(46) * fvar(4) ) + 12 + 2 * var(47) + (!var(46)) * 7
getpower = ifelse(Var(40),0, 240 + (var(2) = 1 && life <= 250) * 240) 
palfx.time = var(47) * 5
palfx.add = var(47) * 255,var(47) * -130, var(47) * -108
ground.cornerpush.veloff = -11
air.cornerpush.veloff    = -11
guard.cornerpush.veloff  = -12
airguard.cornerpush.veloff= -12
ignorehitpause = 0



