[State 200, 1];LV5 、
type = HitDef
triggerall = !var(34)
trigger1 = animelemtime(9) >= 0
trigger1 = !movecontact
attr = S, SA                   
damage = ceil(30 * fvar(0)),1                
guardflag = H                  
hitflag = MAFD                  
priority = 6,miss           
animtype = hard 
ground.type = low
pausetime = 15, 15 + var(47) * 12
guard.pausetime = 15, 15          
hitsound   = s205, 3
guardsound = s150, 1              
ground.slidetime = 19 + var(45) + var(47) * 28
ground.hittime  = 19 + var(45) + var(47) * 28
guard.hittime  = 18	
guard.slidetime  = 18
airguard.ctrltime = 19 
ground.velocity = -0.5 * fvar(5),-1 - var(47) * 3 * fvar(6)  
air.velocity = -0.5 * fvar(5), -1 * fvar(6)          
down.velocity = ifelse(var(2) = 2,-3,-8) * fvar(5),ifelse(var(2) = 2,-2,-2.5) * fvar(6)
guard.velocity = -7.5 
airguard.velocity = -2, -4  
yaccel = 0.5          
fall = 1
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (18 + 18 * var(47) ) * var(46) * fvar(4) ) + 15 + 12 * var(47) + (!var(46)) * 7
getpower = 0,0 
palfx.time = var(47) * 5
palfx.add = var(47) * 255,var(47) * -130, var(47) * -108
ground.cornerpush.veloff = -19
air.cornerpush.veloff    = -19
guard.cornerpush.veloff  = -20
airguard.cornerpush.veloff= -20
p2stateno = ifelse(var(47),5730,5740)
ignorehitpause = 0

