triggerall = Time = 0 && var(59) = 1
trigger1 = prevstateno = 610 
trigger2 = prevstateno = 620 && var(20) = 4 
trigger3 = prevstateno = 600 && var(20) > 0
value = 600
ctrl = 0

[State 42, 6];ガトリングなら即行きOK KにいくのはPS 
