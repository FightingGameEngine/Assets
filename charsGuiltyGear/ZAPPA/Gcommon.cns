[State 115, 4]
type = VelMul
trigger1 = 1
z = 0.8

[State 115, 5]
type = VelSet
trigger1 = AnimTime = -8
z = 0

[State 115, 7]
type = CtrlSet
trigger1 = AnimTime = 0
value = 1

[State 115, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;-------------------------------------------------------------------------WINのみの命令あるため--EFE.cnsに格納
; GUARD (start)	ガード準備　レバーおしっぱでいれば待機130へ、認識距離外、レバーはなしで140(終了へ）
;------------------おそらくCTRLがあってレバー後ろ方向をおすとここにくるシステム	自動着地が52いくのと同じように？
;-------------つまり、かならずここを経由する？ガードすると一瞬でチェんステするけど～
;------通常ガード	HITTIME-1　これは相手依存でいいと思うが、空中ガードは設定-1
;------直前ガード	硬直2～4減少(Air6-11)ノックバックが短くなる、のは早く回復してその分下がらないから？受付８、再受付30必要
;------ＦＤガード	硬直が1～2増加(Air2-4)
;---------こんなんだれも設定してないよーきっと。commonで設定するべき?、普通攻撃側だよね
;---------------------------------------------------------------------------





;---------------------------------------------------------------------------
; LOSE (Time over)	時間切れでまけるとここ
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; DRAWGAME (Time over)ドロー、専用のが無ければ170に移動
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; PREINTRO		イントロダクション。さまざまな演出を。
;-------------------------
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------------
; INTRO (override this state to give character an intro)
[Statedef 191]
type = S
ctrl = 0

[State 191, 1]
type = ChangeState
trigger1 = Time = 0
value = 0

;------------------------------------p2stateno使用時の仕方なく使用するステート　すぐに戻すの
[Statedef 4999]
type    = U
movetype= H
physics = U

[State 5000, 2];対象外強制戻し
type = selfstate
triggerall = statetype = L
trigger1 = Time = 0
value = 5080
ignroehitpause = 1

[State 5000, 2];対象外強制戻し
type = selfstate
triggerall = statetype = A
trigger1 = Time = 0
value = 5020
ignroehitpause = 1

[State 5000, 2];対象外強制戻し
type = selfstate
triggerall = statetype = S || statetype = C
triggerall = gethitvar(type) = 3
trigger1 = Time = 0
value = 5070
ignroehitpause = 1

[State 5000, 2];対象外強制戻し
type = selfstate
triggerall = statetype = C
trigger1 = Time = 0
value = 5010
ignroehitpause = 1

[State 5000, 2];対象外強制戻し
type = selfstate
trigger1 = Time = 0
value = 5000
ignroehitpause = 1

;------------------------------------以下-食らいシステム
;-----ぱっぱは悪霊にも青あり、本体が食らいになるが。。、
;--らおうはいい、本体セットだから。
;---剣と幽霊は位置がずれる。ゆえに青もずれる、赤もずれる。
;---へるぱが食らったとき本体連動でうまく本体食らいにできるか？
;---VARたりない、HITPAUSETIMEうまくいかない。p2statenoの攻撃はあたらない
;---相手MOVEHITの数値とかどうなるかとか不明？
;--へるぱのVAR参照とかが一番だけど記述めんどいなー
;---------------------------------------------------------------------------
;-----v43に自分カウンタ判定 でヒットストップをのばせばいい。
; HITG_SHAKE		地上立ちでくらうとここ、硬直	頭くらい5000-　お腹くらい5010-　がある
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0


[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD　アニメを5000～5002(5010～5012)のどれかにかえる
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK		BACK指定のアニメ
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)　上書きUPとかのアニメ
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim	指定アニメで硬直させる
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up 打ち上げだったらA
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

;-----------------------ガードバランス自前処理：対応キャラ以外のみ
;--5000立ち5010しゃがみ5020空中5070アシ払い5080ダウンくらい
[state 7000,];くらいで減らす
type = varadd
triggerall = var(49) != 2
triggerall = var(19) > 0
trigger1 = time = 0
var(19) = -1 * ifelse(gethitvar(animtype) = 0,8,ifelse(gethitvar(animtype) = 1,7,6))
ignorehitpause = 1
persistent = 0

;---------------------------ここから自前カウンターHITSTOｐ増加
;----自カウンタ判定43　対応キャラ判定49＝2
[State 5000, 6];var(43)が１になってたら　増加分とをたして・・ 増加するのはL2から,MID以上にしておく
type = varset
triggerall = time = 0 
triggerall = var(43) = 1 && var(49) != 2
trigger1 = gethitvar(animtype) = [1,3]
var(43) = gethitvar(hitshaketime) + gethitvar(animtype) * 3 
ignorehitpause = 1
persistent = 15

[State 3400,];カウンタ時の色かえ
type = PALFX
triggerall = time = 0 
trigger1 = var(43) && var(49) != 2
add = 255,-130, -108
time = 5
ignorehitpause = 1
persistent = 0

[state 3400,];カウンター音とか	HITPAUSEちゅうにでればいいからd、最初に出る必要は無い最初は相手の判断できない
type = playsnd
triggerall = time = 0
trigger1 = var(43) && var(49) != 2
value = s60,11
channel = 11
ignorehitpause = 1
persistent = 0

[State 5000, 6];var(43)  これのクリップボード表示は前Fので、まにあってないから1で動き出せばあってるはず
type = varadd
trigger1 = var(43) > 0 
var(43) = -1
ignorehitpause = 1

;--------------でもってV43が０になればOK 0だったらそのまま０だしね
[State 5000, 6];PAUSETIME終了してY方向が0でFALLでもないと地上ノックバック
type = ChangeState
trigger1 = !var(43) && HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 5001 ;HITG_SLIDE

[State 5000, 7];上にあてはまってなければ吹き飛び
type = ChangeState
trigger1 = !var(43) && HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE		地上ノックバック
[Statedef 5001]
type    = S
movetype= H
physics = S

[State 5001, 1];相手のHITDEFのVELを有効に		速度を１にしてるのではなく、真・設定を有効にしろ、という意味？
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2];5000～とかがおわったら5005（5015)にする 設定によってはこのアニメ使うまもなく終了するが。
type = ChangeAnim
trigger1 = AnimTime = 0
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 5001, 3] ;Stop sliding back	スライドタイムの間
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1


[State 5001, 6]
type = ChangeState
trigger1 = HitOver
value = 0
ctrl = 1

