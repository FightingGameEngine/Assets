trigger1 = Time = 0 && var(59) = 3
value = 620
ctrl = 0

[State 42, 6];ガトリングなら即行きOK HsにいくのはPS 
type = ChangeState
triggerall = Time = 0 && var(59) = 4
trigger1 = prevstateno = 600 || prevstateno = 620
value = 630
ctrl = 0

;独り言 0,100,200;---憑いてるときは控えめに
;---SLRE8種0-7 AC11種8-18 ALL19
;------------------ランダムかそうでないかでわけておくかな
[State -3, voice];固定設定の場合3,5
type = PlaySnd
triggerall = var(54) < 6
triggerall = random % ifelse(!var(20),2,3) = 0
trigger1 = time = 0
value = s999, ifelse(var(54) >= 3,  (random % 11 + 8) + var(54) * 100 - 300,random % 8 + (var(54) * 100)) 
channel = 0

[State -3, voice];ランダム設定の場合
type = PlaySnd
triggerall = var(54) >= 6 
triggerall = random % ifelse(!var(20),2,3) = 0
trigger1 = time = 0
value = s999, ifelse(var(54) = 8, random % 19, ifelse(var(54) = 7,random % 11 + 8,random % 8)) + random % 3 * 100
channel = 0

[State 42, 6];50のほうでCTRLセット　１F必要なので
type = ChangeState
trigger1 = Time = 0
value = 50
ctrl = 0

