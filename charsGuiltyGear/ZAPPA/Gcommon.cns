;-------------------comonn for GGXX + TWIN "Ikaros"
; Common state file for M.U.G.E.N beta 2002.04.14
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defence increases at time = 0
; Hit_bounce (5100): defence increases at time = 0, player becomes
;                    invincible if within 10 ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0
;5160,5161は-30AIRでずらす？
;---------------------------------------------------------------------------
;----------自動振り向きあり、
[Statedef 0]
type = S
physics = S
sprpriority = 0
Hitcountpersist = 1

;独り言 0,100,200;---憑いてるときは控えめに
;---SLRE8種0-7 AC11種8-18 ALL19
;------------------ランダムかそうでないかでわけておくかな
[State -3, voice];固定設定の場合3,5
type = PlaySnd
triggerall = var(54) < 6
triggerall = random % ifelse(!var(20),2,3) = 0
trigger1 = prevstateno != [10,52]
trigger1 = animelemtime(1) = 1 
trigger2 = prevstateno = [10,52]
trigger2 = animelemtime(1) = 1 && time > 1
value = s999, ifelse(var(54) >= 3,  (random % 11 + 8) + var(54) * 100 - 300,random % 8 + (var(54) * 100)) 
channel = 0

[State -3, voice];ランダム設定の場合
type = PlaySnd
triggerall = var(54) >= 6 
triggerall = random % ifelse(!var(20),2,3) = 0
trigger1 = prevstateno != [10,52]
trigger1 = animelemtime(1) = 1 
trigger2 = prevstateno = [10,52]
trigger2 = animelemtime(1) = 1 && time > 1
value = s999, ifelse(var(54) = 8, random % 19, ifelse(var(54) = 7,random % 11 + 8,random % 8)) + random % 3 * 100
channel = 0

;-------------------------ここで各種憑依がおこなわれる
;---0,11,5200,5210に同じものを---
;---ブリジット特殊イントロで被弾している、その場合の判定をしたくないイントロとばしはRS2判定になってついてしまう
[state -3,];強制解除
type = varset
triggerall = var(20) = -1 
trigger1 = !ctrl
var(20) = 0
ignorehitpause = 1

;-------------食らい経由共通抽選
;-------無の確率はそれなりに高い？4分の１ではなさそう
;---食らいで-1になってたらやる。 0,1,2,3を抽選しさらに0or1で強制無
[State 2050,  2];らおう時はやらなくていい 
type = varset
triggerall = !numhelper(100)
triggerall = !numhelper(200)
triggerall = !numhelper(300)
triggerall = !numhelper(400)
trigger1 = var(20) = -1 && time = 0
var(20) =  random % 4  
persistent = 0

[State 2050,  2];保険、前のがまだいた場合・・もしもういたら消す？
type = varset
triggerall = var(20) = -1 && time = 0
trigger1 = numhelper(100) || numhelper(200)
trigger2 = numhelper(300) || numhelper(400)
var(20) =  0 
persistent = 0

[state 1200,light];でもって0より上になってたら実行憑依
type = Helper
triggerall = time = 0
triggerall = var(20) > 0
trigger1 = !numhelper(var(20) * 100)
name = "RANDOM"
ID = var(20) * 100
pos = 0,0 
postype = p1
stateno = var(20) * 200 + 2000
ownpal = 1
size.height = var(20) * 100;ID
size.xscale = 0.5
size.yscale = 0.5
persistent = 0
supermovetime = 9999


[State 0, 1];
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 0.5
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch　しゃがむと幅が増えますmainusで
[Statedef 10]
type    = C
physics = C
anim = 10
Hitcountpersist = 1

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0
Hitcountpersist = 1

;-------------------------ここで各種憑依がおこなわれる
;---0,11,5200,5210に同じものを---
;-------------食らい経由共通抽選
;-------無の確率はそれなりに高い？4分の１ではなさそう
;---食らいで-1になってたらやる。 0,1,2,3を抽選しさらに0or1で強制無
[State 2050,  2];らおう時はやらなくていい
type = varset
triggerall = !numhelper(100)
triggerall = !numhelper(200)
triggerall = !numhelper(300)
triggerall = !numhelper(400)
trigger1 = var(20) = -1 && time = 0
var(20) =  random % 4 
persistent = 0

[State 2050,  2];保険、前のがまだいた場合・・もしもういたら消す？
type = varset
triggerall = var(20) = -1 && time = 0
trigger1 = numhelper(100) || numhelper(200)
trigger2 = numhelper(300) || numhelper(400)
var(20) =  0 
persistent = 0

[state 1200,light];でもって0より上になってたら実行憑依
type = Helper
triggerall = time = 0
triggerall = var(20) > 0
trigger1 = !numhelper(var(20) * 100)
name = "RANDOM"
ID = var(20) * 100
pos = 0,0 
postype = p1
stateno = var(20) * 200 + 2000
ownpal = 1
size.height = var(20) * 100;ID
size.xscale = 0.5
size.yscale = 0.5
persistent = 0
supermovetime = 9999

[State 11, 1] ;しゃがみ振り向きアニメは自動で行われます
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand  しゃがみ攻撃後の立ち上がりではリセットしない、
[Statedef 12]
type    = S
physics = S
anim = 12
Hitcountpersist = 1

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = N;S
sprpriority = 0
Hitcountpersist = 1

;----------モードによる移動速度など これを２で割った数字
;----通常			
;前3.35	後3.25	FD9.6	BD14	AFD14 	ABD14	FJ7.5 FHJ6 BJ5 bhj5
;----GGモード	20%UP?		
;前4	後4 	FD11 	BD17 	AFD19 	ABD16.5	FJ8  FHJ6 BJ8 bhj5
;----Gカラー			
;前8	後6	FD24	BD24	AFD17	ABD16.5	FJ8  FHJ6 BJ8 bhj5
;----GG+Gカラー			
;前10	後7	FD30	BD29	AFD20	ABD20 FJ8 FHJ6 BJ8 bhj5
[State 20, 1];4,Gカラー
type = VelSet
triggerall = palno = var(42)
trigger1 = command = "holdfwd"
x = ifelse(var(2) = 1, 10,8) * 0.5 

[State 20, 1];4,通常
type = VelSet
triggerall = palno != var(42)
trigger1 = command = "holdfwd"
x = ifelse(var(2) = 1,4,3.35) * 0.5

[State 20, 2];Gカラー
type = VelSet
triggerall = palno = var(42)
trigger1 = command = "holdback"
x = ifelse(var(2) = 1,-7,-6) * 0.5

[State 20, 2];通常
type = VelSet
triggerall = palno != var(42)
trigger1 = command = "holdback"
x = ifelse(var(2) = 1,-4,-3.25) * 0.5

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start	0.1.2=３F目にとんでいる,3F目はS50のtime=0であり、そのFはCTRL=0、S50のCTRLはtime=1で
;---------------投げ無敵必殺技OKしゃがみじょうたい３F
;---------通常ジャンプ	全:振向き無:地上0-20	地上Jきゃん	3F
;----------2ジャンプ		全:振向き有:42-50	地上Jきゃん	
;---------ぷちジャンプ	前:振向き無:地上ダッシュ99.地上通常技HITSTOP後しばらく		3f
;---------大ジャンプ		前:振向き無:地上ダッシュ100		3F
;---------ハイジャンプ	全:振向き有:レバー下上		3F
;--------ホーミングJ		前:振向き無:ダスト			1F
[Statedef 40]
type    = c
physics = c
anim = 40
ctrl = 0
sprpriority = 1
Hitcountpersist = 1

[State 10, 2];AI強制0戻し・・憑依考慮したくない、共通のでなにかひとつ・・
type = changestate
triggerall = numhelper(50000)
triggerall = var(39) != [41,43]
trigger1 = time = 0
value = ifelse(p2dist x < 50 ,240,ifelse(p2dist x < 100,205,225))
ctrl = 0

[State 10, 2];ふりむく
type = turn
trigger1 = p2dist x < 0
trigger1 = time = 0
persistent = 0

[state -3,];擬似CTRL 必殺許可
type = varset
trigger1 = time = 0
sysvar(3) = 2
ignorehitpause = 1

[State 40, mu];投げ無敵
type = nothitby
trigger1 = 1
value = ,nt,st,ht
time = 1
ignorehitpause = 1

[State 40, 6s];レバーフリーフラグ
type = varset
trigger1 = 1
var(9) = 1
ignorehitpause = 1

;------------方向決定
[State 40, 1];レバーリセットまたは上
type = VarSet
trigger1 = Time = 0
trigger2 = var(39) = 41
sysvar(1) = 0

[State 40, 2];レバー前上 またはAI強制前とび
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = var(39) = 42
sysvar(1) = 1

[State 40, 3];レバー後上
type = VarSet
trigger1 = command = "holdback"
trigger2 = var(39) = 43
sysvar(1) = -1

[State 40, 3];振り向き属性　ハイジャンプであれば。 仕込みは別コマンドでSV4　ここで必殺にいった場合はどうなる？2にしとく？
type = VarSet
trigger1 = Time = 0
trigger1 = var(13)
var(55) = 2;-1

[State 40, 3];通常J属性	ハイジャンプじゃなければ　HITSTOP仕込みはMINUSで
type = Varset
trigger1 = Time = 0
var(14) = ifelse(var(13),0,2)

[State 40, 3];ハイジャンプ ２J回数へらしておく　14が入ってればHJでもOK ここで必殺にいった場合はどうなる？2にしとく
type = Varset
trigger1 = Time = 0
var(15) = ifelse(var(13),1,0)

;----------モードによる移動速度など これを２で割った数字
;----通常			
;前3.35	後3.25	FD9.6	BD14	AFD14 	ABD14	FJ7.5 FHJ6 BJ5 bhj5
;----GGモード	20%UP?		
;前4	後4 	FD11 	BD17 	AFD19 	ABD16.5	FJ8  FHJ6 BJ8 bhj5
;----Gカラー			
;前8	後6	FD24	BD24	AFD17	ABD16.5	FJ8  FHJ6 BJ8 bhj5
;----GG+Gカラー			
;前10	後7	FD30	BD29	AFD20	ABD20 FJ8 FHJ6 BJ8 bhj5
[State 40, 4];地上基本値 x HJ共通じゃない！前J
type = Varset
triggerall = !var(13)
trigger1 = Time = 0 && sysvar(1) = 1
fvar(7) = ifelse(palNO = var(42), 8,7.5) * 0.5
[State 40, 4];地上基本値 x HJ共通じゃない！　後ろJ
type = Varset
triggerall = !var(13)
trigger1 = Time = 0 && sysvar(1) = -1
fvar(7) = ifelse(palNO = var(42), 8,5) * -0.5

[State 40, 4];地上 HJ　前J6,後ろ5
type = Varset
triggerall = var(13)
trigger1 = Time = 0 ;&& sysvar(1) = 1
fvar(7) = sysvar(1) * ifelse(sysvar(1) = 1,6,5) * 0.5

[State 40, 4];地上 上
type = Varset
trigger1 = Time = 0 && !sysvar(1) 
fvar(7) = 0

[State 40, 4];ぷちJ　ればーNにしたら９９になるはず、地上通常技ダッシュ残し　の場合 16は攻撃中HITSTOP終了後しばらくの・・
type = Varset
triggerall = var(8)
triggerall = Time = 0
triggerall = sysvar(1) >= 0
trigger1 = prevstateno = [99,100]
trigger2 = prevstateno = [200,440]
trigger2 = var(16) >= 2
fvar(7) = ifelse(prevstateno = 100,vel x, vel X / 1.5)

[State 40, 4];HJ V13がはいってる場合はHJ NJy20,40滞空 HJy31,49滞空
type = Varset
trigger1 = Time = 0
fvar(8) = ifelse(var(13),-16.0,-10.5)

[State 40, 4];ジャンプ重力違いV13がはいってる場合 y NJ1.05,HJ1.3
type = Varset
trigger1 = Time = 0
fvar(9) = ifelse(var(13),0.65,0.525)

;---------------ストップ中属性追加されても慣性削除らしい？ほりゅう　
[State 40, 4];ダスト時　慣性残し削除
type = Varset
triggerall = var(4) && !var(11) && !var(12)
triggerall = playerID(var(4)),movetype = H
triggerall = playerID(var(4)),stateno = [5850,5865]
trigger1 = playerID(var(4)),sysvar(0) <= 47
trigger1 = Time = 0
var(8) = 0
ignorehitpause = 1

;------ホーミング部 もしかするとtime１スタートか？
[State 40, 65];ダストジャンプ,F11(D中2段ジャンプするとかで解除)  
type = ChangeState
triggerall = var(4) && !var(11) && !var(12)
triggerall = playerID(var(4)),movetype = H
triggerall = playerID(var(4)),stateno = [5850,5865]
trigger1 = playerID(var(4)),sysvar(0) <= 47
trigger1 = time = 0
value = 55
ctrl = 0

[State 40, 6];ダスト以外ジャンプ
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 0

;---------------------AirJump Start空中でのジャンプ　2段ジャンプとか属性は？
[Statedef 42]
type    = A
physics = N
ctrl = 0
anim = 41
hitcountpersist = 1

[State 2050,  snd];通常ジャンプ効果音
type = PlaySnd
trigger1 = time = 0
value = s50,0
channel = 2

[State 42, 8];AIrダッシュ回数減らす
type = Varadd
trigger1 = Time = 0
var(7) = 1
ignorehitpause = 1

[State 42, 8];2ジャンプしたフラグ 0通常 1仕込状態V14連動 2実行後or不能行動(AIRDASH
type = Varset
trigger1 = Time = 0
var(15) = 2
ignorehitpause = 1

[State 42, 8];レバーニュートラルフラグ
type = Varset
trigger1 = Time = 0
var(9) = 1
ignorehitpause = 1

[State 42, 8];振り向き属性追加・・
type = Varset
trigger1 = Time = 0
var(55) = 1
ignorehitpause = 1

;---------------------------------------速度決定sv2にしてみる
[State 42, 1]
type = VarSet
trigger1 = Time = 0
trigger2 = var(39) = 41
sysvar(2) = 0

[State 42, 2]
type = VarSet
triggerall = Time = 0
trigger1 = command = "holdfwd"
trigger2 = var(39) = 42
sysvar(2) = 1

[State 42, 3]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger2 = var(39) = 43
sysvar(2) = -1

;----------モードによる移動速度など これを２で割った数字
;----通常			
;前3.35	後3.25	FD9.6	BD14	AFD14 	ABD14	FJ7.5 FHJ6 BJ5 bhj5
;----GGモード	20%UP?		
;前4	後4 	FD11 	BD17 	AFD19 	ABD16.5	FJ8  FHJ6 BJ8 bhj5
;----Gカラー			
;前8	後6	FD24	BD24	AFD17	ABD16.5	FJ8  FHJ6 BJ8 bhj5
;----GG+Gカラー			
;前10	後7	FD30	BD29	AFD20	ABD20 FJ8 FHJ6 BJ8 bhj5


[State 40, 4];基本 ダッシュ慣性　のこりじゃない場合 前JNJ
type = Varset
triggerall = !var(8) || (var(8) = 2 && var(15) <= 1)
trigger1 = Time = 0 && sysvar(2) >= 0
fvar(7) = (sysvar(2) * ifelse(palNO = var(42), 8,7.5) * 0.5)

[State 40, 4];基本 ダッシュ慣性　のこりじゃない場合 後ろJ
type = Varset
triggerall = !var(8) || (var(8) = 2 && var(15) <= 1)
trigger1 = Time = 0 && sysvar(2) = -1
fvar(7) = (sysvar(2) * ifelse(palNO = var(42), 8,5) * 0.5)

;--------------慣性残る場合の。
[State 40, 4];プチジャンプ時、すいちょくJ時　0なら0のままだね 慣性残しでもOK
type = Varset
triggerall = var(8) = 1 || (var(8) = 2 && var(15) >= 2)
trigger1 = Time = 0
trigger1 = sysvar(1) = 0 && sysvar(2) = 0
fvar(7) = vel x 

[State 40, 4];プチジャンプで前 0なら普通に足されるだけ
type = Varset
triggerall = var(8) = 1 || (var(8) = 2 && var(15) >= 2)
trigger1 = Time = 0
trigger1 = sysvar(1) = 0 && sysvar(2) = 1
fvar(7) = vel x + (sysvar(2) * ifelse(palNO = var(42), 8,7.5) * 0.5)

[State 40, 4];プチジャンプで後ろ 0なら普通に足されるだけ
type = Varset
triggerall = var(8) = 1 || (var(8) = 2 && var(15) >= 2)
trigger1 = Time = 0
trigger1 = sysvar(1) = 0 && sysvar(2) = -1
fvar(7) = vel x + (sysvar(2) * ifelse(palNO = var(42), 8,5) * 0.5)

;--------------ダッシュ中
[State 40, 4];前J、NJ
type = Varset
triggerall = var(8) = 1 || (var(8) = 2 && var(15) >= 2)
trigger1 = Time = 0
trigger1 = sysvar(1) = 1 && sysvar(2) = 0
fvar(7) = vel x / 2

[State 40, 4];前J、前J
type = Varset
triggerall = var(8) = 1 || (var(8) = 2 && var(15) >= 2)
trigger1 = Time = 0
trigger1 = sysvar(1) = 1 && sysvar(2) = 1
fvar(7) = vel x  

[State 40, 4];前J、後ろJ さらにV８で地上ダッシュしてたら
type = Varset
triggerall = var(8) = 1 || (var(8) = 2 && var(15) >= 2)
trigger1 = Time = 0 
trigger1 = sysvar(1) = 1 && sysvar(2) = -1
fvar(7) = -1 * ifelse(palNO = var(42), 8,5) * 0.5 

;-------------------Yは共通
[State 40, 4];10  6.5
type = varset
trigger1 = Time = 0
fvar(8) = -10.5

[State 40, 4];ジャンプ重力NOにもどす？
