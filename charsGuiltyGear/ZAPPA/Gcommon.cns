;---------------------------------------------------------------------------
; HITA_UP (initial going up)	吹き飛びステート、重力かかる
[Statedef 5030]
type    = A
movetype= H
physics = N
ctrl = 0

[State 5030, 1];HITDEF設定の重力を使用する
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 2];HITDEF設定の速度を　「有効」に。１にするわけではない。
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5030, 3];FALL=0なら自動復帰になる
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 5030, 4];FAL=1ならおちる
type = ChangeState
triggerall = HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL

[State 5030, 5];５０３０アニメが終わったら・・
type = ChangeState
trigger1 = AnimTime = 0
value = 5035 ;HITA_UP (transition)

;---------------------------------------------------------------------------
; HITA_UP_T (transition)	一応くるが、たいてい5035アニメを設定されてない。ので5040,505にすぐ移動
[Statedef 5035]
type    = A
movetype= H
physics = N

[State 5035, 1];5035のアニメがあり、5051～5059でなく5090でもなければチェンジアニメ
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5035

[State 5035, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5035, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 5040 ;HITA_RECOV

[State 5035, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 5050 ;HITA_FALL

;---------------------------------------------------------------------------
; HITA_RECOV (recovering in air, not falling)空中自動回復、GGではまずない(全部FALL)SNK,CAP系には良く見られる
[Statedef 5040]
type    = A
movetype= H
physics = N

[State 5040, 1]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

[State 5040, 1]
type = ChangeState
trigger1 = !Alive
value = 5050

[State 5040, 2]
type = ChangeAnim
triggerall = anim != 41
trigger1 = AnimTime = 0
trigger1 = Anim != 5040
trigger2 = Time = 0
trigger2 = Anim != 5035
value = 5040

[State 5040, 2];もどし
type = Changestate
trigger1 = Anim = 5040
trigger1 = AnimTime = 0
value = 51
anim = 41

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver
value = 1

[State 5040, 4]
type = StateTypeSet
trigger1 = HitOver
movetype = I

[State 5040, 5]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5040, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMPLAND

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)		落ちる
[Statedef 5050]
type    = A
movetype= H
physics = N

;-1:アニメが5035終了　2:5035でなく5051-5059,5061-5069,5090でなければ5050にかえる->　5030はOK
[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

;---5051のが5050より早いタイミングでが5061(5060)にいく上昇中にちぇんあに
[State 5050, 2] ;Coming down anim5050-5059で頂点すぎるころ、5050ならyが1、それ以外-2で5060になる(5060があれば)
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground	地上近くではニュートラル復帰不能
type = ChangeState
triggerall = 1;Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
trigger1 = Command = "holdfwd" || command = "holdback"
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = 1;Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6];
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100 ;HIT_BOUNCE

;---------------------------------------------------------------------------
; HIT_TRIP (shaking)	TRIP設定なら強制ココスタート特殊、GGうつぶせダウンになる5100などの設定をいじるひつようあり
[Statedef 5070]
type    = A
movetype= H
physics = N
velset = 0,0

[State 5070, 1]
type = ChangeAnim 
trigger1 = 1
value = 5070

;-----------------------ガードバランス自前処理：対応キャラ以外のみ
;--5000立ち5010しゃがみ5020空中5070アシ払い5080ダウンくらい
[state 7000,];くらいで減らす
type = varadd
triggerall = var(49) != 2
triggerall = var(19) > 0
trigger1 = time = 0
var(19) = -1 * ifelse(gethitvar(animtype) = 0,8,ifelse(gethitvar(animtype) = 1,7,6))
ignorehitpause = 1
persistent = 0

;---------------------------ここから自前カウンターHITSTOｐ増加
;----自カウンタ判定43　対応キャラ判定49＝2
[State 5000, 6];var(43)が１になってたら　増加分とをたして・・ 増加するのはL2から,MID以上にしておく
type = varset
triggerall = time = 0 
triggerall = var(43) = 1 && var(49) != 2
trigger1 = gethitvar(animtype) = [1,3]
var(43) = gethitvar(hitshaketime) + gethitvar(animtype) * 3 
ignorehitpause = 1
persistent = 15

[State 3400,];カウンタ時の色かえ
type = PALFX
triggerall = time = 0 
trigger1 = var(43) && var(49) != 2
add = 255,-130, -108
time = 5
ignorehitpause = 1
persistent = 0

[state 3400,];カウンター音とか	HITPAUSEちゅうにでればいいからd、最初に出る必要は無い最初は相手の判断できない
type = playsnd
triggerall = time = 0
trigger1 = var(43) && var(49) != 2
value = s60,11
channel = 11
ignorehitpause = 1
persistent = 0

[State 5000, 6];var(43)  これのクリップボード表示は前Fので、まにあってないから1で動き出せばあってるはず
type = varadd
trigger1 = var(43) > 0 
var(43) = -1
ignorehitpause = 1

[State 5070, 2]
type = ChangeState
trigger1 = !var(43) && HitShakeOver
value = 5071

[State 5070, 3]
type = ForceFeedback
trigger1 = time = 0
time = 12
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HIT_TRIP2 (fall through air)
[Statedef 5071]
type    = A
movetype= H
physics = N

[State 5071, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5071, 2] ;Acceleration
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5071, 3] ;Hit ground	5100をとばして5110にいくようになっているため、跳ねなくなる。
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 15
type = ChangeState
value = 5110

;---------------------------------------------------------------------------
; HITL_SHAKE		ダウン中に攻撃を食らうとここにくるGGでは5030アニメになる5090省略しておけば自動で5030
;-------------------------5080は上にとばずその場でぺちっとなるアニメのはず
;----基本的にGGにぺちになる技なし。全て空中に吹き飛ぶ。
[Statedef 5080]
type    = L
movetype= H
physics = N
velset = 0,0

[State 5000, LL2]; lunatic lyra ver2
type = Changestate
trigger1 = ishelper(200)
value = 1710
ignorehitpause = 1

[State 5080, 1] ;Set default anim	上吹き飛びが0なら5080、吹き飛びなら5090 5090がなければ５０３０勝手に使う
type = VarSet
trigger1 = time = 0
sysvar(2) = ifelse (GetHitVar(yvel) = 0, 5080, 5090)

[State 5080, 2];5081-5089,5111-5119 だったらそのアニメの余りを追加代入　でぃじいらない
type = VarAdd
trigger1 = 0;time = 0
trigger1 = (anim = [5081,5089]) || (anim = [5111,5119])
trigger1 = SelfAnimExist(sysvar(2) + (anim % 10))
sysvar(2) = anim % 10

[State 5080, 3] ;If 5090 doesn't exist, default to 5030
type = VarSet
trigger1 = time = 0
trigger1 = sysvar(2) = 5090
trigger1 = 1;!SelfAnimExist(5090)
sysvar(2) = 5030

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

;----------------ガードバランス自前処理	対応キャラ以外	ヒットストップ0対策
;-----5000立ち5010しゃがみ5020空中5070アシ払い5080ダウンくらい
[state 7000,];くらいで減らす
type = varadd
triggerall = var(49) != 2
triggerall = var(19) > 0
trigger1 = time = 0
var(19) = -1 * ifelse(gethitvar(animtype) = 0,8,ifelse(gethitvar(animtype) = 1,7,6))
ignorehitpause = 1
persistent = 0


[State 5080, 4];YVELが０なら5081
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5081 ;HITL_SLIDE

[State 5080, 5];それ以外なら空中吹き飛び
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0
value = 5030 ;HITA_UP

;---------------------------------------------------------------------------
; HITL_SLIDE		ダウン中ヒットバック GGの攻撃なら5080->5030にいくはず 
[Statedef 5081]
type    = L
movetype= H
physics = C

[State 5081, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5081, 2]
type = VelSet
trigger1 = HitOver
x = 0

[State 5081, 3] ;Don't show hit ground frame
type = VarSet
trigger1 = Time = 0
sysvar(0) = 1

[State 5081, 4]
type = ChangeState
trigger1 = HitOver
value = 5110 ;HIT_LIEDOWN

;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground)	基本5050からくるたたきつけ
;---------地上にたたきつけられる、地上０固定
[Statedef 5100]
type    = L
movetype= H
physics = N

[State 5100, 1];上に吹き飛ばないときはX速度を1にする?
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State 5100, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

;----------------------------アニメ5100か5101、5102系にかえる
;-------------GGでは5070->5101   でぃじめい特殊、足払いにのみ1枚余分に絵があるが・・5101にしとく？
;--人によってはでないしー・・基本commonでもでないはずGG系とりこみ足払いではでなくなるし保留??
;--
[State 5100, 2] ;Hit  TRIP anim(GGXX,MB)	
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = 5070
trigger2 = prevstateno = 5070
value = 5101

[State 5100, 2] ;Hit ground anim (normal)5100にかえる
type = ChangeAnim
triggerall = time = 0
triggerall = anim != 5070
triggerall = anim != 5101
triggerall = prevstateno != 5070
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5100, 3] ;Hit ground anim (for hit up)5111-5112にかえる
type = ChangeAnim
triggerall = anim != 5070
triggerall = prevstateno != 5070
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5100, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5100, 7];上に跳ばない設定なら即5110
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110 ;HIT_LIEDOWN

[State 5100, 8]
type = GameMakeAnim
trigger1 = Time = 1
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 5100, 10]
type = PlaySnd
trigger1 = Time = 1
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5100, 11]
type = PosFreeze
trigger1 = 1

;-----------------------5100アニメがおわったら5101に移動、5100はループ不可である
[State 5100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101

[State 5100, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

