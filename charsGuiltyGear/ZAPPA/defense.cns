triggerall = var(25) = 2
trigger1 = fvar(22) <= 0
value  = ifelse(command = "holddown",131,130)
ctrl = 1
ignorehitpause = 1

[state 120x,];FDパワー減少　これはちぇんステしないときのみ実行、むこうでやるからね
type = poweradd
triggerall = power > 0 && !var(40) 
trigger1 = var(25) = 2
value  = -4
ignorehitpause = 0

;25以下でもしFDはいってなければ
[state 120x,];SB　硬直終了。前の130～と結構早く終わる
type = changestate
triggerall = fvar(22) <= 25
trigger1 = var(22) = 0 
trigger2 = power <= 0  
trigger3 = command != "holdback" 
trigger4 = var(40)  
trigger5 = fvar(22) <= 0
