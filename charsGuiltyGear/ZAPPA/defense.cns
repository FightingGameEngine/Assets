;-----------------------------------------
[State 132, 2];HOJ経由のときの重力判定
type = Varset
triggerall = time = 0
trigger1 = var(11) = [1,2] 
var(11) = 3

[State 130, 1];ガード硬直以外から来た場合
type = ChangeAnim
triggerall = prevstateno != [150,153]
trigger1 = Anim != 132
value = 132

[State 130, 1];ガード硬直からそのまま来た場合（FDしっぱなし)
type = ChangeAnim
trigger1 = prevstateno = [150,153]
trigger1 = time = 0
trigger2 = var(25) = 3 && time = 0
value = 132
elem = 3

;----------------ダスと用重力

[State 155, 2];ダストじゃないときfvar(9)?
type = VelAdd
trigger1 = !var(12)
trigger2 = var(12) >= 30
y = fvar(9);Const(movement.yaccel)

[State 132, 3];--POSがすでに地上で速度が下にむかってる→着地OK
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4];上のが真になったらになったら停止
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6];レバーいれたまま地上に着地している立ちガード
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command = "holdback"
value = 130

[State 132, 7];保険的、普通の着地
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding];レバーはなしなどで終了
type = ChangeState
trigger1 = command != "holdback"
trigger2 = var(25) < 2
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; GUARD (end)	ガード解除	共通	空中なら重力かかってる
;--------ガード終了アニメはなし、すぐに通常に戻る　保険でてきとーにAir設定はしといて
;----すぐ戻ると0->120->140->0るーぷして相手攻撃中硬直になるっぽいなんとかして
;---------------ってかCTRL1だし
[Statedef 140]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1


[State 140, 1]
type = ChangeAnim
trigger1 = 0;Time = 0
value = 140 + (statetype = C) + (statetype = A)*2

[State 140, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 140, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 140, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

;[State 140, 5] ;Implemented within engine
;type = ChangeState
;trigger1 = AnimTime = 0
;value = (statetype = C)*11 + (statetype = A)*51

;---------------------------------------------------------------------------
; SGUARDHIT (shaking)これが立ちガード硬直。しゃがみを押してるとGGXXでは内部的にはしゃがみガードだが絵がかわらないという。
;--つまり、硬直を無視してしゃがみガードに送れるが、アニメは立ちのまま、ってことでいいはず?
;-HじゃないとHITSHAKEOVERが考慮されない
;--直前ならLVに応じて早く通常へ2,3,3,4,4 L2 M3 H4とする。
;FDなら共通で2ふえるだけだね・
;---スラッシュバック　やなもの追加、

;-------------地上立ちのHITSTOP PAUSETIME中
[Statedef 150]
type    = S
movetype= h
physics = N
velset = 0,0

;-------------------------------------------ガード属性 優先順位SB>FD>JD>D
[State 150, 2];ガード初期化0以下のときのみ０にしておく　0通常　1JD 2FD 3SB   
type = varset
triggerall = var(25) <= 0
trigger1 = time = 0
var(25) = 0
ignorehitpause = 1

;----------------------SB成功時実行部
;----------v25=3　スラッシュバック成功
[State -1,SB];130経由せず150にくることもあるので・・コマンド入ってたら３
type = varset
var(25) = 3
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = (!var(1) || var(1) = 4)
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = time = 0
ignorehitpause = 1

[State 150, 2];SB	ゲージ減らし2％	ガード硬直（成功）ではprevstateno有効にしておく？
type = poweradd
triggerall = prevstateno != [120,155]
triggerall = var(25) = 3
trigger1 = time = 0
value = -40
ignorehitpause = 1
persistent = 0

[State 150, 2];SB	減らしても成功ゲージ獲得
type = poweradd
triggerall = var(25) = 3
trigger1 = time = 0
value = 120
ignorehitpause = 1
persistent = 0

[state 120x,];SB　ガード不能時間を15に設定しなおし HITPAUSEでへる？へらない？減ると一瞬で不能時間終わる、たぶん減らない
type = varset
triggerall = var(25) = 3
trigger1 = time = 0
fvar(22) = 15
ignorehitpause = 1
persistent = 0

[state 120x,];SB　SB受付フレームのばし成功30Fに	 HITPAUSEでへる？へらない？んー？、たぶん減らない
 type = varset
triggerall = var(25) = 3
trigger1 = time = 0
fvar(23) = 30
ignorehitpause = 1
persistent = 0

;-------------------------SBガードエフェクトベージュの円形、代用はどれがいい？
[state -2,helper partner];----エフェクト代用、黄色バーストのを
type = Helper
triggerall = var(25) = 3
trigger1 = time = 0
name = "SB HIT efect"
ID = 150
pos = 0,-55
postype = p1
stateno = 756
ownpal = 1
ignorehitpause = 1
size.xscale = 0.5
size.yscale = 0.75
persistent = 0

;------------------------------FD	ガード成功時実行
;-----------------------待機中のFD固有動作
[state 120x,]
type = varset
triggerall = var(25) < 3
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time = 0
var(25)  = 2
ignorehitpause = 1

[state -2,helper partner];緑の円
type = Helper
triggerall = var(25) = 2 
triggerall = !numhelper(50)
trigger1 = 1;time = 0
helpertype = normal
name = "FD helper"
ID = 50
pos = 0,0
postype = p1
stateno = 750
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

;----------v25=2　FDガード成功
[state 120x,];FDガードパワー減らし
type = poweradd
triggerall = time = 0
trigger1 = var(25) = 2 && power > 0 && !var(40)
value  = -25
ignorehitpause = 1
persistent = 0

;-------------------------FDガードエフェクト青い稲光みたいなのがあるっぽい
[state 120x,atc efe];ＦＤで当たったときの
type = Explod
triggerall = var(25) = 2 && power > 0 && !var(40)
trigger1 = time = 0
anim = 6165
ID = 760
postype = p1
pos = 0,-55
sprpriority = 4
bindtime = 1
facing = ifelse(random % 2 = 0,1,-1)
vfacing = ifelse(random % 2 = 0,1,-1)
removetime = -2
ownpal = 1
removeongethit = 0
ignorehitpause = 1
scale = 0.5,0.5
persistent = 0

;------引き戻しのときの方向に注意。fv20に格納	引き戻しでFDするとより相手に近づいてしまう
;--hitdefのVELは向きで自動で反転されている、後ろにとぶのはP1ではマイナスp2ではプラスにされているので・・たしかめるには？
;--posaddは自動で反転してくれる、マイナスでいいが、引き戻しの判定方法は？
[state 120x,];----FD距離強制のばし、POSADD ちぇんすてふれーむで ２p側だと逆転してる気がする基本値設定して符号を乗算
type = posadd
triggerall = var(25) = 2 
trigger1 = HitShakeOver
x = -15 * ifelse(gethitvar(xvel) <= 0,1,-1) * facing
ignorehitpause = 1
persistent = 0

;--------------本体で引き戻しできる相手いない？確認できない
[state 120x,];----FD距離強制のばし、画面背のとき	擬似相手押し返し画面はし引き戻しのときはどうなる？相手は？
type =  width
triggerall = 0;var(25) = 2 
triggerall = BackEdgeBodyDist < 35
trigger1 = HitShakeOver
player = 35,0
ignorehitpause = 1
persistent = 1

;----実験おしかえしへるぱ
[state -2,helper partner];
type = Helper
triggerall = var(25) = 2 
triggerall = BackEdgeBodyDist < 35
triggerall = enemynear,moveguarded
trigger1 = HitShakeOver
helpertype = normal
name = "FD ref helper"
ID = 745
pos = 20,0
postype = p2
stateno = 745
keyctrl = 0
ownpal = 1
ignorehitpause = 1
size.height = 240
ground.back = 120    
ground.front = 120   
air.back = 120        
air.front = 120   

;-------------------FD/SB共通擬似ライフ削り無効
;---------------------------------------------FD/SBライフ強制戻し -2でやる



;-----------------------JUSTガード　直前ガード
;----------v25=1　直前ガード成功	FDでもSBでもなくV23が23以上のとき（8F有効
;-------------------------直前ガード 専用実行
[state 120x,]
type = varset
triggerall = var(25) <= 1
trigger1 = var(23) > 22
trigger1 = time = 0
var(25) = 1
ignorehitpause = 1
persistent = 0

[State 1540, 4];光る
type = palfx
triggerall = var(25) = 1
trigger1 = time = 0
time = 10
add = 255,255,255
ignorehitpause = 1
persistent = 0

[State 1540, 4];ＪＤ	テンション獲得。
type = poweradd
triggerall = var(25) = 1
triggerall = !var(40)
trigger1 = time = 0
value = 40
ignorehitpause = 1
persistent = 0

[State 1540, 4];ＪＤ受付リセット	成功時のみ。
type = varset
triggerall = var(25) = 1
trigger1 = time = 0
var(23) = 0
ignorehitpause = 1
persistent = 0

;--------------------ガードバランス増加；対応キャラ以外ね
[state 7000,];自分の方　相手対応キャラでなければ　ガードで増やす  注意：FD(V25=2,3)なら増やさない、他のキャラ判断不能
type = varadd
triggerall = 1
triggerall = var(49) != 2
triggerall = var(19) < 256
triggerall = var(25) <= 1 
trigger1 = time = 0
var(19) = ifelse(gethitvar(animtype) = 0,6,ifelse(gethitvar(animtype) = 1,8 + random % 3,10 + random % 5))
ignorehitpause = 1
persistent = 0
supermovetime = 1

;-----------------------摩擦調整
;---原作と離れ方違う、仕方ない。ガードはX０でも普通後ろに下がるはず
;--ADｄやめ、初速乗算でいいや　Jd,SBなら低く、他なら長くー＞見た目原作の長さになる
[State 1540, 4];でふぉると	
type = varset
trigger1 = time = 0
fvar(13) = ifelse(var(25) = 1 || var(25) =3 ,0.9,1.2)
ignorehitpause = 1
persistent = 0

;-----------------------------------------
;-----------------------ガードこうちょく計算部　ひとつですませられるかな？
[State 150, 2];がード硬直数値格納 (animtype)L0 M1 H2 B3 U4 D5	保険として必ずだいにゅー
type = varset
trigger1 = time = 0
var(24) = GetHitVar(ctrltime)
ignorehitpause = 1

;----以下は、システムの違いでずれはあるでしょうが、しょうがないよ？
[State 150, 2];JUSTガード硬直数値格納 (animtype)L0 M1 H2 B3 U4 D5	2,3,3,4,4減る
type = varset
triggerall = var(25) = 1
trigger1 = time = 0
var(24) = GetHitVar(ctrltime) - ifelse(GetHitVar(animtype) = 0,2,ifelse(GetHitVar(animtype) = 1,3,4))
ignorehitpause = 1

[State 150, 2];FDガード硬直数値格納 (animtype)L0 M1 H2 B3 U4 D5 2,3,3,4,5増
type = varset
triggerall = var(25) = 2
trigger1 = time = 0
var(24) = GetHitVar(ctrltime) + ifelse(GetHitVar(animtype) = 0,2,ifelse(GetHitVar(animtype) = 1,3,4))
ignorehitpause = 1

[State 150, 2];SBガード硬直数値格納 地上２固定　空中4固定
type = varset
triggerall = var(25) = 3
trigger1 = time = 0
var(24) = ifelse(statetype = A,4,2)
ignorehitpause = 1

[State 150, 2];ねくろいんすとガード硬直数値格納 地上２固定　空中4固定
type = varset
triggerall = var(25) = 4
trigger1 = time = 0
var(24) = 1
ignorehitpause = 1

[State 1540, 4];計算すんだら　ＪＤ受付フラグリセット	成功時のみ。
type = varset
triggerall = var(25) = 1
trigger1 = time = 0
var(25) = 0
ignorehitpause = 1
persistent = 0


;-----------------------------------ここから下はいじらない
[State 150, 1];絵的にはここをどうにかする
type = ChangeAnim
trigger1 = 1
value = 130;150
elem = 4
ignorehitpause = 1

;----------------------------------------------------------------

[State 150, 2];硬直が終わるとノックバックへ下おしならしゃがみガードに
type = ChangeState
trigger1 = var(25) = 4 && time >= 0
value = 151 + 2*(command = "holddown")
ignorehitpause = 1

[State 150, 2];硬直が終わるとノックバックへ下おしならしゃがみガードに
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")



[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

;---------------------------------------------------------------------------
; SGUARDHIT2 (knocked back)	硬直がおわってノックバック
;-----FD、通常ガードの時間変更はここでなんとかして。ctrltimeをいじる、設定する
;---ここでSB入力すると有効になるけど130に移動させちゃうとやっかいになるよ
[Statedef 151]
type    = S
movetype= H
physics = S
;anim = 150

;----------------------GG特殊、ガード切り替えでも硬直終了まで絵的にかわらない
[State 151, 1];
type = changeanim
triggerall = prevstateno != 152
trigger1 = Time = 0
value = 150

[State 151, 1];HTIDEF　X設定有効に
type = HitVelSet
triggerall = var(25) != 4
trigger1 = Time = 0
x = 1

[State 151, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 151, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = s

[State 151, 1];ガード数値調整　
type = Velset
trigger1 = time = 0
x = vel x * fvar(13)
persistent = 0

;---しくみ
;---SB連打可能であり、従来どおりFDも発動可能である、3ボタン同時ならSBの３にセットさせる
;---フラグを使わないのであれば、SBを後において上書き法でやる？
;--こSBは一度押したらそのフレームだけ判定継続不可。コマンドのたびに３セットと不能フラグリセット
;--FDはおしっぱ判定可能なので、おしたままガードにいけばそっちで判別されるはず、コマンドでエフェクト、パワー減らしだけ発生
;---------------SB
;----ここでは失敗モーションにいかないので連打できるわけで。たまにCPUがすごいぴかぴかするのはこれであると
;--不能ふれ30に設定しなおすことでガード可能にもどし、この間ガードでSB発動になる
[state 120x,];SB　ガード状態フラグ
type = varset
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = 1
var(25)  = 3
ignorehitpause = 1

[state 120x,];SB　ガード不能時間の発動　成功時１５、失敗時３０、基本30にセットしてガードしたら15に変更
type = varset
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = 1
fvar(22)  = 30
ignorehitpause = 1

[state -2,helper partner];----SB発動リング黄色　成功時のはそっちで、代用エフェ
type = Helper
triggerall = numhelper(55) < 10
triggerall = !numhelper(55) || (numhelper(55) && random % 3 = 0)
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = 1
name = "SB helper splash"
ID = 55
pos = 0,0
postype = p1
stateno = 755
ownpal = 1
ignorehitpause = 1
size.height = 1

[State 150, 2];SB	ゲージ減らし2％	ガード硬直（成功）ここでガードすると2回減るかも、
type = poweradd
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = 1
value = -40
ignorehitpause = 0

;------------FD実行部
;--ここでもFDにいけるようにはする？var判断ではなくコマンド判断？
;---パワーへらしていくため、
[state -2,helper partner];みどりりんぐえふぇ
type = Helper
triggerall = !numhelper(50)
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = 1
helpertype = normal
name = "FD helper"
ID = 50
pos = 0,0
postype = p1
stateno = 750
keyctrl = 0
ownpal = 1
ignorehitpause = 1

[state 120x,];FD/パワー減少
type = poweradd
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = 1
value  = -4
ignorehitpause = 0

;--------------------V25=0通常　1JD -2FD---3SB
;---スライド停止はさすがにmugenに従っとく？いやしかし・・
;--基本ctrltime=slidetimeであるはず
[State 151, 2];デフォルトの設定	完全にそっくりには無理
type = VelSet
trigger1 = Time >= GetHitVar(slidetime)
trigger1 = Time >= var(24)
trigger2 = HitOver
trigger2 = Time >= var(24)
x = 0

[State 151, 3];FD2,SB3はここでも再入力できるのでこの条件はまずい
type = CtrlSet
trigger1 = Time >= var(24)
value = 1

[State 151, 4];設定時間終了、SBなら通常	これここで入力追加あるから、３じゃだめかも13？
type = ChangeState
trigger1 = Time >= var(24)
value = 130
ctrl = 1

