;------ダスト放物線後半部-擬似5030-5050
;----5865(5030,5050)mix
;---------------------------------------------------------------------------
; ------------------------	29ルール後半　通常吹き飛び通常重力
[Statedef 5865]
type    = A
movetype= H
physics = N
ctrl = 0

[State 5030, 1];HITDEF設定の重力を使用する
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 2];HITDEF設定の速度を　「有効」に。１にするわけではない。
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

;-1:アニメが5035終了　2:5035でなく5051-5059,5061-5069,5090でなければ5050にかえる->　5030はOK
[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
triggerall = authorname = "R-R" = 0
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = ifelse(authorname = "R-R",5050 + var(0),5050);5050

;-------
[State 5050, 1] ;双子用
type = ChangeAnim
triggerall = authorname = "R-R"
trigger1 = AnimTime = 0
trigger1 = Anim = 5035 + var(0)
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035 + var(0)
trigger2 = (Anim != [5051 + var(0) , 5059 + var(0)]) && (Anim != [5061 + var(0) , 5069 + var(0)])
trigger2 = Anim != 5090 + var(0);Not if hit off ground anim
value = ifelse(authorname = "R-R",5050 + var(0),5050);5050

;---5051のが5050より早いタイミングでが5061(5060)にいく上昇中にちぇんあに
[State 5050, 2] ;Coming down anim5050-5059で頂点すぎるころ、5050ならyが1、それ以外-2で5060になる(5060があれば)
type = ChangeAnim
triggerall = authorname = "R-R" = 0
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 2] ;双子用
type = ChangeAnim
triggerall = authorname = "R-R"
trigger1 = anim = [5050 + var(0),5059 + var(0)]
trigger1 = Vel Y >= ifelse(anim = 5050 + var(0), 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 4] ;Recover near ground	地上近くではニュートラル復帰不能
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
trigger1 = Command = "holdfwd" || command = "holdback"
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6];
triggerall = authorname = "R-R" = 0
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100 ;HIT_BOUNCE

[State 5050, 6];双子用
triggerall = authorname = "R-R"
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051 + var(0),5059 + var(0)]) || (anim = [5061 + var(0),5069 + var(0)]), 0, 25)
value = 5100 ;HIT_BOUNCE

[state 3800,];計測用 ほーみんぐJに使うか？いらないかな
type = varadd
trigger1 =  time >= 0
sysvar(0) = 1
ignorehitpause = 0

[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "psx=%f,psy=%f,vlx=%f,vly=%f,sv(0)=%d\n"
params =pos x,pos y,vel x,vel y, sysvar(0)
ignorehitpause = 1




