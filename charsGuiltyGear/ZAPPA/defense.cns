;-----------------------GGX,SB用新規ガード関係160
;------------------------SB失敗の　ガードモーション　絵はガードだけど硬直部。一定時間で通常に戻す
;--最初２F FDCできる、ってことはその２Fはガードできるってことにならない？
;--擬似FDとしてここでエフェクト変更と待機時間変更
;--さらに一定時間以後はSBにいけるように・・っややこし
[Statedef 160]
type    = S
movetype = I
physics = S
ctrl = 0
velest = 0,0

;---ガードフラグ3にする必要なし
;-------------------------再びSBへ、fvが25以下で擬似FDのとき。つまり擬似FD最低１Fやってからいけるようにする。
[State -1,SB];SB地上	ここでは３にしない。移動のみさせる	さらに擬似FDになってから、だからこれは上にお
type = ChangeState
value = ifelse(command = "SBS",130,131)
triggerall = fvar(22) <= 25 && var(25) = 2
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
triggerall = 1;command = "start"
trigger1 = 1
ignorehitpause = 0

;----擬似FD,２F以降　
[state 120x,];ガード不能時間切れてもまだFDコマンドなら２にする最初から２でもよさげ。
type = varset
triggerall = var(25) = 2 || var(25) = 3
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1 
var(25) = 2
ignorehitpause = 1

;-----------ここに来た時点でfv22の数は28か26?
;------失敗時にしかこないので30スタートであろう、
;----2F以降の演出だけは出す
[state -2,helper partner];
type = Helper
triggerall = !numhelper(50)
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1
