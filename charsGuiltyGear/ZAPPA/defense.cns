;-------------------------defence	
;-----55ダスト
;--s900挑発 s910敬意 s920一撃準備 s930DAA	 940相殺IDに使用	950黄ばーすと 960青バースト
;----以下敵P2SPR--5700 壁はねかり 5800よろけ　5850ダスト 5900はシステム使用、使っちゃだめ！


[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

;--------------特殊FDCダッシュ　GGXのみ
[State 130, Hi to Lo]
type = ChangeState
triggerall = var(2) = 2
triggerall = var(21)
triggerall = time = 0
trigger1 = command = "FF"
value = 100
ctrl = 0

[State 120, 5];anim120終了したらガード待機130-3まいめ
type = ChangeState
trigger1 = Time = 0
value = 130 + (statetype = C) + (statetype = A)*2

;------------ここ120-140ループになる、どうすればいい？
;----1レバーはなし　2FDでなくガード距離以外
[State 120, Stop Guarding];レバーはなすか　ガード距離じゃなければ終了へ（WINのみ
type = ChangeState
triggerall = 1
trigger1 = command != "holdback"
trigger2 = var(25) < 2
trigger2 = !inguarddist
value = 140

;---------------FD,SBは基本的に130系にとばします　攻撃きたら150系にいきます
;--130->150->130-140
;--150->130->140 	のパターンがあるので順番ずれるがかならずくる。

;---------------------------------------------------------------------------
;---SBだったら規定2or4フレームここで待機させる。当たるとシステムで自動150にいく。
;-受付終了したら絵は同じで硬直扱いのステートにとばしておく。
; STAND GUARD (guarding)	地上ガード待機　レバー下でしゃがみガード待機
[Statedef 130]
type    = S
physics = S

;----------------SB AC、ぱたーん7　
;---SB成功fv23 SBガード不能時間fv22 起上禁止f21
[state 120x,];SB　ガード状態フラグ	JDだろうとFD経由のときでも強制３	FD中コマンドで再帰でくるのでtime０のときのみ
type = varset
triggerall = 1;
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = time = 0
var(25)  = 3
ignorehitpause = 0

[state 120x,];SB　ガード不能時間の発動　成功時１５、失敗時３０、FD中コマンドで再帰でくるのでtime０のときのみ
type = varset
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = time = 0
fvar(22)  = 30
ignorehitpause = 0

[state -2,helper partner];----SB発動リング黄色　成功時のはそっちで、代用エフェ
type = Helper
triggerall = var(25) = 3
trigger1 = time = 0
name = "SB helper splash"
ID = 55
pos = 0,0
postype = p1
stateno = 755
ownpal = 1
ignorehitpause = 0
size.height = 1

[State 150, 2];SB	ゲージ減らし2％	ガード硬直（成功）ではprevstateno有効にしておく？
type = poweradd
triggerall = prevstateno != [130,132]
triggerall = var(25) = 3
trigger1 = time = 0
value = -40
ignorehitpause = 1
persistent = 0

[state 120x,];SB　コントロル不
type = ctrlset
triggerall = var(25) = 3
trigger1 = time = 0
value = 0
ignorehitpause = 1

[state 120x,];SB　受付終了普通２、成功後で4放置で失敗待機ステート135へ fv23
 type = changestate
triggerall = var(25) = 3
trigger1 = fvar(23) = 0 && time >= 2 
trigger2 = fvar(23) > 0 && time >= 4 
value = 160
ignorehitpause = 1

;-----------------------待機中のFD固有動作	演出だけは直前でもでる
;--保険でここでも2セットできるようにする	SB以外
[state 120x,]
type = varset
triggerall = var(25) <= 2
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 0
var(25)  = 2
ignorehitpause = 1

[state -2,helper partner];
type = Helper
triggerall = var(25) = 2 
triggerall = !numhelper(50)
trigger1 = time >= 0
helpertype = normal
name = "FD helper"
ID = 50
pos = 0,0
postype = p1
stateno = 750
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State -1,SB];FDにかかわらず	SBコマンドはいったら強制移動
type = ChangeState
value = ifelse(command = "SBS",130,131)
triggerall = var(25) <= 2
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = (!var(1) || var(1) = 4)
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = time >= 0
ignorehitpause = 0

[State 150, 2];FDやっててパワーが0になったら・・ 通常Gとする
type = varset
triggerall = var(25) = 2
trigger1 = power < 0
trigger1 = 1
var(25) = 0
ignorehitpause = 1

[state 120x,];FDパワー減少　
type = poweradd
triggerall = power > 0 && !var(40) 
trigger1 = var(25) = 2
value  = -4
ignorehitpause = 0

;--------------特殊FDCダッシュ　GGXモード、FD入ってるときのみ
[State 130, Hi to Lo]
type = ChangeState
triggerall = var(2) = 2
triggerall = var(25) = 2
triggerall = time = [0,1]
trigger1 = command = "FF"
value = 100
ctrl = 0

[State 130, 1];ガード硬直以外から来た場合
type = ChangeAnim
triggerall = prevstateno != [150,153]
trigger1 = Anim != 130
value = 130

[State 130, 1];ガード硬直からそのまま来た場合（FDしっぱなし)	きえる・？
type = ChangeAnim
triggerall = time = 0
trigger1 = prevstateno = [150,153]
trigger2 = var(25) = 3 
value = 130
elem = 3

;-----終了条件部、SBの3でも３０Fで0にされるので140に戻ってしまうデバック時ここもつぶして

[State 130, Hi to Lo];SB以外で・・
type = ChangeState
triggerall = var(25) < 3
trigger1 = command = "holddown"
value = 131

[State 130, Stop Guarding]
type = ChangeState
triggerall = var(25) < 3
trigger1 = command != "holdback"
trigger2 = var(25) < 2
trigger2 = !inguarddist
value = 140

[State 130, Stop Guarding];NI
type = ChangeState
trigger1 = var(25) = 4
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)しゃがみガード待機、れバー真横で立ちガード
[Statedef 131]
type    = C
physics = C

