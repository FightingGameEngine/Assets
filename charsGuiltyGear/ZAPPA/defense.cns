value = 130

[State 131, Stop Guarding]
type = ChangeState
triggerall = var(25) < 3
trigger1 = command != "holdback"
trigger2 = var(25) < 2
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; AIR GUARD (guarding)空中がーど待機	重力がかかります ダスト時は特殊で・・おもろいかかりかたをする
;----ダスト中の動きはHoJ55と同じようだ。距離によって？一定時間加速あり
[Statedef 132]
type    = A
physics = N

