name = "FD helper"
ID = 50
pos = 0,0
postype = p1
stateno = 750
keyctrl = 0
ownpal = 1
ignorehitpause = 1

;--------GGXのみ足払いOK  GGX/XXの判断ははV2,間違えないで
;---失敗2F[から]なので擬似FDここでもいけるかも
[State -1, FD];擬似	SB/FD失敗 しゃがみへ	保険ループするのでタイム制限
type = ChangeState
value = 161
triggerall = var(25) = 2
triggerall = time >= 1
triggerall = command = "holdback" 
trigger1 = command = "holddown"
trigger1 = fvar(22) > 0

;---擬似FD:ガード不能フラグが0になってまだ入ってたらそのままガードかのなFDへ継続
[state 120x,]
type = changestate
triggerall = var(25) = 2
trigger1 = fvar(22) <= 0
value  = ifelse(command = "holddown",131,130)
ctrl = 1
ignorehitpause = 1

[state 120x,];FDパワー減少　これはちぇんステしないときのみ実行、むこうでやるからね
type = poweradd
triggerall = power > 0 && !var(40) 
trigger1 = var(25) = 2
value  = -4
ignorehitpause = 0

;25以下でもしFDはいってなければ
[state 120x,];SB　硬直終了。前の130～と結構早く終わる
type = changestate
triggerall = fvar(22) <= 25
trigger1 = var(22) = 0 
trigger2 = power <= 0  
trigger3 = command != "holdback" 
trigger4 = var(40)  
trigger5 = fvar(22) <= 0
value = 0
ctrl = 1
ignorehitpause = 0

;-----------------------------SB失敗モーションしゃがみ
[Statedef 161]
type    = C
physics = C
movetype = I
ctrl = 0
velest = 0,0

;---ガードフラグ3にする必要なし
;-------------------------再びSBへ、fvが25以下で擬似FDのとき。つまり擬似FD最低１Fやってからいけるようにする。
[State -1,SB];SB地上	ここでは３にしない。移動のみさせる	さらに擬似FDになってから、だからこれは上にお
type = ChangeState
value = ifelse(command = "SBS",130,131)
triggerall = fvar(22) <= 25 && var(25) = 2
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
triggerall = 1;command = "start"
trigger1 = 1
ignorehitpause = 0

;----擬似FD,２F以降　
[state 120x,];ガード不能時間切れてもまだFDコマンドなら２にする最初から２でもよさげ。
type = varset
triggerall = var(25) = 2 || var(25) = 3
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1 
var(25) = 2
ignorehitpause = 1

;-----------ここに来た時点でfv22の数は28か26?
;------失敗時にしかこないので30スタートであろう、
;----2F以降の演出だけは出す
[state -2,helper partner];
type = Helper
triggerall = !numhelper(50)
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1
helpertype = normal
name = "FD helper"
ID = 50
pos = 0,0
postype = p1
stateno = 750
keyctrl = 0
ownpal = 1
ignorehitpause = 1

;--------GGXのみ足払いOK  GGX/XXの判断ははV2,間違えないで
;---失敗2F[から]なので擬似FDここでもいけるかも
[State -1, FD];擬似	SB/FD失敗 たちへ タイム制限しないとループエラー？
