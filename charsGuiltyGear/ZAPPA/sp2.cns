y = 0
ignorehitpause = 1

[state 7000,];---------------ロマキャンフラグリセット　ガトリング経由時time=0でやるための
type = varrangeset
trigger1 = time = 0
first = 34
last = 38
value = 0
persistent = 0
ignorehitpause = 1

[state 7000,];---------------相手V18ガードバランス関係
type = varadd
triggerall = var(49) <= 1 || (var(49) = 2 && enemynear,var(25) < 1)
trigger1 = movecontact
var(18) = ifelse(movehit,-7,5)
persistent = 0
ignorehitpause = 1

[state 7000,];--------------
type = varset
trigger1 = movecontact
var(34) = ifelse(movehit,2,1)
persistent = 0
ignorehitpause = 1

[state 1540,helper partner];----2pでもチーム時当たったほうに出るが同時ヒット時に片方のみ？
type = Helper
trigger1 = movecontact
name = "HIT SPARK"
ID = 8000 + stateno 
pos = 0,-5
postype = p2
stateno = ifelse(movehit,8002,8003)
ownpal = 1
persistent = 0
ignorehitpause = 1
size.height = -5;Y座標
size.ground.front = 40;相殺時X座標
size.ground.back = 6;持続
size.head.pos = 8002,8003

;--------------よろけ、ダメージなし後ろに下がるかそのままか？？おとあり、えふぇくとあり
[State 200, 1];LV2 x12
type = HitDef
triggerall = !var(34)
triggerall = !root,var(1) || root,var(1) = 4
trigger1 = animelem = 17
attr = S, NA       
sprpriority = -2            
damage = 0             
guardflag = L                  
hitflag = M                  
priority = 4,miss           
animtype = medium 
ground.type = low          
pausetime = 12, 12
guard.pausetime = 12, 12 + var(47) * 2          
hitsound   = s205, 1
guardsound = s150, 1             
ground.slidetime = 33
ground.hittime  = 33
guard.hittime  = 11	
guard.slidetime  = 11
airguard.ctrltime = 11 
ground.velocity = -7.5 * root,fvar(5)           
air.velocity = -3 * fvar(5), -7 * fvar(6)          
down.velocity = ifelse(var(2) = 2,-3,-8) * fvar(5),ifelse(var(2) = 2,-2,-2.5) * fvar(6)
guard.velocity = -7.5 
airguard.velocity = -2, -4
yaccel = 0.5
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (12 + 12 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 12 + 2 * root,var(47) + (!root,var(46)) * 7
getpower = ifelse(root,Var(40),0, 52 + (root,var(2) = 1 && root,life <= 250) * 52) 
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = 0
air.cornerpush.veloff    = 0
guard.cornerpush.veloff  = 0
airguard.cornerpush.veloff= 0
ignorehitpause = 0
p2stateno = 5800

[state 8110,vel];
type = destroyself
trigger1 = animtime = 0
ignorehitpause = 0
