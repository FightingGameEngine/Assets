[statedef 530];
type    = A
movetype= i
physics = N
ctrl = 0
velset = 0,0
anim = 228
sprpriority = 2

[State 3660,]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 3660,];ぐえっ
type = playsnd
trigger1 = time = 0
value = s80,9
channel = 5

;---------VELでやると本体ヒットストップ時の固定がめんどいかな？
;----って爆発アニメに変わるから・・アニメ固定はいみないやん・・
;---位置をなんとかしないと・
[State 3660,];本体固定	最初の４F
type = bindtoroot 
trigger1 = anim = 228
trigger1 = animelemtime(4) < 0
pos = 0,0
ignorehitpause = 1

;---AIR112,-135　の半分かも
[State 3660,];本体固定	持続1-3
type = bindtoroot 
trigger1 = anim = 228
trigger1 = animelemtime(5) >= 0
trigger1 = animelemtime(6) < 0
pos = 112 /2 ,-135 / 2
ignorehitpause = 1

;---AIR132,-125
[State 3660,];本体固定	持続4
type = bindtoroot 
trigger1 = anim = 228
trigger1 = animelemtime(7) >= 0
trigger1 = animelemtime(8) < 0
pos = 132 / 2,-125 / 2
ignorehitpause = 1
;---AIR137,-125
[State 3660,];本体固定	持続5-6
type = bindtoroot 
trigger1 = anim = 228
trigger1 = animelemtime(9) >= 0
trigger1 = animelemtime(10) < 0
pos = 137 / 2,-125 / 2
ignorehitpause = 1
;---AIR156,-111
[State 3660,];本体固定	持続7-9
type = bindtoroot 
trigger1 = anim = 228
trigger1 = animelemtime(11) >= 0
trigger1 = animelemtime(12) < 0
pos = 156 / 2,-111 / 2
ignorehitpause = 1

;---AIR166,-82
[State 3660,];ここからはなれてもいいかな	
type = bindtoroot 
trigger1 = anim = 228
trigger1 = animelemtime(13) = 0
pos = 166 / 2,-82 / 2
ignorehitpause = 1

[State 3660,];	
type = posadd 
trigger1 = anim = 228
trigger1 = animelemtime(15) = 0
x = 30
ignorehitpause = 1

[State 3660,];	
type = posset 
trigger1 = anim = 228
trigger1 = animelemtime(15) = 0
y = -10
ignorehitpause = 1

