;------------特殊ガード系移動。SBもできるかもしんないね
;----ここでやったばあい、FDと違って軌道変更がない。普通のほーみんである。やっかいすぎ保留？
[state 120x,];SB　ガード状態フラグ
type = varset
triggerall = var(25) <= 3; || var(25) = 3 || var(25) = 2
triggerall = !var(40) && power >= 20 && fvar(21) = 0  && !var(53)
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
trigger1 = command = "holdS" && command = "holdHS"
var(25)  = 3
ignorehitpause = 0

[state 120x,];SB　ガード不能時間の発動　成功時１５、失敗時３０、基本30にセットしてガードしたら15に変更	これもガードでやる？
type = varset
triggerall = var(25) = 3 
triggerall = !var(40) && power >= 20 && fvar(21) = 0 && !var(53)
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
trigger1 = command = "holdS" && command = "holdHS"
fvar(22)  = 30
ignorehitpause = 0

[State -1,SB];SB 空中
type = ChangeState
value = 132
triggerall = var(25) = 3 ;|| var(25) = 2
triggerall = !var(40) && power >= 20 && statetype = a && fvar(21) = 0 && !var(53)
triggerall = (!var(1) || var(1) = 4)
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
trigger1 = command = "holdS" && command = "holdHS"
ignorehitpause = 0

[State -1, FD];フォルトレス　空 レバー上はいっててもOK
type = ChangeState
value = 132
triggerall = var(25) <= 2 && fvar(22) <= 0 
triggerall = !var(40) && power > 0 && !var(53)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22) = 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) <= 3) && var(22))
triggerall = command = "holdback" 
trigger1 = time > 0
ignorehitpause = 0



;---------------ガトリング先行部	ダストにもこぴぺして
;---地上Jキャンの場合、高度制限ない必殺技可能、さっきまで、帰ってくるな？通る？
;---空中Jキャンは通常技；ガトリング系のみ
[State 42, 6];ガトリングなら即行きOK DにいくのはS,HS ,剣幽霊HSからはだめ
type = ChangeState
triggerall = Time = 0 && var(59) = 5
trigger1 = var(20) != 2 && var(20) != 3 && var(20) != 1 
trigger1 = prevstateno = 630
trigger2 = prevstateno = 620
value = 640
ctrl = 0

[State 42, 6];ガトリングなら即行きOK PにいくのはK らおうならS 憑依でP連打OK
type = ChangeState
triggerall = Time = 0 && var(59) = 1
trigger1 = prevstateno = 610 
trigger2 = prevstateno = 620 && var(20) = 4 
trigger3 = prevstateno = 600 && var(20) > 0
value = 600
ctrl = 0

[State 42, 6];ガトリングなら即行きOK KにいくのはPS 
type = ChangeState
triggerall = Time = 0 && var(59) = 2
trigger1 =  prevstateno = 600 || prevstateno = 620
value = 610
ctrl = 0

[State 42, 6];ガトリングなら即行きOK sにいくのはPK
type = ChangeState
triggerall = prevstateno = [600,610]
trigger1 = Time = 0 && var(59) = 3
value = 620
ctrl = 0

[State 42, 6];ガトリングなら即行きOK HsにいくのはPS 
type = ChangeState
triggerall = Time = 0 && var(59) = 4
trigger1 = prevstateno = 600 || prevstateno = 620
value = 630
ctrl = 0

[State 40, 6];2ジャンぷ レバーはなれてること、
type = changestate
triggerall = !var(9) && !var(53)
triggerall = !var(15) || (var(14) && var(15) = 1)
triggerall = command = "holdup" 
trigger1 = time >= 1
value = 42


;-----------------速度設定・カウント系は重複を避けるためちぇんステ命令あと
