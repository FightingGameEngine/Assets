trigger1 = animelem = 3 
anim = 3060
ID = 200
postype = p1
pos = 0,0
sprpriority = -2
bindtime = -1
removetime = -2
ownpal = 1
ignorehitpause = 1
scale = 0.5,0.5
supermovetime = 9999
persistent = 0

[state 3100,cut];SP発動暗転演出 airfront=背景時間　back=持続時間？一応確保  height = エフェクトLV
type = helper
trigger1 = time = 0
pos = 0, -50
postype = p1
name = "Cut Ex power ring"
stateno = 790
id = 790
supermovetime = 9999
size.air.front = 80
size.air.back = 80
ownpal = 1
size.height = 2
persistent = 0

[State 3100, Super A];暗転中強制　移動停止ー＞慣性のこるはず、仕様？むりい
type = posfreeze
trigger1 = time < 20
value = 1

[State 3100, Super A];暗転する40	仕様違いでー１だっけ
type = SuperPause
trigger1 = time = 0
postype = p1
pos = 0, -50
anim = -1;
sound = s60, 0
poweradd = -1000
persistent = 0
time = 39
movetime = 39
darken = 0

;------------覚醒系ヒット時フラッシュ。テスト。ぴかぴかよくない気もする
[State 3000,00]
type = allPalfx
trigger1 = movehit
trigger1 = hitpausetime
trigger1 = var(35) % 6 = 0
add = 255,255,255
time = 1
persistent = 0
ignorehitpause = 1

[state 7000,];---------------相手V18ガードバランス関係  対応きゃらならFD以外・・不正確だけどしかたないね
type = varadd
triggerall = var(49) <= 1 || (var(49) = 2 && enemynear,var(25) < 1) 
trigger1 = movecontact
trigger1 = hitpausetime
trigger1 = var(35) % 6 = 0
var(18) = ifelse(movehit,-6,14)
ignorehitpause = 1

[state 1540,helper partner];----height=Y位置　Gback=持続時間　2
type = Helper
trigger1 = animelem = 11 || animelem = 12 || animelem = 13 || animelem = 14
name = "HIT SPARK"
ID = 8000 + stateno 
pos = 0,0
postype = p2
stateno = 8020
ownpal = 1
ignorehitpause = 0
size.height = -60;Y軸
size.ground.front = 50;相殺時X座標
size.ground.back = 2;持続
size.head.pos = 8010,8011
size.proj.doscale = 3

;---STOP７なのでずれてるかも？2DOTか4Aが12から８になった・・??
[State 200, 1];LV4　4HIT　 X12Y10 AX12y14  GX17?15?
type = HitDef
triggerall = 1;!var(34)
trigger1 = animelem = 11 || animelem = 12 || animelem = 13 || animelem = 14
attr = S, HA                   
damage = ceil(40 * fvar(0)),1                
guardflag = M                  
hitflag = MAFD                  
priority = 6,miss           
animtype = hard 
ground.type = High         
pausetime = 7, 7 + var(47) * 8
guard.pausetime = 7, 7          
hitsound   = s205, 3
guardsound = s150, 4            
ground.slidetime = 17 + var(45)
ground.hittime  = 17 + var(45)
guard.hittime  = 16	
guard.slidetime  = 16
airguard.ctrltime = 16
ground.velocity = -5 * fvar(5),-5 * fvar(6)
air.velocity = -5 * fvar(5), -7 * fvar(6)
down.velocity = ifelse(var(2) = 2,-3,-8) * fvar(5),ifelse(var(2) = 2,-2,-2.5) * fvar(6)            
guard.velocity = -7.5
airguard.velocity = -2 ,-4
yaccel = 0.5           
fall = 1
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (60 + 60 * var(47) ) * var(46) * fvar(4) ) + 14 + 8 * var(47) + (!var(46)) * 7	
getpower = 0,0
palfx.time = var(47) * 5
palfx.add = var(47) * 255,var(47) * -130, var(47) * -108
ground.cornerpush.veloff = -15
air.cornerpush.veloff    = -15
guard.cornerpush.veloff  = -16
airguard.cornerpush.veloff= -16
ignorehitpause = 0

[state 3200,rend]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

