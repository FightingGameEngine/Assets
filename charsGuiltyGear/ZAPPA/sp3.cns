[state 3140,]
type = destroyself
trigger1 = root,alive = 0
trigger2 = enemy,alive = 0
trigger3 = roundstate >= 3

[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "EDX=%f,EDY=%f,fv0=%f,fv1=%f,V53=%d\n"
params = p2bodydist x,p2bodydist y,fvar(0),fvar(1),root,var(53)

[state -2, displayb];
type = appendtoclipboard
trigger1 = 1
text = "v10=%d,v11=%d,V12=%d"
params = var(10),var(11),var(12),

[state -2, displayb];
type = appendtoclipboard
trigger1 = 0
text = "v3=%d,v4=%d,v5=%d,V6=%d,V12=%d"
params = var(3),var(4),var(5),var(6),var(12)


