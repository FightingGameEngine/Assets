;---ぱっぱ　ゲージ技
;s3000 生まれる　s3100 まりす　s3200かいざー　s3600　こわいよー

;----うまれる
[statedef 3000];----
type    = S
movetype= A
physics = n
poweradd= 0
ctrl = 0
anim = 3000
sprpriority = 0
hitcountpersist = 1
velset = ifelse(prevstateno < 99,0,vel x ),0 

;--------------------------ダッシュ経由速度減少、停止処理0,20,99では０になってる
;----暗転中5枚目までは動かないはず---VELADDMULをじゃない、移動自体がフリーズのはずposfreeze?
;---暗転後もまだ慣性のこってる・うごくはず・仕様的にしょうがない？
[State 99,];1.05%?=0.105
type = Velmul
trigger1 = 1
x = 1 - 0.105

[State 99,]
type = Velset
trigger1 = Vel X <= 0.1
x = 0

[state 7000,];---------------ロマキャンフラグリセット　ガトリング経由時time=0でやるための
type = varrangeset
trigger1 = time = 0
first = 34
last = 39
value = 0
persistent = 0
ignorehitpause = 1

;----------------ACのは2連になってしまった。ややこしい
[state 193,];ボイス	まず抽選0-5のどれかがきまる
type = varset
trigger1 = time = 0
var(51) = ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3

[State 1100, sound];うまれる
type = PlaySnd
trigger1 = time = 0
value = s3000,var(51) 
channel = 0

[State 1100, sound];うまれる  AC2連
type = PlaySnd
triggerall = var(54) >= 3 && var(54) != 6
trigger1 = time = 45
value = s3000,var(51) + 10
channel = 0

[State 3200, ];無敵1-19	
type = nothitby
trigger1 = animelemtime(13) <= 0
time = 1
value = sca
ignorehitpause = 1

[State 3200, ];だげ無敵20-21
type = nothitby
trigger1 = animelemtime(13) >= 1
trigger1 = animelemtime(14) < 0
time = 1
value = ,na,np,sa,sp,ha,hp
ignorehitpause = 1

[State 99,]
type = playerpush
trigger1 = 1
value = 1
ignorehitpause = 1

[State 3660,];GOLD以外強制お祓い
type = varset
triggerall = palno !=  var(42)
trigger1 = time = 0
var(20) = 0
superemovetime = 1

[State 3660,];ぎゃーーーー
type = playsnd
trigger1 = animelem = 10
value = s80,7
channel = 4

;----------------演出手前
[state 100x,atc efe];1
type = Explod
trigger1 = animelem = 3 
anim = 3050
ID = 200
postype = p1
pos = 0,0
sprpriority = 2
bindtime = -1
removetime = -2
ownpal = 1
ignorehitpause = 1
scale = 0.5,0.5
supermovetime = 9999
persistent = 0

[state 100x,atc efe];1演出おく
