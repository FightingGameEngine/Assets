[state 3140,];・
type = varset
trigger1 = 1
var(20) = root,var(20)

;------------------------相手との距離
;---最低距離は14？。幅の関係？
;--Xは＋なら対面して前　　Yはマイナスなら相手が上、プラスなら相手が下
;--BDISTでなければ密着ーにいく・・
[state 3140,];X距	めくりっぽく、空中戦用？
type = varset
trigger1 = p2dist x <= -10
fvar(0) = -1
[state 3140,];X距	ちょー至近距離１	地上投げれる範囲
type = varset
trigger1 = p2dist x > -10
trigger1 = p2dist x <= 20
fvar(0) = 0
[state 3140,];X距	至近距離１_1	
type = varset
trigger1 = p2dist x = 20
trigger1 = p2dist x <= 45
fvar(0) = 0.5 
[state 3140,];X距	至近距離2
type = varset
trigger1 = p2dist x > 45
trigger1 = p2dist x <= 60
fvar(0) = 1
[state 3140,];X距	近距離1  
type = varset
trigger1 = p2dist x > 61
trigger1 = p2dist x <= 100
fvar(0) = 2
[state 3140,];X距	中距離1	Sがとどくぎりぎり
type = varset
trigger1 = p2dist x > 100
trigger1 = p2dist x <= 170
fvar(0) = 3 
[state 3140,];X距	遠距離1
type = varset
trigger1 = p2dist x > 170
trigger1 = p2dist x <= 210
fvar(0) = 4 
[state 3140,];X距	遠距離2	
type = varset
trigger1 = p2dist x > 210
fvar(0) = 5 
;----------------------------------------Yはマイナスなら相手が上、プラスなら相手が下------Y
[state 3140,];y距	相手上 かなり離れている。2キャラ分ぐらい？ 自分地上で相手ジャンプ？
type = varset
trigger1 = p2dist y <= -50
fvar(1) = -2
[state 3140,];y距	相手上、1キャラ分ぐらい？	空中同士なら投げれるかも？
type = varset
trigger1 = p2dist y < -10
trigger1 = p2dist y > -50
fvar(1) = -1
[state 3140,];Y距	高さほぼ同じ,基準位置？
type = varset
trigger1 = p2dist y >= -10 
trigger1 = p2dist y <= 10 
fvar(1) = 0 
[state 3140,];y距	Sがとどくかな？むりかな
type = varset
trigger1 = p2dist y > 10
trigger1 = p2dist y < 50
fvar(1) = 1
[state 3140,];y距	高い、じゃんぷ頂点ぐらい？
type = varset
trigger1 = p2dist y >= 50
trigger1 = p2dist y <= 120
fvar(1) = 2 

[state 3140,];	行動常時りせっと
type = parentvarset
trigger1 = 1
var(52) = 0

[state 3140,];思考ぱたーん、HPに応じて？	
type = varset
trigger1 = 1
var(58) = ifelse(life >= 500,0,ifelse(life >= 250,2,3)) 

;-------------------------移動系は53にしてみる？


;----どこらへんがいい間合いでしょうね？というか不自然になるねーやっぱ
[state 3140,];位置調整	地上前あるき・・	
type = parentvarset
triggerall = var(3) <= 2 && fvar(0) >= 4 && !var(57)
trigger1 = var(6) && root,stateno <= 20 && random % 300 = 0
var(53) = 20

[state 3140,];位置調整	地上ダッシュ、HP余裕あるとき。	
type = parentvarset
triggerall = var(3) <= 2 && fvar(0) >= 2 && !var(58)
trigger1 = var(6) && root,stateno <= 20 && random % 600 = 0
var(53) = 100

[state 3140,];位置調整	地上後ろあるき・・,相手がI時？	
type = parentvarset
triggerall = var(3) <= 2 && fvar(0) <= 1 && !var(57)
trigger1 = var(6) = 1 && root,stateno <= 20  && random % 200 = 0
var(53) = 21

[state 3140,];位置調整	地上バックダッシュ・・近くて相手が攻撃時、とかね	
type = parentvarset
triggerall = var(3) <= 2 && fvar(0) <= 1
trigger1 = !var(6) && root,stateno <= 20  && random % 100 = 0
var(53) = 105

[state 3140,];位置調整	とびこみ
type = parentvarset
triggerall = var(3) <= 2 && fvar(0) <= 2 && fvar(0) >= 1 && !fvar(1) && var(4) <= 2 
trigger1 = var(0) = [0,20]
trigger1 = random % 60 = 0
var(53) = 42

[state 3140,];位置調整	じゃんぷきゃんせ200,210,220,225,400,600,620,640
type = parentvarset
triggerall = var(3) <= 2 && fvar(0) <= 2 && fvar(1) <= -1 && var(4) = 3 && var(6) = 2
trigger1 = var(12) && (var(0) = 225 || var(0) = 210) 
var(53) = 42

[state 3140,];システム動作系	立ちへs0は１でいく	
type = parentvarset
triggerall = var(3) <= 2
trigger1 = root,var(53) = 20
trigger1 = fvar(0) <= 1
trigger2 = root,var(53) = 21
trigger2 = backedgedist < 10
var(53) = 1

[state 3140,];システム動作系封鎖	プレイやの判断もかねているためる最低１は保障しないと?んー？-1にする？
type = parentvarset
triggerall = var(3) <= 2 
trigger1 = !root,var(53)
trigger2 = stateno = [130,131]
trigger2 = !inguarddist
trigger3 = root,var(53) = [41,53] 
trigger3 = var(0) = 52 
var(53) = 1

[state 3140,];システム動作系封鎖	空中状態
type = parentvarset
triggerall = var(3) = 3 
trigger1 = !root,var(53)
trigger2 = root,var(53) != [40,53] 
trigger2 = root,var(53) != [100,107] 
trigger3 = stateno = 132
trigger3 = !inguarddist
var(53) = 2

[state 3140,];一度歩きとかに入ったら・・	あまり連続は変なので
type = varset
trigger1 = root,var(53) = [20,21]
trigger1 = !var(57)
var(57) = 300
[state 3140,];	
type = varadd
trigger1 = var(57) > 0
var(57) = -1

;-------------------------ガード特殊本体V25もいじるといい？いらないか
;-----でぃすとより遠い場合の判断はどうしようか？むり？
[state 3140,];システム動作系封鎖	立ちへ
type = parentvarset
triggerall = fvar(0) <= 3 && !var(6)
triggerall = inguarddist && random % 240
trigger1 = root,stateno = [0,20]
var(53) = ifelse(var(4) = 1,130,131)

;------------------------------ここから攻撃動作命令V52使用
;---コンボはストップ中のみ抽選する？じゃないと延々とやるよ？
;-------------------------------------------------------
;-----------------------------たちすたーと必殺系----
;---------------げーじがあったらやらせてみよう
;------------ぱっぱは憑依V20も考慮しないといけない
[state 7000,];	うまれる
type = parentvarset
triggerall = power >= 1000 && !root,var(40)
trigger1 = !var(59) && fvar(0) < 2 && !fvar(1) && var(4) < 4 
trigger1 = var(11) && var(3) <= 2
trigger2 = var(13) && var(12) = 1 && (var(0) = 220 || var(0) = 235 || var(0) = 230 || var(0) = 420)
var(52) = 3000

;----------必殺技
[state 7000,];
type = parentvarset
triggerall = !root,var(52) && fvar(0) <= 2 && !fvar(1) && var(4) < 4 
trigger1 = !var(59) && var(11) && var(3) <= 2 && random % 20 = 0
trigger2 = var(13) && var(12) = 1 && (var(0) = 210 || var(0) = 410 || var(0) = 230)
var(52) = 1100


;----------------通常技、間合いにあわせててきとー
;------またはコンボ
;--------------------基本行動足払いD
[state 7000,];
type = parentvarset
triggerall = var(20) != 2
triggerall = !root,var(52) && fvar(0) <= 1 && !fvar(1) && var(4) < 4 
trigger1 = !var(59) && var(10) && var(4) = 1 && random % 3 = 0
trigger2 = var(13) && var(12) = 1 && (var(0) = 230 || var(0) = 410)
var(52) = 440


