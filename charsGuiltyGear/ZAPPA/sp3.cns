[state 3140,]
type = turn
trigger1 = root,facing != facing

[state 3140,];本体すてーと
type = varset
trigger1 = 1
var(0) = root,stateno

;--------Var系
[state 3140,];モード１
type = varset
trigger1 = 1
var(1) = root,var(1)
[state 3140,];モード2
type = varset
trigger1 = 1
var(2) = root,var(2)

[state 3140,];モード１
type = varset
trigger1 = 1
var(1) = root,var(1)
[state 3140,];モード2
type = varset
trigger1 = 1
var(2) = root,var(2)
[state 3140,];本体状態 1立ち 2しゃがみ 3空 4だうん？		V3
type = varset
trigger1 = root,statetype = S || root,statetype = C  
var(3) = ifelse(root,statetype = S,1,2)
[state 3140,];本体状態 1立ち 2しゃがみ 3空 4だうん？		V3
type = varset
trigger1 = root,statetype = A || root,statetype = L  
var(3) = ifelse(root,statetype = A,3,4)

[state 3140,];手近な相手状態 1立ち 2しゃがみ 3空 4だうん？	V4
type = varset
trigger1 = enemynear,statetype = S || enemynear,statetype = C  
var(4) = ifelse(enemynear,statetype = S,1,2)
[state 3140,];手近な相手 1立ち 2しゃがみ 3空 4だうん？		V4
type = varset
trigger1 = enemynear,statetype = A || enemynear,statetype = L  
var(4) = ifelse(enemynear,statetype = A,3,4)

[state 3140,];本体状態 0A 1I 　2H	V5
type = varset
trigger1 = 1
var(5) = ifelse(root,movetype = A,0,ifelse(root,movetype = I,1,2))

[state 3140,];手近な相手状態 0A 1I 　2H	V6
type = varset
trigger1 = 1
var(6) = ifelse(enemynear,movetype = A,0,ifelse(enemynear,movetype = I,1,2))

[state 3140,];本体CTLR状態　擬似CTRLは通常OKなら１、ALLOKなら2
type = varrangeset
trigger1 = 1
value = 0
first = 10
last = 12
[state 3140,];本体CTLR状態通常系OK　擬似CTRLは通常OKなら１、ALLOKなら2,判断しにくいねわける
type = varset
trigger1 = root,ctrl || root,sysvar(3) = 1
trigger2 = root,stateno = [0,20]
trigger3 = root,stateno = [50,51]
var(10) = 1
[state 3140,];本体CTLR状態必殺系もOK　擬似CTRLは通常OKなら１、ALLOKなら2,判断しにくいねわける
type = varset
trigger1 = root,ctrl || root,sysvar(3)
trigger2 = root,stateno = [0,20]
trigger3 = root,stateno = [50,51]
var(11) = 1
[state 3140,];本体	movecontact、重要  ヒットなら1、ガードされたら-１,あたってるだけを判断ならvar(12)だけですむ
type = varset
trigger1 = root,movecontact
var(12) = ifelse(root,movehit,1,-1)

[state 3140,];本体MOVEHITなど・・これぱっぱだと・・
type = varset
trigger1 = 1
var(13) = ifelse(root,hitpausetime, 1,0)

[state 3140,];本体HITSHARKなど・・
type = varset
trigger1 = 1
var(14) = ifelse(root,HitShakeOver, 1,0)


;----------------------------------ぱっぱ特殊
