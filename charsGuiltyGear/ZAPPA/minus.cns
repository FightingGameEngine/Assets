;-------------------------------------一撃必殺技準備モード時特殊パワー設定
;-----これ準備モーション中はへらさない?後半から減ってる気がする
[state 7000,];だんだんぱわーをへらすのだ 食らい中へらさない
type = varadd
triggerall = roundstate = 2
triggerall = 1;stateno != 920
triggerall = movetype != H && statetype != L 
trigger1 = var(40) = 1
trigger1 = gametime % 2 = 0
trigger1 = fvar(12) > 0
fvar(12) = -2
ignroehitpause = 0

;-----食らい中へらさない、ライフに応じて減少速度低下開始。
[state 7000,];だんだんらいふもけずるのだ -----これ準備モーション中はへらさない
type = lifeadd
triggerall = roundstate = 2
triggerall = stateno != 920
triggerall = movetype != H && statetype != L 
