[state 7000,debu2]
type =varadd
triggerall = 0
trigger1 = command = "holdback"
trigger1 = var(19) < 256
var(19) = 1
ignorehitpause = 1

[state 7000,debu2]
type =varadd
triggerall = 0
trigger1 = command = "holdfwd"
trigger1 = var(18) > 0
var(18) = -1
ignorehitpause = 1

[state 7000,debu2]
type =varadd
triggerall = 0
trigger1 = command = "holdback"
trigger1 = var(18) < 256
var(18) = 1
ignorehitpause = 1

;-------------ブラックカラーてんしょんMAX,あと一撃ゲージもへらないようだ
[state 7000,debu2]
type =powerset
triggerall = !var(40)
trigger1 = palno = var(41)
value = 2000
ignorehitpause = 1

[state 7000,debu2];一撃ゲージは100％なので1000でいい20から12にへんこ
type =varset
triggerall = var(40) = 1
trigger1 = palno = var(41)
fvar(12) = 1000
ignorehitpause = 1

;----------------------しゃがみ幅ふやし
[State 10, 2]
type = width
triggerall = statetype = C
trigger1 = stateno != 40 
player = 1,0
ignorehitpause = 1

;-------------------------アフターイメージ関連　ハイジャンプ(透明) 一撃準備(赤）GGモード瀕死（黄）
[State 200,];大、ほーみんぐ残像を消す
type = AfterImageTime
trigger1 = stateno = 52
trigger2 = movetype = H
time = 0
ignorehitpause = 1

;---------------STARSHIPのみかもしれないロマキャン、食らいなどでのエフェクトけし　他はへるぱ
;----メイには～ないかな？
[state 1100x,]
type = removeexplod
trigger1 = movetype != A
ID = 200
ignorehitpause = 1

;--------------------------------------特殊ガード関連
;---------------------------------------------------------------------------------------------

;---------常時でいい？回復になる、正確には
[state 120x,]
type = lifeset
triggerall = stateno = 150 || stateno = 152 || stateno = 154
trigger1 = var(25) = 2 && power > 0 && !var(40)
trigger2 = var(25) = 3
value  = var(21)
ignorehitpause = 1

[state 120x,];ライフ格納 SBのときも気をつけるS+HSはいっててもね。あとこれじゃだめ、FD状態の確認がない FDかSB以外
type = varset
triggerall = 1;
trigger1 = 1;var(25) != 2 && var(25) != 3
var(21)  = life
ignorehitpause = 0

;------------v23----直前ガード30　で8FOK---------受付はHITSTOP中OK,なので早くやりすぎると失敗するわけね--------------------------
;---------------22-30の間にガードにいければ、成功
[state 120x,]
type = varadd
triggerall = var(23) > 0
trigger1 = 1
var(23)  = -1
ignorehitpause = 1

[state 120x,]
type = varset
triggerall = var(23) <= 0
trigger1 = 1
var(23)  = 0
ignorehitpause = 1

;-------------------------------v25を1にする	これ保険。
[state 120x,]
type = varset
triggerall = var(23) <= 22
trigger1 = var(25) = 1
var(23)  = 0
ignorehitpause = 1

;--------------------ここからSB
;-------------SB起き上がり１０F不能フラグ  fv21  これは5120あたりでやって
[state 120x,]
type = varadd
triggerall = fvar(21) > 0
trigger1 = 1
fvar(21)  = -1
ignorehitpause = 1

[state 120x,]
type = varset
triggerall = fvar(21) <= 0
trigger1 = 1
fvar(21)  = 0
ignorehitpause = 1

;------------------------sb	fv22ガード不能時間減少
[state 120x,]
type = varadd
triggerall = fvar(22) > 0
trigger1 = 1
fvar(22)  = -1
ignorehitpause = 0

[state 120x,]
type = varset
triggerall = fvar(22) <= 0
trigger1 = 1
fvar(22)  = 0
ignorehitpause = 0

;------------------------sb	FV23受付フレーム増加カウンター
[state 120x,]
type = varadd
triggerall = fvar(23) > 0
trigger1 = 1
fvar(23)  = -1
ignorehitpause = 0

[state 120x,]
type = varset
triggerall = fvar(23) <= 0
trigger1 = 1
fvar(23)  = 0
ignorehitpause = 0

;---------------SB,０になったらガードフラグ解除
[state 120x,]
type = varset
triggerall = var(25) = 3
trigger1 = fvar(22) <= 0
var(25) = 0
ignorehitpause = 0

;-----このフラグはレバー後ろでシステムガード不能になる。
;---手動で（FDなど）直接１３０に送り込み、そこであたるとガードになる。
;----この間FDも出せないのでそのように設定すればOK
;---ガードノックバックでの連打の関係でどうしようか
[State 3660,];SB後遺症　30Fまたは１５Fガード不能になる　－＞FDも？
type = AssertSpecial
triggerall = !var(1) || var(1) = 4
triggerall = fvar(22) > 0
trigger1 = fvar(23) = 0 && fvar(22) <= 28 
trigger2 = fvar(23) > 0 && fvar(22) <= 26 
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1

;---------V25　ガード状態0,1,2か食らい状態-1  st1でもやってる  超必,投げなら-3(バースト封じ)　それ以外-1
[state 120x,];通常状態
type = varset
triggerall = var(25) < 0
trigger1 = movetype != H
trigger1 = stateno != [120,155] 
var(25)  = -1
ignorehitpause = 1

[state 120x,];普通くらい
type = varset
triggerall = numenemy
triggerall = movetype = H
triggerall = gethitvar(guarded) = 0
trigger1 = 1;!HitShakeOver
trigger1 = enemynear,hitdefattr = sca,na,np,sa,sp
var(25)  = -2
ignorehitpause = 1

;----投げを判定できていない。HITDEFATTRは相手のHITDEFが有効でないとだめ、が、他の判断法は・・ない
;----対応キャラ＆＆CHAIIDでもできる、がnumtarget(*)使う攻撃にはできないね。
;--本体演出長い技ならだみーHITDEFでもいける
;---問題はヘルパ攻撃。こればっかりはなかなか
[state 120x,];バーストダメくらい
type = varset
triggerall = numenemy
triggerall = movetype = H
triggerall = gethitvar(guarded) = 0
trigger1 = enemynear,hitdefattr = sca,nt,st,ha,hp,ht
trigger2 = gethitvar(chainId) = 950 && var(49) = 2
var(25)  = -3
ignorehitpause = 1

;-------------------特殊チェンステ　-2部
[State -1, ded];デッドアングルアタック　ヒットスップ中でもＯＫ終わるまで待機だけどネ
type = ChangeState
value = 930
triggerall = !var(40) && power >= 1000
triggerall = statetype != A
triggerall = stateno = 150 || stateno = 152
triggerall = command = "holdfwd" 
trigger1 = command = "DAA" || command ="ALL"
ignorehitpause = 1

[State -1, ded];デッドアングルアタック　ヒットスップ中でもＯＫ終わるまで待機だけどネ
type = ChangeState
value = 935
triggerall = !var(40) && power >= 1000
triggerall = statetype != A
triggerall = stateno = 151 || stateno = 153
triggerall = command = "holdfwd" 
trigger1 = command = "DAA" || command ="ALL"
ignorehitpause = 0

