;っぱっぱ　マイナス２，３
[statedef -2]

;------------------------------デバッククリップボード--------------------
[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "psx=%f,psy=%f,vlx=%f,vly=%f,v=%d\n"
params =pos x,pos y,vel x,vel y,var(12)
ignorehitpause = 1

[state -2, displayb];剣幽霊監視
type = appendtoclipboard
trigger1 = 0;numhelper(100)
text = "V39=%d,"
params = helper(100),var(39)
ignorehitpause = 1

[state -2, displayb];剣幽霊監視
type = appendtoclipboard
trigger1 = 0;numhelper(300)
text = "V39=%d,V40=%d,V41=%d,"
params = helper(300),var(39),helper(300),var(40),helper(300),var(41)
ignorehitpause = 1

[state -2, displayb];剣幽霊監視
type = appendtoclipboard
trigger1 = 1
text = "V26=%d,V27=%d,V34=%d,V35=%d,V5=%d"
params = var(26),var(27),var(34),var(35),var(20)
ignorehitpause = 1

[state -2, displayb];ヒット関係
type = appendtoclipboard
trigger1 = 0
text = "EDX=%f,EBDX=%f,EDY=%f,EDBY=%f"
params = p2dist x,p2bodydist x,p2dist y ,p2bodydist y
ignorehitpause = 1


;----------------デバック用憑依
;---0無　１剣　２犬　３幽霊　４らおう
[State 2050,  voice];
type = varset
trigger1 = 0
var(20) = 2
ignorehitpause = 1

[State 2050,  ];命令がのこってしまうこともあるをクリア？V10 わんこの命令と同時ヒットとか・・
type = varset
trigger1 = !numhelper(100) && !numhelper(200) && !numhelper(300) && !numhelper(400) 
trigger2 = var(20) <= 0
var(10) = 0

;--------当たった時点での向きが必要になる。
;---59が1でP1gawa、－１で２P側からとする？
;--4100ごるふ　4110 鉢植え 4120ばなな
[state 1200,light];不幸もーどばななど
type = Helper
triggerall = numhelper(330)
trigger1 = helper(330),var(59) = -1
name = " BANANA LEFT"
ID = 345
pos = 0,-145 
postype = left
stateno = 4100 + random % 3 * 10
ownpal = 1
size.height = -1
supermovetime = 9999

[state 1200,light];不幸もーどばなななど
type = Helper
triggerall = numhelper(330)
trigger1 = helper(330),var(59) = 1
name = "BANANA RIGHT"
ID = 345
pos = 0,-145 
postype = right
stateno = 4100 + random % 3 * 10
ownpal = 1
size.height = 1
supermovetime = 9999

;----------------擬似CTRL　
;---着地時は2F目からかも
;----通常技許可	ダッシュ中,挑発敬意R移動  (FDも同タイミング?) 
[state -3,];
type = varset
trigger1 = stateno = 99 || (stateno = 100 && time >= 1)
trigger2 = (stateno = 102 || stateno = 107) && time >= 6
trigger3 = stateno = 900 && time >= 61
trigger4 = stateno = 910 && time >= 17
trigger5 = stateno = 52 && time > 0
trigger6 = numtarget(940)
trigger7 = (stateno = 800 || stateno = 850) && time = 1
sysvar(3) = 1
ignorehitpause = 1

;----必殺技許可	ジャンプ予備動作、相殺　着地
;---解釈？？２ふれ以内限定はジャンプキャンセル受付?すると後だしならリセットされる？有利にならない？ 
;----いるかさん横縦空ふり着地時はずっといい?
[state -3,];
type = varset
trigger1 = stateno = 40
trigger2 = stateno = 52 && time > 0
trigger3 = numtarget(940)
trigger4 = prevstateno = [1700,1730]
trigger4 = stateno = 52 
trigger5 = stateno = 1685 
sysvar(3) = 2
ignorehitpause = 1

;----0にする・・
[state -3,];
type = varset
trigger1 = stateno = [0,22]
trigger2 = stateno = 50 || stateno = 51 || stateno = 55 || stateno = 56
trigger3 = movetype = H
trigger4 = stateno = [120,3600] 
trigger4 = time <= 1
sysvar(3) = 0
ignorehitpause = 1

;--------------------実験ステートふぃーど戻し
[state 5900,v5];
type = varset
trigger1 = stateno = [0,20]
var(5) = 0
ignorehitpause = 1

;--------------------ゴールドカラーラオウ常時
[state 5900,GOLD];
type = varset
trigger1 = palno = var(42)
var(20) = 4
ignorehitpause = 1

;--------------憑依強制解除,受身中もHであるので除外しといて
;----イントロ時に抽選させない->ブリジット特殊でうまく機能していない
[state -3,];ラオウ以外
type = varset
triggerall = var(20) < 4
trigger1 = stateno != [150,155]
trigger1 = stateno != [5201,5210]
trigger1 = movetype = h
var(20) = ifelse(random % 3 = 0,-1,0) 
ignorehitpause = 1

;----これヒットスパークでやってもいいかも
;----------------------頭上ではなく、チームサイド
[state 100x,atc efe];よろければがちゃエフェクト6480	これは気絶、自分のほう基本的にないはず
type = Explod
triggerall = !numexplod(6485)
triggerall = movetype = H
trigger1 = stateno = 5300 
trigger2 = anim = 5300
anim = 6480
ID = 6485
postype = left
pos = ifelse(teamside = 2,240,80),80
sprpriority = 5
bindtime = -1
removetime = -1
ownpal=1
ignorehitpause = 1
scale = 0.5,0.5

[state 100x,atc efe];気絶がちゃエフェクト6485
type = removeExplod
trigger1 = movetype != H
trigger2 = anim != 5300
ID = 6485
ignorehitpause = 1

[state 100x,atc efe];よろければがちゃエフェクト6480
type = Explod
triggerall = numenemy
triggerall = !numexplod(6480)
trigger1 = enemynear,stateno = 5800
trigger1 = enemynear,movetype = H
trigger1 = enemynear,statetype != A
anim = 6480
ID = 6480
postype = left
pos = ifelse(teamside = 1,240,80),80
sprpriority = 5
bindtime = -1
removetime = -1
ownpal=1
ignorehitpause = 1
scale = 0.5,0.5

[state 100x,atc efe];よろければがちゃエフェクト4680  けし
type = removeExplod
triggerall = numenemy
trigger1 = enemynear,stateno != [5800,5820]
trigger2 = enemynear,ctrl 
ID = 6480
ignorehitpause = 1


;-------振り向き属性は、2JUNP後のフリーでも,airdash,HIGHJ で有効にされる、どこかにまとめたほうがいいかも
;----受身取った後にできてなくないかい？確認して
[state 2,];AIR自動振り向き  はしっこではできないと思う sv4
type = turn
triggerall = frontedgedist >= 30
triggerall = p2dist X < -1
triggerall = time >= 0
trigger1 = stateno = [50,51]
trigger1 = var(55);振り向き属性
trigger2 = stateno = 42
trigger3 = numhelper(65)
trigger3 = stateno = 132
trigger3 = var(12) && var(25) = 2
 
