trigger1 = anim = 5003
value = s2550,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3
parsistent = 0
channel = 0

[state -3,flag reset]
type = varset
trigger1 = anim != 5003
var(57) = 0

;--------KO時セリフ58
[state -3,flag reset]
type = varadd
trigger1 = alive = 0
var(58) = 1

[State -3, recove voice];一撃必殺のときは出ないようにできる？0にすると続けてなぐられたらきえるのでは？
type = PlaySnd
triggerall = var(48) != 3
