;-----------------ここから初期設定  汎用-------ブリジット・イノ以外
;-------------レバーによって移動させる、
;---->閉じたら有効とする。ので直接RV54はいじらない
;------Y0---Y1
;-X0---8
;-X1-- 0    3
;-X2-- 1    4
;-X3-- 2    5
;-X4-- 6    7
;-----X20,X21で擬似表
[state 3160,];X0表代入
type = varset
triggerall = time = 0
trigger1 = var(54) <= 2
trigger2 = var(54) = 6
trigger3 = var(54) = 8
var(20) = 0
[state 3160,];X1表代入
type = varset
triggerall = time = 0
trigger1 = var(54) = 3
trigger2 = var(54) = 4
trigger3 = var(54) = 5
trigger4 = var(54) = 7
var(20) = 1

[state 3160,];Y0表代入
type = varset
triggerall = time = 0
trigger1 = var(54) = 8
var(21) = 0
[state 3160,];Y1表代入
type = varset
triggerall = time = 0
trigger1 = var(54) = 0 
trigger2 = var(54) = 3
var(21) = 1
[state 3160,];Y2表代入
type = varset
triggerall = time = 0
trigger1 = var(54) = 1
trigger1 = var(54) = 4
var(21) = 2
[state 3160,];Y3表代入
type = varset
triggerall = time = 0
trigger1 = var(54) = 2 
trigger2 = var(54) = 5
var(21) = 3
[state 3160,];Y4表代入
type = varset
triggerall = time = 0
trigger1 = var(54) = 6 
trigger2 = var(54) = 7
var(21) = 4

;-----------------レバー動かし
;----即動かしはいや
[state 3160,];左右移動0か１  0のときは動かさない
type = varadd
triggerall = time >= 30
triggerall = var(21) > 0 
trigger1 = command = "Ba" 
var(20) = ifelse(var(20) = 0,1,-1)
[state 3160,];左右移動0か１
type = varadd
triggerall = time >= 30
triggerall = var(21) > 0 
trigger1 = command = "Fr" 
var(20) = ifelse(var(20) = 0,1,-1)

[state 3160,];上下＋  Y軸01234  0で上押すと４になる
type = varadd
triggerall = time >= 30
trigger1 = command = "Up"
var(21) = ifelse(var(21) = 0,4 ,-1)
[state 3160,];上下＋  01234  4で倒すと０になる
type = varadd
triggerall = time >= 30
trigger1 = command = "Do"
var(21) = ifelse(var(21) = 4,-4 ,1)

