;-------8020,ここから8000-8010にSチェンジ
[statedef 8020];8020ヒットスパークスタートステート  一元管理　条件にあったところへ飛ばす
type    = a
movetype= I
physics = N
ctrl = 0
anim = 6000
sprpriority = 3
velset = 0,0

[State 3660,];影をなくしておく
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state 3400,];空中の相手とかにあたるとうまくない const(size.height)をY軸の位置変数に使用します
type = posset
trigger1 = time = 0
y = parent,pos y + const(size.height)
ignorehitpause = 1

;---位置X１:相殺時	2ヘルパーに当たったとき
[state 3400,];相殺時のときのXは判定の部分 const(size.ground.front) ID940
type = posset
triggerall = anim = 6000
triggerall = parent,HITPAUSEtime
trigger1 = parent,movehit
trigger1 = parent,numtarget(940);p2movetype = A
trigger2 = parent,movehit		;ヘルパーなどにあたっているとき
trigger2 = enemynear,movetype != H
x = parent,pos x + ifelse(facing = 1,-1 * const(size.ground.front), const(size.ground.front))
ignorehitpause = 1
persistent = 1

[state 3400,];ステート格納
type = varset
trigger1 = time = 0
var(1) = parent,stateno
persistent = 0
ignorehitpause = 1

[state 3400,];相打ち時 れいこん増加テスト とりあえずこれで
type = parentvaradd
triggerall = anim = 6000
triggerall = parent,numtarget(940) = 0
trigger1 = var(1) = 1100
trigger1 = enemynear,stateno != [150,155]
trigger1 = enemynear,movetype = H;相手も被攻撃
trigger1 = parent,var(36);被攻撃
var(30) = ifelse(root,var(1) = 0 || root,var(1) = 2,1,3)
persistent = 0
ignorehitpause = 1

;----V35に攻撃HITSTOP,V36に被攻撃HITSTOP　の計測それをつかってうまくできない？
[state 3400,];相打ち時にもでるように気をつけてね	8000,8002,8010
type = changestate
triggerall = anim = 6000
triggerall = parent,numtarget(940) = 0
trigger1 = var(1) = parent,stateno
trigger1 = parent,HITPAUSEtime
trigger1 = parent,var(35);		あてた	ヘルパーあたってもOK
trigger1 = parent,movehit;ガード時はだめ
trigger2 = enemynear,movetype = H;相手も被攻撃
trigger2 = parent,var(36);被攻撃
value = const(size.head.pos.x)
persistent = 1
ignorehitpause = 1

;-----ー
[state 3400,];相殺：：REVDEFもMOVEHITになるから・・8009
type = changestate
triggerall = anim = 6000
triggerall = var(1) = parent,stateno
trigger1 = parent,numtarget(940);p2movetype = A
trigger1 = parent,var(35) = 0;parent,movehit
trigger2 = parent,var(37);parent,movehit
trigger2 = parent,hitpausetime || parent,hitshakeover = 0
value = 8009
persistent = 1
ignorehitpause = 1

[state 3400,];---ガード絵に
type = changestate
triggerall = anim = 6000
triggerall = var(1) = parent,stateno
trigger1 = parent,moveguarded
trigger1 = parent,HITPAUSEtime
value = const(size.head.pos.y)
persistent = 0
ignorehitpause = 1

[state 3400,];相殺「された」時にきえる?
type = destroyself
triggerall = 1
trigger1 = anim != 6000
trigger1 = animtime = 0
trigger2 = anim = 6000
trigger2 = time >= const(size.ground.back) 
trigger2 = parent,hitpausetime = 0
ignorehitpause = 0

[state 12, ];
type = displaytoclipboard
trigger1 = 1
text = "moveH=%d,moveG=%d,v1=%d,px=%f,t=%d\n"
params = parent,movehit, parent,moveguarded, var(1),pos x ,root,teamside
ignorehitpause = 1

[state 12, ];
type = appendtoclipboard
trigger1 = 1
text = "pposy =%f,pos=%f,v2=%d,=%d"
params = parent,pos y, pos y , const(size.ground.back),parent,numtarget(940)
ignorehitpause = 1







