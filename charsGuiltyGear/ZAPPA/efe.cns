;----------------------------------------------GG4割、一撃モードの残像
;-------------------------赤と黄色2種
;------GGライフ3分の１と同時な場合一撃モード優先、赤。
;----イントロ、ダウン中、死亡、勝利ポーズでは消えているようだ。
;---p2stateno中も消す、双子と同じくずれる
[statedef 770]
type    = a
movetype= I
physics = N
poweradd= 0
ctrl = 0
velset = 0,0
sprpriority = -2

[state 2090,];むてきとすりぬけ
type = nothitby
trigger1 = 1
value = sca
time = 1
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[State 8000x,noturn];かげなし
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[State 8000x,noturn];透明にする
type = AssertSpecial
trigger1 = roundstate != 2
trigger2 = root,alive = 0 || enemy,alive = 0
trigger3 = !selfanimexist(root,anim)   
trigger4 = root,statetype = L  
trigger5 = root,movetype = H  
trigger5 = root,stateno != [5000,5155]
trigger5 = root,stateno != [120,155]    
flag = noshadow
flag2 = invisible
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;-------------------elemも判断できるといいのだけど・・
;---投げられると落ちる
[State 3400,]
type = changeanim
triggerall = selfanimexist(root,anim)
trigger1 = root,movetype != H  
trigger2 = root,movetype = H 
trigger2 = root,stateno = [5000,5155]
trigger3 = root,movetype = H 
trigger3 = root,stateno = [120,155] 
value = root,anim
elem = root,animelemno(0)
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 2090,];コレ追加で再び半透明
type = turn
trigger1 = root,facing != facing
supermovetime = 9999
pausemovetime = 9999

[state 2090,];コレ追加で再び半透明
type = trans
trigger1 = 1
trans = add;alpha
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 2090,];
type = angledraw
trigger1 = 1
scale = time % 20 * 0.005 + 0.95,time % 20 * 0.005 + 0.98
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 2090,];
type = bindtoroot
trigger1 = 1
x = -1
y = -5
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;---------------------------赤かなりうすい、ぴんく？
