first = 0
last = 59

;---------------速度決定　
[state 3200,rend];上下のみまんなかスタートのため・
type = varset
triggerall = const(size.height) <= 1
trigger1 = time = 0
var(1) = 15

;-----------縦のは真ん中ｽﾀｰﾄっぽい？
;---2,3は0ｽﾀｰﾄ、ほかは初期値違いかも・・まあいいか
;0↓,1↑,2↓→, 3↑←, 4↑→, 5↓← 
[state 3200,rend];初速	01	
type = velset
triggerall = time = 0
trigger1 = const(size.height) <= 1
y = ifelse(const(size.height) = 0,3,-3)

[state 3200,rend];初速	2	
type = velset
triggerall = time = 0
trigger1 = const(size.height) = 2
x = -3
y = -3
[state 3200,rend];初速	3	
type = velset
triggerall = time = 0
trigger1 = const(size.height) = 3
x = 3
y = 3

[state 3200,rend];初速	4	
type = velset
triggerall = time = 0
trigger1 = const(size.height) = 4
x = 3
y = -3
[state 3200,rend];初速	5	
type = velset
triggerall = time = 0
trigger1 = const(size.height) = 5
x = -3
y = 3

[state 3200,rend]
type = velset
trigger1 = time != 0
trigger1 = !var(1); % 30 = 0
x = vel x * -1
y = vel y * -1

[state 3200,rend]
type = varset
trigger1 = 1
var(1) = ifelse(var(1) = 30,0,var(1) + 1)

;-----------------拡大縮小
[state 3200,rend]
type = angledraw
triggerall = var(1) <= 15
trigger1 = const(size.height) = 0
trigger2 = const(size.height) = 2
trigger3 = const(size.height) = 5
value = 0
scale = 0.7 + var(1) * -0.05,0.7 + var(1) * -0.05

[state 3200,rend]
type = angledraw
triggerall = var(1) > 15
trigger1 = const(size.height) = 1
trigger2 = const(size.height) = 3
trigger3 = const(size.height) = 4
value = 0
scale = 0.7 + var(1) * -0.05,0.7 + var(1) * -0.05


[state 8110,vel];
type = destroyself
trigger1 = parent,var(34) && time >= 100
trigger2 = !parent,var(34) && time >= 70

