ownpal = 1           ;ヘルパーが(PalFXなどで)本体の色が変わった時に一緒に変わるかどうか（Explodのownpalと一緒）
size.xscale = 0.9    ;ヘルパーの横のサイズ
size.yscale = 0.9    ;ヘルパーの縦のサイズ
helpertype = normal  ;ヘルパーの属性：画面スクロールの影響を受けるか否かを決める
