;---------------------------------------------------------------------------
; 勝動作 start
;-----181 スカートめくれ -----182 ヨーヨーキャッチ -----183 ヨーヨーキャッチ（相手が。
;相手が5150で自ステート0がここにくる条件、5110の時点で抽選しているはず
;---ラウンド終了で全てhitdef無効になる、ので疑似的に当たった演出を。
[Statedef 180]
type = S
;anim = 0

[state 193,];ボイス2連なので固定用
type = varset
trigger1 = time = 0
var(51) = ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3

[State 180, 1];デバック
type = ChangeState
trigger1= 0;time = 0
value = 183

[State 180, 1];一撃KOの時のみ
type = ChangeState
triggerall = numhelper(3600)
trigger1= time = 0
value = 185

;双子は除外、スプライト化け対応しきれない。170はnothitbyかかってるので余計変になるよ
;---相手情報取得のへろぱーですでにDOS<WIN,チームモード判断してるからいらないかも
;;KO勝ちしんぐるのみ相手キャッチへ行けます。
[State 180, 1];KO勝ちでないかチームモードなら相手キャッチ以外です
type = ChangeState
triggerall = !numhelper(3600) 
triggerall = numhelper(184)
trigger1= time >= 0
value = 181 + var(5);random % 3 

[State 180, 1];それ以外の勝ち方 ぶつけ以外
type = ChangeState
triggerall = !numhelper(3600) 
triggerall = !numhelper(184)
trigger1= time >= 0
value = 181 + random % 2 

[State 181, 4]
type = AssertSpecial
trigger1 = Time  <= 150
flag = RoundNotOver

