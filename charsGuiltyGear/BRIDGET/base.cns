trigger1 = time = 0
fvar(26) = 145

;-------------------------ガードバランスゲージ表示位置 1P2P Y  Default 30
[state 5900,blance 1P2PY];fvar(27) is Guard Gauge Y
type = varset
trigger1 = time = 0
fvar(27) = 30

;--------------------------------
;-------------------------バーストゲージ＋SPカラー表示位置 1P X Default  30  
[state 5900,burst x];fvar(28) is burst Gauge X
type = varset
trigger1 = time = 0
fvar(28) = 30

;-------------------------バーストゲージ＋SPカラー表示位置 1P2P Y Default 40
[state 5900,burst 1p2pY];fvar(29) is burst Gauge Y
