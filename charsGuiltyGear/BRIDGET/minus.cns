;----------------通常攻撃声 弱
[State -3, atack voice ws];はい！えい！はあ！
type = PlaySnd
triggerall =random % 2 = 0
trigger1 = stateno = 200 || stateno = 210 || stateno = 235 || stateno = 400 || stateno = 600
trigger1 = time = 3
trigger2 = (stateno = 410 || stateno = 610) && animelem = 3
value = s200,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3
channel = 0

;----------------通常攻撃 中
[State -3, atack voice lfm];楽しんでます？行きますよ　危ないですよ
type = PlaySnd
triggerall = random % 2 = 0
trigger1 = stateno = 220 || stateno = 420 || stateno = 440 || stateno = 620 || stateno = 630
trigger1 = animelemtime(2) = 1
trigger2 = stateno = 225
trigger2 = animelemtime(2) = 1
value = s201,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3
channel = 0

;----------------通常攻撃声 強
[State -3, atack voice lfs];はいまわしますよ　これ難しいんですよ　おひとつどですか？
type = PlaySnd
trigger1 = stateno = 230 && animelemtime(2) = 1
trigger2 = var(54) <= 2 || var(54) = 6
trigger2 = stateno = 240 && animelem = 3 
trigger3 = stateno = 640 && animelem = 3
trigger4 = anim = 850 && animelem = 3
value = s202,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3
channel = 0

[State -3, atack voice lfs];AC新ボイス	ダスト専用	よけないで～	
type = PlaySnd
triggerall = var(54) >= 3 && var(54) != 6
trigger1 = stateno = 240 && time = 1 
value = s240,ifelse(var(54) < 6, var(54),random % 3 + 3) + (var(54) <= 2) * 3
channel = 0


;-------------------------------------一撃必殺技準備モード時特殊パワー設定
;-----これ準備モーション中はへらさない?後半から減ってる気がする
[state 7000,];だんだんぱわーをへらすのだ 食らい中へらさない
type = varadd
triggerall = roundstate = 2
triggerall = 1;stateno != 920
triggerall = movetype != H && statetype != L 
trigger1 = var(40) = 1
trigger1 = gametime % 2 = 0
trigger1 = fvar(12) > 0
fvar(12) = -2
ignroehitpause = 0

;-----食らい中へらさない、ライフに応じて減少速度低下開始。
[state 7000,];だんだんらいふもけずるのだ -----これ準備モーション中はへらさない
type = lifeadd
triggerall = roundstate = 2
triggerall = stateno != 920
triggerall = movetype != H && statetype != L 
triggerall = var(40) = 1
trigger1 = life > 1
trigger1 = fvar(12) <= 0
trigger1 = ifelse(life > 400,1,ifelse(life > 200,gametime % 2 = 1,gametime % 3 = 1))
value = -1
kill = 1
ignroehitpause = 0

[state 7000,];ゲージ、パワーは固定である		演出上標準のゲージには０にしちゃう？
type = powerset
triggerall = roundstate = 2
trigger1 = var(40) = 1 || var(40) = -1
value = 0
ignroehitpause = 1

