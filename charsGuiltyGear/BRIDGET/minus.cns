;----------------------------ガードバランス自然回復部 17字分　１８相手
;-----同キャラのときはどうするか？自分のを使わないようにする。そのほうが正確　判定はV49が2
;めんどいけど、ヒットストップ０のときこまるかな？こもんでやる？
;-----0-255の範囲？ 食らいで減りガード中に増える
[state 7000,];くらいで減らす
type = varadd
triggerall = 0;var(49) != 2
triggerall = time = 1
triggerall = var(19) > 0
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
trigger2 = stateno = 5080 || stateno = 5070 
var(19) = -1 * ifelse(gethitvar(animtype) = 0,8,ifelse(gethitvar(animtype) = 1,7,6))
ignorehitpause = 1
persistent = 0
supermovetime = 999

;----------------これも同じくこもんでやるほうがいい？ガードのストップ０はないかな・？
[state 7000,];自分の方　相手対応キャラでなければ　ガードで増やす  注意：FD(V25=2,3)なら増やさない、他のキャラ判断不能
type = varadd
triggerall = 1
triggerall = var(49) != 2
triggerall = time = 1
triggerall = var(19) < 256
triggerall = var(25) = [0,1] 
trigger1 = stateno = 150 || stateno = 152 || stateno = 154
var(19) = ifelse(gethitvar(animtype) = 0,3,ifelse(gethitvar(animtype) = 1,8 + random % 3,14 + random % 5))
ignorehitpause = 1
persistent = 0
supermovetime = 999

[state 7000,];自分の方　いきすぎりせっと
type = varset
trigger1 = var(19) > 256
var(19) = 256
ignorehitpause = 1
supermovetime = 999

[state 7000,];自分の方　いきすぎりせっと
type = varset
trigger1 = var(19) < 0
var(19) = 0
ignorehitpause = 1
supermovetime = 999

[state 7000,];回復バランスがたまってるときに徐々にへる暗転中もへってるようである
type = varadd
triggerall = var(49) != 2
triggerall = time % 5 = 0
triggerall = var(19) > 128 
trigger1 = movetype != H
trigger2 = statetype = L
var(19) = ifelse(stateno = 5120,-2,-1)
ignorehitpause = 1
supermovetime = 999

[state 7000,];対応キャラの場合はこっちを使用しないが保険でいちおう　これが128＋64以上いかなければカウンタにならないしね
type = varset
trigger1 = var(19) <= 128 
trigger1 = movetype != H
trigger2 = var(49) = 2
var(19) = 128
ignorehitpause = 1
supermovetime = 999

