;-------------fvar(4)	受身不能時間調整
;-------------------復帰不能時間操作 ここまで長くなることは、まずないんじゃないかなと・・
;--- 受身不能時間減少 最初の3,6,10%減 9,12,18,で5%  最大60%OFF、14秒で0.6？3秒毎なのに？15秒の誤植？
[state 5900,fv4];fv4  くらい状態の長さにより復帰不能時間減少 基本乗数1
type = varset
triggerall = numenemy
trigger1 = var(44) < 60 * 3
trigger2 = enemynear,movetype != H
trigger3 = enemynear,stateno = [120,155]
fvar(4) = 1
ignorehitpause = 0

;--ダウン追い討ちなら0にするため、var(46)=0を乗算して０にする。 　最初の2回10%,あとは2秒ごとに5%なら14秒で0.6にあう
;----ページによってかいてあることが違うぞ！163P基準にする？
[state 5900,fv4];fv4 
type = varadd
trigger1 = var(44) = 60 * 3	;5%
trigger2 = var(44) = 60 * 5	;5%
trigger3 = var(44) = 60 * 7	;10%
trigger4 = var(44) = 60 * 10	;10%
trigger5 = var(44) = 60 * 14	;10%
fvar(4) = ifelse(var(44) <= 60 * 5, -0.05, -0.1)
ignorehitpause = 0

;------------fvar(5)　ヒットバック補正　
;---------------1秒以降増加開始、最大8秒
[state 5900,fv5];fv5  くらい状態の長さでX距離増加 基本乗数1
type = varset
triggerall = numenemy
trigger1 = var(44) < 60 
trigger2 = enemynear,movetype != H
trigger3 = enemynear,stateno = [120,155]
fvar(5) = 1
ignorehitpause = 0

;--数値不明、2倍になる
;----一律10％とすると倍?んー？浮きと同じようなら最初少なくて後でどかんと？
[state 5900,fv5];fv5 
type = varadd
trigger1 = var(44) = 60 * 1	;5%
trigger2 = var(44) = 60 * 2	;5%
trigger3 = var(44) = 60 * 3	;10%
trigger4 = var(44) = 60 * 4	;10%
trigger5 = var(44) = 60 * 5	;10%
trigger6 = var(44) = 60 * 6	;20%
trigger7 = var(44) = 60 * 7	;20%
trigger8 = var(44) = 60 * 8	;20%
fvar(5) = ifelse(var(44) <= 60 * 2,0.05,ifelse(var(44) >= 60 * 6,0.2, 0.1))
ignorehitpause = 0

;------------fvar(6) 浮き補正　	数値不明
;---------------------------ヒットカウント＋var(33)=ヘルパーのヒットカウント
;--------浮き補正は6HItから。35HIT以降は減らない、数値不明、これも乗算形式？
;---6-35の間、6も含むから30? 1%ずつ、最大30%OFFとしてみる?
;とりがーhitcountは(HITCOUNTPERSIST=0でリセットされると0にされる,表記はつながってるのでまぎらわしい
[state -3,];相手のヒットカウントを計算して浮き補正
type = varset
trigger1 = hitcount + var(33) >= 6
trigger1 = hitcount + var(33) < 35
fvar(6) = 1 - (hitcount + var(33) - 5) * 0.01
ignorehitpause = 1

[state -3,];浮き補正、35HIT以上固定数値  仮：最大0.7倍
type = varset
trigger1 = hitcount + var(33) >= 35
fvar(6) = 0.7  
ignorehitpause = 1

[state -3,];ヒット途切れまたは５HIT以下のとき乗数１、変化させない
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype != H
trigger2 = enemynear,stateno = [120,155]
trigger3 = hitcount + var(33) < 6
fvar(6) = 1
ignorehitpause = 0

;----------fvar(0)に係数集約する。順番的にここ
;----mug1000,GG420 であれば攻撃設定値は約2.38倍するべき？根性値考慮できないので多すぎるかも
;---たまに回復しない？
[state -3,fv0];基本1 * 基底補正2 * Gバランス補正3 *ダウン補正
type = varset
trigger1 = 1
fvar(0) = fvar(1) * fvar(2) * ifelse(!var(46),0.25,1) * 2
ignorehitpause = 0

