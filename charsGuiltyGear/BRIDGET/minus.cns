[State 1000, 7]
type = DefenceMulSet
triggerall = numenemy
trigger1 = enemynear,hitdefattr = sca,na,np,nt,sa,sp,st
value = fvar(20) * ifelse(var(49) != 2,fvar(18),1)
ignorehitpause = 1

[State 1000, 7]
