;---------------------攻撃力補正関連------------- -2に移動
;----その他各種監視関連
;----------------ロマキャンは接触したらその動作中ALL有効34
[state -3,];ロマキャン
type = varset
triggerall = numtarget
triggerall = !numtarget(940)
triggerall = MoveContact 
trigger1 = stateno = [200,640]
trigger2 = stateno = 1150 || stateno = 1200 || stateno = 1250 || stateno = 1300 || stateno = 1340 || stateno = 1360
trigger3 = stateno = 935 || stateno = 3100
var(34) = ifelse(movehit,2,1)
ignorehitpause = 1

[state -3,];相殺も一応いれておく
type = varset
triggerall = numtarget
triggerall = numtarget(940)
triggerall = MoveContact 
trigger1 = stateno = [200,640]
trigger2 = stateno = 1150 || stateno = 1200 || stateno = 1250 || stateno = 1300 || stateno = 1340 || stateno = 1360
trigger3 = stateno = 935 || stateno = 3100
var(34) = -1
ignorehitpause = 1

[state -3,];めるぶらとかのシールド
type = varset
triggerall = MoveReversed
trigger1 = stateno = [200,640]
trigger2 = stateno = 1150 || stateno = 1200 || stateno = 1250 || stateno = 1300 || stateno = 1340 || stateno = 1360
trigger3 = stateno = 935 || stateno = 3100
var(34) = -2
ignorehitpause = 1

;----34-38	はろじゃも同じNO使う、あるていど共通
;-----------------------自分が攻撃をあてたHITSTOP中のみ増えるVAR
[state -3,];相殺以外	これはHITTSTOP - 1　の値になります  ヒットかうんとにもつかいます
type = varadd
triggerall = numtarget
triggerall = !numtarget(940)
trigger1 = target,movetype != A
trigger1 = hitpausetime
var(35) = 1
ignorehitpause = 1

[state -3,];これは　HITSTOPの値になります	相打ち時はコッチだけ有効になる、GETHITが優先されるってことで
type = varadd
trigger1 = !hitshakeover
var(36) = 1
ignorehitpause = 1

;--------これは対応キャラの相殺「された」も判定できればして 大変になるよ
[state 7000,];---------------相殺用のカウンと 1HIt=15 リセットタイミングをヒットと同期
type = varadd
trigger1 = numtarget(940)
trigger1 = HITPAUSETIME
var(37) = 1
ignorehitpause = 1

[state -3,];両方リセットしてみる KSMH発射、AHMHはtime１でやると不都合そっちでやる
type = varrangeset
trigger1 = stateno = [0,52]
first = 34
last = 38
value = 0

;------------------------------自分カウンタ判定 v49=2の対応キャラ以外
;------攻撃状態と、ガードバランスV19
[state 5900,v43];43　攻撃中だったかもしくはガードバランスがたまっている(対応キャラ以外
type = varset
triggerall = var(49) < 2
triggerall = movetype != h
trigger1 = movetype = A
trigger2 = var(19) >= 128 + 64
var(43) = 1
ignorehitpause = 1

[state 5900,v43];43　HITPAUSE中は変えない。
type = varset
triggerall = movetype != H 
trigger1 = movetype != A
trigger1 = var(19) < 128 + 64
trigger2 = statetype = L
trigger3 = var(49) = 2
var(43) = 0
ignorehitpause = 0

;--------------------------------enemynearの状態監視主にHITDEFとよろけなどの判定に
;----------------------仕様変更にともないmovetype＝A判定ぐらいしかつかわないかも
[state 5900,v46];44  くらい状態の長さをはかる	復帰不能時間減少に使う10秒ごとに減り始める？600F　
type = varadd
triggerall = numenemy
trigger1 = enemynear,movetype = H
trigger1 = enemynear,stateno != 150
trigger1 = enemynear,stateno != 152
trigger1 = enemynear,stateno != 154
var(44) = 1
ignorehitpause = 0

[state 5900,v46];44  くらいい状態の長さリセット　
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype != H
trigger2 = enemynear,stateno = 150
trigger3 = enemynear,stateno = 152
trigger4 = enemynear,stateno = 154
var(44) = 0
ignorehitpause = 1

[state 5900,v45];45　しゃがみ状態 HITPAUSE中でも変える  HITDEFで必要
type = varset
triggerall = numenemy
trigger1 = 1
var(45) = ifelse(enemynear,statetype = C,1,0)
ignorehitpause = 1

[state 5900,v46];46　ダウン状態	HITPAUSE中でも変えて ダウン時復帰不能時間計算に必要Lなら0
type = varset
triggerall = numenemy
trigger1 = 1
var(46) = ifelse(enemynear,statetype = L,0,1)
ignorehitpause = 1

[state 5900,v47];47　カウンター判定、ダウン、、GバランスがたまっていないではカウンタにならないHITPAUSE中は変えない。
type = varset
triggerall = numenemy
trigger1 = !HITPAUSETIME
trigger1 = var(18) <= 128 + 64
trigger1 = enemynear,movetype != A
trigger2 = enemynear,statetype = L
var(47) = 0
ignorehitpause = 1

[state 5900,v47];47　カウンター判定、厳密には判定できないので相手が攻撃ステートなら、にする	HITPAUSE中は変えない。
type = varset
triggerall = numenemy
triggerall = enemynear,statetype != L
trigger1 = enemynear,movetype = A
trigger2 = var(18) > 128 + 64
var(47) = 1

[state 3400,];カウンター音とか	HITPAUSEちゅうにでればいいからd、最初に出る必要は無い最初は相手の判断できない
type = playsnd
triggerall = var(47)
triggerall = numtarget
triggerall = !numtarget(940)
triggerall = target,stateno != [150,155]
trigger1 = HITPAUSETIME
trigger1 = stateno != 800 && stateno != 850
trigger2 = movetype = H
trigger2 = target,movetype = H
trigger2 = var(36)
value = s60,11
channel = 11
ignorehitpause = 1


;-----以下-----------------------------------------
;----補正関連なのでここに置く
;---本体のヒットカウントはHITCOUNTで取れる、HITDEFPERSISTを通常状態にもつけること！
[state -3,];ヒットカウント強制クリア　
type = hitadd
triggerall = numenemy
triggerall = hitcount != 0
trigger1 = enemynear,movetype = I
trigger2 = enemynear,movetype = A
trigger3 = enemynear,stateno = [150,155] 
value = hitcount * -1 
ignorehitpause = 0

;-----------------ヘルパーのヒットカウントV33を0クリア
[state -3,];ヒットカウント強制クリア　
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype = I
trigger2 = enemynear,movetype = A
trigger3 = enemynear,stateno = [150,155] 
var(33) = 0 
ignorehitpause = 0

;-------ダメージ補正は　1:がーどばらんす	攻撃側で設定可能
;-------		2:基底			攻撃側で設定可能
;---------------	3:ダウン追い討ち	攻撃側で設定可能
;---------------	4:根性値		防御側でやったほうがいいかも

;--------------------fvar(1) 各種基底だめーじ補正
;--------------対応技でセットする。ここではリセットのみ
[state -3,fv1];基底ダメージ補正係数リセット　相手が被くらいでなくなったら。
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype != H
trigger2 = enemynear,stateno = [150,155]
fvar(1) = 1
ignorehitpause = 1

;------------------Fv2------------ガードバランス　通常・必殺技用補正-------------
;----------------------fV3-----ガードバランス　覚醒技用補正--------
;-------------この数値はSLASHばーじょん、ACではまたちがうようである・・ころころと
[state -3,fv2re];ガードバランスによる補正 V18で考慮 本来は防御をいじるべきだけど、defencemulでは不可能であろう
type = varrangeset
trigger1 = var(18) >= 128 - 16  
fvalue  = 1
first = 2
last = 3
ignorehitpause = 1

;-----75%より下ダメージが補正減少になる　　通常と覚醒で違う部分
;---基本通常技の補正分が入ってるので打ち消す計算をする。
;---覚醒技HITDEF.damege =  var(0) / fvar(2) * fvar(3) * 攻撃値 とやる
;-----75%以上では常時カウンター扱いで100％くらい
;--ACではまた変更はいってるようである、めんどい
;-----こっち通常用
[state -3,fv2re];-16・・78%
type = varset
trigger1 = var(18) = [101,116] 
fvar(2) = 0.78
ignorehitpause = 1

[state -3,fv2re];-32・・59%
type = varset
trigger1 = var(18) = [84,100] 
fvar(2) = 0.59
ignorehitpause = 1

[state -3,fv2re];-48・・44%o
type = varset
trigger1 = var(18) = [67,83] 
fvar(2) = 0.44
ignorehitpause = 1

[state -3,fv2re];-64・・31% 33%
type = varset
trigger1 = var(18) = [50,66] 
fvar(2) = ifelse(var(1) >= 4,0.33,0.31)
ignorehitpause = 1

[state -3,fv2re];-80・・18%
type = varset
trigger1 = var(18) = [33,49] 
fvar(2) = 0.18
ignorehitpause = 1

[state -3,fv2re];-96・・12% 14%?
type = varset
trigger1 = var(18) = [50,66] 
fvar(2) = ifelse(var(1) >= 4,0.14,0.12)
ignorehitpause = 1

[state -3,fv2re];-112  6% 8%
type = varset
trigger1 = var(18) = [16,32] 
fvar(2) = ifelse(var(1) >= 4,0.08,0.06)
ignorehitpause = 1

[state -3,fv2re];くらいすぎてると3% 6%
type = varset
trigger1 = var(18) = [0,15]  
fvar(2) = ifelse(var(1) >= 4,0.06,0.03)
ignorehitpause = 1

