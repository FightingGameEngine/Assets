helpertype = normal
name = "voice select"
ID = 175
pos = 40,-180
postype = back
stateno = 9010
keyctrl = 1
ownpal = 1

[state 7000,test];一度けす？
type = removeExplod
triggerall = numhelper(175)
triggerall = helper(175),stateno = 9015
triggerall = helper(175),time >= 30
trigger1 = command = "P" || command = "K"
trigger2 = command = "S" || command = "HS"
trigger3 = command = "D" || command = "ALL"
trigger4 = command = "start" 
ID = 6050 
ignorehitpause = 0

[state 7000,test];ボイスタイプ・・表示は画面右上右下、普通スコアがでるところ？これはちむ表示対応いいや・・
type = Explod
triggerall = numhelper(175)
trigger1 = helper(175),stateno = 9020
trigger1 = !numexplod(6050)
anim = 7200 + var(54)
ID = 6050
postype = left
pos = ceil(ifelse(teamside = 1,50,255)),10 
sprpriority = 4
bindtime = -1
removetime = 300
ownpal=1
facing = 1
scale = 0.5,0.5
ignorehitpause = 1


