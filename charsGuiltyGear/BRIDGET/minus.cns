triggerall = 0;!numhelper(115)
triggerall = numhelper(100)
triggerall = helper(100),stateno = 1600
trigger1 = numprojID(1600) = 0
name = "stage edge"
ID = 115
pos = 0,0
postype = p1
stateno = 730
ownpal = 1
supermovetime = 999

;------これ保留にする
[state -2,helper partner];----GGモード瀕死時　黄色い残像 128が32以下でなる 1000なら250  height1なら赤2なら黄色
type = Helper
triggerall = !NumHelper(70)
trigger1 = var(40) = 1 
trigger2 = var(2) = 1 && life <= 250 
name = "after image"
ID = 70
pos = 0,0
postype = p1
stateno = 770
ownpal = 1
size.height = 2
size.xscale = 0.5
size.yscale = 0.5

;--------------------------ダスト字背景赤くする31Fから
;--------HITSTOP中も計測している可能性あり、V12じゃだめかも？
;---50,55はFD
[state -2,helper partner];----マイナスでやる
type = Helper
triggerall = !NumHelper(60)
trigger1 = var(12) = 30
name = "Dust Red BG"
ID = 60
pos = 0,0
postype = p1
stateno = 780
ownpal = 1
persistent = 0

;--------------これでぃじーのときは出さないように。まほうじんが一瞬でも消える、、特殊イントロ固定だから問題ない、がうまくいかない
[state -2,helper partner];----イントロ踏み解放用ヘルパー
type = Helper
triggerall = numenemy
;triggerall = NumHelper(192) = 0
triggerall = var(50) != 10  
triggerall = stateno = 0
triggerall = roundstate = 2
triggerall = p2stateno = 0
trigger1 = TeamMode = Simul = 0 && enemy,teammode = simul = 0
name = "intro end"
ID = 192
pos = 0,0
postype = p2
stateno = 6020
ownpal = 1

;----------一撃必殺以外、双子システム以外、
;----シングルのみ 勝利でタイムオーバー以外　まあ普通死んだを判断してるから問題ない？
;---F1やろじゃでやったときずれるかも
[state -2,helper partner];----勝利イントロ用相手dist情報消失対策　2800,defenceで
type = Helper
triggerall = numenemy
triggerall = !NumHelper(184) 
triggerall = enemy,alive = 0
triggerall = win = WinKO || win = WinPerfect
triggerall = win != Wintime
triggerall = var(49) != 1 && !var(52)
triggerall = p2stateno = 5110
trigger1 = TeamMode = Simul = 0 && enemy,teammode = simul = 0
name = "win intro state"
ID =184
pos = 0,0
postype = p2
stateno = 2800
ownpal = 1

;----------------------------------------ボイス・効果音-2部（ガードとかは-2っぽい
;--------気絶アニメ指定時セリフ56
[state -3,flag reset];タイムオー場時はでないよ
type = varadd
triggerall = stateno != 170
trigger1 = anim = 5300
var(56) = 1

[State -3, recove voice]
type = PlaySnd
triggerall = alive 
trigger1 = var(56) = 1
trigger1 = anim = 5300
value = s5300,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3
parsistent = 0
channel = 0

[state -3,flag reset]
type = varset
trigger1 = anim != 5300
var(56) = 0

;--------よろけアニメ指定時セリフ57 が１になったとき1回だけでる
[state -3,flag reset]
type = varadd
trigger1 = anim = 5003
var(57) = 1

[State -3, recove voice]
type = PlaySnd
triggerall = alive 
trigger1 = var(57) = 1
trigger1 = anim = 5003
value = s2550,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3
parsistent = 0
channel = 0

[state -3,flag reset]
type = varset
trigger1 = anim != 5003
var(57) = 0

;--------KO時セリフ58
[state -3,flag reset]
type = varadd
trigger1 = alive = 0
var(58) = 1

[State -3, recove voice];一撃必殺のときは出ないようにできる？0にすると続けてなぐられたらきえるのでは？
type = PlaySnd
triggerall = stateno != [5660,5680]
trigger1 = alive = 0
trigger1 = var(58) = 1
value = s5140,ifelse(var(54) < 6, var(54),ifelse(var(54) = 8,random % 6,random % 3)) + (var(54) = 7) * 3 + random % 2 * 10
parsistent = 0
channel = 10

[state -3,flag reset]
type = varset
trigger1 = alive = 1
var(58) = 0

