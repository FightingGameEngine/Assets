triggerall = !numhelper(110)
trigger1 = 0;helper(100),stateno = 1610
name = "Solitude Strings"
ID = 110
pos = 0,0
postype = p1
stateno = 710
ownpal = 1
supermovetime = 999

[state 1510,helper partner];----画面はし判定用
