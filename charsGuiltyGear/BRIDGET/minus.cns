;ブリジットとヨーヨー　マイナス２，３

[statedef -2]

;------------------------------デバッククリップボード--------------------
[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "psx=%f,psy=%f,vlx=%f,vly=%f,48=%d\n"
params =pos x,pos y,vel x,vel y,numhelper(1)
ignorehitpause = 1

[state -2, displayb];tesut
type = appendtoclipboard
trigger1 = 1
text = "v39=%d,v53=%d\n"
params = var(39),var(53)
ignorehitpause = 1

[state -2, displayb];R移動
type = appendtoclipboard
trigger1 = 0;numhelper(100)
text = "YYRD1=%f,YYRDY=%f,YYPX=%f,YYPY=%f,Y=%f"
params = helper(100),rootdist x,helper(100),rootdist y,helper(100),pos x,helper(100),pos y,fvar(15)
ignorehitpause = 1

[state -2, displayb];SB関連
type = appendtoclipboard
trigger1 = 0
text = "f21=%f,f22=%f,f23=%f,v22=%d.v25=%d"
params = fvar(21),fvar(22),fvar(23),var(22),var(25)
ignorehitpause = 1

[state -2, displayb];ヒット関係
type = appendtoclipboard
trigger1 = 0
text = "34=%d,v35=%d,v36=%d,37=%d.38=%d"
params = var(34),var(35),var(36),var(37),var(38)
ignorehitpause = 1

[state -2, displayb];ダスト
type = appendtoclipboard
triggerall = numenemy
trigger1 = 0
text = "SV0=%d,v28=%d,v!2=%d,dix=%f.diY=%f"
params = enemynear,sysvar(0),var(28),var(12),p2dist x,p2dist y
ignorehitpause = 1

;------------------------超特殊、メンテ悲劇	子爆発本体から呼び出させる
;----------てきどないちずれはヘルパ側でやらせればいい？
[state 3250,helper detective];-爆発おこして実際に攻撃判定もつへるぱ 39F以降 ランダム一
type = Helper
triggerall = numhelper(3200)
triggerall = helper(3200),stateno = 2400
trigger1 = var(0) = 3200
name = "Mente Tragedy Little Bomb"
ID = 3250
pos = ceil((helper(3200),rootdist x) * -1) * ifelse(helper(3200),facing != facing,-1,1),ceil(helper(3200),rootdist y * -1)
postype = p1
stateno = 2410
ownpal = 1
size.xscale = 0.5
size.yscale = 0.5

;------------------------超特殊、メンテ笑劇	子爆発本体から呼び出させる
[state 1200,light];実際の爆発攻撃PADDするへるぱ
type = Helper
triggerall = numhelper(3400)
triggerall = helper(3400),stateno = 2460
trigger1 = var(0) = 3400
name = "Mente Farce Little Bomb"
ID = 3450
pos = ceil((helper(3400),rootdist x) * -1) * ifelse(helper(3400),facing != facing,-1,1),ceil(helper(3400),rootdist y * -1) 
postype = p1
stateno = 2470
ownpal = 1
size.xscale = 0.5
size.yscale = 0.5
ignorehitpause = 1

[state 5900,];子爆発りせっ
type = varset
trigger1 = var(0)
var(0) = 0 
ignorehitpause = 1

;------------------------笑劇強制移動
;----相手がしんでたらやめとく
[state 7000,];--------キャッチ成功、またはガード,
type = changestate
triggerall = numenemy
triggerall = enemy,alive
triggerall = numhelper(3400)
triggerall = helper(3400),rootdist x = [-20,20]
triggerall = helper(3400),pos y > -55;-55
triggerall = helper(3400),stateno = 2450
triggerall = stateno != [3410,3450]
triggerall = statetype != A && statetype != L
trigger1 = stateno = [0,20]
trigger2 = movecontact
trigger3 = stateno = 130 || stateno = 131
value = 3410

[state 7000,];--------キャッチ失敗１、頭にあたる
type = changestate
triggerall = numenemy
triggerall = enemy,alive
triggerall = numhelper(3400)
triggerall = helper(3400),rootdist x = [-20,20]
triggerall = helper(3400),pos y > -55;-55
triggerall = helper(3400),stateno = 2450
triggerall = stateno != [3410,3450]
triggerall = statetype != A && statetype != L
trigger1 = stateno != [0,20]
value = 3420

;----これヒットスパークでやってもいいかも
;----------------------頭上ではなく、チームサイド
;---この子特殊、墜落はそっちで、Idもかえよ
[state 100x,atc efe];よろければがちゃエフェクト6480	これは気絶、自分のほう基本的にないはず
type = Explod
triggerall = !numexplod(6485)
triggerall = movetype = H
triggerall = stateno != [1150,1170]
trigger1 = stateno = 5300 
trigger2 = anim = 5300
anim = 6480
ID = 6485
postype = left
pos = ifelse(teamside = 2,240,80),80
sprpriority = 5
bindtime = -1
removetime = -1
ownpal=1
ignorehitpause = 1
scale = 0.5,0.5

[state 100x,atc efe];気絶がちゃエフェクト6485墜落以外ね
type = removeExplod
trigger1 = movetype != H
trigger2 = anim != 5300
ID = 6485
ignorehitpause = 1

[state 100x,atc efe];墜落	気絶がちゃエフェクト6485墜落以外ね
type = removeExplod
trigger1 = stateno != [1150,1170]
ID = 6486
ignorehitpause = 1

[state 100x,atc efe];よろければがちゃエフェクト6480
type = Explod
triggerall = numenemy
triggerall = !numexplod(6480)
trigger1 = enemynear,stateno = 5800
trigger1 = enemynear,movetype = H
trigger1 = enemynear,statetype != A
anim = 6480
ID = 6480
postype = left
pos = ifelse(teamside = 1,240,80),80
sprpriority = 5
bindtime = -1
removetime = -1
ownpal=1
ignorehitpause = 1
scale = 0.5,0.5

[state 100x,atc efe];よろければがちゃエフェクト4680  けし
type = removeExplod
triggerall = numenemy
trigger1 = enemynear,stateno != [5800,5820]
trigger2 = enemynear,ctrl 
ID = 6480
ignorehitpause = 1

;-------振り向き属性は、2JUNP後のフリーでも,airdash,HIGHJ で有効にされる、どこかにまとめたほうがいいかも
;---time0実行されない
[state 2,];AIR自動振り向き  はしっこではできないと思う sv4
type = turn
triggerall = frontedgedist >= 30
triggerall = p2dist X < -1
triggerall = time >= 0
trigger1 = stateno = [50,51]
trigger1 = sysvar(4);振り向き属性
trigger2 = stateno = 42
trigger3 = numhelper(65)
trigger3 = stateno = 132
trigger3 = var(12) && var(25) = 2


;-------------------ヨーヨーフラグ　リセットためろじゃなどで回収した場合用
[state 7000,debu2]
type = varset
trigger1 = !numhelper(100)
var(10) = 0
ignorehitpause = 1



;-------------ブラックカラーてんしょんMAX,あと一撃ゲージもへらないようだ
[state 7000,debu2]
type = powerset
triggerall = !var(40)
trigger1 = palno = var(41)
value = 2000
ignorehitpause = 1

[state 7000,debu2];一撃ゲージは100％なので1000でいい20から12にへんこ
type =varset
triggerall = var(40) = 1
trigger1 = palno = var(41)
fvar(12) = 1000
ignorehitpause = 1

;----------------------しゃがみ幅ふやし
[State 10, 2]
type = width
triggerall = statetype = C
trigger1 = stateno != 40 
player = 1,0
ignorehitpause = 1

;-------------------------アフターイメージ関連　ハイジャンプ(透明) 一撃準備(赤）GGモード瀕死（黄）
[State 200,];大、ほーみんぐ残像を消す
type = AfterImageTime
trigger1 = stateno = 52
trigger2 = movetype = H
time = 0
ignorehitpause = 1

;---------------STARSHIPのみかもしれないロマキャン、食らいなどでのエフェクトけし　他はへるぱ
[state 1100x,]
type = removeexplod
trigger1 = movetype != A
ID = 200
ignorehitpause = 1

;----------------擬似CTRL　-2に移動
;----通常技許可	ダッシュ中,挑発敬意R移動  (FDも同タイミング?)
[state -3,];
type = varset
trigger1 = stateno = 99 || (stateno = 100 && time >= 1)
trigger2 = (stateno = 102 || stateno = 107) && time >= 6
trigger3 = stateno = 900 && time >= 61
trigger4 = stateno = 910 && time >= 17
trigger2 = prevstateno != [950,961]
trigger5 = stateno = 52 && time > 0
trigger6 = numtarget(940)
trigger7 = prevstateno = [950,961]
trigger7 = stateno = 52 && time >= 1
trigger8 = stateno = 1100 && time >= 1
trigger9 = (stateno = 800 || stateno = 850) && time = 1
trigger10 = stateno = 1110 && time >= 1
sysvar(3) = 1
ignorehitpause = 1

;----必殺技許可	ジャンプ予備動作、相殺　着地
;---解釈ミス。２ふれ以内限定はジャンプキャンセル受付かも commonにもかかないとtime0でセットされない
;----いるかさん横縦空ふり着地時はずっといい?
[state -3,];
type = varset
trigger1 = stateno = 40
trigger2 = stateno = 52 && time > 0
trigger3 = numtarget(940)
sysvar(3) = 2
ignorehitpause = 1

;----0にする・・
[state -3,];
type = varset
trigger1 = stateno = [0,22]
trigger2 = stateno = 50 || stateno = 51 || stateno = 55 
trigger3 = stateno = [120,3600] 
trigger3 = time <= 1
trigger4 = movetype = H
sysvar(3) = 0
ignorehitpause = 1

;--------------------------------------特殊ガード関連
;---------------------------------------------------------------------------------------------
;FDパワー減少HITPAUSE中のはガードステートにうつす

;---------常時でいい？回復になる、正確には
;---気をつけないとしなくても回復するからー
[state 120x,]
type = lifeset
triggerall = stateno = 150 || stateno = 152 || stateno = 154
trigger1 = var(25) = 2 && power > 0 && !var(40)
trigger2 = var(25) = 3
value  = var(21)
ignorehitpause = 1

[state 120x,];ライフ格納 SBのときも気をつけるS+HSはいっててもね。あとこれじゃだめ、FD状態の確認がない FDかSB以外
type = varset
triggerall = 1;
trigger1 = 1;var(25) != 2 && var(25) != 3
var(21)  = life
ignorehitpause = 0

;------------v23----直前ガード30　で8FOK---------受付はHITSTOP中OK,なので早くやりすぎると失敗するわけね--------------------------
;---------------22-30の間にガードにいければ、成功
[state 120x,]
type = varadd
triggerall = var(23) > 0
trigger1 = 1
var(23)  = -1
ignorehitpause = 1

[state 120x,]
type = varset
triggerall = var(23) <= 0
trigger1 = 1
var(23)  = 0
ignorehitpause = 1

;-------------------------------v25を1にする	これ保険。
[state 120x,]
type = varset
triggerall = var(23) <= 22
trigger1 = var(25) = 1
var(23)  = 0
ignorehitpause = 1

;--------------------ここからSB
;-------------SB起き上がり１０F不能フラグ  fv21  これは5120あたりでやって
[state 120x,]
type = varadd
triggerall = fvar(21) > 0
trigger1 = 1
fvar(21)  = -1
ignorehitpause = 1

[state 120x,]
type = varset
triggerall = fvar(21) <= 0
trigger1 = 1
fvar(21)  = 0
ignorehitpause = 1

;------------------------sb	fv22ガード不能時間減少
[state 120x,]
type = varadd
triggerall = fvar(22) > 0
trigger1 = 1
fvar(22)  = -1
ignorehitpause = 0

[state 120x,]
type = varset
triggerall = fvar(22) <= 0
trigger1 = 1
fvar(22)  = 0
ignorehitpause = 0

;------------------------sb	FV23受付フレーム増加カウンター
[state 120x,]
type = varadd
triggerall = fvar(23) > 0
trigger1 = 1
fvar(23)  = -1
ignorehitpause = 0

[state 120x,]
type = varset
triggerall = fvar(23) <= 0
trigger1 = 1
fvar(23)  = 0
ignorehitpause = 0

;---------------SB,ガードフラグ解除
[state 120x,]
type = varset
triggerall = var(25) = 3
triggerall = fvar(22) > 0
trigger1 = fvar(23) = 0 && fvar(22) <= 28 
trigger2 = fvar(23) > 0 && fvar(22) <= 26 
var(25) = 0
ignorehitpause = 0

;-----このフラグはレバー後ろでシステムガード不能になる。
;---手動で（FDなど）直接１３０に送り込み、そこであたるとガードになる。
;----この間FDも出せないのでそのように設定すればOK
;---ガードノックバックでの連打の関係でどうしようか
[State 3660,];SB後遺症　30Fまたは１５Fガード不能になる　－＞FDも？
type = AssertSpecial
triggerall = !var(1) || var(1) = 4
triggerall = fvar(22) > 0
trigger1 = fvar(23) = 0 && fvar(22) <= 28 
trigger2 = fvar(23) > 0 && fvar(22) <= 26 
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1

;---------V25　ガード状態0,1,2か食らい状態-1  st1でもやってる  超必,投げなら-3(バースト封じ)　それ以外-1
[state 120x,];通常状態
type = varset
triggerall = var(25) < 0
trigger1 = movetype != H
trigger1 = stateno != [120,155] 
var(25)  = -1
ignorehitpause = 1

[state 120x,];普通くらい
type = varset
triggerall = numenemy
triggerall = movetype = H
triggerall = gethitvar(guarded) = 0
trigger1 = 1;!HitShakeOver
trigger1 = enemynear,hitdefattr = sca,na,np,sa,sp
var(25)  = -2
ignorehitpause = 1

;----投げを判定できていない。HITDEFATTRは相手のHITDEFが有効でないとだめ、が、他の判断法は・・ない
;----対応キャラ＆＆CHAIIDでもできる、がnumtarget(*)使う攻撃にはできないね。
;--本体演出長い技ならだみーHITDEFでもいける
;---問題はヘルパ攻撃。こればっかりはなかなか
[state 120x,];バーストダメくらい
type = varset
triggerall = numenemy
triggerall = movetype = H
triggerall = gethitvar(guarded) = 0
trigger1 = enemynear,hitdefattr = sca,nt,st,ha,hp,ht
trigger2 = gethitvar(chainId) = 950 && var(49) = 2
var(25)  = -3
ignorehitpause = 1

;-------------------特殊チェンステ　-2部
[State -1, ded];デッドアングルアタック　ヒットスップ中でもＯＫ終わるまで待機だけどネ
type = ChangeState
value = 930
triggerall = !var(40) && power >= 1000
triggerall = statetype != A
triggerall = stateno = 150 || stateno = 152
triggerall = command = "holdfwd" 
trigger1 = command = "DAA" || command ="ALL"
ignorehitpause = 1

[State -1, ded];デッドアングルアタック　ヒットスップ中でもＯＫ終わるまで待機だけどネ
type = ChangeState
value = 935
triggerall = !var(40) && power >= 1000
triggerall = statetype != A
triggerall = stateno = 151 || stateno = 153
triggerall = command = "holdfwd" 
trigger1 = command = "DAA" || command ="ALL"
ignorehitpause = 0

;-------------------------------------------------------------イントロ/演出/残像へるぱー
[state 1510,helper partner];----ヨーヨーの糸 Id = 110	st710-715
