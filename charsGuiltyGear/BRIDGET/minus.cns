triggerall = numenemy && !numpartner
trigger1 = !numexplod(6000)
trigger1 = roundstate >= 2 || (Roundstate <= 1 && (stateno != 5900 || (stateno = 5900 && time >= 1))) 
anim = 6000 + var(1)
ID = 6000
postype = left
pos = ifelse(teamside = 1,10,310),230 
sprpriority = 3
bindtime = -1
removetime = -1
ownpal = 1
facing = 1
scale = 0.5,0.5
