;----最大が8HTIなだけで、判定自体はもっと多い回数でているよ
;-----相殺が割り込むから、やりづらいね  2HIT目で一旦V35を０クリアしてみる？
;----V35カウンタで何発めか判断でき・・ないかも途中からあたるとめちゃくちゃだー 14+5+5～
;---端でやると下がる、注意
;--覚醒は通常Gバランスの分除算して消してから覚醒用を乗算
[State 3100, 1];1～7はLV5,　1hit目は特殊、ひきよせになる6or9 9dot  AX3,Ay6
type = HitDef
triggerall = 1
triggerall = !var(35) 
trigger1 = animelem = 6 || animelem = 9
attr = S, HA                   
damage = ceil(fvar(0) / fvar(2) * fvar(3) * 20) ,1                           
guardflag = M                  
hitflag = MAFD                  
priority = 7,hit           
animtype = hard 
ground.type = high
air.type = low            
pausetime = 15, 15 + var(47) * 12              
guard.pausetime = 15, 15    
hitsound   = s205, 3
guardsound = s150, 4         
ground.slidetime = 19 + var(45)
ground.hittime  = 19 + var(45)
guard.hittime  = 18	
guard.slidetime  = 18
airguard.ctrltime = 19    
ground.velocity = 4.5 * fvar(5) ;戻しの場合減るべき?保留
air.velocity = 1.5 * fvar(5), -3 * fvar(6)
down.velocity = ifelse(var(2) = 2,-3,-8) * fvar(5),ifelse(var(2) = 2,-2,-2.5) * fvar(6)
guard.velocity = 4.5
airguard.velocity = 2, -3  
yaccel = 0.5      
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (18 + 18 * var(47) ) * var(46) * fvar(4) ) + 15 + 12 * var(47) + (!var(46)) * 7
getpower = 0,0
palfx.time = var(47) * 5
palfx.add = var(47) * 255,var(47) * -130, var(47) * -108
ground.cornerpush.veloff = -5
air.cornerpush.veloff    = -5
guard.cornerpush.veloff  = -5
airguard.cornerpush.veloff= -5
ID=3100

