;---------------ループザループ---
;-----ロマキャンはここで設定させるといい
;-----elemで　最初の１HIT目は6o9どちらか片方
[statedef 3100];----くるくる回して…
type    = S
movetype= A
physics = n
poweradd= 0
ctrl = 0
anim =3100
sprpriority = 0
hitcountpersist = 1
velset = ifelse(prevstateno < 99,0,vel x ),0 

[State 99,];1.05%?=0.105
type = Velmul
trigger1 = vel x > 0
x = 1 - 0.105

[state 7000,];---------------ロジャぺち　リセット
type = varset
trigger1 = time = 0
var(31) = 0
persistent = 0
ignorehitpause = 1

[state 7000,];---------------ロマキャンフラグリセット　ガトリング経由時time=0でやるための
type = varrangeset
trigger1 = time = 0
first = 34
last = 39
value = 0
persistent = 0
ignorehitpause = 1

