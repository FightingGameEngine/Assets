;------------distでやるなら。Ｒ移動とある程度同じ。
;acos(X / (X*X+Y*Y))   -> /pi*180
;----ＹＹより↑でー（-50？）下で＋　（-50）　+YY貼りつけでずらす5
[State var]
type = varset
triggerall = numhelper(100)
trigger1 =  time = 0
fvar(4) = helper(100),rootdist x

[State var]
type = varset
triggerall = numhelper(100)
trigger1 =  time = 0
fvar(5) = helper(100),rootdist y 

;^-----新
;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = ABS(rootdist y) != 0
triggerall = ABS(rootdist x) != 0
trigger1 = time = 0
fvar(22) = ifelse(ABS(rootdist x) > ABS(rootdist y),rootdist x / 20,rootdist y / 20)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = time = 0
trigger1 = rootdist y = 0
trigger2 = rootdist x = 0
trigger3 = rootdist x = rootdist y
fvar(22) = 0
ignorehitpause = 1

;----------------------基本移動量＝?
[state 8150,5];-217,90 
type = velset
triggerall = fvar(22);0でないなら比計算されてるはず
trigger1 = time = 0
x = ABS(rootdist x / 20) * ifelse(rootdist x < 0,-1,1)
y = ABS(rootdist y / 20) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time = 0
trigger1 = rootdist y = 0
trigger2 = rootdist x = 0
x = ifelse(rootdist x = 0,0,rootdist x / 20) * ifelse(rootdist x < 0,-1,1)
y = ifelse(rootdist y = 0,0,rootdist y / 20) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];同じ値で90.90　ともに0じゃない時（0除算　
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time = 0
trigger1 = rootdist x = rootdist y
trigger1 = rootdist x != 0 && rootdist y != 0
x = ABS(rootdist x / 20) * ifelse(rootdist x < 0,-1,1);
y = ABS(rootdist y / 20) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time = 0
trigger1 = rootdist x = rootdist y
trigger1 = rootdist x = 0 && rootdist y = 0
x = 0
y = 0
ignorehitpause = 1

[state 8150,5];強制停止
type = velset
trigger1 = time >= 5
trigger1 = random % 4 = 1 
x = 0
y = 0
ignorehitpause = 1

[state 8300,]
type = destroyself
trigger1 = !numhelper(100)
trigger2 = numhelper(100)
trigger2 = helper(100),stateno = [1640,2190]

