;-----------------GGエフェクト,ガード
;DOSで使えないもの多用の関係で全てまとめる？　
;trance,inguraddist,moverever
;--固有----700YOYO火花--710糸 720ハグ 
;-共通OK--750FDｴﾌｪ 760ろまCｴﾌｪ 770-赤黄色残像ヘルパ 780-ダスト赤背景--790 SPリング背景ｴﾌｪ
;--共通--8000ヒットスパーク関連（HEるぱ



;-------------------------------ヨーヨ戻し時の火花
[statedef 700];
type    = A
movetype= i
physics = N
ctrl = 0
velset = 0,0
sprpriority = 4
anim = 6000

[state 2090,]
type = bindtoparent
trigger1 = numhelper(100)
time = 1
pos  = 0,-52
ignorehitpause = 1

[state 2090,]
type = angleadd
trigger1 = anim = 1650
value = 10

[state 2090,];これやると半透明無効
type = angledraw
trigger1 = anim = 1650

[state 2090,];コレ追加で再び半透明
type = trans
trigger1 = anim = 1650
trans = add

[State 3660,]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

;----火花はぜったいでるっぽい
[state 2090,];タメ版のときの小さい火花、これないから作って？
type = Explod
triggerall = !numexplod(115)
triggerall = numhelper(100)
triggerall = root,var(1) = 0 || root,var(1) = 3 || root,var(1) = 4
trigger1 = parent,anim = 1610 || parent,anim = 1620
trigger1 = parent,animelemtime(2) < 0
trigger2 = parent,stateno = 1620
anim = 1640
ID = 115
pos = 0,0
postype = p1
sprpriority = 3
bindtime = -1
removetime = -1;114
ownpal=1
scale = 0.5,0.5
ignorehitpause = 1

[state 2090,];タメ版のときの小さい火花、動き始め、またはろじゃ技も含むようになってしまったくらいでけすのは発射してから！
type = removeExplod
triggerall = numhelper(100)
trigger1 = parent,anim = 1610 || parent,anim = 1620
trigger1 = parent,animelemtime(2) >= 0
trigger2 = parent,anim = 1605 || parent,anim = 1630
trigger3 = parent,stateno = [1700,2199]
trigger4 = parent,stateno = 1650
trigger5 = parent,stateno = 1640
trigger5 = root,movetype = H
ID=115
ignorehitpause = 0

[state 2090,];タメ版のときの小さい火花、消えたら
type = removeExplod
trigger1 = !numhelper(100)
ID=115
ignorehitpause = 0

[state 2090,];大きい火花、攻撃時parentoあにめによって・・
type = changeanim
triggerall = numhelper(100)
triggerall = anim != 1650
trigger1 = parent,anim = 1610 || parent,anim = 1620
trigger1 = parent,animelemtime(4) >= 0
value = 1650

[state 2090,];大きい火花消す、くらい、タメなおしで	ろじゃとかいってもけす
type = changeanim
triggerall = numhelper(100)
triggerall = anim != 6000
triggerall = anim = 1650
trigger1 = root,movetype = h
trigger2 = parent,anim != 1610 && parent,anim != 1620 && parent,anim != 1630
trigger3 = parent,stateno = [1700,2199]
value = 6000

[state 2090,];大きい火花消す、くらい、タメなおしで	ろじゃとかいってもけす
type = changeanim
trigger1 = !numhelper(100)
value = 6000

[state 2090,];消える
type = destroyself
trigger1 = !numhelper(100)

;-------------------------------------ヨーヨーの糸--------------------710
;-ブリジットとヨーヨーの間。手の位置あたり。pos y - 45ぐらい？
;呼び出しは、本体からの方がいいかな？minusで
;--長距離の場合、短いのが2.3本、流れるようにアニメする。糸は全体に貼ってあるわけでない。
;ブリジットの手にはつねにあるように見える？？いや見えない。
;軸線上のどこかに短いのがランダムででてるよう・・動きにはついてこない。定期的に貼りなおしてる感じ。
;複数だすと・・angleの関係で複数常時ヘルパーになってしまうので却下。
;X2+y2 =Z2 で糸自体の距離、使えない？ tanθ=y/x θは任意角、であれば。dist y /dist x ？？
;---上のほうにあると角度が変になる
;-----アングルを使わないとやってられないので、常時ヘルパー・・・・・
[statedef 709];
type    = A
movetype= i
physics = N
ctrl = 0
velset = 0,0
sprpriority = 4
anim = 6000

[State 3000, 2];透明にしておく 
type = AssertSpecial
trigger1 =1
time = 1
flag = noautoturn
flag2 = noshadow
flag3  = invisible
ignorehitpause = 1

[state 8310,];ちょっと時間稼ぎ、そのうち検討
type = changestate
trigger1 = time >= 30
value = 710

;------------------------------本体からだしてみる？
;----本体から出す場合はよーよーを目標地点とした角度、速度設定、必殺ヒットスパークと通じるものがある？
[Statedef 710]
type = A
movetype = I
physics = N
velset = 0,0
sprpriority = 1
ctrl = 0
anim = 1660;旧VER1580

[State 3000, 2];透明にしておく 
type = AssertSpecial
trigger1 =1
time = 1
flag = noautoturn
flag2 = noshadow
flag3  = invisible
ignorehitpause = 1

;--------z2軸上にランダムに貼りつけ。短いのを定期的にずらして貼る
[state 8300,];YY基準で、velでずらす
type = posset
triggerall = numhelper(100)
trigger1 = time = 0
x = parent,pos x
y = parent,pos y
ignorehitpause = 1

[state 8310,];角度調整部へ
type = changestate
trigger1 = animtime = 0
value = 715

;-------------新新移動00基準 el.ver2	よよ応用編孤独な糸
;---これは時差ありなので、速度設定は一度きりでいい、はず
;----------rootdist x が負なら、本体向きより前にある。正なら後ろにある。
;----------rootdist y が負なら、本体より下にある。正なら上.本体地上(posy0)通常配置でdisty=90
[state 8150,2]
type = varset
triggerall = numhelper(100)
triggerall = ABS(helper(100),rootdist y) != 0
triggerall = ABS(helper(100),rootdist x) != 0
trigger1 = time = 0
fvar(13) = ifelse(ABS(helper(100),rootdist x) > ABS(helper(100),rootdist y),helper(100),rootdist x / 20,helper(100),rootdist y / 20)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = numhelper(100)
triggerall = time = 0
trigger1 = helper(100),rootdist y = 0
trigger2 = helper(100),rootdist x = 0
trigger3 = helper(100),rootdist x = helper(100),rootdist y
fvar(13) = 0
ignorehitpause = 1

[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time = 0
fvalue = 0
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist x != 0)
trigger1 = time = 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist y != 0)
trigger1 = time = 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

[state 8150,2];移動速度
type = varset
trigger1 = time = 0
fvar(16) = abs(ifelse(abs(rootdist x) >= ABS(rootdist y),rootdist x / 15,rootdist y / 15))
ignorehitpause = 1

;----------------------基本移動量＝
;--まとめるとどうしても０除算になる、なんでだろうね
[state 8150,5];-YX	一度0に設定して真横真縦に対応
type = velset
trigger1 = time = 0
x = 0
y = 0
ignorehitpause = 1

[state 8150,5];-X	0じゃなければ改めて設定
type = velset
trigger1 = time = 0
trigger1 = fvar(14) != 0
x = fvar(16) / fvar(14) * ifelse(rootdist x < 0,-1,1) 
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
trigger1 = time = 0
trigger1 = fvar(15) != 0
y = fvar(16) / fvar(15) * ifelse(rootdist y > 0,1,-1)
ignorehitpause = 1
;-----------new移動ここまで

[state 8150,];角度用に格納しておく
type = varset
trigger1 = time = 0
fvar(4) = vel x
ignorehtipause = 1

[state 8150,];角度用に格納しておく
type = varset
trigger1 = time = 0
fvar(5) = vel y
ignorehtipause = 1

[state 8150,];本体とおりすぎたらとめないといけないが・・本体もうごくしなー
type = velset
trigger1 = time > 2
trigger1 = random % 4 = 0
trigger2 = animtime = 0
trigger3 = rootdist x = [-20,20]
trigger3 = rootdist y = [-20,20]
x = 0
y = 0

[state 8300,];特殊でまできえてる
type = destroyself
trigger1 = !numhelper(100)
trigger2 = numhelper(100)
trigger2 = helper(100),stateno = [1700,2190]
trigger3 = numhelper(100)
trigger3 = helper(100),stateno = [1640,1650]

;-------------debug クリップボード
[state 8100x, clip];基本編
type = displaytoclipboard
trigger1 = numhelper(100)
text = "PdiX=%f PdiY=%f,YYdiX=%f,YYdiY=%f,f=%d\n"
params =parentDist X,parentdist y,helper(100),rootdist x,helper(100),rootdist y,var(28)

[state 8100x, clip];基本編
type = appendtoclipboard
trigger1 = numhelper(100)
text = "rdiX=%f rdiY=%f"
params = rootDist X,rootdist y

;------一ここでは710;8300で決めた角度でangledrowのみ。定期的に8300＜－＞8310　LOOP
[Statedef 715]
type = A
movetype = I
physics = N
velset = 0,0
anim = 1660
sprpriority = 1  

;----範囲判定は本体とにしたほうがいいかも
[State 3000, 2] ;範囲外だったら
type = AssertSpecial
triggerall = numhelper(100)
trigger1 = rootdist x != [-40,40]
trigger1 = rootdist y != [-30,30]
trigger1 = parentdist x != [-50,50]
trigger1 = parentdist y != [-40,40]
time = 1
flag = noautoturn
flag2 = noshadow
ignorehitpause = 1

;---------空中N配置とか、近すぎた場合にうまくいってない
;-----とおりすぎたときもやばいんだけど
[State 3000, 2] ;範囲内だったら透明も追加
type = AssertSpecial
triggerall = numhelper(100)
trigger1 = rootdist x = [-40,40]
trigger1 = rootdist y = [-40,40]
trigger2 = parentdist x = [-50,50]
trigger2 = parentdist y = [-40,40]
time = 1
flag = noautoturn
flag2 = noshadow
flag3 = invisible
ignorehitpause = 1

[State 3000, 2] ;透明も追加
type = AssertSpecial
triggerall = !numhelper(100)
trigger1 = 1
time = 1
flag = noautoturn
flag2 = noshadow
flag3 = invisible
ignorehitpause = 1

[state 8150,2]
type = varset
triggerall = 0;numhelper(100)
triggerall = ABS(helper(100),rootdist y) != 0
triggerall = ABS(helper(100),rootdist x) != 0
trigger1 = time = 0
fvar(13) = ifelse(ABS(helper(100),rootdist x) > ABS(helper(100),rootdist y),helper(100),rootdist x / 20,helper(100),rootdist y / 20)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = 0;numhelper(100)
triggerall = time = 0
trigger1 = helper(100),rootdist y = 0
trigger2 = helper(100),rootdist x = 0
trigger3 = helper(100),rootdist x = helper(100),rootdist y
fvar(13) = 0
ignorehitpause = 1

;----distは、相手と関係して向きが変更かかる？
;--YYが前で-後ろなら+　０除算に注意
;+180なら左に下がる？
;---YYが上のほうーとか縦に距離あると変になってる
;---縦横どちが長いか判断で1Fおかしくなってる？YYに近いほどおきる。あにめがおかしい、なんでたてがまざってるの？
;--0Fでない、0除算注意fv4は速度X
[State angle];らぢあん。tan=y/x
type = AngleSet
triggerall = numhelper(100)
triggerall = fvar(13) != 0
triggerall = fvar(4) != 0
trigger1 = time = 0
value = atan(fvar(5) / fvar(4)) * (-180.0 / pi) ;+ (ABS(helper(100),rootdist x) * 2 < ABS(helper(100),rootdist y)) * 180
;value=atan(fvar(5) / fvar(4)) * (-180.0 / pi); + (var(28) = -1) * 180

[State angle];らぢあん。tan=y/x	速度Yが０	横にしか動いてない。真横
type = AngleSet
triggerall = numhelper(100)
triggerall = fvar(5) = 0
trigger1 = time = 0
value = 0

[State angle];らぢあん。tan=y/x 速度xが０　縦にしか動いてない、真縦
type = AngleSet
triggerall = numhelper(100)
triggerall = fvar(4) = 0
trigger1 = time = 0
value = 90

[State angle]
type = AngleDraw
triggerall = 1;numhelper(100)
trigger1 = time >= 0

[state 8300,]
type = destroyself
triggerall = 1
trigger1 = !numhelper(100)
trigger2 = numhelper(100)
trigger2 = helper(100),stateno = [1700,2190]
trigger3 = numhelper(100)
trigger3 = helper(100),stateno = [1640,1650]

[state 8310,]
type = changestate
triggerall = 1
trigger1 = animtime = 0
value = 710

