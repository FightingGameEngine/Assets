;----------------------------------------------------必殺ヒットｴﾌｪしりーず
;-------------------------------------------------------------------------------緑の線
;---------基本移動量(16)8

;------------------------------------テスト緑線別ばー
;---------------------------------------------------------
[statedef 8015];
type    = a
movetype= I
physics = N
poweradd= 0
ctrl = 0
anim = 6305
sprpriority = 3

[state 2090,];コレ追加で再び半透明
type = trans
trigger1 = 1
trans = add
ignorehitpause = 1

;---------------------AC赤実験


[State 3660,]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

;-----------------------初速基本(16) 8 で19Ｆ動く
[state 8150,2];Ｘ速度ランダムで決定　狩
type = varset
trigger1 = time = 0
fvar(15) = random % 81 * 0.1 * ifelse(random % 2 = 0,1, -1)
ignorehitpause = 1

[state 8150,2];Y速度  - x
type = varset
trigger1 = time = 0
fvar(16) = (8 - ABS(fvar(15))) * ifelse(random % 2 = 0,1, -1)
ignorehitpause = 1

[state 8150,2]
type = velset
trigger1 = time = 0
x = fvar(15)
y = fvar(16)
ignorehitpause = 1

[State angle];らぢあん。tan=y/x
type = AngleSet
triggerall = fvar(15) != 0
triggerall = fvar(16) != 0
trigger1 = time = 0
value = atan(vel y / vel x) * (-180.0 / pi) 

[State angle];らぢあん。tan=y/x
type = angleset
triggerall = fvar(15) = 0
trigger1 = time = 0
value = 90

[State angle];らぢあん。tan=y/x
type = angleset
triggerall = fvar(16) = 0
trigger1 = time = 0
value = 0

[State angle];角度描画
type = Angledraw
trigger1 = 1

[State angle];到達点へ
type = changeanim
trigger1 = anim = 6305
trigger1 = animtime = 0
value = 6310

[State angle];速度すとっぷ
type = velset
trigger1 = anim = 6310
x = 0
y = 0

[State angle];到達点へ
type = destroyself
trigger1 = anim = 6310
trigger1 = animtime = 0

[state 12, ];
type = displaytoclipboard
trigger1 = 1
text = "fv1=%f,fv2=%f,fv3=%f,fv4=%f.fv5=%f\n"
params = fvar(1),fvar(2),fvar(3),fvar(4),fvar(5) 
ignorehitpause = 1

[state 12, ];
type = appendtoclipboard
trigger1 = 1
text = "sgb=%d,\n"
params = const(size.ground.back)
ignorehitpause = 1


;-----------------------------------------------------------
;-----------------------------------
;-----ロジャーが使うと、消えたときにフリーズすることがある、なんか考えて->むり
;-------8020,ここから8000-8010にSチェンジ
[statedef 8020];8020ヒットスパークスタートステート  一元管理　条件にあったところへ飛ばす
type    = a
movetype= I
physics = N
ctrl = 0
anim = 6000
sprpriority = 3
velset = 0,0

[State 3660,];影をなくしておく
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state 3400,];空中の相手とかにあたるとうまくない const(size.height)をY軸の位置変数に使用します
type = posset
trigger1 = time = 0
y = parent,pos y + const(size.height)
ignorehitpause = 1

;---位置X１:相殺時	2ヘルパーに当たったとき
[state 3400,];相殺時のときのXは判定の部分 const(size.ground.front) ID940
type = posset
triggerall = anim = 6000
triggerall = parent,HITPAUSEtime
trigger1 = parent,movehit
trigger1 = parent,numtarget(940);p2movetype = A
trigger2 = parent,movehit		;ヘルパーなどにあたっているとき
trigger2 = enemynear,movetype != H
x = parent,pos x + ifelse(facing = 1,-1 * const(size.ground.front), const(size.ground.front))
ignorehitpause = 1
persistent = 1

[state 3400,];ステート格納
type = varset
trigger1 = time = 0
var(1) = parent,stateno
persistent = 0
ignorehitpause = 1

;----V35に攻撃HITSTOP,V36に被攻撃HITSTOP　の計測それをつかってうまくできない？
[state 3400,];相打ち時にもでるように気をつけてね	8000,8002,8010
type = changestate
triggerall = anim = 6000
triggerall = parent,numtarget(940) = 0
trigger1 = var(1) = parent,stateno
trigger1 = parent,HITPAUSEtime
trigger1 = parent,var(35);		あてた	ヘルパーあたってもOK
trigger1 = parent,movehit;ガード時はだめ
trigger2 = enemynear,movetype = H;相手も被攻撃
trigger2 = parent,var(36);被攻撃
value = const(size.head.pos.x)
persistent = 1
ignorehitpause = 1

;-----ー
[state 3400,];相殺：：REVDEFもMOVEHITになるから・・8009
type = changestate
triggerall = anim = 6000
triggerall = var(1) = parent,stateno
trigger1 = parent,numtarget(940);p2movetype = A
trigger1 = parent,var(35) = 0;parent,movehit
trigger2 = parent,var(37);parent,movehit
trigger2 = parent,hitpausetime || parent,hitshakeover = 0
value = 8009
persistent = 1
ignorehitpause = 1

[state 3400,];---ガード絵に
type = changestate
triggerall = anim = 6000
triggerall = var(1) = parent,stateno
trigger1 = parent,moveguarded
trigger1 = parent,HITPAUSEtime
value = const(size.head.pos.y)
persistent = 0
ignorehitpause = 1

[state 3400,];相殺「された」時にきえる?
type = destroyself
triggerall = 1
trigger1 = anim != 6000
trigger1 = animtime = 0
trigger2 = anim = 6000
trigger2 = time >= const(size.ground.back) 
trigger2 = parent,hitpausetime = 0
ignorehitpause = 0

[state 12, ];
type = displaytoclipboard
trigger1 = 1
text = "moveH=%d,moveG=%d,v1=%d,px=%f,t=%d\n"
params = parent,movehit, parent,moveguarded, var(1),pos x ,root,teamside
ignorehitpause = 1

[state 12, ];
type = appendtoclipboard
trigger1 = 1
text = "pposy =%f,pos=%f,v2=%d,=%d"
params = parent,pos y, pos y , const(size.ground.back),parent,numtarget(940)
ignorehitpause = 1


