trigger1 = root,var(1) = 1 || root,var(1) = 3
trigger2 = root,var(1) = 0 || root,var(1) = 4
trigger2 = (root,var(20) = 0 && root,var(32) = 1) || (root,var(20) = 1 && root,var(32) = -1) 
var(20) = 0

[state 1900,fvarset2];ORのシフト対応・なくせば簡単だけどね EXタイプ
