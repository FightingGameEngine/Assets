;----------------------------------ここから移動
;-------------新新移動00基準 el.ver2	よよ基本編
;distが０以外のとき、０除算注意
;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time >= 0
fvalue = 0
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

;----------------------基本移動量＝14dotなので7
;--まとめるとどうしても０除算になる、なんでだろうね
;------んー必ず動いてくれないとこまるかな・・
[state 8150,5];-YX	一度0に設定して真横真縦に対応
type = velset
trigger1 = time > 0
x = 0
y = 0
ignorehitpause = 1

[state 8150,5];-X	0じゃなければ改めて設定
type = velset
trigger1 = time >= 0
trigger1 = fvar(14) != 0
x = 7 / fvar(14) * ifelse(rootdist x < 0,-1,1) 
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
trigger1 = time >= 0
trigger1 = fvar(15) != 0
y = 7 / fvar(15) * ifelse(rootdist y > 0,1,-1)
ignorehitpause = 1
;-----------new移動ここまで

;---------------------------------------消滅
;-----最低発生してから消す？10前後以上あるかも？
[state 8110,varset];手ぶらフラグ reset
type = parentvarset
triggerall = rootdist y = [-20,30]  
triggerall = rootdist x = [-8,8]
trigger1 = (!var(1) || var(1) >= 3) && time >= 11  
trigger2 = (var(1) = 1 || var(1) = 2) && time >= 10  
var(30) = 0
ignorehitpause = 0

[state 8110,vel]
type = destroyself
triggerall = rootdist y = [-20,30]  
triggerall = rootdist x = [-8,8]
trigger1 = (!var(1) || var(1) >= 3) && time >= 11  
trigger2 = (var(1) = 1 || var(1) = 2) && time >= 10  
ignorehitpause = 0

