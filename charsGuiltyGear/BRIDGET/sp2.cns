;---ぶりじっと　ヨーヨー関連 
;1600 配置と戻し攻撃 1700じゃっく 1800 はぐ 1900 ラッシュ 2000 げっと　2100　きる
;--2400～悲劇へるぱ　喜劇へるぱ  笑劇へるぱ
;-----
;--ヨーヨー状態var(30)フラグについて　　R移動、ろじゃ、ハグ、タメ、戻しなど
;-AC,タメ中にろじゃなど可能、正確には引き戻しに入ってから、判定でるまでの7Fの間受付、と解釈
;--動きだしてからだから,動きはとめとかないと、本体に回収されてしまうんじゃないかな
;---0	何らかの攻撃動作中	全て受付不可
;---1	SLACタメ中、		引き戻し含め全部OK	受付HS離した次の１Fのみ・・！？
;---2	配置後停止中		全て受付可	
;---3	ハグ引っ付き中		ハグ以外受付可
;-  : Root,var(10)-->Action State Number designate 		YOYO ID 100に変更　0だとバグる
;-動作固定　攻撃判定無し、各種ヨーヨー技受け付けOK		init
;--全部向き固定、ゲット以外は自分に戻る、ＦＢはどっかいく。
;-出した時点での本体向きがヘルパーの向き固定のため、逆になるとヒットバックが[ヘルパーに対して後ろ」になる見た目逆転現象が起こる注意。
[statedef 1600]
type =A
physics = N
movetype = I
velset = 0,0
anim = 1600
hitcountpersist = 1
sprpriority = 1
ctrl = 0

[State 3660,];共通ALL影なし
type = AssertSpecial
trigger1 = 1
flag = noshadow

[state 8000,];v30ヨーヨー状態設定通常受け付け 0不可　1戻し以外OK　2ALLOK　3ハグ中ハグ以外OK
type = parentvarset
trigger1 = 1
var(30) = 2

[state 8000,];各種フラグ0リセット
type = varrangeset
trigger1 = time = 0
first = 34
last = 38
value = 0

[state 8000,fvarset];攻撃力	本体のを使うのですが、一応保険
type = varset
trigger1 = 1
fvar(0) = root,fvar(0)

[state 8000,fvarset];もーど	本体のを使うのですが、見逃しの保険
type = varset
trigger1 = 1
var(1) = root,var(1)

[State 1510, atack voice ws];よーよーだし音
type = PlaySnd
trigger1 = time = 0
value = s80,0
channel = 5
persistent = 0

;-----------糸少し遅めにだす？へんになってる 709で時間稼ぎ　仮
[state 1510,helper partner];----ヨーヨーの糸 Id = 110	st710-715  本体からだすにへんこう
type = Helper
triggerall = !numhelper(110)
trigger1 = time = 0
name = "Solitude Strings"
ID = 110
pos = 0,0
postype = p1
stateno = 709;710
ownpal = 1
supermovetime = 999

;----------VEL X方向格納
;----んー、特殊投げの7場合も1にしたい。
[state -2, ]
type = varset
trigger1 = 1
var(11) = ifelse(vel x = 0,0,ifelse(vel x > 0,1,-1)) 

;----------------------------SLACモード特殊なげ、地上,1、4 RE以外だった
[state 8150,6];
type = changestate
triggerall = root,var(1) != 1
triggerall = time = 0
trigger1 = root,var(26) = 4
trigger2 = root,var(26) = 7
value = ifelse(root,var(26) = 4,1660,1680)

;-------------------AC,N 特殊投げ追加5  1690
[state 8150,6];
type = changestate
triggerall = root,var(1) = 0 || root,var(1) = 4
triggerall = time = 0
trigger1 = root,var(26) = 5
value = 1690

;--------------------------------------------------------速度決定
;------テンキーではいっているはず。
[state 8150,6];6方向　正面		10dot=5	45Fで止まる32から8,6,5,4,3,3,2,2,1～  mul0.8?
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 6
trigger2 = root,var(26) = [15,16]
x = 5
y = 0

[state 8150,9];9方向　斜め前上	x7=3.5	y7=-3.5
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 9
trigger2 = root,var(26) = 19
x = 3.5
y = -3.5

[state 8150,8];8方向　上	x0	y10=5  起き上がり配置は早めにとまる
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 8
trigger2 = root,var(26) = 18
trigger3 = root,var(26) = 28
x = 0
y = -5

;----------------------------地上7,4方向はSLとORで特殊な動き、チェんステで
[state 8150,7];7方向　斜め後ろ上	x7=-3.5	y7=-3.5
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 7
trigger2 = root,var(26) = 17
x = -3.5
y = -3.5

[state 8150,4];4方向　後ろ　#R,EX	
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 4
trigger2 = root,var(26) = 14
x = -5
y = 0

;----------------ココから下は空中のときのみ123方向
[state 8150,1];1方向　斜め後ろ下	
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 1
trigger2 = root,var(26) = 11
x = -3.5
y = 3.5

[state 8150,2];2方向　真下　
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 2
trigger2 = root,var(26) = 12
x = 0
y = 5

[state 8150,3];3方向　斜め前下	
type = velset
triggerall = time = 0
trigger1 = root,var(26) = 3
trigger2 = root,var(26) = 13
x = 3.5
y = 3.5

;-----------------------------------------共通MULでいいかな？
[state 8150,2];32F以降VELMUL
type = velmul
trigger1 = time >= 32
x = 0.8
y = 0.8

;---------時間経過、地上いきすぎなどで停止へ
[state 8150,2];一定時間したらとまる AC,N配置ははやめにとまる	空中Pの最大射程＋1個分よーよぐらいの位置
type = changestate
triggerall = root,var(1) = 0 || root,var(1) = 4
triggerall = root,var(26) = 15
trigger1 = time >= 9
value = 1610

[state 8150,2];一定時間したらとまる 起き上がり配置、ライフバーあたりでとまる（画面内でとまる
type = changestate
triggerall = root,var(26) = 28
trigger1 = time >= 31
value = 1610

[state 8150,2];一定時間したらとまる
type = changestate
trigger1 = time >= 45
value = 1610

[state 8150,2];地面にいったら止まるYのみ、
type = velset
trigger1 = pos y >= 52
y = 0

[state 8150,2];地面	固定　現SFFAIRではY=52がちょうどぴったし
type = posset
trigger1 = pos y >= 52
y = 52

[state 8150,2];行動を設定
type = changestate
trigger1 = root,var(10)
value = root,var(10)

[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "pr%d,pr=%d,v12=%d\n"
params = root,numprojID(1600),numprojID(1600) ,var(12)
ignorehitpause = 1

;---------------停止状態　各種受付OK
;--------------このとき画面外にいたりすると、ずずっと移動してくるかも、あとでね
[statedef 1610]
type = A
physics = N
movetype = I
hitcountpersist = 1
sprpriority = 2
ctrl = 0
velset = 0,0
anim = 1600

[State 3660,];共通ALL影なし
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state 8000,];v30ヨーヨー状態設定通常受け付け不可能=0	1以上R移動可能　2以上ろじゃ可能　3ハグ状態
type = parentvarset
trigger1 = 1
var(30) = 2
ignorehitpause = 1

[state 8150,2];行動設定
type = changestate
trigger1 = root,var(10)
value = root,var(10)

;--------------------------強制すてーじ内復帰
;------場所移動X
;---へるぱ監視(despiclip)ではmumPは２になるが本体では１となっている
;-----time０上で2以上になったら停止フラグ発動で--除外は？
;------動かさないと消えるかどうかの判定してくれない。
;---前方向配置の場合前に動かして消えるか確かめ、後ろ配置なら後ろに・・？
;---はじめから壁際のときまで動いてしまうっと。0にしておいてタイムカウント方式？
;-----特殊後方、や地面設置の場合も消えるようになってしまっている->動いてしまう
[State 9000,wall];----
type = projectile
triggerall = root,var(26) != 8 && root,var(26) != 18 && root,var(26) != 28;上ならいらない
triggerall = root,var(26) != 2 && root,var(26) != 12   ;下ならいらない
triggerall = !var(12)
trigger1 = root,var(1) = 1;REなら特殊投げなし,ALLOK
trigger2 = root,var(1) != 1
trigger2 = root,var(26) != 4;後方特殊、勝手に相手後ろでとまる,はず？
projanim = 1680
projremovetime = 1
projid = 1600 
attr = a,np
animtype = light
velocity = var(11), 0
postype = p1
offset = 0,0
remvelocity = 0, 0
projedgebound = 320 * 100
projstagebound = 5
projheightbound = -300,-300
projscale = 1,1

;----------2個以上、つまり消えないようなら停止フラグ
;----地面接触のときも消える扱いなのでセットされてしまわないように・
;---上はためしたけど、あまり高いすてーじだとどうだろうね。森は大丈夫だった
;--画面外で地面接触のときはどうやる?
;--2でるということは、横画面内である。1であれば・・
[state -2, ];ぷろじぇ発生停止地面設置時もやっといて
type = varset
trigger1 = root,numprojID(1600) >= 2
var(12) = 1;ifelse(pos y >= 52,2,1)
ignorehitpause = 1

[state -2, ];停止カウント、これも一回でいい
type = varset
trigger1 = var(12) = 1
trigger2 = root,numprojID(1600) >= 2
trigger2 = pos y >= 52
var(13) = 17
ignorehitpause = 1
persistent = 0

[state -2, ];停止
type = varadd
trigger1 = var(13) > 1
var(13) = -1
ignorehitpause = 1

[state -2, ];戻らせ開始、一回でいいかな
type = velset
trigger1 = time > 1
trigger1 = !var(12) 
x = var(11) * -1
ignorehitpause = 1
persistent = 0

[state -2, ];停止
type = velset
trigger1 = var(13) = 1
x = 0
ignorehitpause = 1

[state 8150,2];場所移動Y	上過ぎると、ずずっとさがってくる	森ステージでかすかに見えるぐらいの高さ。
type = posadd
triggerall = 1
trigger1 = pos y < -173
y= 1
ignorehitpause = 0


[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "px=%f,py=%f,rdx=%f,rdy=%f,pid=%d\n"
params =pos x,pos y,rootdist x,rootdist y,life
ignorehitpause = 1

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
text = "RprId=%d,V11=%d,fa=%d,v12=%d,V13=%d"
params = root,numprojId(1600),var(11),facing,var(12),var(13)
ignorehitpause = 1

;----------通常引き戻し	SLの待機は最大92、発生が８、地上命令が12なので112、空中命令14なので114
;----AC,ここでろーりんぐOK,ろじゃわざもOKらしい、つまり戻し以外ALLOK?動き出したらたぶんだめ、
;---命令くるまでに動き出す可能性あり,タイマーをカウントを命令動作中は進めないようにしてみる？
;----------SLだとこのときため音があるが、どうしましょ？ないよ
[statedef 1620]
type = A
physics = N
movetype = I
hitcountpersist = 1
sprpriority = 2
ctrl = 0
poweradd = 0
velset = 0,0
anim = 1600

[State 3660,];共通ALL影なし
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state 8000,];v10resetto
type = parentvarset
trigger1 = time = 0
var(10) = 0
ignorehitpause = 1

;-----------SLACOR	のみタメ音	タメにもっかいくることがあるから・・
[State 2050,  snd];発火音として、タメでなくても出ているこれ OR,SL,ACのみ　ドクンと低め脈動のような音
type = PlaySnd
triggerall = root,var(1) = 0 || root,var(1) = 3 || root,var(1) = 4 
trigger1 = time = 0
value = s60,6
channel = 7
volume = 255

[State 2050,  snd];発火音OR,SL,ACのみ もう１こかぶせる 31っぽいんだけど・・？  割れるような音
type = PlaySnd
triggerall = root,var(1) = 0 || root,var(1) = 3 || root,var(1) = 4 
trigger1 = time = 0
value = s210,11
channel = 6
volume = 0

;-----------------------------------ここにヘルパで回転する小さな火花　アニメないのでなんとかして
;-------------------------------回転含むのでEXPLODではだめなわけ
[state 1510,helper partner];----火花用		サイズをなんとかあわせて・・
type = Helper
triggerall = !numhelper(120)
trigger1 = time = 0
helpertype = normal
sprpriority = 3
name = "YOYO Fire"
ID = 120
pos = 0,-45
postype = p1
stateno = 700
keyctrl =0
ownpal = 1
size.xscale = 1
size.yscale = 1

;--------R移動がだせるようになってしまっている・今後も増えるかもしれない。 許可段階追加、COM記述も追加
;----ろじゃわざもだせるらしい、再変更,1で戻し以外だせるように
;--が、通常ろじゃは出すのきつい1Fだし
;-----一応、モード確認して
[state 8000,];v30ヨーヨー状態設定通常受け付けOK	ここでは実質ぐるぐるとFBのみ
type = parentvarset
trigger1 = 1
var(30) = ifelse(root,var(1) = 0 || root,var(1) = 4,1,0)
ignorehitpause = 1

[state 8150,2];行動設定一応制限つけておく。
type = changestate
triggerall = root,var(1) = 0 || root,var(1) = 4
trigger1 = root,var(10)
value = root,var(10)
ignorehitpause = 1

[state 8100,];ヨーヨーフラグをHS離しのときはそのまま、タイム切れのときは０に、同時にHS離してたらOKとしとく  
type = parentvarset
triggerall = root,var(1) = 0 || root,var(1) = 4
trigger1 = time >= 92 + 40
trigger1 = root,command = "holdHS"
var(30) = 0
ignroehitpause = 1
 
;------空中だとそもそも命令が2遅いので・・実質同じ時間になるはず
;-----ACでは＋40
[state 8150,2];SL%ORのため最大112　+ 8?	EX,#Rなら即移動 12で発生 anim8Fで実際にでる
type = changestate
trigger1 = root,var(1) = 1 || root,var(1) = 2
trigger1 = time >= 0
trigger2 = root,var(1) = 3 
trigger2 = root,command = "holdHS"
trigger2 = time >= 92
trigger3 = root,var(1) = 0 || root,var(1) = 4
trigger3 = root,command = "holdHS"
trigger3 = time >= 92 + 40
trigger4 = root,command != "holdHS"
value = 1640

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "px=%f,py=%f,rdx=%f,rdy=%f,v46=%d\n"
params =pos x,pos y,rootdist x,rootdist y,(!root,var(46)) * 7
ignorehitpause = 1

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
text = "v34=%d,v35=%d,V36=%d,v37=%d,V38=%d"
params = var(34),var(35),var(37),var(37),var(38)
ignorehitpause = 1

;-----------------------------------------------------------------------------------------------
;--本体に戻る　攻撃判定あり　2Fから移動開始。判定が出るのはモードによって違う
;----ACタメて、１，２Fぐらい受付可能にする、その際速度停止はない、近すぎれば回収される
;---1610 #,R,	発生11(7F) 
;---1620 O,A,S	発生12(8F)
[statedef 1640]
type = A
physics = N
movetype = A
hitcountpersist = 1
sprpriority = 1
ctrl = 0
poweradd = 0
anim = ifelse(root,var(1) = 1 || root,var(1) = 2, 1610,1620)

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "px=%f,py=%f,rdx=%f,rdy=%f,v46=%d\n"
params =pos x,pos y,rootdist x,rootdist y,(!root,var(46)) * 7
ignorehitpause = 1

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
text = "v34=%d,v35=%d,V36=%d,v37=%d,V38=%d"
params = var(34),var(35),var(37),var(37),var(38)
ignorehitpause = 1

[State 3660,];共通ALL影なし
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state 8100,];命令reセット  すこし受付可能にしないと・・？アニメで赤箱でるまでに若干かかるから・・その間に・？
type = parentvarset
trigger1 = time = 0
var(10) = 0
ignorehitpause = 0

;-----------------AC重要、1Fのみなので・ACT1まで	ORは長めにアレンジ
;--elem4枚目で発生
[state 8100,];ヨーヨーフラグを　0,受付不可  
type = parentvarset
trigger1 = root,var(1) = 1 || root,var(1) = 2 || root,var(1) = 3
trigger1 = time = 0
trigger2 = root,var(1) = 4
trigger2 = time >= 2
trigger3 = root,var(1) = 0
trigger3 = time >= 5
var(30) = 0
ignroehitpause = 1

;---もし発動した場合小さいままにして戻し攻撃発生させない？食らってもそのまま未発生
;-----アニメどうしようか・・
[state 8150,2];一応ろじゃとか発動したらあにめ固定ためーために注意1620ではまず出ないからいいかなと
type = changeanim
triggerall = 0;root,var(1) = 0 || root,var(1) = 4
trigger1 = root,stateno = [1540,1599]
trigger2 = root,stateno = [1530,1599]
trigger2 = prevstateno = 1640
value = anim
ignorehitpause = 0

;-----------AC	発生までろじゃ受付保険に一応２，３F猶予
[state 8150,2];行動設定一応制限つけておく。	食らった場合は無効?戻しがヒットしちゃった場合はどうなる？
type = changestate
triggerall = 1;anim = [1610,1620]
triggerall = root,var(1) = 0 || root,var(1) = 4
trigger1 = root,var(10)
value = root,var(10)
ignorehitpause = 0

;----タメー＞ろじゃ変更につき4枚目でだすように
[State 2050,  voice];戻り火花音  長い、しゅいーん
type = PlaySnd
triggerall = anim = [1610,1620]
trigger1 = animelem = 4
value = s80,2
channel = 8

[State 2050,  voice];戻り火花音追加テスト 0039?　かすかに聞こえる気がする、一瞬の布ずれのような音
type = PlaySnd
triggerall = anim = [1610,1620]
trigger1 = animelem = 4
value = s210,9
channel = 9

;-----基本
[state 8000x,nohit];無敵設定
type = NotHitBy
trigger1 = 1
value = SCA, NA, SA, HA, NT, ST, HT ,NP, SP, HP
time = 1
ignorehitpause = 1

[State 8000x, ride];テスト結果:P2stateno無効？すりぬける
type = HitOverride
trigger1 =1 
attr = sca,na,sa,ha,np,sp,hp,nt,st,ht
slot = 0
stateno = 1650
time = 1
ignorehitpause = 1

[State 8000x,noturn]
type = AssertSpecial
trigger1 = 1
flag = noautoturn
flag2 = nowalk
flag3 = noshadow
ignorehitpause = 1

;-----本体が食らった場合、小さくなるアニメ、もともと最小でも一度最大-1?になってから最小アニメになる。要するに、エレム考慮いらない
[state 8110,];本体被攻撃で（ガードも!）攻撃判定消失アニメを変えて見る	元の大きさに戻る1605にして 小さいよーよ
type = changeanim
triggerall = anim != 1605
triggerall = anim = [1610,1620]
trigger1 = root,movetype = h
trigger2 = root,stateno = [150,155] 
value = 1605
ignorehitpause = 0

[state 8110,];当たった場合、同じアニメ(拡大よーよ）で判定なしにしちゃえ	大きくて炎でてる状態
type = changeanim
triggerall = anim != 1630
trigger1 = movecontact
value = 1630
ignorehitpause = 0

[state 7000,];---------------ロマキャンフラグリセット　ガトリング経由時time=0でやるための
type = varrangeset
trigger1 = time = 0
first = 34
last = 38
value = 0
persistent = 0
ignorehitpause = 1

[state 7000,];---------------ヒットバック逆転用テスト
type = varset
trigger1 = 1
var(31) = ifelse(root,facing = facing = 1,1,-1) 
ignorehitpause = 1

;-------ACではガードされても増加しない？
[state 7000,];---------------相手V18ガードバランス関係
type = parentvaradd
triggerall = root,var(49) <= 1 || (root,var(49) = 2 && enemynear,var(25) < 1)
trigger1 = movecontact
var(18) = ifelse(movehit,-6,14 * (root,var(1) != 4))
ignorehitpause = 1
persistent = 0

;--------ヒットスパークへるぱ  lv4----相打ちにならないはず、HIT時でOK
[state 1540,helper partner];----2pでもチーム時当たったほうに出るが同時ヒット時に片方のみ？
type = Helper
trigger1 = movecontact
name = "HIT SPARK"
ID = 8000 + stateno 
pos = 0,-60
postype = p1
stateno = ifelse(movehit,8010,8011)
ownpal = 1
persistent = 0
ignorehitpause = 1
size.height = -50;Y座標
size.ground.front = 0;相殺時X座標
size.ground.back = 2;持続

;---------YYのhitstopは０！みたいすぐ動いてる
;---これも、当たる位置によってHIGHLOW変わる。ifelseとかつかえないしなー
;-----ヘルパーのFACING固定により、ヒットバックが逆転してしまう、どうしよう？v31に反転用のをセットする
[State 1800, 1];LV4des		常時相手の状態監視として、１HITしかさせないように気をつけて16d?  AX6 Y14
type = HitDef
trigger1 = anim = 1610 || anim = 1620
attr = A, sA                   
damage = ceil(40 * root,fvar(0)),1                             
guardflag = MA                  
hitflag = MAFD                  
priority = 7,miss           
animtype = hard 
ground.type = High
air.type = low
pausetime = 0, 14 + root,var(47) * 8
guard.pausetime = 0, 14          
hitsound   = s205, 3
guardsound = s150, 4             
ground.slidetime = 17 + root,var(45)
ground.hittime  = 17 + root,var(45)
guard.hittime  = 16	
guard.slidetime  = 16
airguard.ctrltime = 16  
ground.velocity = -7.5 * var(31) * root,fvar(5)        
air.velocity = -3 * var(31) * root,fvar(5), -7 * root,fvar(6) 
down.velocity = ifelse(root,var(2) = 2,-3,-8) * var(31) * root,fvar(5),ifelse(root,var(2) = 2,-2,-2.5) * root,fvar(6)          
guard.velocity = -7.5  * var(31)
airguard.velocity = -2 * var(31), -3 
yaccel = 0.5          
fall = 0
air.fall = 1                 
fall.recover = 1
fall.recovertime = ceil( (16 + 16 * root,var(47) ) * root,var(46) * root,fvar(4) ) + 14 + 8 * root,var(47) + (!root,var(46)) * 7
getpower = ifelse(root,Var(40),0,48 + (root,var(2) = 1 && root,life <= 250) * 48)
palfx.time = root,var(47) * 5
palfx.add = root,var(47) * 255,root,var(47) * -130, root,var(47) * -108
ground.cornerpush.veloff = 0
air.cornerpush.veloff    = 0
guard.cornerpush.veloff  = 0
airguard.cornerpush.veloff= 0
ignorehitpause = 0
ID = 1600

