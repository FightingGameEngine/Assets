[state 1910,var];タイムカウント　持続を計るため、判定が出てからADDするといい
type = varadd
trigger1 = time >= 13;animelemtime(7) >= 0
var(34) = 1
ignorehitpause = 0
supermovetime = 0

;---------------以下移動、　本体に戻る
;-------------新新移動00基準 el.ver2	くま応用編:FB対応
;---FBではリバースになる、rootvar(32)=通常は1乗算 FBなら-1乗算で反転
;distが０以外のとき、０除算注意
;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time >= 0
fvalue = 0
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

;----------------------基本移動量＝モードによって違う、速度はfv(20)に
;--まとめるとどうしても０除算になる、なんでだろうね
[state 8150,5];-YX	一度0に設定して真横真縦に対応
type = velset
trigger1 = 1
x = 0
y = 0
ignorehitpause = 1

[state 8150,5];-X	0じゃなければ改めて設定
type = velset
triggerall = fvar(14) != 0
trigger1 = 1
x = fvar(20) / fvar(14) * ifelse(rootdist x < 0,-1,1) * root,var(32)
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定
type = velset
triggerall = fvar(15) != 0
trigger1 = 1
y = fvar(20) / fvar(15) * ifelse(rootdist y > 0,1,-1) * root,var(32)
ignorehitpause = 1

[state 8150,5];FBで地面におしつけになることがある
type = velset
trigger1 = root,var(32) = -1
trigger1 = pos y >= 50
y = 0
ignorehitpause = 1
;-----------new移動ここまで

