;-------------------------------------------きるろじゃだけは特殊、速度０になることはない・・はず
;-------------新新移動00基準 el.ver2	くま応用編:FB対応自転車くま　家庭用で可能になる可能性も、ある?
;---FBではリバースになる、rootvar(32)=通常は1乗算 FBなら-1乗算で反転
;distが０以外のとき、０除算注意
;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
trigger1 = time >= 0
fvalue = fvar(20)
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist x != 0)
trigger1 = time >= 0
fvar(14) = ifelse(abs(rootdist x) >= ABS(rootdist y), 1,ABS(rootdist y) / ABS(rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = abs(rootdist y != 0)
trigger1 = time >= 0
fvar(15) = ifelse(abs(rootdist y) >= ABS(rootdist x),1,ABS(rootdist x) / ABS(rootdist y))
ignorehitpause = 1

;----------------------基本移動量＝モードによって違う、速度はfv(20)に
;----------------本体近くで消えないので、範囲セットのため、time0で一回必ずやらないと動かない
;--x=40,40	y=-10,10でちょうど見た目よさげだが・・Yもちっと増やしたい
[state 8150,5];-X	0じゃなければ改めて設定	、一定範囲内ではやらない
type = velset
triggerall = fvar(14) != 0
trigger1 = time = 0
trigger2 = rootdist x != [-40,40]
trigger2 = root,var(32) = 1 && time >= 0
trigger3 = root,var(32) = -1 && time = 0
x = fvar(20) / fvar(14) * ifelse(rootdist x < 0,-1,1) * root,var(32)
ignorehitpause = 1

[state 8150,5];-Y	0じゃなければ改めて設定-10
type = velset
triggerall = fvar(15) != 0
trigger1 = time = 0
trigger2 = rootdist y != [-50,50]
trigger2 = root,var(32) = 1 && time >= 0
trigger3 = root,var(32) = -1 && time = 0
y = fvar(20) / fvar(15) * ifelse(rootdist y > 0,1,-1) * root,var(32)
ignorehitpause = 1

[state 8150,5];-Y	本体近くで動くときはリバース反転させちゃる
type = velset
triggerall = rootdist x = [-40,40]
triggerall = rootdist y = [-40,40]
trigger1 = rootdist y <= -9 && vel y > 0
trigger2 = rootdist y >= 9  && vel y < 0
y = vel y * -1
ignorehitpause = 1

