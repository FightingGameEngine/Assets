type = displaytoclipboard
trigger1 = 1
text = "px=%f,py=%f,rdx=%f,rdy=%f,f=%d\n"
params =pos x,pos y,rootdist x,rootdist y,facing
ignorehitpause = 1

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
text = "v34=%d,v35=%d,V36=%d.v37=%d,r1=%d"
params = var(34),var(35),var(36),var(37) / 13,root,var(1)
ignorehitpause = 1


