;イントロ　イントロ関連をここに。
;s2800 勝利ぶつけイントロ用  2850一撃必殺用 2900イントロ相手が０にならない、または当たらないとき
;--2930 ミリア、チップ、バイケン,ジョニー　アンジ　2940アンジ専用 2945みりあ専用(両方)　2950でぃずいー１
;2970カイ専用 2975ろぼかい 2980いの(両方)　2985じゃむ(うちの)2990-95でぃじぃー(うちの)
;6000　イントロTRIPヨーヨー
;--ASSRTでらいふばーけすイントロ相手、カイ。イノ

;--------------決着後、相手の情報が取れなくなります。そのタイミング直前で一度引き込んで位置情報などを確保する。
;----------S5110であたるはず。5150いくと判断できなくなる
[statedef 2800];倒した相手に貼りつく。ID184へるぱー
type = A
movetype = A
physics = n
anim = 6000
ctrl = 0
velset = 0,0
sprpriority = -4

[state 2810,]
type  = posset
trigger1 = 1
x = enemy,pos x
y = enemy,pos y

[state 8000,];フィードバックリセット181か182を選ばせるため0か1を引く
type = parentvarset
trigger1 = time = 0
var(5) = random % 3
ignorehitpause = 1

[state 8000,];各種フラグ0リセット
type = varrangeset
trigger1 = time = 0
first = 34
last = 38
value = 0
ignorehitpause = 1

;---------挑発とかで長く0に戻らないとずれる
;---んー攻撃戻り時とかの判断できない、
;---この時点で動かさないと以降制御不可能、
[State 2800, 1];5110にとばすまたはぶつけにとばすが・・るーとが勝利ぽーずずれてたら？
type = HitDef
triggerall = time = 0
trigger1 = 1;root,stateno = [0,20]
attr = a, NT         
hitflag = MAFD          
priority = 7, hit   
sprpriority = -1      
numhits = 0
pausetime = 0, 0                 
hitsound = 0
hitcount = 0
p1stateno = ifelse(root,var(5) = 2 ,2810,2805)   
p2stateno = ifelse(root,var(5) = 2 ,5115,5110)   
;p1stateno = ifelse(root,var(5) = 2 && root,stateno <= 20,2810,2805)   
;p2stateno = ifelse(root,var(5) = 2 && root,stateno <= 20,5115,5110)   

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
ignorehitpause = 1

[state 2810,];当たらなかった場合 消すとしつこくでてくるので・・
type = changestate
trigger1 = time >= 1
value = 2805

;------------------------------------------------------------- 
[statedef 2805];とれなかった、もしくは相手に当てない場合はこっちで待機
type = A
movetype = A
physics = n
ctrl = 0
anim = 6000
sprpriority = -4

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5150]
type = parentvarset
trigger1 = time = 0
var(5) = random % 2
ignorehitpause = 1

;------------------------------------------------------------- 
;----targetstateも無効！まずtime０で相手の速度をとっておいて・・5150にいかれた時点でnumtargetきかなくなる
[statedef 2810];当たった場合待機して・・もしぶつけの場合は移動させる
type = A
movetype = A
physics = n
ctrl = 0
anim = 6000
sprpriority = -4

[state 8000,];フィードバックリセット183にいくようにする
type = parentvarset
trigger1 = time = 0
var(5) =  2
ignorehitpause = 1

[State 5110, 13] ;ヒットカウントをとれるかな？
type = Varset
triggerall = numtarget
trigger1 = time = 0
var(20) = target,gethitvar(hitcount)
ignorehitpause = 1
persistent = 0

[State 5110, 13] ;相手の速度と同期する
type = Velset
triggerall = numtarget
trigger1 = time = 0
x = target,vel x
persistent = 0
ignorehitpause = 1

[State 5110, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85
ignorehitpause = 0

[State 5150, 7] ;Friction
type = VelSet
trigger1 = Vel x < .05
persistent = 0
x = 0

[state 2810,]
type = destroyself
trigger1 = 0


;----------------------------げしげしイントロ
;---------------------相手がいつまでも0にならないとき	
;-----------これは本体動作
[statedef 2900];
type = s
movetype = i
physics = s
anim = 0
ctrl = 0

[state 2900,helper partner];----stateno0にならない時の後ろから走ってくる
type = Helper
triggerall = NumHelper(193) = 0
trigger1 = time = 60
helpertype = normal
sprpriority  = 0
name = "intro bridget"
ID = 193
pos = -100,0
postype = p1
stateno = 2920
keyctrl =0
ownpal = 1
persistent = 0

[State 190, 2] 
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = invisible

[State 2900, 4] 
type = ChangeState
triggerall = numhelper(193)
trigger1 = helper(193),stateno = 2925
value = 2910

;---------------------------------
[statedef 2910];本体動作・終了
type = s
movetype = i
physics = s
anim = 0
ctrl = 0
anim = 0

[State 2910, 4] 
type = ChangeState
trigger1 = time = 0;animtime = 0
value = 0

;-------------------イントロ走ってくるブリジット
;----------はしってくるだけ
[statedef 2920]
type = s
movetype=i
ctrl = 0
sprpriority = 2
physics = N
anim = 100
velset = 6,0

[state 7030,]
type = turn
trigger1 = root,facing != facing
trigger1 = time = 0
persistent = 0
 
[state 2950,]
type = changestate
trigger1 = abs(rootdist x) = [0,20]
value =2925

;---------イントロ本体と重なって終了
[statedef 2925]
type = s
movetype=i
ctrl = 0
physics = s
velset = 0,0
anim = 0

[state 2925,]
type = posset
trigger1 = time = 0
x = root,pos x

[state 2925,]
type = destroyself
trigger1 = time = 2

