palfx.add = var(47) * 255,var(47) * -130, var(47) * -108
ground.cornerpush.veloff = -9
air.cornerpush.veloff    = -9
guard.cornerpush.veloff  = -9
airguard.cornerpush.veloff= -9
ignorehitpause = 0

