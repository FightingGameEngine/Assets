[State 200, 1];LV1 HIT10 PAUSE11 CH0	GX13?とるたびに変わるね・・ 震えの関係で2SOT誤差あり？
type = HitDef
trigger1 = !var(34) && !movecontact
attr = S, NA                   
damage = ceil(12 * fvar(0)),0                            
guardflag = M                  
hitflag = MAFD                 
priority = 2,hit           
animtype = Light	
ground.type = high
air.type = low
pausetime = 11, 11
guard.pausetime = 0, 1          
hitsound   = s205, 0
guardsound = s150, 1
ground.slidetime = 10
ground.hittime  = 10
guard.hittime  = 9	
guard.slidetime  = 9
airguard.ctrltime = 9
ground.velocity = -5.5 * fvar(5) 
air.velocity = -2.5 * fvar(5), -7 * fvar(6)        
