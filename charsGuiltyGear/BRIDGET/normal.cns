;ブリジット　通常技;---
;---摩擦の問題あり　システム上同じは無理です---地上吹き飛びは技によって違う場合あり
;--空中HIT吹き飛びはカイ様(係数1)で確かめ、2で割ってね 若干多めにしておけばいいかも？

;---------------------------攻撃などに１Fの余裕が必要  最速スタート無攻撃滞空時間90F 91Fは着地
;---地上initJ時は相手46FでもHJ,48FではNJ, 空中攻撃ダストCJは29Fまで。
;---X基本値8　近すぎると自然に減るというか押し合いの関係で減る、がmuではコッチ優先になるので手動で減らす
;---Y最速12, 飛ぶタイミング？DISTY距離?で変化　-15確認相手22F目J
;--0.25add,-10以上にならないように？飛び越さないように？
;----攻撃すると事前-10がヒット後、-11になった。その後重力？ -15が当たってなくても-16になったり
;----攻撃終了後はXがふえたりもしているようだ？通常前JXになる？
;---ヒットしない場合距離で加速？-17とか・・
;Yは相手との距があると加速、一定範囲にいったら増えないで停滞、攻撃終了後(はずれ時)そのままなら通常重力s51に
;--P連打でのぼってくのは、51にいくまえにC攻撃しているから、重力かからない。おそらく29F中そうである。
;-disty-30  なにもしなければ50Fあたりで下降に転じる
;-----FDでも加速になっている。
;--------------55はINIT40からくる  ぶりじっと 
[Statedef 55]
type    = a
movetype = i
physics = n
ctrl = 0
hitcountpersist = 1
velset = 3.5,-7

;-----------------------------------アニメチェンジ、人によって違う-----------------------
;---ぶりじっと　最初のアニメループ
[State 40, 6];あにめ固定1-2
type = changeanim
trigger1 = time = 0
trigger2 = anim = 41 
trigger2 = animelem = 3
value = 41
elem = 1

;---------------------------------------------
[State 40, 6];ダッシュカウント強制解除
type = varset
trigger1 = time = 0
var(6) = 0
ignorehitpause = 1

[State 40, 6];ほーみんぐ中通常フラグ1ほーみん　2ほーみん攻撃ヒット
type = varset
trigger1 = time = 0
var(11) = 1
ignorehitpause = 1

;-------------------------演出
[State 200x,];dash  大、ホーミング
type = Afterimage
triggerall = prevstateno = 40
trigger1 = time = 0
trans = add1
TimeGap = 2
FrameGap = 3
length = 10
time = 99
PalBright = 0,0,0
PalContrast = 125,125,125
PalAdd = 0,0,0

[State 2050, snd];ジャンプ効果音 毎回なってる
type = PlaySnd
trigger1 = time = 0
value = s50,1
channel = 2
persistent = 0

[state 7000,test];JUMPエフェクト　砂埃	
type = Explod
trigger1 = time = 0 
anim = 6040
ID = 6040
pos = 0,0
postype = p1
sprpriority = -4
bindtime = 1
removetime = -2
ownpal = 1
scale = 0.5,0.5


;-----------------速度設定・カウント系は重複を避けるためちぇんステ命令あと
;---------これも指標ヘルパ設定してやるといいかもね・
[state -2,tes];---目標地点指標へるぱ仮
type = Helper
triggerall = var(4)
triggerall = !numhelper(65)
triggerall = playerID(var(4)),stateno = [5850,5860]
trigger1 = playerID(var(4)),sysvar(0) <= 30
name = "Posset dust"
ID = 65
pos = 0,0
postype = p1
stateno = 786

;:最速ジャンプ99F滞空	
;密着:初速+1:X6Y14->X7Y14->X6Y14
;遠い:初速+1:X8Y14->X8Y14->X8Y13--->(28F->29F)X8Y7
[State 40, 6];近いときは　X減らす　　自動ではこっちが優先で相手を押して　追い越しになってしまう
type = velset
trigger1 = time > 0
trigger1 = vel Y < 0
x = ifelse(P2Dist x <= 35,3,4)
[State 40, 6];HJおわり？下降？とにかく２になってたから・・
type = velmul
trigger1 = time > 0
trigger1 = vel Y >= 0
x = 0.75
persistent = 0

;--------------Y15?14?
;----攻撃JCの場合も再設定される？
;---攻撃中は重力少なめ？
;-------基本14（7）として、相対距離によって設定しなおす？
;---最大17=9.5
;------RDISTは本体が下なら＋上ならー
;-----基本値以外は自Vだけでなくあいてきりもみ状態も考慮かな？
[State 40, 6];相手が上、Dist+
type = velset
triggerall = var(4)
triggerall = var(12) < 30
triggerall = numhelper(65)
triggerall = playerID(var(4)),stateno = [5850,5860]
trigger1 = playerID(var(4)),sysvar(0) <= 30
trigger1 = helper(65),rootdist y > 40
y = -8
[State 40, 6];相手が上、Dist+
type = velset
triggerall = var(4)
triggerall = var(12) < 30
triggerall = numhelper(65)
triggerall = playerID(var(4)),stateno = [5850,5860]
trigger1 = playerID(var(4)),sysvar(0) <= 30
trigger1 = helper(65),rootdist y > 70
y = -9.5

[State 40, 6];相手が下、Dist-
type = velset
triggerall = var(4)
triggerall = var(12) < 30
triggerall = numhelper(65)
triggerall = playerID(var(4)),stateno = [5850,5860]
trigger1 = playerID(var(4)),sysvar(0) <= 30
trigger1 = helper(65),rootdist y < -40
y = -6
[State 40, 6];相手が下、Dist-
type = velset
triggerall = var(4)
triggerall = var(12) < 30
triggerall = numhelper(65)
triggerall = playerID(var(4)),stateno = [5850,5860]
trigger1 = playerID(var(4)),sysvar(0) <= 30
trigger1 = helper(65),rootdist y < -70
y = -5.0


;----------方式変更相手きりもみ29Ｆ間は微調整のみ、重力しない
;----相手のきりもみだよ？これ自Ｖじゃないのでは？
;----ブリジット最速100?滞空0.28で98滞空Ｏｋ　微調整は？？
;---相手のY係数=重さによっても違う、標準カイに100F,
[State 40, 6];基本加速2J以降？
type = veladd
triggerall = prevstateno != 40
triggerall = vel y > -9
triggerall = time > 0
trigger1 = var(12) < 30
y = -0.25

[State 40, 6];減速
type = veladd
triggerall = time > 0
trigger1 = var(12) >= 30
y = 0.282
ignorehtipause = 0

;----------------これは600系で使用、0.28では軽すぎ、基本0.85では重すぎる
;---からふりP試験、５Fぐらいは速度そのまま、1dot/5＝0.2？
;---からふりだと66Fで落ちる。
;---ヒット時、ヒット前からいきなり2dotへった、わけわかんなーい
[State 40, 6];重力　設定　ここではなく攻撃ステートなどで使用される
type = varset
trigger1 = time = 0
fvar(9) = 0.3
ignorehitpause = 1

;------------特殊ガード系移動。SBもできるかもしんないね
;----ここでやったばあい、FDと違って軌道変更がない。普通のほーみんである。やっかいすぎ保留？
[state 120x,];SB　ガード状態フラグ
type = varset
triggerall = var(25) <= 3; || var(25) = 3 || var(25) = 2
triggerall = !var(40) && power >= 20 && fvar(21) = 0  && !var(53)
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
trigger1 = command = "holdS" && command = "holdHS"
var(25)  = 3
ignorehitpause = 0

[state 120x,];SB　ガード不能時間の発動　成功時１５、失敗時３０、基本30にセットしてガードしたら15に変更	これもガードでやる？
type = varset
triggerall = var(25) = 3 
triggerall = !var(40) && power >= 20 && fvar(21) = 0 && !var(53)
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
trigger1 = command = "holdS" && command = "holdHS"
fvar(22)  = 30
ignorehitpause = 0

[State -1,SB];SB 空中
type = ChangeState
value = 132
triggerall = var(25) = 3 ;|| var(25) = 2
triggerall = !var(40) && power >= 20 && statetype = a && fvar(21) = 0 && !var(53)
triggerall = (!var(1) || var(1) = 4)
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
trigger1 = command = "holdS" && command = "holdHS"
ignorehitpause = 0

[State -1, FD];フォルトレス　空 レバー上はいっててもOK
type = ChangeState
value = 132
triggerall = var(25) <= 2 && fvar(22) <= 0 
triggerall = !var(40) && power > 0 && !var(53)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22) = 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) <= 3) && var(22))
triggerall = command = "holdback" 
trigger1 = time > 0
ignorehitpause = 0


;---------------Jキャン先行部	空中：ガトリングのみ
