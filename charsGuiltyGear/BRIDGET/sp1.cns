;-------------------------------------------------------------------------------------
;-----------------------------1500-地上ヨーヨー配置
;---------PC#Rコマドリ確認によると6F=time5で方向決定,7Fからアニメチェンジ
;--#R 8=26F(13) 9=22F(11) 4,7,6=22F(13)
;--S,E
[statedef 1500];ここではアニメ変更のみ　じゃない！良く見て・・方向はＶ26、テンキーで
type = s
physics = n
movetype = a
hitcountpersist = 1
sprpriority = 0
ctrl = 0
anim = 0
velset = ifelse(prevstateno < 99,0,vel x ),0 

;--------------------------ダッシュ経由速度減少、停止処理0,20,99では０になってる
[State 99,];1.05%?=0.105
type = Veladd
trigger1 = vel x > 0
x = -1 * (vel x * 0.105)

[State 99,]
type = Velset
trigger1 = Vel X <= 0.1
x = 0

;-------------重要、カウンタ判定用にAにすると相手がガードにいってしまう
;---ぐるぐる、かくしゅろじゃなど注意
[State 1100, ad]
type = AttackDist
trigger1 = 1
value = 0
ignorehitpause = 1

[state 1500,ca];投げ方向格納VARデフォルト 正面は6
type = varset
trigger1 = time = 0
var(26) = 6
persistent = 0

