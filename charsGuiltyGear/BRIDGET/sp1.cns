;ぶりじっと必殺技関連 
;s1100 R移動	s1200,スターシップ s1300,キックスタートマイハート s1500-YY配置戻し ろじゃ命令形
;s3100 るーぷざるーぷ s3200 悲劇　s3300喜劇	s3400きるましーん s3600むーん

;ぐるぐる検証　
;絵的に一回転するまで(12F間)はアイドル状態。13Fから本移動開始、とする
;ふわり、と浮いてごー。手綱をふるって(12F)走り出す(13F～)なイメージ。
;---最初の12F(2F以降他ステートにうつれる、ので必ず１Fで速度設定される。
;0時点でYVELがはいるので、YOYOに近いとはねるようになる。重力をかけて12F目でいったんYが0に。つまり11-12F間同じ場所！
;-位置によってXもすこしだけ加算する。
;---ぐるぐる開始(13F～126F(24*5+1F)
;---このときまず位置によって符号を再設定。これ一度のみ。
;-目標に向かってくるくると。33F超えるとアニメが2Fずつのに変わる、見た目回転速くなるってこと。
;-ハグのときは相手に向かうため、相手の周りをぐるぐるすることも。
;終了は相手ではなく見た目よーよーの指定範囲。なので、ハグ仕様を変更してー＞済
;下方向の終了判定が狭い。下はくぐりぬけれるが上は終了する

;--よよ配置と引き戻し、ろじゃ系は＃Rのキャプフレームによるものを1500～にしています＃Rモードはたぶんこれ。
;---もう１種類は1500～をコピーして作った1400～から。これがSLとか。たいていフレームが遅くなって弱体化。
;---たいてい２種類で、モードによって使いわけることになるので気をつけて
;--あと、命令と発生は同時ではない。命令をして変身完了するまでの時間がある。ので差がある。
;--ACタメ経由ろじゃなどは受付３Fぐらい、基本的に無理かこつをつかまないと・

;--1400,開始	よーよーID100に変更、ハグ相手はりつきは200に変更
;-------１Ｆ目に真上にＶＥＬ。それ以降はＹＯＹＯにむかう　ので１Ｆ
;---------------地上スタート、1Fから空中だが　2F以降じゃないと動けない
[Statedef 1100];地上スタート、上にちょっとはねてステートチェンジ
type = A
movetype = A
physics = n
ctrl = 0
hitcountpersist = 1
anim = 1100

[state -3,59];リセットせんこうがとりんぐ
type = varset
trigger1 = time = 0
var(59) = 0

;-------------重要、カウンタ判定用にAにすると相手がガードにいってしまう
;---ぐるぐる、かくしゅろじゃなど注意
[State 1100, ad]
type = AttackDist
trigger1 = 1
value = 0
ignorehitpause = 1


;----------------------------演出
[State 1100, sound];ぐるぐるこうかおん
type = PlaySnd
trigger1 = time = 0
value = s80,3
persistent = 0
channel = 6

;-----------------回数制限でもある
[state 1410,];RMスタート判定あとでずらして～27に変更
type = varadd
trigger1 = time = 0
var(27) = 1
ignorehitpause = 1

;-----------０のときは受付不能？
[state 1410,];ヨーヨーフラグ
type = varset
trigger1 = time = 0
var(30) = 0
ignorehitpause = 1

[state 1410,];ヨーヨーフラグ	OKにする
type = varset
trigger1 = time > 0
var(30) = 1
ignorehitpause = 1

[state 1410,];RM重力	他すてーとでもつかう、重要
type = varset
trigger1 = time = 0
fvar(9) = 0.3
ignorehitpause = 1

;-----------えっふぇくと
[state 1400x,atc efe];きらきらエフェクト発生は４Fぐらいから？2枚目あにめから　移動開始と同じであろう
type = Explod
triggerall = !numexplod(1400) < 50
triggerall = time >= 3
trigger1 = time % 2 = 0 
anim = 1110 + random % 3
ID = 1400
postype = p1
pos = 0,-55
random = 25,50
sprpriority = 2
bindtime = 1
removetime = -2
ownpal = 1
accel = -0.1,0
scale = 0.5,0.5

[state 1400x,atc efe];きらきらエフェクト発生は４Fぐらいから？2枚目あにめから　移動開始と同じであろう
type = Explod
triggerall = !numexplod(1400) < 50
triggerall = time >= 3
trigger1 = time % 2 = 1 
anim = 1110 + random % 3
ID = 1400
postype = p1
pos = 0,-55
random = 25,50
sprpriority = 2
bindtime = 1
removetime = -2
ownpal = 1
accel = -0.1,0
scale = 0.5,0.5

;--------ここまでやる？長すぎるとアニメ変更
[state 1410,];34Fからの２Fずつアニメに変更2枚目からに
type = changeanim
triggerall = anim = 1100
trigger1 = time = 33
value = 1105
elem = 2
persistent = 0

;--------------------とくしゅちぇんすて、すらっしゅばっく　たぶんでる
[state 120x,];SB　ガード状態フラグ
type = varset
triggerall = !var(40) && power >= 20 && fvar(21) = 0
triggerall = !var(1)  || var(1) = 4
triggerall = command = "SBS" || command = "SBC" || command = "SBA"
triggerall = command = "holdS" && command = "holdHS"
trigger1 = time > 0
var(25)  = 3
ignorehitpause = 0
persistent = 0

[state 120x,];SB　ガード不能時間の発動　成功時１５、失敗時３０、基本30にセットしてガードしたら15に変更	これもガードでやる？
type = varset
trigger1 = var(25) = 3 
trigger1 = time > 0
fvar(22)  = 30
ignorehitpause = 0
persistent = 0

[State -1,SB];SB空中
type = ChangeState
value = 132
trigger1 = var(25) = 3 
trigger1 = time > 0
ignorehitpause = 0
persistent = 0

;----特殊ちぇんすて、FDｃきゃんせる
;------------------------------ＦＤキャンセル
;-----------------FD状態にセット 2
[state 120x,]
type = varset
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time > 0
var(25)  = 2
ignorehitpause = 1

;---------------GGXモードのみＰＫ押しだけしかきかない
;--------GGXのみ足払いOK  GGX/XXの判断ははV2,間違えないで
[State -1, FD];フォルトレス たち	しゃがみ
type = ChangeState
value = 132
triggerall = power > 0 && !var(40)
triggerall = (var(2) != 2 && var(22)) || (var(2) = 2 && (var(22) = 1 || var(22)= 2))
triggerall = ((!var(1) || var(1) = 4) && var(22) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time > 0


;-----------------特殊ちぇんすて
;-------------------OR	ろーりんぐ墜落へ
;---15F目でいいや
[state 1400,];たまに目を回して落下->墜落 Orモードのみ
type = changestate
triggerall = numhelper(100)
triggerall = !var(1) && var(27) >= 5
triggerall = random % 5 = 0 
trigger1 = time = 15
value = 1150
ctrl = 0

[state 1400,];
type = velset
trigger1 = time = 0
x = 0
y = 0

;----ちぇんすて着地	地面によよがあってその上でやると跳ねる、着地にはならない、さあどうしよう？4F以降は着地可能かな？
;----地面にむかっていくと、着地前に１F降下アニメがはいることあり、これは単にXが範囲に入った？
[state 1410,];タメ中でもでき、その間に戻しにはいるので、yoyo消滅する場合もある。最大126Fまで。
type = changestate
triggerall = time > 0
trigger1 = !numhelper(100)
trigger2 = time >= 126
value = 51
anim = 41
ctrl = 0

[state 1400,];--------------着地は・・
type = changestate
triggerall = time > 5
trigger1 = vel y > 0 && pos y >= 0
value = 52
anim = 47
ctrl = 0

;----------------------ボイス、ACはあるっぽい	それ～あわないかも？
[State -3, recove voice]
type = PlaySnd
triggerall = var(54) >= 3 && var(54) != 6
trigger1 = time = 1
value = s1100,ifelse(var(54) < 6, var(54),random % 3 + 3) + (var(54) <= 2) * 3
parsistent = 0
channel = 0

;------ちょうーじゅうよう	ヨーヨーとの向き違い狩りV28 1前に飛びたいとき  V28　INT変数、注意
[state 8150,2]
type = varset
triggerall = numhelper(100)
triggerall = 1
trigger1 = helper(100),facing = facing 
trigger1 = helper(100),rootdist x <= 0
trigger2 = helper(100),facing != facing 
trigger2 = helper(100),rootdist x > 0
var(28) = 1
ignorehitpause = 1

[state 8150,2]
type = varset
triggerall = numhelper(100)
triggerall = 1
trigger1 = helper(100),facing = facing 
trigger1 = helper(100),rootdist x > 0
trigger2 = helper(100),facing != facing 
trigger2 = helper(100),rootdist x < 0
var(28) = -1
ignorehitpause = 1

;---Y位置特殊、よよが地面にうまっているときの特殊もあるので注意
;---正確位置を特定しないときびしいかもね
;--最低５F目まではねる可能性あるようです
;-----------------------上のとセット1:通常の範囲　2;ハグ中の範囲（敵の青箱の関係で広めにとる)
;---デバックでR移動の絵で確かめ、DISTY-10あたりが真ん中になってる？位置不正確、完全あわせるの無理
;---はね特殊ステート用意したほうが、らくかもしんないね
[state 1400,];time >= 1　以上のとき終了可能  -60
type = changestate
triggerall = numhelper(100)
triggerall = time = [1,5]
trigger1 = var(30) = [1,2]
trigger1 = helper(100),rootdist x = [-42,42]
trigger1 = helper(100),rootdist y <= 10
trigger1 = helper(100),rootdist y >= -100
trigger2 = var(30) = 3
trigger2 = helper(100),rootdist x = [-50,50]
trigger2 = helper(100),rootdist y <= 10
trigger2 = helper(100),rootdist y >= -100
value = 51
ctrl = 0

[state 1410,];本移動後。規定点達してから）フリーに
type = changestate
triggerall = numhelper(100)
triggerall = time > 5
trigger1 = var(30) = [1,2]
trigger1 = helper(100),rootdist x = [-42,42]
trigger1 = helper(100),rootdist y <= 10
trigger1 = helper(100),rootdist y >= -60
trigger2 = var(30) = 3
trigger2 = helper(100),rootdist x = [-50,50]
trigger2 = helper(100),rootdist y <= 10
trigger2 = helper(100),rootdist y >= -60
value = 51
anim = 41
ctrl = 0

;-----------------------------------------特殊上に跳ねるような
;--------------------------はねろーる有効F内速度
;-----調整むずい。はね。17dot=8.5;----1F?18 2F-17 3F-14　----16だったりもするたぶん重力かけてる
;--一回転するまで(3Fアニメ一巡)状態0-14F,この間ふわりとした感じである
;----世々の高さによって重力も違う、厄介すぎる初速TIM0は同じっぽい、同じ位置
[state 1405,];Y速度	初速
type = velset
trigger1 = time = 0
y = -9.5

;-----基本数値を設定し・・6配置なら14Fは０の位置、さすがにあわせ無理かな
[state 1405,];Y重力　9.5/15?
type = veladd
triggerall = numhelper(100)
trigger1 = time = [0,14]
y = ifelse(helper(100),rootdist y < 0,0.9,0.6)

;----------そこにY距離がはなれているときさらに加算してみる下に距離長いときは逆ですね
[state 1405,];Y重力	よよが本体より上のほう 重力を増加？
type = veladd
triggerall = numhelper(100)
triggerall = helper(100),rootdist y > 80
trigger1 = time = [0,14]
y = -0.2

[state 1405,];Y重力	よよが本体より下　重力を増やす
type = veladd
triggerall = numhelper(100)
triggerall = helper(100),rootdist y < -60
trigger1 = time = [0,14]
y = 0.125

;--Xは位置によって少しよよによる1,2では1DOT,?
;---よよ向き固定のため、facing違いでおかしくなる。
[state 1400,];目標方向にこしずつ・・　
type = veladd
triggerall = numhelper(100) 
triggerall = time = [1,14]
trigger1 = helper(100),rootdist x != [-25,25]
x = 0.25 * var(28)

;---本ぐるぐるは15Fからとしてみる
;---------ハグ仕様変更により判定はYOYOだけでいいですID100
;----------範囲認識だけ、V30によってハグのとき広げたり調節
;--てゆーか、ハグで追跡してないじゃん。なんでおかしくしちゃったの？
;---ハグのときは極端な話バックする、+が-になることもあるから、注意
;---X14F目は9,10dot、Yはそのときによって違う
;---開始前に速度が入ってるため、単純加算ではずれまくるわけで、とくに縦長時。
;---一度一回転時に長いほう基準で短いほうをセットしなおしたほうがいい？
;----------rootdist x が負なら、本体向きより前にある。正なら後ろにある。
;----------rootdist y が負なら、本体より下にある。正なら上.本体地上(posy0)通常配置でdisty=90
;---AIrで見た目とずらしたため、参照POSYは０でいい。このほうが誤差、不都合でない
;---hug中でもしきえたらどうする？
;----たまに直前でとまってしまうことあり、注意

;distが０以外のとき、０除算注意のため
;---通常なら、一度比で加算すれば終了までどちらかの数値優位は逆転しないはず・・？
;--はぐ中はXがころころかわるかも
;------------テスト２つの変数使用
[state 8150,2];X Y　いったん０
type = varrangeset
triggerall = numhelper(100)
trigger1 = time >= 0
fvalue = 1
first = 14
last = 15
ignorehitpause = 1

[state 8150,2];X 	X優位なら1、出なければ比率
type = varset
triggerall = numhelper(100)
triggerall = abs(helper(100),rootdist x != 0)
trigger1 = time >= 1
fvar(14) = ifelse(abs(helper(100),rootdist x) >= ABS(helper(100),rootdist y), 1,ABS(helper(100),rootdist y) / ABS(helper(100),rootdist x))
ignorehitpause = 1

[state 8150,2];Y	Y優位なら1、出なければ比率
type = varset
triggerall = numhelper(100)
triggerall = abs(helper(100),rootdist y != 0)
trigger1 = time >= 1
fvar(15) = ifelse(abs(helper(100),rootdist y) >= ABS(helper(100),rootdist x),1,ABS(helper(100),rootdist x) / ABS(helper(100),rootdist y))
ignorehitpause = 1

;----------------------基本移動量＝9,10
;---facingちがいで符号反転にしてみる
;---ADDで、ハグ中のことを考えるとタイム制限はだめ、最大速度制限
;---速度制限すると目標から軌道ずれ
;----16Fからスタート?t=15
;-----------スタート、または一回転時、いったん速度を再決定、animtime=0ごとでもいい？
;--Y長時、重力と位置関係で符号が違うため、とまってしまうように見えるのを防ぐには。。・
;--直前まで上昇か下降で符号が違うはず、
;---符号設定していいのは最初の16F時に一度のみ、その後は符号かえない。特にハグで顕著にでるこれ
;-fv14はXの１か比率　15はYの１か比率
;---------------もしかして、Y考慮時点でx加算されるのでずれる？varでクッションしないとだめかな？
;---縦優先のとき止ってしまうように見えるのは？
;---といてこれやらないととんでもないことになるし
[state 8150,5];-yが長いとき、xをVel X/比で再設定
type = velset
triggerall = numhelper(100)
triggerall = fvar(14) != 0
triggerall = ABS(helper(100),rootdist x) <= ABS(helper(100),rootdist y)
trigger1 = time = 15
x = abs(vel y) / fvar(14) * var(28)
ignorehitpause = 1

[state 8150,5];-Xが長いとき、YをVel X/比で再設定
type = velset
triggerall = numhelper(100)
triggerall = fvar(15) != 0
triggerall = ABS(helper(100),rootdist x) >= ABS(helper(100),rootdist y)
trigger1 = time = 15
y = abs(vel x) / fvar(15) * ifelse(helper(100),rootdist y > 0,-1,1)
ignorehitpause = 1

;--------------ADD加速部15からでいい？
;---0.25では少ないかも1DOTは0.5
;----------ADDは位置によっては足さなくいい方向があるから基本０
[state 8150,5];-
type = varrangeset
trigger1 = time >= 15
fvalue = 0
first = 16
last = 17
ignorehitpause = 1

;--fvが０ならadd０なので書かなくてもいいかなまとめるとどうしても０除算になる、なんでだろうね
[state 8150,5];-XYADD	1つですまないね。。やっぱ
type = varset;veladd
triggerall = numhelper(100)
trigger1 = time >= 15
trigger1 = fvar(14) != 0
fvar(16) = 0.5 / fvar(14) * var(28)
ignorehitpause = 1

[state 8150,5];-YYADD	1つですまないね。。やっぱ
type = varset;veladd
triggerall = numhelper(100)
trigger1 = time >= 15
trigger1 = fvar(15) != 0
fvar(17) = 0.5 / fvar(15) * ifelse(helper(100),rootdist y > 0,-1,1)
ignorehitpause = 1

[state 8150,5];-YYADD	1つですませると楽
type = veladd
triggerall = numhelper(100)
trigger1 = time >= 15
x = fvar(16)
y = fvar(17) 
ignorehitpause = 1

;---------------速度制限おーばーしたらその分戻し
;----一回分両方もどさないといけない！
;--２等辺の時2回実行されてもこまる。真横真縦で実行されないかもこれ
[state 8150,5];-YYADD	reverseADD	
type = veladd
triggerall = numhelper(100)
triggerall = time >= 15
trigger1 = vel x > 7 || vel x < -7
trigger2 = vel y > 7 || vel y < -7
x = fvar(16) * -1
y = fvar(17) * -1
ignorehitpause = 1

;--------------制限部、はぐとかで位置入れ替わるといきなり符合反転しちゃうことない？確認して







