ID = 7025
pos = ceil(ifelse(teamside = 1,fvar(28),319 - fvar(28))),ceil(fvar(29)) 
postype = left
sprpriority = -6
bindtime = -1
removetime = -1
ownpal = 1
scale = 0.5,0.5
ignorehitpause = 1
supermovetime = 999

[state 7000,test];満タン時に背景光る	のをけす
type = removeExplod
trigger1 = fvar(10) < 15000
ID = 7025
;-------------------------ここまでバーストゲージ
[State -2];カウンター判定初期化
type = varset
triggerall = numenemy
triggerall = var(33) > 0
triggerall = time >= ifelse(stateno=210,19,1)
trigger1 = enemynear,movetype != A
trigger2 = enemynear,statetype = L
trigger3 = !HITPAUSETIME
trigger3 = var(22) <= 128 + 64
var(33) = 0

[State -2];カウンター判定
type = varset
triggerall = numenemy
trigger1 = enemynear,movetype = A
trigger2 = var(22) > 128 + 64
var(33) = 1
persistent = 1
ignorehitpause = 1
;-------------ブラックカラーてんしょんMAX
[state 7000,debu2]
type =powerset
trigger1 = palno = 12
value = 2000
ignorehitpause = 1

[State -2]
type = powerset
trigger1 = !numpartner
trigger1 = roundstate < 2
trigger1 = roundsexisted > 0
value = 0

[state -2,helper partner];一撃用赤
type = Helper
triggerall = !NumHelper(770)
trigger1 = var(24) = 1 
name = "after image"
ID = 770
pos = 0,0
postype = p1
stateno = 770
ownpal = 1
size.height = 2
size.xscale = 0.5
size.yscale = 0.5

;--------------------------------enemynearの状態監視主にHITDEFとよろけなどの判定に
;----------------------仕様変更にともないmovetype＝A判定ぐらいしかつかわないかも
[state 5900,v46];44  くらい状態の長さをはかる	復帰不能時間減少に使う10秒ごとに減り始める？600F　
type = varadd
triggerall= numenemy
trigger1 = enemynear,movetype = H
trigger1 = enemynear,stateno != 150
trigger1 = enemynear,stateno != 152
trigger1 = enemynear,stateno != 154
var(44) = 1
ignorehitpause = 0

[state 5900,v46];44  くらいい状態の長さリセット　
type = varset
triggerall= numenemy
trigger1 = enemynear,movetype != H
trigger2 = enemynear,stateno = 150
trigger3 = enemynear,stateno = 152
trigger4 = enemynear,stateno = 154
var(44) = 0
ignorehitpause = 1

;------------fvar(5)　ヒットバック補正　最大ヤク2倍らしい
;---------------1秒以降増加開始、最大8秒
[state 5900,fv5];fv14  くらい状態の長さでX距離増加 基本乗数1
type = varset
triggerall= numenemy
trigger1 = var(44) < 60 
trigger2 = enemynear,movetype != H
trigger3 = enemynear,stateno = [120,155]
fvar(14) = 1
ignorehitpause = 0

;--数値不明、最大約2倍であるという。約。約。約って範囲広い
;----一律10％とすると1.8倍?んー？浮きと同じようなら最初少なくて後でどかんと？
[state 5900,fv5];fv14
type = varadd
trigger1 = var(44) = 60 * 1	;10%
trigger2 = var(44) = 60 * 2	;10%
trigger3 = var(44) = 60 * 3	;10%
trigger4 = var(44) = 60 * 4	;10%
trigger5 = var(44) = 60 * 5	;10%
trigger6 = var(44) = 60 * 6	;10%
trigger7 = var(44) = 60 * 7	;10%
trigger8 = var(44) = 60 * 8	;10%
fvar(14) = 0.1
ignorehitpause = 0

;------------fvar(15) 浮き補正　	数値不明
;---------------------------ヒットカウント＋var(33)=ヘルパーのヒットカウント
;--------浮き補正は6HItから。35HIT以降は減らない、数値不明、これも乗算形式？
;---6-35の間、6も含むから30? 1%ずつ、最大30%OFFとしてみる?
;とりがーhitcountは(HITCOUNTPERSIST=0でリセットされると0にされる,表記はつながってるのでまぎらわしい
[state -3,];相手のヒットカウントを計算して浮き補正
type = varset
trigger1 = hitcount>= 6
trigger1 = hitcount< 35
fvar(15) = 1 - (hitcount - 5) * 0.01
ignorehitpause = 1

[state -3,];浮き補正、35HIT以上固定数値  仮：最大0.7倍
type = varset
trigger1 = hitcount >= 35
fvar(15) = 0.7  
ignorehitpause = 1

[state -3,];ヒット途切れまたは５HIT以下のとき乗数１、変化させない
type = varset
triggerall= numenemy
trigger1 = enemynear,movetype != H
trigger2 = enemynear,stateno = [120,155]
trigger3 = hitcount < 6
fvar(15) = 1 
ignorehitpause = 0

