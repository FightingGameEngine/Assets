triggerall = var(35) <= 22
trigger1 = stateno != 3150
trigger1 = var(36) = 1
var(35)  = 0
ignorehitpause = 1



;--------------------ここからSB
;-------------SB起き上がり１０F不能フラグ  fv21  これは5120あたりでやって
[state 120x,]
type = varadd
triggerall = fvar(21) > 0
trigger1 = 1
fvar(21)  = -1
ignorehitpause = 1

[state 120x,]
type = varset
triggerall = fvar(21) <= 0
trigger1 = 1
fvar(21)  = 0
ignorehitpause = 1

;------------------------sb	fv22ガード不能時間減少
[state 120x,]
type = varadd
triggerall = fvar(22) > 0
trigger1 = 1
fvar(22)  = -1
ignorehitpause = 0

[state 120x,]
type = varset
triggerall = fvar(22) <= 0
trigger1 = 1
fvar(22)  = 0
ignorehitpause = 0

;------------------------sb	FV23受付フレーム増加カウンター
[state 120x,]
type = varadd
triggerall = fvar(23) > 0
trigger1 = 1
fvar(23)  = -1
ignorehitpause = 0

[state 120x,]
type = varset
triggerall = fvar(23) <= 0
trigger1 = 1
fvar(23)  = 0
ignorehitpause = 0

;---------------SB,０になったらガードフラグ解除
[state 120x,]
type = varset
triggerall = var(45) = 3
trigger1 = fvar(22) <= 0
var(45) = 0
ignorehitpause = 0

;-----このフラグはレバー後ろでシステムガード不能になる。
;---手動で（FDなど）直接１３０に送り込み、そこであたるとガードになる。
;----この間FDも出せないのでそのように設定すればOK
;---ガードノックバックでの連打の関係でどうしようか
[State 3660,];SB後遺症　30Fまたは１５Fガード不能になる　－＞FDも？
type = AssertSpecial
triggerall = var(59)
triggerall = fvar(22) > 0
trigger1 = fvar(23) = 0 && fvar(22) <= 28 
trigger2 = fvar(23) > 0 && fvar(22) <= 26 
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1

;---------V25　ガード状態0,1,2か食らい状態-1  st1でもやってる  超必,投げなら-3(バースト封じ)　それ以外-1
[state 120x,];通常状態
type = varset
triggerall = var(45) < 0
trigger1 = movetype != H
trigger1 = stateno != [120,155] 
var(45)  = -1
ignorehitpause = 1

[state 120x,];普通くらい
type = varset
triggerall= numenemy
triggerall = movetype = H
triggerall = gethitvar(guarded) = 0
triggerall = !(var(45)=3&&time=0)
trigger1 = 1;!HitShakeOver
trigger1 = enemynear,hitdefattr = sca,na,np,sa,sp
var(45)  = -2
ignorehitpause = 1

[State -2]
type = varadd
trigger1 = p2stateno != [150,155]
trigger1 = p2movetype = H
var(53) = 1
persistent = 1
ignorehitpause = 1
[State -2]
type = varset
triggerall = var(53) > 0
trigger1 = p2movetype != H
var(53) = 0
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(53) < 180
fvar(25) = 1
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(53) = [180,300)
fvar(25) = 0.95
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(53) = [300,420)
fvar(25) = 0.9
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(53) = [421,600)
fvar(25) = 0.8
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(53) = [600,840)
fvar(25) = 0.7
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(53) >= 840
fvar(25) = 0.6
ignorehitpause = 1

[state -2, displayb];
type = displaytoclipboard
trigger1 = 1
text = "var(22)=%d,fvar(6)=%f,var(33)=%d,fvar(23)=%f,var(48)=%d\n"
params = var(22),fvar(6),var(33),fvar(23),var(48)
ignorehitpause = 1


;--------------------------------------------------
;	⑨氏の赤朱秋葉の「獣を焦がす」に対応
;--------------------------------------------------
[State -2]
Type = LifeAdd
TriggerAll = NumEnemy > 0
TriggerAll = Enemy,AuthorName = "⑨" && Enemy,Name = "Akiha_Vermilion"
Trigger1 = Enemy,Var(47) = 1
Value = -5
Kill = 0

[State -2]
Type = PowerAdd
TriggerAll = NumEnemy > 0
TriggerAll = Enemy,AuthorName = "⑨" && Enemy,Name = "Akiha_Vermilion"
Trigger1 = Enemy,Var(47) = 1
Value = -26

;-------------------------------------
;      毒効果（ドロウィンアルカナ)
;-------------------------------------
[state -2, 0]
type = poweradd
triggerall = enemy,authorname = "Drowin arcana"
triggerall = enemy,fvar(20) > 0
trigger1 = power > 0
value = -1
[state -2, 0]
type = lifeadd
triggerall = enemy,authorname = "Drowin arcana"
triggerall = enemy,fvar(20) > 0
trigger1 = gametime % 7 = 0
value = -1
kill = 0
[State -2,0]
type = Palfx
triggerall = enemy,authorname = "Drowin arcana"
trigger1 = enemy,fvar(20) > 0
add = 100,0,110
mul = 220,220,220
time = 5
ignorehitpause = 1
;====================================================================================================
;■西行寺幽々子　霊符及び寿命相手ステート
;====================================================================================================
[State -2]
Type       = LifeAdd
TriggerAll = Enemy,AuthorName    = "Souki" && Enemy,Name = "Yuyuko Saigyouji"
Trigger1   = Enemy,Var(3)        = 1 || Enemy,Var(3) = 2
Trigger1   = GameTime%6          = 0
Value      = IfElse(Enemy,Var(3) = 1, -2, -3)
Kill       = 0


;脱魂の儀 
;移動 ;-------------------------------------------------------------------------------------- 
;振り向き抑制 
[State pos moving] 
type = AssertSpecial 
Triggerall = (Enemynear,Name = "Komachi Onozuka")*(Enemynear,AuthorName = "Mikage")*(TeamMode = single) 
trigger1 = (enemynear,stateno = 820)*(enemynear,anim = 823)*(enemynear,animelem = 6,13) 
trigger2 = (enemynear,stateno = 821)*(enemynear,anim = 823)*(enemynear,animelem = 6,43) 
flag = noautoturn 

;移動 
[State pos moving] 
type = Posadd 
Triggerall = (Enemynear,Name = "Komachi Onozuka")*(Enemynear,AuthorName = "Mikage")*(TeamMode = single) 
trigger1 = (enemynear,stateno = 820)*(enemynear,anim = 823)*(enemynear,animelem = 6,13) 
trigger2 = (enemynear,stateno = 821)*(enemynear,anim = 823)*(enemynear,animelem = 6,43) 
x = ceil(enemynear,fVar(24))*((enemynear,fVar(24)>=0)-(enemynear,fVar(24)<0)) 
y = -ceil(enemynear,fVar(25))*(statetype!=L) 

;statetype!=A+statetype!=Lの場合強制落下stateへ 
[State pos moving] 
type = Changestate 
Triggerall = (Enemynear,Name = "Komachi Onozuka")*(Enemynear,AuthorName = "Mikage")*(TeamMode = single) 
Triggerall = (statetype != A)*(pos y!=0)*(statetype!=L) 
trigger1 = (enemynear,stateno = 820)*(enemynear,anim = 823)*(enemynear,animelem = 6,13) 
trigger2 = (enemynear,stateno = 821)*(enemynear,anim = 823)*(enemynear,animelem = 6,43) 
value = 50 
;-------------------------------------------------------------------------------------- 