triggerall = roundstate = 2
triggerall = fvar(10) < 15000
triggerall = movetype = h
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080
trigger1 = time = 1
fvar(10) = (gethitvar(damage) * 3 + 100) * (gethitvar(hitcount) * 0.03 + 1)
ignorehitpause = 1

[state 7000,];行き過ぎリセット
type = varset
trigger1 = fvar(10) >= 15000
fvar(10) = 15000
ignorehitpause = 1


;-------------------理由不明できえるときあり。
;---暗転命令時、１Ｆ消える、MOVETIMEを時間通り設定するとなる？
;---消えるのは暗転させ側がバーストした後。相手側もバーストなど消えるという意味不明。
