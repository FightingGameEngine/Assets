scale		= fvar(2),fvar(1)

[State 0]
type		= VarAdd
trigger1	= time <= 10
fvar(2)	= 0.1

[State 0]
type		= VarAdd
trigger1	= time <= 10
fvar(1)	= 0.05

[State 0]
type		= VarAdd
trigger1	= time >= 70
trigger1	= fvar(1) > 0 
fvar(1)	= -0.025

[State 0]
type		= Varset
trigger1	= fvar(1) <= 0 
fvar(1)	= 0

[State 0]
type		= Destroyself
trigger1	= root,movetype = H
trigger2	= root,stateno != 3400
trigger3	= Animtime = 0
;-----------------------------------------------------------------------------
;扇
[Statedef 3410]
type    = A
movetype = I
physics = N
juggle = 5
poweradd = 0
anim = 3410
ctrl = 0

[State 200, 0]
type = BindToParent
trigger1 = time <= 150
time = 1
pos = -2,60

[State 200, 0]
trigger1 = 1
type = sprpriority 
value = -3

[State 1000, 1] 
type = PlaySnd
trigger1 = time = 0
value = 0, 7


