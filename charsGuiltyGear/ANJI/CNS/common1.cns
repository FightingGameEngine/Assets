;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = var(58) = 1
trigger2 = Anim = 20
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State -2, 0];空中ダッシュ時間リセット
type = varset
trigger1 = time = 0
v = 5
value = 0

[State 40 , 0];ハイジャンプじゃない時
type = PlaySnd
trigger1 = var(3) = 0
trigger1 = animtime = 0
value = s40,0
channel = 20
persistent=0

[State 40 , 0];ハイジャンプ時
type = PlaySnd
trigger1 = var(3) = 1
trigger1 = animtime = 0
value = s40,1
channel = 20
persistent=0

[State 40 , 0]
type = Explod
trigger1 = animtime = 0
anim = 9660
id = 800
postype = p1
pos = 0,17
sprpriority = 12
bindtime = 1
persistent = 0
ownpal = 1
scale = 0.5,0.5

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0


[State 40, 2]
type = VarSet
Trigger1 = var(58) = 0
trigger1 = command = "holdfwd"
Trigger2 = var(58) = 1
Trigger2 = EnemyNear,MoveType = H || Random <= 333
sysvar(1) = 1

[State 40, 3]
type = VarSet
Trigger1 = var(58) = 0
trigger1 = command = "holdback"
Trigger2 = var(58) = 1
Trigger2 = P2statetype != L
trigger2 = P2MoveType != H
Trigger2 = Random <= 500
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 4]
type = velset
trigger1 = AnimTime = 0
trigger1 = prevstateno != 100
trigger1 = prevstateno != 103
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40, 4]
type = velset
trigger1 = AnimTime = 0
trigger1 = prevstateno = 103
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))+ifelse(sysvar(1)=-2,0,1.4)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

