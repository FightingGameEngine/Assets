;-----------------------GGX,SB用新規ガード関係160
;------------------------SB失敗の　ガードモーション　絵はガードだけど硬直部。一定時間で通常に戻す
;--最初２F FDCできる、ってことはその２Fはガードできるってことにならない？
;--擬似FDとしてここでエフェクト変更と待機時間変更
;--さらに一定時間以後はSBにいけるように・・っややこし
[Statedef 160]
type    = S
movetype = I
physics = S
ctrl = 0
velest = 0,0

;---ガードフラグ3にする必要なし
;-------------------------再びSBへ、fvが25以下で擬似FDのとき。つまり擬似FD最低１Fやってからいけるようにする。
[State -1,SB];SB地上	ここでは３にしない。移動のみさせる	さらに擬似FDになってから、だからこれは上にお
type = ChangeState
value = ifelse(command = "SBS",130,131)
triggerall = fvar(22) <= 25 && var(45) = 2
triggerall = !var(24) && power >= 20 && fvar(21) = 0
triggerall = var(59)
triggerall = (command = "SBS" || command = "SBC" || command = "SBA")
triggerall = (command = "holdS" && command = "holdHS")
triggerall = var(58)=0
trigger1 = 1
ignorehitpause = 0

;----擬似FD,２F以降　
[state 120x,];ガード不能時間切れてもまだFDコマンドなら２にする最初から２でもよさげ。
type = varset
triggerall = var(45) = 2 || var(45) = 3
triggerall = power > 0 && !var(24)
triggerall = var(58)=0
triggerall = (var(59) && var(26)) || (var(59) = 0 && (var(26) = 1 || var(26)= 2))
;triggerall = (var(59) && var(26) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1 
var(45) = 2
ignorehitpause = 1

;--------GGXのみ足払いOK  GGX/XXの判断ははV2,間違えないで
;---失敗2F[から]なので擬似FDここでもいけるかも
[State -1, FD];擬似	SB/FD失敗 しゃがみへ	保険ループするのでタイム制限
type = ChangeState
value = 161
triggerall = var(45) = 2
triggerall = time >= 1
triggerall = command = "holdback" 
trigger1 = command = "holddown"
trigger1 = fvar(22) > 0

;---擬似FD:ガード不能フラグが0になってまだ入ってたらそのままガードかのなFDへ継続
[state 120x,]
type = changestate
triggerall = var(45) = 2
trigger1 = fvar(22) <= 0
value = (ifelse(command = "holddown",131,ifelse(var(58),131,130)))
ctrl = 1
ignorehitpause = 1

;25以下でもしFDはいってなければ
[state 120x,];SB　硬直終了。前の130～と結構早く終わる
type = changestate
triggerall = fvar(22) <= 25
trigger1 = var(26) = 0
trigger2 = power <= 0
trigger3 = command != "holdback" 
trigger4 = var(24)  
trigger5 = fvar(22) <= 0
value = 0
ctrl = 1
ignorehitpause = 0

;-----------------------------SB失敗モーションしゃがみ
[Statedef 161]
type    = C
physics = C
movetype = I
ctrl = 0
velest = 0,0

;---ガードフラグ3にする必要なし
;-------------------------再びSBへ、fvが25以下で擬似FDのとき。つまり擬似FD最低１Fやってからいけるようにする。
[State -1,SB];SB地上	ここでは３にしない。移動のみさせる	さらに擬似FDになってから、だからこれは上にお
type = ChangeState
value = ifelse(command = "SBS",130,131)
triggerall = fvar(22) <= 25 && var(45) = 2
triggerall = !var(24) && power >= 20 && fvar(21) = 0
triggerall = var(59)
triggerall = (command = "SBS" || command = "SBC" || command = "SBA")
triggerall = (command = "holdS" && command = "holdHS")
triggerall = var(58)=0
trigger1 = 1
ignorehitpause = 0

;----擬似FD,２F以降　
[state 120x,];ガード不能時間切れてもまだFDコマンドなら２にする最初から２でもよさげ。
type = varset
triggerall = var(45) = 2 || var(45) = 3
triggerall = power > 0 && !var(24)
triggerall = var(58)=0
triggerall = (var(59) && var(26)) || (var(59) = 0 && (var(26) = 1 || var(26)= 2))
;triggerall = (var(59) && var(26) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1 
var(45) = 2
ignorehitpause = 1

;--------GGXのみ足払いOK  GGX/XXの判断ははV2,間違えないで
;---失敗2F[から]なので擬似FDここでもいけるかも
[State -1, FD];擬似	SB/FD失敗 しゃがみへ	保険ループするのでタイム制限
type = ChangeState
value = 161
triggerall = var(45) = 2
triggerall = time >= 1
triggerall = command = "holdback" 
trigger1 = command = "holddown"
trigger1 = fvar(22) > 0

;---擬似FD:ガード不能フラグが0になってまだ入ってたらそのままガードかのなFDへ継続
[state 120x,]
type = changestate
triggerall = var(45) = 2
trigger1 = fvar(22) <= 0
value = (ifelse(command = "holddown",131,ifelse(var(58),131,130)))
ctrl = 1
ignorehitpause = 1

;25以下でもしFDはいってなければ
[state 120x,];SB　硬直終了。前の130～と結構早く終わる
type = changestate
triggerall = fvar(22) <= 25
trigger1 = var(26) = 0
trigger2 = power <= 0
trigger3 = command != "holdback" 
trigger4 = var(24)  
trigger5 = fvar(22) <= 0
value = 0
ctrl = 1
ignorehitpause = 0



;-----------------------------SB失敗モーション空中
[Statedef 162]
type    = A
movetype = I
physics = N
ctrl = 0

;---ガードフラグ3にする必要なし
;-------------------------再びSBへ、fvが25以下で擬似FDのとき。つまり擬似FD最低１Fやってからいけるようにする。
[State -1,SB];SB地上	ここでは３にしない。移動のみさせる	さらに擬似FDになってから、だからこれは上にお
type = null;ChangeState
value = 132
triggerall = fvar(22) <= 25 && var(45) = 2
triggerall = !var(24) && power >= 20 && fvar(21) = 0
triggerall = var(59)
triggerall = (command = "SBS" || command = "SBC" || command = "SBA")
triggerall = (command = "holdS" && command = "holdHS")
triggerall = var(58)=0
trigger1 = 1
ignorehitpause = 0

;----擬似FD,２F以降　
[state 120x,];ガード不能時間切れてもまだFDコマンドなら２にする最初から２でもよさげ。
type = varset
triggerall = var(45) = 2 || var(45) = 3
triggerall = power > 0 && !var(24)
triggerall = var(58)=0
triggerall = (var(59) && var(26)) || (var(59) = 0 && (var(26) = 1 || var(26)= 2))
;triggerall = (var(59) && var(26) != 7) || ((var(1) >= 1 && var(1) < 4) && var(22))
triggerall = command = "holdback" 
trigger1 = time >= 1 
var(45) = 2
ignorehitpause = 1

;--------GGXのみ足払いOK  GGX/XXの判断ははV2,間違えないで
;---失敗2F[から]なので擬似FDここでもいけるかも
[State -1, FD];擬似	SB/FD失敗 しゃがみへ	保険ループするのでタイム制限
type = ChangeState
value = 161
triggerall = var(45) = 2
triggerall = time >= 1
triggerall = command = "holdback" 
trigger1 = command = "holddown"
trigger1 = fvar(22) > 0

;25以下でもしFDはいってなければ
[state 120x,];SB　硬直終了。前の130～と結構早く終わる
type = changestate
triggerall = fvar(22) <= 25
trigger1 = var(26) = 0 
trigger2 = power <= 0  
trigger3 = command != "holdback" 
trigger4 = var(24)  
trigger5 = fvar(22) <= 0
value = 51
ctrl = 1
ignorehitpause = 0

[State 132, 3];--POSがすでに地上で速度が下にむかってる→着地OK
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4];上のが真になったらになったら停止
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 7];もしFDままだったらFDへ着地
type = ChangeState
triggerall = sysvar(0)
triggerall = var(45) = 2
trigger1 = command = "holdback" 
value = (ifelse(command = "holddown",131,ifelse(var(58),131,130)))


[State 132, 7];保険的、普通の着地
type = ChangeState
trigger1 = sysvar(0)
value = 52



