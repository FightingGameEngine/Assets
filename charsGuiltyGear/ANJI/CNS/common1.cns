type    = C
movetype= H
physics = C
anim = 151

[State 153, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 153, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
trigger2 = var(58)
trigger2 = p2statetype = C
statetype = C
physics = C

[State 153, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
Trigger2 =! EnemyNear,HitDefAttr = , NT, ST, HT
Trigger2 = EnemyNear,MoveType = A
trigger2 = var(58)
statetype = S
physics = S

