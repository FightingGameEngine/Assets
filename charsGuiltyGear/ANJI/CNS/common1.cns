;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = destroyself 
trigger1 = ishelper

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
trigger3 = numhelper(150)
x = 0

[State -2] 
type = varset
trigger1 = time = 0
v = 31
value = 0

[State 0, 5]
type = changestate
trigger1 = animtime = 0
trigger1 = Random <= 100
value = 1

[State -1]
type = Posset
trigger1 = time = 0
y = 0

[State 0, 5]
type = changestate
trigger1 = animtime = 0
trigger1 = Random <= 100
value = 2

