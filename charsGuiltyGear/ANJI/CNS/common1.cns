trigger1 = Time >= var(37)
value = 131
ctrl = 1

[State 153, 3]
type = null;CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 153, 4]
type = null;ChangeState
trigger1 = Time >= GetHitVar(hittime)
value = 131
