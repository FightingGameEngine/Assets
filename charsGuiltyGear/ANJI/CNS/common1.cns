trigger1 = Time%10 = 5
anim = 9666
postype = p1
pos = 20,5
sprpriority = 8
bindtime = 1
ownpal = 1
scale = 0.5,0.5
ID = 9666

[State 100 , 1]
type = PlaySnd
trigger1 = time = 0
value = s100,0

[State 200, 1]
type = PlaySnd
trigger1 = Animelemtime(3) = 1
trigger2 = Animelemtime(7) = 1
value = s100, 1

[State 100, 1]
type = VelSet
trigger1 = time >= 0
x = const(velocity.run.fwd.x)+ifelse(Time <= 25,Time * 0.2,5)

[State 100, 1]
type = VelSet
trigger1 = Vel X >= (const(velocity.run.fwd.x)+5)
x = (const(velocity.run.fwd.x)+5)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100 , 5]
type = ChangeState
triggerall = var(58) = 0
trigger1 = command != "holdfwd"
trigger2 = command = "holddown"
value = 103
;ctrl = 1

;HＳ
[State -3, Slash]
type = ChangeState
value = 240
Triggerall = Var(58)
triggerall = var(59) = 0
Triggerall = Vel X > 1.1||FrontEdgeBodyDist < 30
triggerall = p2bodydist X = [40,108]
triggerall = statetype != A
TriggerAll = p2statetype != L
trigger1 = prevstateno = 120
trigger1 = !moveguarded

[State 100, DashStop]
type = ChangeState
triggerall = var(58) = 1&&prevstateno!=[120,155]
triggerall = var(26) = 0
;triggerall = (ダッシュストップ条件)
trigger1 = inguarddist
trigger2 = p2MoveType = A
Trigger2 = P2BodyDist X = [-90,90]
trigger3 = P2BodyDist X <= 30
trigger3 = P2BodyDist Y >= -50
trigger4 = P2BodyDist X <= -25
value = 103
;ctrl = 1

[State 100, 3]
type = ChangeState
triggerall = var(58) = 0
trigger1 = command = "holdup"
value = 40

