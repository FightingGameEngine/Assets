ignorehitpause = 0

;--------------------V25=0通常　1JD -2FD---3SB
;---スライド停止はさすがにmugenに従っとく？いやしかし・・
;--基本ctrltime=slidetimeであるはず
[State 151, 2];デフォルトの設定	完全にそっくりには無理
type = VelSet
trigger1 = Time >= GetHitVar(slidetime)
trigger1 = Time >= var(37)
trigger2 = HitOver
trigger2 = Time >= var(37)
trigger3 = numhelper(150)
x = 0

[State 151, 3];FD2,SB3はここでも再入力できるのでこの条件はまずい
type = CtrlSet
trigger1 = Time >= var(37)
value = 1

[State 151, 4];設定時間終了、SBなら通常	これここで入力追加あるから、３じゃだめかも13？
type = ChangeState
trigger1 = Time >= var(37)
value = 130
ctrl = 1

[State 151, 3]
type = null;CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 151, 4]
type = null;ChangeState
trigger1 = Time >= GetHitVar(hittime)
value = 130
ctrl = 1

;---------------------------------------------------------------------------
; CGUARDHIT (shaking)
[Statedef 152]
type    = C
movetype= H
physics = N
velset = 0,0

[State 152, 1]
type = ChangeAnim
trigger1 = 1
value = 151
ignorehitpause = 1

[state 120x,];SB
type = varset
triggerall = var(58)
triggerall = var(59)
triggerall = time = 0
triggerall = var(45) < 2
triggerall = p2statetype != L
trigger1 = life <= 80
trigger1 = power >= 300
trigger2 = power >= 2000
var(45)  = 3
ignorehitpause = 0


[State -1,SB];130経由せず150にくることもあるので・・コマンド入ってたら３
type = varset
var(45) = 3
triggerall = !var(24) && power >= 20 && fvar(21) = 0
triggerall = var(59)
triggerall = !var(58)
triggerall = (command = "SBS" || command = "SBC" || command = "SBA")
triggerall = (command = "holdS" && command = "holdHS")
trigger1 = time = 0
ignorehitpause = 1

[State 150, 2];SB	ゲージ減らし2％	ガード硬直（成功）ではprevstateno有効にしておく？
type = poweradd
triggerall = prevstateno != [120,155]
triggerall = var(45) = 3
trigger1 = time = 0
value = -40
ignorehitpause = 1
persistent = 0

[State 150, 2];SB	減らしても成功ゲージ獲得
type = poweradd
triggerall = var(45) = 3
trigger1 = time = 0
value = 120
ignorehitpause = 1
persistent = 0

[state 120x,];SB　ガード不能時間を15に設定しなおし HITPAUSEでへる？へらない？減ると一瞬で不能時間終わる、たぶん減らない
type = varset
triggerall = var(45) = 3
trigger1 = time = 0
fvar(22) = 15
ignorehitpause = 1
persistent = 0

[state 120x,];SB　SB受付フレームのばし成功30Fに	 HITPAUSEでへる？へらない？んー？、たぶん減らない
 type = varset
triggerall = var(45) = 3
trigger1 = time = 0
fvar(23) = 30
ignorehitpause = 1
persistent = 0


[state -2,helper partner]
type = Helper
triggerall = var(45) = 3
trigger1 = time = 0
name = "SB HIT efect"
ID = 150
pos = 0,-55
postype = p1
stateno = 756
ownpal = 1
ignorehitpause = 1
size.xscale = 0.5
size.yscale = 0.75
persistent = 0
[State 1540, 4];光る
type = palfx
triggerall = var(45) = 3
trigger1 = time = 0
time = 4
add = 200,200,0
ignorehitpause = 1
persistent = 0
[state 120x,];----FD距離強制のばし、POSADD ちぇんすてふれーむで ２p側だと逆転してる気がする基本値設定して符号を乗算
type = posadd
triggerall = var(26)
trigger1 = HitShakeOver
x = -15 * ifelse(gethitvar(xvel) <= 0,1,-1) * facing
ignorehitpause = 1
persistent = 0

;--------------本体で引き戻しできる相手いない？確認できない
[state 120x,];----FD距離強制のばし、画面背のとき	擬似相手押し返し画面はし引き戻しのときはどうなる？相手は？
type =  width
triggerall = 0;var(25) = 2 
triggerall = BackEdgeBodyDist < 35
trigger1 = HitShakeOver
player = 35,0
ignorehitpause = 1
persistent = 1

;-----------------------JUSTガード　直前ガード
;----------v25=1　直前ガード成功	FDでもSBでもなくV23が23以上のとき（8F有効
;-------------------------直前ガード 専用実行
[state 120x,]
type = varset
triggerall = var(36) <= 1
triggerall = var(45) < 2
trigger1 = var(35) > 22
trigger1 = time = 0
var(36) = 1
ignorehitpause = 1
persistent = 0

[State 1540, 4];光る
type = palfx
triggerall = var(36) = 1
trigger1 = time = 0
time = 8
add = 255,255,255
ignorehitpause = 1
persistent = 0

[State 1540, 4];ＪＤ	テンション獲得。
type = poweradd
triggerall = var(36) = 1
trigger1 = time = 0
value = 40
ignorehitpause = 1
persistent = 0

[State 1540, 4];ＪＤ受付リセット	成功時のみ。
type = varset
triggerall = var(36) = 1
trigger1 = time = 0
var(35) = 0
ignorehitpause = 1
persistent = 0

;-----------------------摩擦調整
;---原作と離れ方違う、仕方ない。ガードはX０でも普通後ろに下がるはず
;--ADｄやめ、初速乗算でいいや　Jd,SBなら低く、他なら長くー＞見た目原作の長さになる
[State 1540, 4];でふぉると	
type = varset
trigger1 = time = 0
fvar(13) = ifelse(var(36) = 1 || var(45) =3 ,0.9,1.2)
ignorehitpause = 1
persistent = 0

;-----------------------------------------
;-----------------------ガードこうちょく計算部　ひとつですませられるかな？
[State 150, 2];がード硬直数値格納 (animtype)L0 M1 H2 B3 U4 D5	保険として必ずだいにゅー
type = varset
triggerall = !hitshakeover
trigger1 = time = 0
var(37) = GetHitVar(ctrltime)
ignorehitpause = 1

;----以下は、システムの違いでずれはあるでしょうが、しょうがないよ？
[State 150, 2];JUSTガード硬直数値格納 (animtype)L0 M1 H2 B3 U4 D5	2,3,3,4,4減る
type = varset
triggerall = !hitshakeover
triggerall = var(36) = 1
trigger1 = time = 0
var(37) = GetHitVar(ctrltime) - ifelse(GetHitVar(animtype) = 0,2,ifelse(GetHitVar(animtype) = 1,3,4))
ignorehitpause = 1

[State 150, 2];FDガード硬直数値格納 (animtype)L0 M1 H2 B3 U4 D5 2,3,3,4,5増
type = varset
triggerall = !hitshakeover
triggerall = var(36) = 2
trigger1 = time = 0
var(37) = GetHitVar(ctrltime) + ifelse(GetHitVar(animtype) = 0,2,ifelse(GetHitVar(animtype) = 1,3,4))
ignorehitpause = 1

[State 150, 2];SBガード硬直数値格納 地上２固定　空中4固定
type = varset
triggerall = !hitshakeover
triggerall = var(45) = 3
trigger1 = time = 0
var(37) = ifelse(statetype = A,4,2)
ignorehitpause = 1

[State 1540, 4];計算すんだら　ＪＤ受付フラグリセット	成功時のみ。
type = varset
triggerall = var(36) = 1
trigger1 = time = 0
var(36) = 0
ignorehitpause = 1
persistent = 0

[State 152, 3]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown"||var(58))

[State 152, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S &&(command = "holddown"||var(58))
statetype = C
physics = C

[State 152, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
trigger1 = !var(58)
statetype = S
physics = S

[State 152, 4]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 4

