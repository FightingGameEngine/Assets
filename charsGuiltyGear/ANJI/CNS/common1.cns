; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
;velset = 0,0

[State 45, 0];空中ダッシュのときダッシュvarリセット
type = VarSet
trigger1 = Time >= 0
trigger1 = var(4) >= 1
var(9) = 0

[State 45, 0]
type = VarSet
trigger1 = Time >= 0
trigger1 = var(2) = 1
var(2) = 2

[State 45, 0]
type = VarSet
trigger1 = Time >= 0
trigger1 = var(48) = 3
var(48) = 4

[State 45 , 0]
type = PlaySnd 
trigger1 = time = 0
value = s40,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
Trigger2 = var(58) = 1
Trigger2 = EnemyNear,MoveType = H || Random <= 333
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6];ダッシュ前
type = VelSet
trigger1 = Time = 2
trigger1 = var(9) = 1
trigger1 = vel X > 2.2
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = const(velocity.airjump.y)

[State 45, 6];ダッシュ前
type = VelSet
trigger1 = Time = 2
trigger1 = var(9) = 1
trigger1 = vel X  <= 2.2
trigger1 = sysvar(1) = 1
x = const(velocity.airjump.fwd.x)
y = const(velocity.airjump.y)

;[State 45, 6];ダッシュ垂直
;type = VelSet
;trigger1 = Time = 2
;trigger1 = var(9) = 1
;trigger1 = vel X > 2.2
;trigger1 = sysvar(1) = 0
;x = const(velocity.airjump.fwd.x)
;y = const(velocity.airjump.y)

;[State 45, 6];ダッシュ垂直
;type = VelSet
;trigger1 = Time = 2
;trigger1 = var(9) = 1
;trigger1 = vel X < -2.25
;trigger1 = sysvar(1) = 0
;x = const(velocity.airjump.back.x)
;y = const(velocity.airjump.y)

[State 45, 6];ダッシュ垂直
type = VelSet
trigger1 = Time = 2
trigger1 = var(9) = 1
trigger1 = sysvar(1) = 0
x = const(velocity.airjump.neu.x)
y = const(velocity.airjump.y)


[State 45, 6];ダッシュ後ろ
type = VelSet
trigger1 = Time = 2
trigger1 = var(9) = 1
trigger1 = sysvar(1) = -1
trigger1 = vel X >= -2.25
x = const(velocity.airjump.back.x)
y = const(velocity.airjump.y)

[State 45, 6];ダッシュ後ろ
type = VelSet
trigger1 = Time = 2
trigger1 = var(9) = 1
trigger1 = vel X < -2.25
trigger1 = sysvar(1) = -1
x = -4.1
y = const(velocity.airjump.y)

[State 45, 6]
type = VelSet
trigger1 = Time = 2
trigger1 = var(9) != 1
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

