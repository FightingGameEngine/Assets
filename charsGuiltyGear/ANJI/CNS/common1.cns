; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1];フォルトレスディフェンス時
type = ChangeAnim
triggerall= Var(26)
triggerall= var(58) = 0
trigger1 = Time = 0
value = 6000 + (statetype = C) + (statetype = A)*2

[State 120, 1];フォルトレスディフェンスじゃない時
type = ChangeAnim
triggerall= Var(26) = 0
triggerall= var(58) = 0
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State type];フォルトレスディフェンス時
type = StateTypeSet
;triggerall = var(26)
trigger1 = var(58) = 0
trigger1 = statetype != A
trigger1 = command !="holddown"
trigger2 = var(58) = 1
trigger2 = statetype != A
statetype = S

[State type]];フォルトレスディフェンス時
type = StateTypeSet
;triggerall = var(26)
trigger1 = var(58) = 0
trigger1 = statetype != A
trigger1 = command ="holddown"
trigger2 = var(58) = 1
trigger2 = statetype != A
statetype = C

[State 120, 2];フォルトレスディフェンスじゃない時
type = StateTypeSet
;triggerall = var(26) = 0
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3];フォルトレスディフェンスじゃない時
type = StateTypeSet
;triggerall = var(26) = 0
trigger1 = Time = 0 && statetype = C
physics = C

[State -1, AI]
Type = StateTypeSet
TriggerAll = Var(58)
TriggerAll = StateType != A
Trigger1 = P2StateType = A
StateType = S
Physics = S
IgnoreHitPause = 1

[State -1, AI]
Type = StateTypeSet
TriggerAll = Var(58)
TriggerAll = StateType != A
Trigger1 = P2StateType = C
StateType = C
Physics = C
IgnoreHitPause = 1

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

