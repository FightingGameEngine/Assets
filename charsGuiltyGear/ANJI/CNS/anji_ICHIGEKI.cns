Trigger1 = Time = 0
fvar(2) = 0.5+random%40*0.1

[State -2]
Type = VarSet
Trigger1 = Time = 0
;Trigger1 = IsHelper(2008) || IsHelper(2108)
fvar(3) = 30*(Pi/180.0)

[State 2007, 変数増減]
Type = null;VarAdd
Trigger1 = fvar(3) < 10
fvar(3) = .3*time*(Pi/180.0)

[State 7000, VarSet]
type = Varadd
trigger1 = IsHelper(3601)
ignorehitpause = 1
fvar(3) = (1+random%100*0.05)*(Pi/180.0)

[State 7000, VarSet]
type = Varadd
trigger1 = IsHelper(3602)
ignorehitpause = 1
fvar(3) = -(1+random%100*0.05)*(Pi/180.0)
