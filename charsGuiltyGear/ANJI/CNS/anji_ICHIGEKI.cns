[State 2]
Type = VelSet
Trigger1 = 1
X = fvar(1)*Cos(fvar(3))+((ifelse(Facing=1,(enemynear,pos x-Pos x),(Pos X-enemynear,pos x))-10)/(30+random%70))
Y = -fvar(2)*Sin(fvar(3))+(((enemynear,pos y-Pos y)-40)/(50+random%60))

[State 2]
Type = VelSet
Trigger1 = parent,AnimElem = 21
X = (-10+random%20)*60
Y = (-10+random%20)*60

;-------------------------
[state 3601]
type = angleset
Trigger1 = (vel x != 0)
Value = atan(Vel Y/Vel X)*(-180.0/pi)+((Vel X<0)*180)

[state 3601]
Type = AngleSet
Trigger1=(vel x=0)
Value = ifelse(vel y<0,90,-90)

[state 3601]
Type = AngleDraw
trigger1 = 1

