;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2,DEBUG-skeletor]
type = DisplayToClipboard
trigger1 = 1
;text="spada = %3d, P2BodyDist X = %d P2BodyDist Y = %d heman= %3d AI= %3d\n\Credits: made by kain The Supreme."
;params = var(40),floor(P2BodyDist X),floor(P2BodyDist Y),var(15),var(20)
text="armor = %3d, P2BodyDist X = %d P2BodyDist Y = %d heman= %3d AI= %3d\n\Credits: made by kain The Supreme."
params = var(11),floor(P2BodyDist X),floor(P2BodyDist Y),var(15),var(20)

[State -2, StopAI]
type = VarSet
triggerall = var(58) > 0
trigger1 = RoundState != 2
trigger2 = !Alive
var(58) = -2
IgnoreHitPause = 1

[State -2, Simplifier]
type = VarSet
trigger1 = var(58) = 1
trigger2 = var(20):=0
var(20) = 1
IgnoreHitPause = 1

; AI SECTION
[State -2, guard]
type = ChangeState
value = 132
triggerall = p2movetype = A || (enemy, NumProj >= 1)
triggerall = P2bodydist X <= 70 || (enemy, NumProj >= 1)
triggerall = P2life != 0
triggerall = statetype = A
triggerall = var(0) = 1
triggerall = ctrl
triggerall = stateno != 132
trigger1 = p2statetype = A
trigger2 = (enemy, NumProj >= 1)
trigger3 = (enemy,numhelper >= 1)

[State -2, guard]
type = ChangeState
value = 130
triggerall = p2movetype = A || (enemy, NumProj >= 1)
triggerall = P2bodydist X <= 70 || (enemy, NumProj >= 1)
triggerall = statetype != A
triggerall = var(0) = 1
triggerall = ctrl
triggerall = stateno != 120
trigger1 = p2statetype != C
trigger2 = (enemy, NumProj >= 1)
trigger3 = (enemy,numhelper >= 1)

[State -2, guard]
type = ChangeState
value = 131
triggerall = p2movetype = A || (enemy, NumProj >= 1)
triggerall = P2bodydist X <= 70 || (enemy, NumProj >= 1)
triggerall = statetype != A
triggerall = var(0) = 1
triggerall = ctrl
triggerall = stateno != 130
trigger1 = p2statetype = C
trigger2 = (enemy, NumProj >= 1)
trigger3 = (enemy,numhelper >= 1)


; Stand Light Punch
[State -2, AI-Stand Light Punch]
type = ChangeState
value = 200
triggerall = p2statetype != L
triggerall = (p2bodydist X < 30) && var(20) = 1 && enemy, alive = 1 && (statetype = S) && (ctrl)
trigger1 = stateno = 215 ||stateno = 215 || stateno = 205
trigger1 = movehit && random < 300
trigger3 = p2statetype = S
;---------------------------------------------------------------------------
; Stand hard Punch
[State -2, AI-Stand hard Punch]
type = ChangeState
value = 210
triggerall = (p2bodydist X < 38) && var(20) = 1 && enemy, alive = 1 && (statetype = S) && (ctrl)
triggerall = p2statetype != L
trigger2 = stateno = 200 || stateno = 205
trigger2 = movehit && random < 300
trigger1 = stateno = 210 || stateno = 215
trigger1 = movehit && random < 300
trigger3 = p2statetype = S
;---------------------------------------------------------------------------
; Stand low kick
[State -2, AI-Stand low kick]
type = ChangeState
value = 205
triggerall = (p2bodydist X < 50) && var(20) = 1 && enemy, alive = 1 && (statetype = S) && (ctrl)
triggerall = p2statetype != L
trigger2 = stateno = 210 || stateno = 200
trigger2 = movehit && random < 300
trigger1 = stateno = 205 || stateno = 215
trigger1 = movehit && random < 300
trigger3 = p2statetype = S

;---------------------------------------------------------------------------
; Stand hard Kick
[State -2, AI-Stand hard Kick]
type = ChangeState
value = 215
triggerall = p2bodydist X < 50 && var(20) = 1 && (enemy, alive = 1) && (statetype = S) && (ctrl)
triggerall = p2statetype != L
trigger2 = stateno = 210 || stateno = 205
trigger2 =  movehit && random < 300
trigger1 = stateno = 215 || stateno = 200
trigger1 = movehit && random < 300
trigger3 = p2statetype = S

; Stand power punch
[State -1, Stand Power Punch]
type = ChangeState
value = 250
triggerall =var(20) = 1 && (statetype = C) && (ctrl) && random < 300
trigger1 = stateno = 200 && movecontact && random < 300
trigger2 = stateno = 210 && movecontact && random < 300
trigger3 = stateno = 215 && movecontact && random < 300
trigger4 = stateno = 205 && movecontact && random < 300

[State -2, Crouching Light Punch]
type = ChangeState
value = 400+10*(random%2)
triggerall = (p2bodydist X <= 50) && var(20) = 1 && (statetype = C) && (ctrl)
trigger2 = stateno = 405 && movecontact && random < 300
trigger3 = stateno = 410 && movecontact && random < 300
trigger4 = stateno = 400 && movecontact && random < 300
trigger1 = p2statetype = C || p2statetype = S

[State -2, Crouching low kick]
type = ChangeState
value = 405+10*(random%2)
triggerall = (p2bodydist X <= 50) && var(20) = 1 &&(statetype = C) && (ctrl) && (enemy, alive = 1)
trigger1 = p2statetype = C || p2statetype = S
trigger2 = stateno = 400 && movecontact && random < 300
trigger3 = stateno = 410 && movecontact && random < 300
trigger4 = stateno = 405 && movecontact && random < 300

[State -2, Jump Light Punch]
type = ChangeState
value = 600+10*(random%2)
triggerall = var(20) = 1 && (enemy, alive = 1) && (statetype = A) && (ctrl)
trigger1 = (p2statetype = A) && (ctrl) && random < 300
