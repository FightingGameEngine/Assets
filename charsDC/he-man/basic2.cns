[Statedef -3]

;stop sound run
[State -3, StopSnd]
type = StopSnd
triggerall = stateno != 100
triggerall = stateno != 192
trigger1 = time = 5
channel= 10

[State -3, AnimAltHeman]
type = VarSet
trigger1 = stateno = 0
v = 15
value = 0

[State -3, SetAI]
type = VarSet
triggerall = Alive
triggerall = IsHomeTeam
trigger1 = TeamSide = 2
trigger2 = MatchNo > 1
var(58) = 1

