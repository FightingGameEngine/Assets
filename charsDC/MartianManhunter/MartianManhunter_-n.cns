;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State Debug Display]
type = DisplayToClipboard
text = "%f %f %f %f "
params = pos x,pos y,P2BodyDist X, P2BodyDist Y;Pos X,Pos Y
trigger1 = 1

[State Append]
type = AppendToClipboard
text = "%d %d %d %d %d"
params = prevstateno,FrontEdgeDist,NumExplod,NumProj,NumHelper;BackEdgeDist,var(8),NumHelper
trigger1 = 1

[State -2]
type = SelfState
triggerall = stateno != 7722
triggerall = StateType = A && MoveType != A
trigger1 = Win
value = 7722

;------------------------------------
;run into screen
[State -2]
type = ChangeState
triggerall = roundstate = 2
triggerall = Movetype != H && Stateno != 7827 
trigger1 = BackEdgeDist < -10 -const(size.ground.front)-const(size.ground.back)
trigger1 = StateType != A
value = 7827

;---------------------------------------------
;Pos Y
[State -2]
type = PosSet
trigger1 = PrevStateno = 0 && Pos Y != 0
trigger1 = StateType != A
y = 0

;-----------------------------------
;Pos Y
[State -2]
type = PosSet
trigger1 = PrevStateno = [100,107] 
trigger1 = StateType != A && Pos Y != 0
y = 0

;-------------------------------------
;Life
[State -2]
type = varset
trigger1 = !var(30)
var(30) = floor(LifeMax/(100))

[State -2]
type = varset
trigger1 = !var(31)
var(31) = floor(const(data.life)/LifeMax/(100))

[State -2]
type = varset
trigger1 = !var(33)
trigger1 = numenemy > 1
var(33) = floor(enemy(1),LifeMax/(100))

;---------------------------------
;Flight
[State -2]
type = varadd
trigger1 = var(54) = [1,1320]
var(54) = 1

[State -2]
type = varset
trigger1 = var(54) > 1320
trigger2 = StateType != A && var(54)
trigger2 = stateno != 1330
trigger3 = roundstate = 3
var(54) = 0

[State -2]
type = AssertSpecial
trigger1 = var(54)
flag = noairguard

;---------------------------------
[State -2]
type = AttackMulSet
trigger1 = var(56) != 4
trigger1 = roundstate = 2
value = 0.7

[State -2]
type = null;DefenceMulSet
trigger1 = var(56) != 4
trigger1 = roundstate = 2
value = 0.5

;--------------------------------
[State -2]
type = null;Ctrlset
trigger1 = roundstate < 2
value = 0

;-------------------------------------------------------
;Launcher reset
[State -2]
type = Varset
trigger1 = var(29)
trigger1 = p2movetype != H
var(29) = 0
ignorehitpause = 1 

;-----------------------------------
[State -1, Light Hit]
type = VarSet
triggerall = var(19)
trigger1 = movetype != A
trigger2 = p2movetype != H
var(19) = 0

;-----------------------------------
[State -1, Medium Hit]
type = VarSet
triggerall = var(20)
trigger1 = movetype != A
trigger2 = p2movetype != H
var(20) = 0

;---------------------------------------------------------------
[State -1, Hard Hit]
type = VarSet
triggerall = var(21)
trigger1 = movetype != A
trigger2 = p2movetype != H
var(21) = 0

;---------------------------------------------------------------
