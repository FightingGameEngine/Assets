trigger1 = fvar(2) = (0,30)
fvar(3) = ATan(fvar(4)/fvar(2))*180/Pi

[State 8620, VarSet]
type = VarSet
trigger1 = var(3) >= 4
trigger1 = fvar(2) < 0
fvar(3) = 180+ATan(fvar(4)/fvar(2))*180/Pi

[State 8620, VarSet]
type = VarSet
trigger1 = var(3) >= 4
trigger1 = fvar(2) = 0
