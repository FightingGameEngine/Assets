; Beastboy's constants file

[Data]
life = 1000             ;Amount of life to start with
attack = 100            ;attack power (more is stronger)
defence = 100           ;defensive power (more is stronger)
fall.defence_up = 50    ;Percentage to increase defense everytime player is knocked down
liedown.time = 60       ;Time which player lies down for, before getting up
airjuggle = 15          ;Number of points for juggling
sparkno = 2             ;Default hit spark number for HitDefs
guard.sparkno = 40      ;Default guard spark number
KO.echo = 0             ;1 to enable echo on KO
volume = 0              ;Volume offset (negative for softer)

IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1   ; 0.8333 for scaling 4:3 mvsc -- 
yscale = 1  ; Vertical scaling factor.
ground.back = 12     ;Player width (back, ground)
ground.front = 16   ;Player width (front, ground)
air.back = 12       ;Player width (back, air)
air.front = 15       ;Player width (front, air)
height = 80          ;Height of player (for opponent to jump over)
attack.dist = 120    ;Default attack distance
proj.attack.dist = 120 ;Default attack distance for projectiles
proj.doscale = 1     ;Set to 1 to scale projectiles too
head.pos = 0, -95  ;Approximate position of head
mid.pos = 5, -60   ;Approximate position of midsection
shadowoffset = -1     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 5.9, -6.0 ;Run forward (x, y)
run.back = -4.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-9.8    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)

[Movement]
airjump.num = 3      ;Number of air jumps allowed (opt)
airjump.height = 40  ;Minimum distance from ground before you can air jump (opt)
yaccel = .5       ;Vertical acceleration
stand.friction = .85;  ;Friction coefficient when standing
crouch.friction = .82; ;Friction coefficient when crouching
stand.friction.threshold = 7          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .2       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 15           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 30   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -3  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .55    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 3      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0,10            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 2          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .1         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

[Quotes]
victory1 = "Watch out! Endangered species comin' through! "
victory2 = "Preeeeeeesenting... the real me! The Changeling!... in the verdant flesh! "
victory3 = "As far as changelings go, you're good... but I, young Jedi, am the master! "
victory4 = "Steel, go! Let us sluggo the Nancies! "
victory5 = "God, you'd think you jerks could come up with snappier dialogue."
victory6 = "This the best you've got? I've been on tougher stairmasters."
victory7 = "Titans together!!!"



