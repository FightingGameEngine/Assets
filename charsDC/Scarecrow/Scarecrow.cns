;----------------------------CVG TEMPLATE-------------------------------------------
;VARIABLES
;-----------------------------------------------------------------------------------
;var(2) -Statedef 810 Throw Player State
;var(3) Statedef -2-Damage damper
;!gethitvar(isbound) -Statedef 820 Thrown p2 Custom state
;var(1) - Statedef -2 Display To Clipboard
;var(50) - Statedef -2 Display to Clipboard
;var(17) -Statedef -3 Explod
;var(39) -statedef -3 Explod
;var(37) -statedef -3 Explod
;var(48) -Combos for Artificial Intelligence
;var(0)  -statedef -1 Artificial Intelligence
;----------------------------------------------------------------------------------
;----------------------------------------------------------------------------------
;----------------------------------------------------------------------------------

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2
guard.sparkno = s8001
KO.echo = 0
volume = 255
IntPersistIndex = 50
FloatPersistIndex = 20

[Size]
xscale = 1 ;Horizontal scaling factor.
yscale = 1 ;Vertical scaling factor.
ground.back = 35 ;Player width (back, ground)
ground.front = 35 ;Player width (front, ground)
air.back = 18  ;Player width (back, air)
air.front = 22 ;Player width (front, air)
height = 60  ;Height of player (for opponent to jump over)
attack.dist = 160   ;Default attack distance
attack.width = 4,4  ;Default attack width
proj.dist = 90  ;Default attack distance for projectiles
proj.attack.dist = 90 ;Default projectiles attack distance
proj.doscale = ;0 Set to 1 to scale projectiles too
head.pos = 1, -83 ;Approximate position of head
mid.pos = 1, -53  ;Approximate position of midsection
shadowoffset = 0 ;Number of pixels to vertically offset the shadow
draw.offset = 0,0 ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd = 2.7   ;Walk forward
walk.back = -2.7 ;Walk backward
run.fwd = 7      ;Run forward (x, y)
run.back = -7,-3 ;Hop backward (x, y)
jump.neu = 0,-9.0;Neutral jumping velocity (x, y)
jump.back = -3.2 ;Jump back Speed (x, y)
jump.fwd = 3.2   ;Jump forward Speed (x, y)
runjump.fwd = 4.2
runjump.back = -4.4
airjump.neu = 0, -8.9
airjump.fwd = 2.5 ;Air jump speeds (opt)
airjump.back = -2.55

[Movement]
airjump.num = 0  ;Number of air jumps allowed (opt)
airjump.height = 35 ;Minimum distance from ground before you can air jump (opt)
yaccel = .41 ;Vertical acceleration
stand.friction = .80 ;Friction coefficient when standing
crouch.friction = .80 ;Friction coefficient when crouching
air.friction = .80  ;Friction coefficient when air



;---------------------------------------------------------------------------
; Win state decider
;---------------------------------------------------------------------------
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose 1 - Bow
;---------------------------------------------------------------------------
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0


[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 666666,1
volume = 0
channel = -1
;lowpriority = -1
freqmul = 1.0
loop = 0


[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1



;---------------------------------------------------------------------------
; Introduction
;---------------------------------------------------------------------------
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190


[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = nomusic

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = s666666,39
volume = 0
channel = 8

[State 0, dark]
type = Palfx
trigger1 = Animelem = 14
time = 4
add = -150,-150,-150

[State 0, dark]
type = Palfx
trigger1 = Animelem = 15
time = 4
add = -120,-120,-120

[State 0, dark]
type = Palfx
trigger1 = Animelem = 16
time = 4
add = -90,-90,-90

[State 0, dark]
type = Palfx
trigger1 = Animelem = 17
time = 4
add = -60,-60,-60

[State 0, dark]
type = Palfx
trigger1 = Animelem = 18
time = 4
add = -25,-25,-25

[State 191, tumblez]
type = Explod
trigger1 = RoundState != 0
persistent = 0
anim = 191
postype = p1
pos = -260, 0
velocity = 4.2, 0
removetime = 148
ontop = 1

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Taunt
;---------------------------------------------------------------------------
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, 1]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 191, Snd 2]
type = PlaySnd
trigger1 = animelem = 1
value = s666666,38
volume = 255

[State 195, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


