trigger1 = Anim != 4505
x = 8
Y = 8

[State 4505, velocity2]
type = VelSet
trigger1 = Anim = 4505
trigger1 = AnimElem = 2, >= 0
Y = 4
x = 2

[State 4505, invincibility] ; the character cannot be hit until he has fully entered on the stage
type = NotHitBy

trigger1 = BackEdgeBodyDist <= 0
value = SCA
time = 2

[State 4505, invincibility] ; if partner was KOed, appear being invincible
type = NotHitBy
trigger1 = Partner, Life <= 0
value = SCA
time = 6

[State 4505, screen bound] ; Prevents the camera from following the char
type = ScreenBound
trigger1 = 1
value = 0

[State 4505, 3]
type = VelSet
triggerall = BackEdgeBodyDist >= 0
trigger1 = FrontEdgeBodyDist <= 0	; he has reached the other side of the screen
trigger2 = partner, life <= 0		; his partner has just died
trigger2 = (Time >= 50) || (P2BodyDist X = [-100, 100])
trigger3 = P2Dist X < 0                 ; his enemy is behind him
trigger4 = P2BodyDist X = [-100, 100]
trigger4 = Win
trigger5 = Win
trigger5 = Time >= 20
x = 0
y = 0

[State 4505, end state] ; the character does not attack his opponent if:
type = ChangeState
triggerall = BackEdgeBodyDist >= 0
trigger1 = FrontEdgeBodyDist <= 0	; he has reached the other side of the screen
trigger2 = Partner, Life <= 0           ; his partner has just died
trigger2 = (Time >= 50) || (P2BodyDist X = [-100, 100])
trigger3 = P2Dist X < 0                 ; his enemy is behind him
trigger4 = P2BodyDist X = [-100, 100]
trigger4 = Win
trigger5 = Win
trigger5 = Time >= 20
value = 4506
ctrl = 1



[State 4505, end state] ; cancel if:
type = ChangeState
triggerall = BackEdgeBodyDist <= 0
trigger1 = Time >= 100
value = 4506
ctrl = 1


;---------------------------------------------------------------------------
; Landing
[Statedef 4506]
type = S
movetype = I
physics = N
anim = 47
sprpriority = 2

ctrl = 0

[State 4505, 0]
type = PosSet
trigger1 = Time = 0
y = 0

[State 4505, 5]
type = NotHitBy
trigger1 = 1
value = SCA
time = 6

[State 4505, 10]
type = ChangeState
trigger1 = AnimTime >= 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 0] ;Clear all int variables
type = VarRangeSet
trigger1 = roundno = 1
value = 0
last = 49

[State 5900, 1] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0


[State 5900, 7]
type = VarSet
triggerall = NumPartner
trigger1 = RoundState < 2
trigger1 = Var(51) = 0
v = 51
value = 1

[State 5900, 10] ;Intro W/Partner
type = TagIn
triggerall = partner, stateno != [4502,4504]	; Partner not waiting outside the screen (thus on stage)
triggerall = NumPartner
triggerall = ID > Partner,ID
trigger1 = roundno = 1
trigger1 = Time = [0, 1]
trigger1 = RoundState <= 2
trigger1 = Partner, Life > 0
trigger1 = StateNo != [4502, 4504]
stateno = 4502
partnerstateno = 190

[State 5900, 11] ;Intro
type = ChangeState
trigger1 = roundno = 1
trigger1 = !NumPartner ; partner does not exist
value = 190


