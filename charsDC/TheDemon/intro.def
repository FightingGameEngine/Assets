; Introduction cutscene for etrigan.

; This storyboard has multiple scenes.
; Each scene uses two overlay anims, one for the picture, and
; another for the text.
; The fadein and fadeout parameters are used to fade one screen
; to the next.

[SceneDef]
spr = intro.sff
startscene = 0         ;Starting scene number (for debugging)


;------------------------------------

[Scene 3]
; Fade
fadein.time = 60       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 15
fadeout.col = 255,255,255
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 160,0   ;Default position for all layers
layer0.anim =  50       ;Anim action number
layer0.offset = 0,32   ;Position offset
layer0.starttime = 0   ;Time to start display
layer1.anim =  1
layer1.offset = 0,176
; Music
; Total time
bgm = ending.mid
bgm.loop = 0
end.time = 460


;Background image
[Begin Action 50]
50,0, 0,0, -1

[Scene 2]
; Fade
fadein.time = 25
fadein.col = 255,255,255
fadeout.time = 15
;fadeout.col = 255,255,255
clearcolor = 0,0,0
bg.name = sheet1
; Overlay Anims (from 0 to 9)
; Total time
end.time = 2000

[sheet1def]

[sheet1]; sheet 1 up
type = normal
spriteno = 50,1
iD =9
start = -160,0
layer = 1
velocity = 0,0 ; -0.4

[sheet1CtrlDef]
CtrlID = 9
layer = 1

[sheet1Ctrl]
type = VelSet
time = 200
y = -0.3



[Scene 4]
; Fade
fadein.time = 25
fadein.col = 255,255,255
fadeout.time = 15
;fadeout.col = 255,255,255
clearcolor = 0,0,0
bg.name = sheet2
; Overlay Anims (from 0 to 9)
layer5.anim =  11
layer5.offset = 0,-80
layer5.starttime = 0
; Total time
end.time = 5350

[sheet2def]

[sheet2]; sheet back
type = normal
spriteno = 99,99
layer = 1
mask=1
velocity = 0,0
iD =8

[sheet2]; sheet 1 up
type = normal
spriteno = 0,0
iD =9
start = -160,0
layer = 1
velocity = 0,0 ; -0.4

[sheet2CtrlDef]
CtrlID = 9
layer = 1

[sheet2Ctrl]
type = VelSet
time = 200
y = -0.3

;action
[Begin Action 11]
11,0,0,0,5325
11,1,0,0,5
11,2,0,0,5
11,3,0,0,5
11,4,0,0,5
11,5,0,0,5
11,6,0,0,5
11,7,0,0,5



