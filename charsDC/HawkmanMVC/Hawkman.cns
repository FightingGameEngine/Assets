; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12
velset = 0,0
facep2 = 1

[state 52, Dust]
type = removeexplod
trigger1 = time = 1
id = 8881

[State 0, PalFXWiz]
type = PalFX
trigger1 = time = 1
time =1
add = 0,0,0
mul = 200,231,200
sinadd = -80,-80,-80,10
invertall = 0
color = 256

[State 12, 1]
