;---------------------------------------------------------------------------
; Soco fraco abaixado
; CNS difficulty: easy
; Description: Ataque simples abaixado. O parâmetro de HitDef's guardflag
;     é ajustado para "L", significando que o golpe deve ser defendido
;     abaixado(crouching), e não em pé ou pulando.
;     Como em todos os light attacks, é bo manter os parâmetros de slidetime
;     e o  hittime em números pequenos, so the opponent isn't
;     stunned for too long. For all crouching attacks you have to
;     remember to set the attr parameter to indicate that it is crouching
;     attack. In this case, "C, NA" stands for "crouching, normal attack".
;     The HitDef's priority is set at 3, instead of the default of 4,
;     so this attack has a lower priority than most others, meaning the
;     player will get hit instead of trading hits with the opponent if
;     their attack collision boxes (Clsn1) intersect each other's Clsn2
;     boxes at the same time.
[Statedef 400]
type    = C
movetype= A
physics = C
juggle  = 5
poweradd= 15
ctrl = 0
anim = 400

[State 400, Sound Light punch]
type = playsnd
trigger1 = time = 0
value = S0, 6

[State 400, 1]
type = HitDef
trigger1 = Time = 0
attr = C, NA			;Atributos: Standing, Normal Attack
damage = 20, 0			;Dano que o golpe causa, dano na defesa
animtype = Light		;Tipo de animação: Light, Medium, Heavy, Back (def: Light)
guardflag = MA			;Flags on how move is to be guarded against
hitflag = MAF			;Flags of conditions that move can hit
priority = 4, Hit		;Attack priority: 0 (least) to 7 (most), 4 default
				;Hit/Miss/Dodge type (Def: Hit)
pausetime = 7, 8		;Tempo de pausa do atacante, tempo de vibração do oponente
sparkno = 0			;Spark anim no (Def: set above)
sparkxy = -10, -46		;X-offset posição para o "hit spark" em relação ao p2,
				;Y-offset for the spark rel. to p1
hitsound = S2, 0		;Som a se ouvir na hora do hit
guardsound = 6, 0		;Sound to play on guard
ground.type = Low		;Type: High, Low, Trip (def: Normal)
ground.slidetime = 1		;Tempo que o oponente vai para trás
ground.hittime  = 9     	;Tempo que o oponente fica em "hit" state
ground.velocity = -5		;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8	;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = Low			;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3		;X-velocity at which opponent is pushed,
					;Y-velocity at which opponent is pushed
air.hittime = 9			;Time before opponent regains control in air

[State 400, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

