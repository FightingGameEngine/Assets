;----------------------------CVG TEMPLATE-------------------------------------------
;VARIABLES
;-----------------------------------------------------------------------------------
;var(0) -statedef -1 Artificial Intelligence
;var(2) -Guard Crush Feature
;var(18) -K.O sounds
;var(48) -Combos for Artificial Intelligence
;var(50) - Death count
;----------------------------------------------------------------------------------
;----------------------------------------------------------------------------------
;----------------------------------------------------------------------------------

[Data]
;Amount of life to start with
life = 1000
;attack power (more is stronger)
attack = 100
;defensive power (more is stronger)
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 50
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = s8001
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 255
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 50
FloatPersistIndex = 20

[Size]
xscale = 1 ;Horizontal scaling factor.
yscale = 1 ;Vertical scaling factor.
ground.back = 30 ;Player width (back, ground)
ground.front = 30 ;Player width (front, ground)
air.back = 18  ;Player width (back, air)
air.front = 22 ;Player width (front, air)
height = 60  ;Height of player (for opponent to jump over)
attack.dist = 160   ;Default attack distance
attack.width = 4,4  ;Default attack width
proj.dist = 90  ;Default attack distance for projectiles
proj.attack.dist = 90 ;Default projectiles attack distance
proj.doscale = 0;0 Set to 1 to scale projectiles too
head.pos = 1, -83 ;Approximate position of head
mid.pos = 1, -53  ;Approximate position of midsection
shadowoffset = 0 ;Number of pixels to vertically offset the shadow
draw.offset = 0,0 ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd = 2.8  ;Walk forward
walk.back = -2.1  ;Walk backward
run.fwd = 7    ;Run forward (x, y)
run.back = -7,-4.5 ;Hop backward (x, y)
jump.neu = 0,-9.0 ;Neutral jumping velocity (x, y)
jump.back = -3.7  ;Jump back Speed (x, y)
jump.fwd = 3.2   ;Jump forward Speed (x, y)
runjump.fwd = 6.4
runjump.back = -4.4
airjump.neu = 0, -8
airjump.fwd = 2.5 ;Air jump speeds (opt)
airjump.back = -2.55

[Movement]
airjump.num = 0  ;Number of air jumps allowed (opt)
airjump.height = 35 ;Minimum distance from ground before you can air jump (opt)
yaccel = .41 ;Vertical acceleration
stand.friction = .80 ;Friction coefficient when standing
crouch.friction = .80 ;Friction coefficient when crouching
air.friction = .80  ;Friction coefficient when air

[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "What's nowhere but everywhere except when something is?  -Nothing"
victory2 = "What's strong enough to smash ships but still fears the sun?  -Iceberg"
victory3 = "What has hands but can't clap?  -Clock"
victory4 = "The less you have the more they're worth.  -Friends"
victory5 = "I am as strong as a rock, but a word can destroy me. What am I?  -Silence"
victory6 = "I am the son of water, but if water touches me I die. What am I?  -Salt"
victory7 = "You struggle to regain me, when I'm lost you struggle to obtain me. What am I?  -Time"
victory8 = "What must be broken before it can be use?  -Egg"
victory9 = "I can be a member of a group but I can never blend in. What am I?  -Individual"
victory10 = "Light as a feather yet no man can holt it long.  -Breath"
victory11 = "What's black and white but red all over?  -Newspaper"
victory12 = "I am heavy forward, but backwards I am not. What am I?  -TON"
victory13 = "Some tried to hide some tried to cheat, in time will always let us meet. What am I?  -Death"
victory14 = "I can be broken without being held. Given and then taken away. What am I?  -Promise"
victory15 = "What's green and red and goes round and round?  -Frog in a blender"
victory16 = "I can fill a room but just one heart, others may have me but I can't be shared. What am I?  -Loneliness"
victory17 = "I am worthless to one but priceless to two. What am I?  -Love"
victory18 = "I can bring tears to your eyes and resurrect the dead. What am I?  -Memory"
victory19 = "None suffer to have me, but do from my lack. What am I?  -Sleep"
victory20 = "I am given and taken, I was there from your first breath and will follow you till death. What am I?  -Name"
; END


