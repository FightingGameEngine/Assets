;-------------------------
; STAND
;-------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = changeanim
trigger1 = Anim != 0 && (Anim != 5 && Anim != 3)
trigger2 = ( Anim = 5 || Anim = 3 )  && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 5] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

