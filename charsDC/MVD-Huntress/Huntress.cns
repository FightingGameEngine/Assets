anim =  193
ID = 193
pos = -17,0
postype = p1  ;p2,front,back,left,right
removetime = -2
scale = 0.9,0.9
sprpriority = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem=1
value = S192,0
volume = 0




[State 192, 2]
type = ChangeState
trigger1 = AnimTime = -10
value = 0
