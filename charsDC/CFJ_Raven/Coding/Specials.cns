trigger1 = animelem = 2
value = 760,3

[State 220, Swing Snd]
type = playsnd
trigger1 = animelem = 2
value = 760,1

[State 220, 1]
type = Projectile
trigger1 = AnimElem = 3
projanim = 1023
projID = 1023
projpriority = 1
projremovetime = 19
projremove = 0
projscale = 1, 1.5
projshadow = -1
offset = 75,8
attr = S, SP
damage   = 40,0
animtype = hard
guardflag = MAD
hitflag = MA
pausetime = 12,12
hitsound   = S2,2
sparkno = S9995
guard.sparkno = s13351
sparkxy = 10,-60
guardsound = S130,0
ground.type = High
ground.slidetime = 20
ground.hittime = 30
air.hittime = 40
guard.ctrltime = 20
ground.velocity = -2,-13
guard.velocity = -6
air.velocity = -1,-11
airguard.velocity = -6
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = -6
air.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
persistent = 0
fall = 0
air.fall = 0
fall.recover = 0
