[State 3000, Super D]
type = ScreenBound;NotHitBy
trigger1 = anim=3000;time = 0;1;AnimElem = 2
value = 0;SCA;, NA, SA, AT
;time = 12

[State 50, 1]
type = ChangeAnim
trigger1 = anim = 3000 && time=300
value = 43

[State 50, 2]
type = velset
trigger1 = anim = 43 && time=300
x=-3
y=-2.5

[State 50, 3]
type = velset
trigger1 = BackEdgeBodyDist < 1 && vel x < 0
trigger2 = FrontEdgeBodyDist < 1 && vel x > 0
x= (vel x)*-1.1

[State 50, 3]
type = velset
trigger1 = ScreenPos Y > 239 && vel y > 0
trigger2 = ScreenPos Y < 40 && vel y < 0
y= (vel y)*-1.005

[State 1000, 7]
type = ChangeState
trigger1 = Anim = 43; && vel y > 2
value = 50
ctrl = 0
