[Quotes]
;Cyborg
victory1 = "How many heroes you know that are in both the Teen Titans and The Justice League?"
victory2 = "All right. I'm only going to say this once... BOOYAH!!!"
victory3 = "Boo-yah!"
victory4 = "I'm plugged into every computer on earth. Even yours."
victory5 = "Sorry. But you can't compite with the highest tech in the multiverse!"
victory6 = "I love being part of the Justice League, but I'll always be a Titan at heart."

;Vs Nightwing
victory7 = "Nightwing, don't pretend this is practice. Real fight, real win."

;Vs Beast Boy
victory8 = "Sorry, Gar. But there's no animal on Earth that can defeat me."

;Vs Raven
victory9 = "Nice fight you put up there, Raven. That was almost scary."

;Vs Starfire
victory10 = "It turns out those starbolts of yours really do measure up to my sonic booms, Star."

;Vs Deathstroke
victory11 = "The ride's over, Slade!"

;Vs Lex Luthor
victory12 = "It's the man that counts, not the machine, Luthor."

;Vs Megaman, Zero and X
victory13 = "It seems that arm cannon of yours really needs an upgrade, man. I might be able to help with that."

;Vs Iron Man and War Machine
victory14 = "That armor's no rival for me. Better luck next time."

;Vs Ultron, Sentinel and Brainiac
victory15 = "When it comes to two robots fighting each other, the one with the better tech always wins."

;Vs Iori Yagami
victory16 = "Hey boy! Nice haircut you have there. Lose a bet?"

;Vs Mai
victory17 = "And here I thought Starfire's costume showed too much."

;Vs Maxima
victory18 = "Looks like you could use some adjustments for your cybernetics. You just malfunctioned right before the match was over."

[Statedef 21]
type    = S
physics = S
sprpriority = 1

; Just to prevent strange behaviors...
[State 21, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0


[State 21, 1]
type = VelSet
triggerall = enemy, stateno != [190, 194]
trigger1 = command = "holdfwd"
x = 1.5

[State 21, 2]
type = VelSet
triggerall = enemy, stateno != [190, 194]
trigger1 = command = "holdback"
x = -1.2

[State 21, 3]
type = VelSet
triggerall = enemy, stateno != [190, 194]
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
x = 0

[State 21, 4]
type = ChangeAnim
triggerall = Vel X > 0
trigger1 = command = "holdfwd" && anim != 20
value = 20

[State 21, 4]
type = ChangeAnim
triggerall = Vel X < 0
trigger1 = command = "holdback" && anim != 21
value = 21

[State 21, 4]
type = ChangeAnim
triggerall = Vel X = 0
trigger1 = command != "holdfwd" && anim != 0
trigger1 = command != "holdback" && anim != 0
value = 0


[State 21, 5]
type = ChangeState
trigger1 = ctrl
value = ifelse((command = "holdfwd") || (command = "holdback"), 20, 0)

