
;-| Button Remapping |-----------------------------------------------------
[Remap]
x = x
y = y
z = z
a = a
b = b
c = c
s = s

;-| Default Values |-------------------------------------------------------
[Defaults]
; Default value for the "time" parameter of a Command. Minimum 1.
command.time = 15

; Default value for the "buffer.time" parameter of a Command. Minimum 1,
; maximum 30.
command.buffer.time = 1


;-| Super Motions |--------------------------------------------------------
;The following two have the same name, but different motion.
;Either one will be detected by a "command = TripleKFPalm" trigger.
;Time is set to 20 (instead of default of 15) to make the move
;easier to do.

[Command]
name = "ve"   ;Same name as above
command = ~D, DF, F, a+b
time = 20

[Command]
name = "ve"   ;Same name as above
command = ~D, DF, F, c
time = 20

;-| Special Motions |------------------------------------------------------
[Command]
name = "sgx"
command = ~F, D, DF, x

[Command]
name = "sgy"
command = ~F, D, DF, y


[Command]
name = "hbx"
command = ~D, DF, F, x

[Command]
name = "hby"
command = ~D, DF, F, y


[Command]
name = "atfx"
command = ~D, DB, B, x

[Command]
name = "atfy"
command = ~D, DB, B, y

[Command]
name = "dga"
command = ~D, DB, B, a

[Command]
name = "dgb"
command = ~D, DB, B, b



;-| Double Tap |-----------------------------------------------------------
[Command]
name = "DU"     ;Required (do not remove)
command = D, U
time = 10
[Command]
name = "DU"     ;Required (do not remove)
command = D, UF
time = 10
[Command]
name = "DU"     ;Required (do not remove)
command = D, UB
time = 10


[Command]
name = "FF"     ;Required (do not remove)
command = F, F
time = 10

[Command]
name = "BB"     ;Required (do not remove)
command = B, B
time = 10

[Command]
name = "DD"     ;Required (do not remove)
command = D, D
time = 10

[Command]
name = "DFDF"
command = DF, DF
time = 10

[Command]
name = "DBDB"
command = ~DB, DB
time = 10

;-| 2/3 Button Combination |-----------------------------------------------
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

[Command]
name = "hj"
command = a+b
time = 1

[Command]
name = "x+a"
command = x+a
time = 1

[Command]
name = "y+b"
command = y+b
time = 1

;-| Dir + Button |---------------------------------------------------------
[Command]
name = "down_a"
command = /$D,a
time = 1

[Command]
name = "down_b"
command = /$D,b
time = 1

;-| Single Button |---------------------------------------------------------
