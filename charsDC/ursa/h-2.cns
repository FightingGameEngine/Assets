;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]



;スピニングギア
[State -1, Light Kung Fu Blow]
type = ChangeState
value = 1300
triggerall = RoundState = 2
triggerall = Var(58) = 1
trigger1 = stateno = 610 && movehit
trigger1 = enemynear,statetype = A
trigger2 = stateno = [150,155]
trigger2 = p2bodydist x < 15
trigger2 = enemynear,statetype != A


;投げ
[State -1, Kung Fu Throw]
type = ChangeState
value = 830
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = statetype != A
triggerall = stateno != 100
triggerall = p2bodydist x < 3
triggerall = enemynear,statetype != A
triggerall = enemynear,statetype != L
triggerall = ctrl || ((stateno = 52) && time >= 1)
trigger1 = enemynear,stateno = [120,153]
trigger2 = enemynear,movetype != A
trigger2 = !numtarget



[State -3];立ちガードする
type = ChangeState
value = 130
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = p2StateType = A
triggerall = Statetype != A
triggerall = ctrl
Trigger1 = InguardDist || var(49)
Trigger1 = EnemyNear,MoveType = A
Trigger1 = enemy,numproj > 0 ||  Enemy,Numhelper > 0
Trigger2 = InguardDist || var(49)
Trigger2 = EnemyNear,HitDefAttr = , AA,AP


[State -3];しゃがみガードする
type = ChangeState
value = 131
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = p2StateType != A
triggerall = Statetype != A
triggerall = ctrl
Trigger1 = InguardDist || var(49)
Trigger1 = EnemyNear,MoveType = A
Trigger1 = enemy,numproj > 0 ||  Enemy,Numhelper > 0
Trigger2 = InguardDist || var(49)
Trigger2 = EnemyNear,HitDefAttr = , AA,AP



;中段
[State -1, Stand Light Punch]
type = ChangeState
value = 710
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = statetype != A
trigger1 = stateno = 430 && moveguarded

;しゃがみ強キック
[State -1, Crouching Strong Kick]
type = ChangeState
value = 440
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = stateno = 430 && movehit
trigger1 = Var(50) >= 2
trigger2 = p2bodydist x > 30


;しゃがみ弱パンチ
[State -1, Crouching Light Punch]
type = ChangeState
value = 400
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = Var(50) < 2
trigger1 = stateno = 430 && movehit
trigger1 = p2bodydist x <= 30


;しゃがみ弱キック
[State -1, Crouching Light Kick]
type = ChangeState
value = 430
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = p2bodydist X < 50
Triggerall = EnemyNear,statetype != A
Triggerall = EnemyNear,statetype != L
triggerall = statetype != A
trigger1 = ctrl || ((stateno = 52) && time >= 1)
trigger2 = stateno = 400 && movehit

;空中弱ｋ
[State -1, Jump Light Kick]
type = ChangeState
value = 630
triggerall = RoundState = 2
triggerall = Var(58) = 1
triggerall = p2bodydist X < 25
trigger1 = stateno = 4010

;ホーミング
[State -1, Jump Strong Kick]
type = ChangeState
value = 4000
triggerall = RoundState = 2
triggerall = Var(58) = 1
Triggerall = EnemyNear,statetype != L
triggerall = var(5) != 0
Trigger1 = !InguardDist && !var(49)
trigger1 = p2bodydist X > 80
trigger1 = ctrl
trigger1 = stateno != 4010
trigger2 = stateno = 6900
trigger2 = time = 32

;じゃんぷ強
[State -1, Jump Strong Punch]
