;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -1, ];この記述消せばAI入る
type = VarSet
trigger1 = var(58)=1
var(58) = 2

[State -2,];虫取り用
type = DisplayToClipboard
trigger1 = 1
text = "bl1=%d,bl2=%d,bl3=%f"
params = var(11),var(12),p2bodydist x;GetHitVar(fall.recovertime)
ignorehitpause = 1

[State -2, 8];ゲージはラウンド毎初期化
type = powerset
trigger1 = !NumPartner
trigger1 = RoundState != 2
value = 0


[State -2, 8]
type = AttackMulSet
