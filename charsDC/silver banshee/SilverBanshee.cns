movetype = H
physics = N
ctrl = 0
velset = 0,0

[State 1131, posset]
type = PosSet
trigger1 = Pos Y <= 0
y = 0

[State 1131, anim]
type = ChangeAnim
trigger1 = !time
value = ifelse(selfanimexist(5300),5300,5000)

[State 1131, back to normal]
type = SelfState
trigger1 = (Time > 75) && (Alive = 1)
value = 0
ctrl = 1

