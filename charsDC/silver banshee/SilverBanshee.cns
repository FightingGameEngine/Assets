;-----------------------------------------------------------------------------------------
;******************** VOLAR ********************
;---------------------------------------------------------------------------------------
;FLY MODE
[Statedef 8000]
type = A
ctrl = 0
anim = 8000
velset = 0,0

;Esta parte detiene al personaje
;cuando la tecla es soltada o la posicion Y es muy alta.
[State 8000, Stop1]
type = VelSet
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = command != "holdup"
trigger1 = command != "holddown"
trigger1 = Var(2) = 0
trigger2 = Pos Y < -350
x = 0
y = 0

[State 8000, Stop2]
type = ChangeAnim
trigger1 = command != "holdup"
trigger1 = command != "holddown"
trigger1 = Anim != 8000
value = 8000

;Esta parte hace ver al personaje como si volara.
[State 8000,fuwaVar(1)]
type = VarSet
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = command != "holdup"
trigger1 = command != "holddown"
trigger1 = Var(2) != 2
trigger2 = Var(2) = 2
trigger2 = Vel Y >= 1.5
v = 2
value = 1

[State 8000,fuwaVar(2)]
type = VarSet
trigger1 = Var(2) = 1
trigger1 = Vel Y <= -1.5
v = 2
value = 2

[State 8000,fuwaUp]
type = VelAdd
trigger1 = Var(2) = 1
y = -0.2

[State 8000,fuwaDown]
type = VelAdd
trigger1 = Var(2) = 2
y = 0.2

[State 8000,fuwaEnd]
type = VelSet
triggerall = Var(2) != 0
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
trigger3 = command = "holdup"
trigger4 = command = "holddown"
y = 0

[State 8000,fuwaEndVar]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
trigger3 = command = "holdup"
trigger4 = command = "holddown"
v = 2
value = 0

;Esta parte establece el límite de la altura a la que puede volar el personaje.
[State 8000, UpBorder]
type = PosSet
trigger1 = Pos Y < -500
y = -300

;Esta parte mueve al personaje hacia abajo cuando la tecla "abajo" es apretada.
[State 8000, GoDown1]
type = VelAdd
trigger1 = command = "holddown"
y = 0.3

[State 8000,GoDown2]
type = VelSet
trigger1 = command = "holddown"
trigger1 = Vel Y < 0 
y = 0

[State 8000, GoDown3]
type = ChangeAnim
triggerall = Anim != 8002
trigger1 = command = "holddown"
value = 8002

;Esta parte mueve al personaje hacia arriba cuando la tecla "arriba" es apretada.
[State 8000, GoUp1]
type = VelAdd
trigger1 = command = "holdup"
y = -0.3

[State 8000,GoUp2]
type = VelSet
trigger1 = command = "holdup"
trigger1 = Vel Y > 0 
y = 0

[State 8000, GoBackAnim]
type = ChangeAnim
triggerall = Anim != 8004
trigger1 = command = "holdup"
value = 8004

;Esta parte retrocede al personaje cuando la tecla retroceso es apretada.
[State 8000, GoBack1]
type = VelAdd
trigger1 = command = "holdback"
x = -0.2

[State 8000,GoBack2]
type = VelSet
trigger1 = command = "holdback"
trigger1 = Vel X > 0 
x = 0

[State 8000, GoBackAnim]
type = ChangeAnim
triggerall = Anim != 8003
trigger1 = command = "holdback"
value = 8003

;Esta parte avanza al personaje cuando la tecla adelante esta apretada.
[State 8000, GoFwd1]
type = VelAdd
trigger1 = command = "holdfwd"
x = 0.2

[State 8000,GoFwd2]
type = VelSet
trigger1 = command = "holdfwd"
trigger1 = Vel X < 0 
x = 0

[State 8000, GoFwdAnim]
type = ChangeAnim
triggerall = Anim != 8006
trigger1 = command = "holdfwd"
value = 8006

;Esta parte hace voltear al personaje cuando el oponente esta tras de él.
[State 8000,Turn]
type = Turn
trigger1 = P2bodydist X < -20


;Esta parte hace aterrizar al personaje cuando toca el piso.
[State 8000,Land]
type = ChangeState
trigger1 = Pos Y >= 0
value = 50
ctrl = 1

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = Time > 10 ;2
trigger1 = command = "fly"
value = 50
ctrl = 1

;Dando de alta a MegaSonico
[State 8000,End]
type = ChangeState
trigger1 = command = "mega sonico"
value = 1020
ctrl = 0

;Dando de alta a Rayo Sonico Volando
[State 8000,End]
type = ChangeState
trigger1 = command = "sonico volando"
value = 1021
ctrl = 0

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = command = "a"
value = 630
ctrl = 0

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = command = "b"
value = 640
ctrl = 0

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = command = "c"
value = 650
ctrl = 1

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = command = "x"
value = 600
ctrl = 1

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = command = "y"
value = 610
ctrl = 0

;This part make a character land 
;when c key is pushed.
[State 8000,End]
type = ChangeState
trigger1 = command = "z"
value = 620
ctrl = 0

;This part is required not to freeze a character
;when he win or lose.
[State 8000,WinLose]
type = ChangeState
trigger1 = Win = 1
trigger2 = Lose = 1
value = 50

;Flying from the ground
[Statedef 8002]
type = A
ctrl = 0
anim = 8000
velset = 0,-6

[State 810, 10]
type = PlaySnd
trigger1 = time = 0
value = 100,0

[State 810, 13]
type = ChangeState
trigger1 = Pos Y < -60
value =8000
ctrl = 0

