[Data]
life = 1000
attack = 105
defence = 100
fall.defence_up = 50
liedown.time = 65
airjuggle = 17
sparkno = 2
guard.sparkno = 00
KO.echo = 1
volume = 0
power = 3000

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 13
air.back = 12
air.front = 12
z.width = 3
height = 60
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 1
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
;draw.offset = 0,0

[Velocity]
walk.fwd = 1.8
walk.back = -1.8
run.fwd = 4.8, 1
run.back = -4.6, -3.8
jump.neu = 0, -8.6
jump.back = -2.7, 0
jump.fwd = 2.75, 0
runjump.back = -2.55, -8.1
runjump.fwd = 4, -8.1
airjump.neu = 0, -8.1
airjump.back = -2.55, -8.1
airjump.fwd = 2.5, -8.1

[Movement]
airjump.num = 2
airjump.height = 30
yaccel = .43
stand.friction = .85
crouch.friction = .82

[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "Oirme es morirse"
victory2 = "Y eso que no me has escuchado cantar"
victory3 = "Mi fuerza es de 10 hombres ¿La tuya de media niña?"
victory4 = "Libertaaaaad!!!"

