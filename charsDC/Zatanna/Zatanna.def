; Definition file for Zatanna, 
; Sprites by GM Spectre and new ones by Chimoru.
; Redone by and also Voices and Portraits supplied by Chimoru
; Coding by: Jhonny_DC, Kong, ZVitor, and Chimoru
; Some Hyper codes done and graciously given permission to use by ZVitor
; Sword attacks by Kong
; AI Provided by Colosse
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Zatanna"        ;Name of character
displayname = "Zatanna" ;Name of character to display
versiondate = 05,17,2014    ;Version date of character
mugenversion = 1.0  ;Version of M.U.G.E.N character works on
author = "GM Spectre, JhonnyDC, & Chimoru"
pal.defaults = 1      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Zatanna.cmd   ;Command set
cns     = Zatanna0.cns      ;Constants
st      = Zatanna0.cns
st1     = hypers.cns
st2     = specials.cns
stcommon = common1.cns ;Common states
sprite  = Zatanna.sff        ;Sprite
anim    = Zatanna.air       ;Animation
sound   = Zatanna.snd   ;Sound
pal1    = Zatanna.act       ;Palettes (can have up to 12)
pal2    = Zatanna01.act
pal3    = Zatanna02.act
pal4    = Zatanna03.act


; Arcade mode
[Arcade]
intro.storyboard =
ending.storyboard = 