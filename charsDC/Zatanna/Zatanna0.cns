; Zatanna GM Spectre & Jhonny DC
; constants and state file.
; --------------------------------------------
; Variables
; --------------------------------------------
; var(1) = WinPose/Intro Chooser
; var(2) = WinQuote Chooser
; var(3) = SuperJump Enabled
; var(10) = Flying Counter (-1 = Inactive; >0 = Active)

[Data]
life = 1000
attack = 120
defence = 110
fall.defence_up = 50
liedown.time = 25
airjuggle = 20
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20 
ground.front = 20 
air.back = 20
air.front = 20
height = 60
attack.dist = 160 
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0, -80
mid.pos = -2, -57
shadowoffset = 0
draw.offset = 0, 0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.6      
walk.back = -2.4    
run.fwd  = 7, 0    
run.back = -7,-3.8 ;
jump.neu = 0,-8.8    
jump.back = -3,-9   
jump.fwd = 3.5,-9   
runjump.back = -2.55,-8.1 
runjump.fwd = 6,-8.1      
airjump.neu = 0,-8.8      
airjump.back = -2.55      
airjump.fwd = 3 

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 40
yaccel = .5
stand.friction = .80
crouch.friction = .83
;air.friction = .80

[Quotes]
victory1 = "Believe in magic yet?"
victory2 = "Never mess with a magical chick."
victory3 = "Presto! You lose!"

