;Telekinetic Hyper

[State -2, After Image]
type = afterimage
trigger1 = numexplod(3301)>0 && Time%80 = 0
time = 80
ignorehitpause = 1
PalBright = 0, 0, 0
PalContrast =  47,114,251;255,50,50
PalAdd = 0, 0, 0
PalMul = 1,1,1
trans = none
Length = 20
FrameGap = 4

[State -2, Set Powered Up Attack]
type = AttackMulSet
trigger1 =  var(19) = 3
value = 1.1

[State -2, Set Powered Up Attack]
type = AttackMulSet
trigger1 =  var(19) = 0
value = 1

[State -2, VarSet]
type = VarSet
trigger1 = var(19)!= 0 && numexplod(3301) = 0
v = 19
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = var(19)!= 3 && numexplod(3301) > 0
v = 19
value = 3

[State -2, PalFX]
type = PalFX
triggerall = timemod = 20,0
trigger1 = numexplod(3301) > 0
trigger2= stateno = 100
trigger3= stateno = 110
time = 50
add = 0,0,60
color = 256;128
sinadd = 0,0,60,50
ignorehitpause = 1

;Remove Hyper Explodes

[State -2, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(3301)>0
trigger1 = lose
id = 3301

[State -2, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(3302)>0
trigger1 = lose
id = 3302
