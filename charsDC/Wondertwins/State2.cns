;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]
[State 0, PowerSet]
type = PowerSet
triggerall = enemynear, name ="Trainingroom"
trigger1 = power != 3000
value = 3000

[State Debug Display]
type = DisplayToClipboard
text = "%f %f %f %f "
params = pos x,pos y,P2BodyDist X, P2BodyDist Y;Pos X,Pos Y
trigger1 = 1

[State Append]
type = AppendToClipboard
text = "%d %d %d %d var(59) = %d"
params = prevstateno,FrontEdgeDist,BackEdgeDist,NumExplod,var(59);
;params = prevstateno,FrontEdgeDist,var(3),var(4),var(0);NumProj,NumHelper;
trigger1 = 1



[State -2, ChangeState]
type = ChangeState
trigger1 = stateno = 220
trigger1 = (animelem = 14) || (animelem = 15)||(animelem = 16)
trigger1 = p2dist X < 0
value = 0
ctrl = 1

;Hope w/o Intro
[State -2, Hope]
type = Helper
triggerall = palno != [3,5]
trigger1 = numhelper(1000) = 0 && RoundState != 0
type = normal
name = "Hope"
ID = 1000
pos = -70, -5
postype = p1
stateno = 1000
size.shadowoffset = -7
supermovetime = 9999
ownpal = 1

;---------------------------------------------
;Pos Y
[State -2]
type = PosSet
trigger1 = PrevStateno = [100,107] 
trigger1 = StateType != A && Pos Y != 0
y = 0

;------------------------------------
;run into screen

[State -2]
type = ScreenBound
trigger1 = P2StateNo = [9020,9030]
value = p2bodydist x < 30 && BackEdgeDist < 30


[State -2]
type = ChangeState
triggerall = roundstate = 2
triggerall = Movetype != H && Stateno != 7827 
trigger1 = BackEdgeDist < -10 -const(size.ground.front)-const(size.ground.back)
trigger1 = StateType != A
value = 7827

;-------------------------------------
;Life

[State -2]
type = varset
trigger1 = !var(30)
var(30) = 7;floor(LifeMax/(100))

[State -2]
type = varset
trigger1 = !var(31)
var(31) = floor(const(data.life)/LifeMax/(100))

[State -2]
type = varset
trigger1 = !var(33)
trigger1 = numenemy > 1
var(33) = floor(enemy(1),LifeMax/(100))

;-------------------------------------------------------
;Launcher reset
[State -2]
type = Varset
trigger1 = p2movetype != H
var(29) = 0
ignorehitpause = 1

;-----------------------------------
[State -2];Miss Hit
type = VarSet
triggerall = var(9)
trigger1 = movetype != A
var(9) = 0

;-----------------------------------
;[State -2];Light Hit
;type = VarSet
;triggerall = var(19)
;trigger1 = movetype != A
;trigger2 = p2movetype != H
;var(19) = 0

;-----------------------------------
[State -2];Medium Hit
type = VarSet
triggerall = var(20)
trigger1 = movetype != A
trigger2 = p2movetype != H
var(20) = 0

;-----------------------------------
[State -2];Hard Hit
type = VarSet
triggerall = var(21)
trigger1 = movetype != A
trigger2 = p2movetype != H
var(21) = 0

;-----------------------------------------------------


;---------------------------------------------------------------
;Hit Vars

[State -2,t]
type = varset
trigger1 = Time = 0
trigger2 = !gethitvar(isbound) 
v = 11
value = 12

[State -2,t]
type = varset
trigger1 = gethitvar(isbound)
v = var(11)
value = enemynear,prevstateno

[State -2,t]
type = varadd
trigger1 = gethitvar(isbound)
trigger1 = var(11) < 14
v = 11
value = 1



