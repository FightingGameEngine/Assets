trigger1 =  time=45
anim = 1911
ID =  1911
pos = -8,-88
postype = p1  ;p2,front,back,left,right
removetime = -2
scale = 1,1
sprpriority = 3
ontop = 0




[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0
