trigger1 = RoundState = 0
value = 191

[State 191, 1]
type = AssertSpecial
trigger1 = Time = [0,1000]
flag = Intro

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time=2
value = S191,0
volume = 0
channel = -1

[State 0, Explod]
