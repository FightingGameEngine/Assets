;--------------------------
;Stop Intro Sounds If Intro Is Skipped
[State -2, StopSnd]
type = StopSnd
triggerall = !time
trigger1 = StateNo != 10191
trigger1 = StateNo != 10192
trigger1 = StateNo != 10193
trigger1 = StateNo != 10194
trigger1 = StateNo != 10195
trigger1 = StateNo != 10200
channel = 1
;--------------------------
[State -2, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Starfire by HyperCombinationFinish"
;-----------------------------------------
;P.o.t.S Damage Dampener, MvC Style (from Mugen Fighter's Guild Help board)
[State -2, Damage based on hits]
type = VarSet
trigger1 = NumEnemy
trigger1 = StateNo != 3000
trigger1 = StateNo != 3013
trigger1 = StateNo != 3050
trigger1 = StateNo != 3100
trigger1 = StateNo != 3130
trigger1 = StateNo != 3200
trigger1 = StateNo != 3250
trigger1 = StateNo != 4001
trigger1 = StateNo != 4002
trigger1 = StateNo != 4003
fvar(12) = IfElse(EnemyNear,GetHitVar(HitCount)=0, 1, IfElse(EnemyNear,GetHitVar(HitCount)=1, .9, .8**EnemyNear,GetHitVar(HitCount)))
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type = varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(12) = 1

[State -2, Dampener itself]
type = attackmulset
trigger1 = 1
value = fvar(12)
ignorehitpause = 1

;-----------------------------------------
;P.o.t.S Back Attack Shenanigans Prevention (from Mugen Fighter's Guild Tips board)
[State -2, P2 Facing]
type = TargetFacing
trigger1 = MoveContact = 1 && NumTarget = 1
trigger1 = !(Target, HitshakeOver) && !(Target, HitFall) && (Target, Time <= 1)
value = ifelse(P2Dist x >= 0, -1, 1)
ignorehitpause = 1

;--------------------------
;Recovery Roll Stuff

[State -2, VarSet]
type = VarSet
trigger1 = (Var(0) = 1) && (MoveType != H)
var(0) = 0

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = S5, 15
;----------------------------
[State -3, Dashing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 100 ;Forward Dash
trigger2 = stateno = 105 ;Back Dash
value = S6, 9

[State -3, Falling Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5110
value = S4, 9

;-----------------------------
;Random Attacking Sounds
[State -3, PlaySnd]
type = PlaySnd
triggerall = time = 1
trigger1 = stateno = [200,250]
trigger2 = stateno = [400,450]
trigger3 = stateno = [600,651]
value = S7,1 +random%12
volume = 250
channel = 0
freqmul = 1.0
loop = 0
pan = 0

;-----------------------------
;Random Damage Sounds
[State -3, PlaySnd]
type = PlaySnd
triggerall = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070
trigger1 = time = 0
value = S8,1 +random%13
volume = 250
channel = -1
freqmul = 1.0
loop = 0
pan = 0

;------------------------------
;Flight Mode Check
[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(8) > 0)
v = 8;0
value = -1
ignorehitpause = 1
