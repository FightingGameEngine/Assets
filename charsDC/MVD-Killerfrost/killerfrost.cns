;---------------------------------------------------------------------------
; States file for Ice (throws/grapples)
;
;---------------------------------------------------------------------------
; Vars:
;   0: for Super Jump (0=vertical, 1=forward, -1=backward)
;   1: keep track of power level (for levelup sounds)
; Helpers:
;   0: superjump opponent position indicator
;   12: ice slick
;   15: ice maiden
; Explods:
;   10: ice shards when leaving "frozen" state
;  300: ice shards for grapple/freeze/push
; 3510: Absolute Zero (blizzard) snow
;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
; Throws / Grapples
;
; Freeze & Push down  (F + HP when close)  -- states 300-304
;   Ice "reaches out and touches someone"... namely her opponent. >:)
;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
; Freeze/push to the ground: strong punch + forward when near P2
[StateDef 3007]
anim = 3007
ctrl = 0
type = S
movetype = A
physics = S
velset = 0,0
poweradd = 100

[State 2000, 2]
type = PlaySnd
trigger1 = Time = 0
value = 3007,0

[State 3007, hitdef]
type = HitDef
trigger1 = Time = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = MAF         ;Affect only ground people who are not being hit
guardflag = M
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark (except for guard)
sparkxy = -50,-80
sprpriority = 1       ;Draw in front of p2
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down
;mindist =
;maxdist =
;snap = 0,0
sprpriority = 1
p2facing = 1
p1stateno = 3022
p2stateno = 3033

[State 300, missed]
type = ChangeState
trigger1 = AnimTime = 0
value = 3011
ctrl = 1


