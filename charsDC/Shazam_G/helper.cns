; Dash Smoke
[StateDef 6100]
Type = S
Physics = N

[State 0, Null]
Type = Null
Trigger1 = !Time
Trigger1 = (Root, StateNO = 105)
Trigger1 = Var(2) := 1
IgnoreHitPause = 1

[State 0, Explod]
Type = Explod
Trigger1 = !Time
Anim = 6006
ID = 6006
PosType = P1
Facing = Cond((Var(2)%2), -1, 1)
Pos = 0,0
Vel = -.3 * Cond((Var(2)%2), -1, 1), 0
Accel = -.3 * Cond((Var(2)%2), -1, 1), 0
Scale = .2,.2
SprPriority = 5
OwnPal = 1

[State 0, Explod]
Type = Explod
Trigger1 = !Time
Anim = 6004
ID = 6004
PosType = P1
Facing = Cond((Var(2)%2), -1, 1)
Pos = Cond((Var(2)%2), -10, 10),-30
Vel = 1 * Cond(!(Var(2)%2), -1, 1), 0
Accel = .075 * Cond(!(Var(2)%2), -1, 1), 0
Scale = .4,.4
SprPriority = 5
OwnPal = 1

[State 0, Null]
Type = Null
Trigger1 = !Time
Trigger1 = Var(0) := Root, Anim
Trigger1 = Var(1) := Root, AnimElemNO(0)
IgnoreHitPause = 1

[State 0, ChangeAnim]
Type = ChangeAnim
Trigger1 = 1
Value = 9999 
IgnoreHitPause = 1

[State 0, AngleDraw]
Type = AngleDraw
Trigger1 = Time <= 25
Scale = 1.5-((Time/25.0)*0.5), 1.0
IgnoreHitPause = 1

[State 0, PalFX]
Type = PalFX
Trigger1 = 1
Time = 999
Color = 0
IgnoreHitPause = 1

[State 0, Trans]
Type = Trans
Trigger1 = Time <= 25
Trans = addalpha
Alpha = Ceil(256.0-((Time/25.0)*256.0)), 256
IgnoreHitPause = 1

[State 0, VelSet]
Type = VelSet
Trigger1 = !Time
X = -.2 * Cond((Var(2)%2),-1,1)
IgnoreHitPause = 1

[State 0, VelAdd]
Type = VelAdd
Trigger1 = 1
X = -.02 * Cond((Var(2)%2),-1,1)
IgnoreHitPause = 1

[State 0, ScreenBound]
Type = ScreenBound
Trigger1 = 1
Value = 0
MoveCamera = 0,0
IgnoreHitPause = 1

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0
ignorehitpause = 1

[State 0, NotHitBy]
