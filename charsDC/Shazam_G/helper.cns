Trigger1 = Time = 25

; RUN_FWD FX
[Statedef 10100]
type    = S
physics = N
ctrl = 0
anim = 101

[State 10100, VS]
type = varset
trigger1 = time = 0
var(0) = root,var(10)

[State 10100, VS]
type = velset
trigger1 = time = 0
x = 14*var(0)

[State 103, Assert]
type = assertspecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 103, fadeout]
type = trans
trigger1 = 1
trans = addalpha
;alpha = ceil(256 - 12 * time), 12 * time
alpha = 256-ceil(256.0*time/10.0),ceil(256.0*time/10.0)

[State 103, End]
type = destroyself
trigger1 = time >= 10;20

