;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

[State -2, copyright]
type = DisplayToClipboard
trigger1 = 1
text = "Lion-o by Erradicator and Hystalin - www.presstart.cjb.net"

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

; play "ow" sound when hit
[state -3, 1]
type = varrandom
trigger1 = stateno = 5000
trigger1 = time = 1
v = 8

; play "ow" sound when hit
[state -3, 2]
type = playsnd
triggerall = time = 1
triggerall = var(8) < 500
trigger1 = stateno = 5001
trigger1 = anim != 5000 
trigger1 = anim != 5010 
trigger2 = stateno = 5040
trigger2 = random < 500
trigger3 = stateno = 5050
value = 6,7

; Play "ow" sound when hit (alternate)
[State -3, 3]
type = PlaySnd
triggerall = Time = 1
triggerall = var(8) >= 500
trigger1 = stateno = 5001
trigger1 = anim != 5000 ;Not hit light
trigger1 = anim != 5010 ;Not hit light
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
value = 6,8

