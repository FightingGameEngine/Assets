;Isso comanda o som de 
[State -3, Flash Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 100  ;dash
trigger2 = stateno = 1001 ;super soco
trigger3 = stateno = 1003 ;super soco Forte
trigger4 = stateno = 1800 ;voar inicio
trigger5 = stateno = 103  ;dash no ar
trigger6 = stateno = 3008 ;super move
value = 100, 0
channel = 0

; Desliga o som de corrida se acertado
[State -3, Flash Sound Off]
type = StopSnd
trigger1 = MoveType = H
channel = 0

