trigger1 = Var(26) = 0
trigger1 = Life <= 200
anim = 7007
sprpriority = 100
postype = Left
pos = ifelse(TeamSide = 2,190,5),55
bindtime = -1
supermove = 1
ownpal = 1
persistent = 0
ignorehitpause = 1
ontop = 1
size.shadowoffset = -9999
id = 7007

[State -2, Increment Var]
