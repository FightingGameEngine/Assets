
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 20    ;60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40
air.juggle = 15

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 35     ;Player width (back, ground)  15
ground.front = 36    ;Player width (front, ground) 16
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60      ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.6        ;Walk forward
walk.back = -2.4       ;Walk backward
run.fwd  = 6, 0        ;Run forward (x, y)
run.back = -6, -3.8    ;Hop backward (x, y)  0
jump.neu = 0,-8.4      ;Neutral jumping velocity (x, y)
jump.back = -2.55,-8.1    ;Jump back Speed (x, y)
jump.fwd = 2.5,-8.1       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.8      ;.
airjump.back = -3.55      ;Air jump speeds (opt)
airjump.fwd = 3.5         ;.

[Movement]
airjump.num = 0;1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = varset
triggerall = numenemy > 0
trigger1 = enemy,name="Scott Summers" || enemy,name="Cyclops"
trigger2 = enemy,name="Cyclops aka Scott Summers [MSH vs. SF + XML]"
trigger3 = p3name="Scott Summers" || p3name="Cyclops"
trigger4 = p3name="Cyclops aka Scott Summers [MSH vs. SF + XML]"
v = 9
value = 1


[State 180, 1]
type = ChangeState
trigger1 = random<=250
value = 181

[State 180, 1]
type = ChangeState
triggerall = var(9) != 1
trigger1 = random>=250
trigger1 = random<=500
value = 183

[State 180, 1]
type = ChangeState
trigger1 = random>=500
trigger1 = random<=1000
value = 187

