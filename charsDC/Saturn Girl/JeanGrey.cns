trigger1 = p2movetype != H
v = 14
value = 0

; End-of-tick updates

[State -2, Hit Count]
type = VarSet
trigger1 = var(17)
v = 19
value = HitCount

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = Null;PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0


[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 101
trigger3 = stateno = 106
value = 9000, 6

[State -3, Dash Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 100
trigger2 = stateno = 102
trigger3 = stateno = 105
value = 9000, 7

[State -3, Dash Sound] ;Memories hyper too
type = StopSnd
trigger1 = movetype = H
trigger2 = ctrl
channel = 12

[State -3, Dash Sound]
type = StopSnd
trigger1 = roundstate >= 2
channel = 11

[State 3001, 4]
type = Helper
trigger1 = numhelper(3333)=0 && win
trigger1 = time = 1
stateno = 3333
ID = 3333
pos = 0,0

[State -3, NotHitBy]
type = NotHitBy
trigger1 = NumHelper(1101) != 0
value = SCA

[State -3, Hitted]
type = PlaySnd
triggerall = Random < 850
triggerall = Time = 1
triggerall = Alive
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080 || stateno = 5100
value = 51, ifelse (stateno = 5100 || GetHitVar(animtype) = 2, 3, ifelse (GetHitVar(animtype) = 0, 1, 2))
channel = 0

[Quotes]
victory1 = "Everybody’s thinking nice, calm thoughts now, Ok?"
victory2 = "You're a firecracker...and I am an atom bomb!"
Victory3 = "Now I'm telepathically making you soil yourself."
Victory4 = "Mutants are not the ones to be feared. Rascists are."
Victory5 = "I am always Jean *and* always the Phoenix."
Victory6 = "I feel reborn!"
Victory7 = "I believe I've won!"
Victory8 = "As I was about to say..."telekinesis" means *mind* over *matter*."
Victory9 = "Fools! You dare to trifle with the Phoenix?"
Victory10 = "Mutants are not the ones mankind should fear."
Victory11 = "Shh. Stop talking. You have to let go of all that now."
Victory12 = "It's incredible. Eerie. It's like gazing into a distorted book."
Victory13 = "Cut the baloney! You and me... we've got some serious talking to do!"
Victory14 = "Oh, I have a knack for intuiting things. That's all."
Victory15 = "I choose to believe. That's what makes me Phoenix!"
Victory16 = "I was showing off!"
Victory17 = "Ha! Ha! Ha! Y-Y'know... Heh, heh... You're right! Ha! Ha! Ha!"
Victory18 = "When someone's hurt as badly as you are. It doesn’t tale a telepath to feel the pain."
Victory19 = "You're not dead yet. Not Quite. But you’re really pushing your luck."
Victory20 = "How can I explain? It’s... like colors on fire. Burning in every direction. "
Victory21 = "To know you’ll win against all the odds. It’s the wing of the Phoenix touching your heart with flame."
Victory22 = "Don’t threaten me and don’t ever endanger any of my students again. Don’t even think about it, or I’ll know."
Victory23 = "The more you annoy me the more I can’t help thinking about deconstructing you, molecule by molecule."
Victory24 = "Do I *look* like I’m losing control?"
Victory25 = "Is that what you think, I am?! The evil omnipotent firebird that consumes your thoughts? "
Victory26 = "I want to be all I’m capable of being, without becoming some nightmare woman in the process. "
...