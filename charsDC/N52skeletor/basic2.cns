;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2,DEBUG-skeletor]
type = DisplayToClipboard
trigger1 = 1
text="P2BodyDist X = %d P2BodyDist Y = %d intro= %3d AI = %d\n\Credits: made by kain The Supreme."
params = floor(P2BodyDist X),floor(P2BodyDist Y),var(2),var(20)

[State -2, StopAI]
type = VarSet
triggerall = var(58) > 0
trigger1 = RoundState != 2
trigger2 = !Alive
trigger3 = stateno=1100 || stateno =3010
trigger4 = stateno =3000 || stateno =3001 || stateno =3002 || stateno =3003
trigger5 = stateno =1010 || stateno =1011
trigger6 = stateno =1020 || stateno =1022
trigger6 = stateno =1040 || stateno =1041
trigger6 = stateno =1030 || stateno =1031
var(58) = -2
IgnoreHitPause = 1

[State -2, Simplifier]
type = VarSet
trigger1 = var(58) = 1
trigger2 = var(20):=0
var(20) = 1
IgnoreHitPause = 1

