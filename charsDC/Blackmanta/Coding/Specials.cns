ID = 1001
pos = -60,0
stateno = 1001
helpertype = normal
name = "p_beams"
keyctrl = 0
ownpal = 1
sprpriority = 6

[State 1000, End]
type=changestate
trigger1= !animtime
value=0
ctrl=1

