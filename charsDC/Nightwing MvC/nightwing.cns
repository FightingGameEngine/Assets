[Data]
life = 1000			;Amount of life to start with
attack = 118
defence = 120			;defensive power (more is stronger)
fall.defence_up = 50		;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15			;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40		;Default guard spark number
KO.echo = 0			
IntPersistIndex = 60
FloatPersistIndex = 40


[Size]
xscale = 1            ;Horizontal scaling factor.
yscale = 1            ;Vertical scaling factor.
ground.back = 15      ;Player width (back, ground)
ground.front = 16     ;Player width (front, ground)
air.back = 12         ;Player width (back, air)
air.front = 12        ;Player width (front, air)
height = 60           ;Height of player (for opponent to jump over)
attack.dist = 160     ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0      ;Set to 1 to scale projectiles too
head.pos = -5, -90    ;Approximate position of head
mid.pos = -5, -60     ;Approximate position of midsection
shadowoffset = 0      ;Number of pixels to vertically offset the shadow
draw.offset = 0,0     ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4           ;Walk forward
walk.back = -2.2          ;Walk backward
run.fwd  = 4.2, 0         ;Run forward (x, y)
run.back = -6.5,-4        ;Hop backward (x, y)
jump.neu = 0,-9.4         ;Neutral jumping velocity (x, y)
jump.back = -2.95,-8.5    ;Jump back Speed (x, y)
jump.fwd = 2.95,-8.5         ;Jump forward Speed (x, y)
runjump.back = -3.55,-8.5 ;Running jump speeds (opt)
runjump.fwd = 4,-8.5      ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 


[Quotes]
victory1 = "!!!I DO NOT HAVE BABY HANDS!!!!!!!!!!!!"
victory2 = "Better you're mature enough to realize your limits than to find out late that you don't. No, losing wasn't finding out. Going to ICU is."
victory3 = "We spend too much time chasing our own doubts."
victory4 = "(on communicator) I gotta tell ya, this job could be fun for you sometimes if you ever let it, B. (Batman: ...don't call me "B".)"
victory5 = "That's not democracy, it's larceny. "
victory6 = "Lives are in jeopardy. And life trumps death every time. "
victory7 = "Us versus them. Simple as that. Some headcase started acting out his criminal fantasy. And we were there to bust heads. "
victory8 = "Ahahaha, and so I kicked another dirt monster into a furnace, and then I was all like: "I bet that really burns you up." It didn't hear me though. It was on fire."
victory9 = "Some people prefer swords or lasers, but I like the baton, see? Just crack! Crack! Ka-kow! Right on the head! The knee! Crack! Clavicle! Whatever! Really gets the job done."
victory10 = "Did I just step in gum? Look at that calf, it could cut diamonds. (flexes)"
victory11 = "You're right. I'm no Batman. But I'm close enough to whoop your buttcheeks up and down like spaghetti noodles in a car. "
victory12 = "Now, listen close, because I'm only going to say this once. ................bruh. "
victory13 = "Batman doesn't dance."
victory14 = "Save that stuff for the club, not the ring."
victory15 = "Like you're the first person to try that move. It's called a CUP. My nuthugger is titanium too. My balls are precious to me."
victory16 = "Damn, just looking at you hurts my feelings."
victory17 = "I'MMA COMB THAT HEAD!!!!!! (Pow! Pow! Ka-krack!) HEAD-COMBING GOOD TIME!!!!! (Kra-kaack! PY-YOW!!)"
victory18 = "...strivin' and surviviiiinnnnn'....good times....ain't we lucky we got'em....bumm bum bum bummmmmm...."

