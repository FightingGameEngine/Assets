;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = GetHitVar(fall.recovertime) = 5070
value = 5070

[State 5000, 2]
type = ChangeState
trigger1 = var(40) = 100
trigger1 = Stateno != 5299
trigger1 = Pos Y < 0
value = 5299

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = GetHitVar(fall.recovertime) = 5400
trigger2 = GetHitVar(fall.recovertime) = 15400
trigger2 = Alive
value = 5400 + ifelse((GetHitVar(animtype) = [0,2]), GetHitVar(animtype), 0)

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = GetHitVar(fall.recovertime) = 5405
trigger2 = GetHitVar(fall.recovertime) = 5400
trigger2 = (!Alive) || (GetHitVar(fall) = 1)
value = 5405

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = PrevStateNo = 5230
value = 5030

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = !alive
trigger1 = Anim != 5030
trigger1 = GetHitVar(fall.recovertime) > 9999
value = 170

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) != [3,5]) || ((gethitvar(fall) = 0) && (gethitvar(yvel) = 0) && (GetHitVar(animtype) = [3,5]))
trigger1 = (Anim != 170) && (Anim != 5030) && (Anim != [5400,5405])
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = PosSet
trigger1 = PrevStateNo = 100
trigger2 = PrevStateNo = 105
Y = 0

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger1 = (Anim != 170) && (Anim != 5030)
trigger1 = (gethitvar(fall) = 1) || (gethitvar(yvel) != 0)
value = 5000 + 10*(GetHitVar(groundtype) = 0)

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = Anim = 5405
value = 5071

[State 5000, Changestate] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = A

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = Anim = 170
value = 5230

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 5001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 5001]
type    = S
movetype= H
physics = S

[State 5001, 1]
type = VarSet
trigger1 = Time = 0
v = 11
value = GetHitVar(hittime)

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
triggerall = AnimTime = 0
trigger1 = Anim != 5007
trigger1 = Anim != [5400,5402]
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 5000, 4] ;Freeze anim
type = ChangeAnim
triggerall = (Anim = [5005,5007]) || (Anim = [5015,5017])
trigger1 = var(21) > 8
trigger1 = (Anim = 5005) || (Anim = 5016)
trigger2 = var(21) > 14
trigger2 = Anim = 5006
trigger3 = var(21) > 24
trigger3 = Anim = 5007
trigger4 = var(21) > 6
trigger4 = Anim = 5015
trigger5 = var(21) > 20
trigger5 = Anim = 5017
value = anim

[State 5001, 1]
type = VarAdd
trigger1 = var(21) > 0
v = 11
value = -1

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5001, 6]
type = ChangeState
triggerall = HitOver 
trigger1 = Anim != 5007
trigger2 = Anim = 5007 && AnimTime = 0
value = 0
ctrl = 1

[State 5001, 2]
type = ChangeState
triggerall = var(40) >= 100
trigger1 = Anim = 5005
trigger1 = Animelem = 3
trigger2 = Anim = 5006
trigger2 = Animelem = 4
trigger3 = Anim = 5007
trigger3 = Animelem = 6
trigger4 = Anim = 5015
trigger4 = Animelem = 3
trigger5 = Anim = 5016
trigger5 = Animelem = 4
trigger6 = Anim = 5017
trigger6 = Animelem = 5
value = 5300

