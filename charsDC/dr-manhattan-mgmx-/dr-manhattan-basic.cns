[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1			;Horizontal scaling factor.
yscale = 1			;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 75			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 10		;Set to 1 to scale projectiles too
head.pos = 0, -120	;Approximate position of head
mid.pos = 0, -80		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0       ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3    ;Walk forward
walk.back = -2.7     ;Walk backward
run.fwd  = 8,-5   ;Run forward (x, y)
run.back = -8,-4.8 ;Hop backward (x, y)
jump.neu = 0,-10    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1     ;.
airjump.neu = 0,-8.1     ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 3.5         ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44        ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------

; Jump Start
[Statedef 48]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 48, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 48, VarSet]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 48, VarSet]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 48, Velset]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -10

[State 48, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 49
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 49]
type    = A
physics = A

[State 49, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 49, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 51, ifelse((vel x)>0, 52, 53))

[State 49, AfterImage]
type = AfterImage
trigger1 = (!Time)
time 	= 8
timegap = 3
framegap = 2
length = 5
paladd = 0, 0, 0
palmul = 1, 1, 1
palcontrast = 255,255,255
trans = none

