;-------------------------------------------------------------------------------
;Afterimage
;-------------------------------------------------------------------------------
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = Stateno != 100 ; run forward
trigger1 = Stateno != 105 ; run backward
trigger1 = Stateno != 108 ;Air Dash backward
trigger1 = Stateno != 107 ;Air Dash forward
trigger1 = Stateno != 701 ;Super Jump
time = 0

;Combo Limiters-------------------------------------------------------------

[State -2, OTG Reset]
type = VarSet
trigger1 = p2movetype != H
fv =0
value = 0
ignorehitpause = 1

[State -2, Wall Bounce Reset]
type = VarSet
trigger1 = p2movetype != H
fv = 2
value = 0
ignorehitpause = 1

[State -2, Ground Bounce Reset]
type = VarSet
trigger1 = p2movetype != H
fv = 3
value = 0
ignorehitpause = 1


[State 0, Air Exchange reset]
type = VarSet
trigger1 = p2movetype !=H
fv = 4
value = 0
ignorehitpause = 1

[State 0, Air Exchange limiter]
type = Varset
triggerall = numtarget
triggerall = fvar(4) != 1
trigger1 = target,stateno = [5102,5104]
fv = 4 
value = 1
ignorehitpause = 1

;Corner Push ---------------------------------------------------------------
[State -3, Corner Push]
type = varset
trigger1 = fvar(20)
trigger1 = numtarget
trigger1 = target, hitover || (target, gethitvar(hitshaketime) > 0 && target, time <= 0)
fvar(20) = 0

[State -3, Corner Push]
type = varset
trigger1 = movecontact = 1 && numtarget
fvar(20) = target, gethitvar(xvel)
ignorehitpause = 1

[State -3, Corner Push]
type = posadd
triggerall = fvar(20)
triggerall = stateno != [1000,1399]
triggerall = (statetype = S || statetype = C) && numtarget
triggerall = !hitpausetime && target, gethitvar(hitshaketime) <= 0
trigger1 = target, frontedgebodydist <= abs(target, vel x)
trigger1 = (target, gethitvar(xvel) * target, facing) > 0
trigger2 = target, backedgebodydist <= abs(target, vel x)
trigger2 = (target, gethitvar(xvel) * target, facing) < 0
x = ifelse(target, frontedgebodydist <= 0, -1, 1) * (target, facing) * fvar(20)

[State -3, Corner Push]
type = varset
trigger1 = fvar(20)
trigger1 = abs(fvar(20)) < 1.0
fvar(20) = 0

[State -3, Corner Push]
type = varset
trigger1 = numtarget
trigger1 = target, gethitvar(hitshaketime) <= 0
fvar(20) = fvar(20) * 0.85

