; Custom State for P2 getting hit by explosion
[Statedef 1107]
type = A
movetype = H
physics = N
ctrl = 0

[State FLY AWAY]
type = HitVelSet
trigger1 = time = 0
x = 1
y = 1

[State CHange to the shocked anim, if possible]
type = ChangeAnim2
trigger1 = time = 0
value = ifelse(selfAnimExist(7696),7696,5061)

[State fall down]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State when you hit the ground, recover]
type = selfState
triggerall = !HitFall
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  
trigger2 = time >= 20
value = 5040 ;HITA_RECOV

[State when you hit the ground, recover]
type = selfState
triggerall = HitFall
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  
trigger2 = time >= 20
value = 5050 ;HITA_FALL

