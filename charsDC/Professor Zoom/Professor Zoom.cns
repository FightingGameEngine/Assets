triggerall = time >=248
trigger1 = Time%12=0
anim = 102
ID = 102
pos = -20,0
postype = p1  ;p2,front,back,left,right
facing = 1
velocity = -1,0
sprpriority = 20
ownpal = 1
removeongethit = 1
scale = const(size.xscale),const(size.yscale)

[State Running Speed]
type = VelSet
trigger1 = time >= 248
x = 12

[State Don't Follow zoom]
