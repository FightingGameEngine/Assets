triggerall = Enemynear, Name != "Kid Flash"
triggerall = Enemynear, Name != "Bart Allen"
triggerall = Enemynear, Name != "Impulse"
triggerall = Enemynear, Name != "Sonic"
triggerall = Enemynear, Name != "Sonic The Hedgehog"
triggerall = Enemynear, Name != "Wally West"
triggerall = Enemynear, Name != "The Flash"
triggerall = Enemynear, Name != "The Flash - Wally West"
trigger1 = time = 60
value = S190,3+random%4
channel = 0

[State Intro's over]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
;Intro 4 - Chair
[Statedef 194]
type = S
ctrl = 0
anim = 192
velset = 0,0
sprpriority = 0

[State This is an Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State Chair]
type = Explod
trigger1 = time =0 
anim = 193
ID = 193
sprpriority = -9

[State Need a random number]
type = VarRandom
trigger1 = time = 0 
v = 5
range = 0,1000

[State Special clip vs. Barry]
type = playsnd
triggerall = time = 129
trigger1 = Enemynear, Name = "Barry Allen"
trigger2 = Enemynear, Name = "The Flash"
trigger3 = Enemynear, Name = "The Flash - Barry Allen"
trigger4 = enemynear, Name = "flash"
value = 191,0
channel = 0

[State If it's a normal intro and the random var is less than 500 play this]
type = playsnd
triggerall = Enemynear, Name != "Barry Allen"
triggerall = Enemynear, Name != "The Flash"
triggerall = Enemynear, Name != "The Flash - Barry Allen"
triggerall = enemynear, Name != "flash"
trigger1 = time = 0 && var(5) = [500,1000]
value = 190,6
channel = 0

[State If it's a normal intro and the random var is more than 500 play this]
type = playsnd
triggerall = Enemynear, Name != "Barry Allen"
triggerall = Enemynear, Name != "The Flash"
triggerall = Enemynear, Name != "The Flash - Barry Allen"
triggerall = enemynear, Name != "flash"
trigger1 = time = 129 && var(5) = [0,500]
value = 190,0
channel = 0

[State Coffee Mug]
type = Explod
trigger1 = time = 259
anim = 194
ID = 194
vel = -12,-5
accel = 0, .5
pos = -23,-94
ontop = 1

[State Still Chair is gone]
type = RemoveExplod
trigger1 = time = 281
id = 193

[State Hit spark from kicking chair]
type = Explod
trigger1 = time = 281
anim = 8002 
ID = 193
ontop = 1
pos = 0,-65
pausemovetime = 9999

[State Hitsound from kicking chair]
type = PlaySnd
trigger1 = time = 281
value =  S8000,4  

[State HitPause from kicking chair]
type = Pause
trigger1 = time = 281
time = 11
movetime = 0

[State CHair goes flying from being kicked]
type = Explod
trigger1 = time = 281
anim = 193
ID = 195
vel = -12,0

[State Flying chair Dissapears]
type = RemoveExplod
trigger1 = AnimTime = 0
id = 195

[State Coffee Mug Dissapears]
type = RemoveExplod
trigger1 = AnimTime = 0
id = 194

[State Intro is over]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

