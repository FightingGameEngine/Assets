trigger3 = var(5) = 2 && (AnimElem = 19 || AnimElem = 21 || AnimElem = 23 || AnimElem = 26)
value = ceil(ifElse(-7 + (fvar(10) - 1) * 7 > -7, -7, -7 + (fvar(10) - 1) * 7))
