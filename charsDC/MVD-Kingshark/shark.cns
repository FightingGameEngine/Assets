;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, 1]
type = AssertSpecial
trigger1 = Time = [0,1000]
flag = Intro

[State 0, Explod]
type = Explod
trigger1 = ANIMELEM=1
anim = 1911
ID =  1911
pos = -100,25
postype = p1  ;p2,front,back,left,right
random = 0,0
removetime = -2
scale = 2,2
sprpriority = -3

[State 0, Explod]
type = Explod
trigger1 = TIME=30
anim = 1912
ID =  1912
pos = 25,0
postype = p1  ;p2,front,back,left,right
random = 0,0
removetime = -2
scale = 1,1
sprpriority = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem=1
value = S191,0
volume = 0
channel = -1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time=110
value = S191,1
volume = 0
channel = -1





[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 191

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0
