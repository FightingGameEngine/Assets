trigger1 = pos y <0
value = SCA
;value2 = S,NA
time = 1
;ignorehitpause =
;persistent =
[State 0, NotHitBy]
type =HitBy
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = SCA,AA,AP
;value2 = S,NA
time = 1
[State 5040, 5]
type = VelAdd
trigger1 = 1
y = .42

[State 5040, 6]
type = selfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMPLAND

