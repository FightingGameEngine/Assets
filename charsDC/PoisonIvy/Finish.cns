[Statedef 9011]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
anim = 10500
ctrl = 0

[State 7500, bind]
type=posset
trigger1=1
x=0
y=-150

[State 9000, 2]
type = PlaySnd
trigger1 = Time = 0
value = 4,7
abspan = 1

[state 9011, 2]
type = AssertSpecial
trigger1 = Time>=0
flag = noshadow

[state 8100, Escurece um pouco]
type = bgPalFx
trigger1 = !Time
add = 10,10,10
mul = 256,256,256
sinadd = -155,-155,-155,500
time = 60

[State 10005, trans]
type=trans
trigger1=1
trans=add

[State 0, Sumindo]
type=trans
trigger1=time>=50
trans=AddAlpha
alpha=ceil(256-10*(time-50)),ceil(256*(time-40))

[State 9011, 3]
type = Destroyself
trigger1 = !AnimTime

