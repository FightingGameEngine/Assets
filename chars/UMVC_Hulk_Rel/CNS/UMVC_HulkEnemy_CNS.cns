movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = Null
trigger1   = Name = "UMVC_Hulk" && AuthorName = "Rel"
trigger1   = Var(20) := GameTime
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = !CanRecover
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = !Alive
ignorehitpause = 1

[State ]
type       = HitBy
trigger1   = !CanRecover
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = Alive
ignorehitpause = 1

[State ]
type       = DefenceMulSet
trigger1   = 0
value      = 1
ignorehitpause = 1

[State ]
type       = AngleDraw
trigger1   = !Time
value      = 0
;scale      = Const(Size.XScale),Const(Size.YScale)
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = A
movetype   = H
physics    = N
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = !AnimTime && Anim = 5035 || !Time && Anim-5035 && !(Anim = [5051,5059]) && !(Anim = [5061,5069]) && Anim-5090
value      = 5050
elem       = 1
ignorehitpause = 0

[State ]
type       = ChangeAnim
trigger1   = Anim = 5051 && SelfAnimExist(5061) && Vel Y >= -2+(Anim = 5050)*3
value      = 5061
elem       = 1
ignorehitpause = 0

[State ]
type       = VelAdd
trigger1   = 1
y          = GetHitVar(YAccel)
ignorehitpause = 0

[State ]
type       = ChangeState
trigger1   = Vel Y > 0 && Pos Y >= !(Anim=[5051,5059])*!(Anim=[5061,5069])*25
value      = 5390
ctrl       = 0
ignorehitpause = 0

[State ]
type       = VelSet
trigger1   = Alive && CanRecover
y          = -2
ignorehitpause = 0

[State ]
type       = SelfState
trigger1   = Alive && CanRecover
value      = 5210
ctrl       = 0
ignorehitpause = 0


