;---------------------------------------------------------------------------
; ガンマトルネード（相手）
; Gamma Tornado (Target)
[Statedef 358]
type            = A
movetype        = H
physics         = N
facep2          = 1
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = -3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP
time       = 0
ignorehitpause = 1

[State ]
type       = HitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP
time       = 1
ignorehitpause = 1

[State ]
type       = AngleDraw
trigger1   = !Time
value      = 0
;scale      = Const(Size.XScale),Const(Size.YScale)
ignorehitpause = 0

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = A
movetype   = H
physics    = N
ignorehitpause = 1

[State ]
type       = PowerAdd
trigger1   = NumEnemy > GetHitVar(ChainID)%2
trigger1   = Enemy(GetHitVar(ChainID)%2),Anim = StateNo-2 && !Enemy(GetHitVar(ChainID)%2),AnimElemTime(79)
value      = Ceil(Ceil(80000*Enemy(GetHitVar(ChainID)%2),SysFVar(0))*1000./1000000*.650)
ignorehitpause = 1
persistent = 0

[State ]
type       = LifeAdd
trigger1   = NumEnemy > GetHitVar(ChainID)%2
trigger1   = Enemy(GetHitVar(ChainID)%2),Anim = StateNo-2 && !Enemy(GetHitVar(ChainID)%2),AnimElemTime(79)
value      = -Ceil(Ceil(80000*Enemy(GetHitVar(ChainID)%2),SysFVar(0))*1000./1000000)
kill       = 1
absolute   = 0
ignorehitpause = 1
persistent = 0

[State ]
type       = ChangeAnim2
trigger1   = NumEnemy > GetHitVar(ChainID)%2
trigger1   = Enemy(GetHitVar(ChainID)%2),Anim = StateNo-2 && Enemy(GetHitVar(ChainID)%2),AnimElemTime(70) >= 0 && AnimElemTime(70) < 0
value      = StateNo
elem       = 70
ignorehitpause = 1

[State ]
type       = ChangeAnim2
trigger1   = Anim-StateNo
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VelSet
trigger1   = NumEnemy > GetHitVar(ChainID)%2
trigger1   = Enemy(GetHitVar(ChainID)%2),Anim = StateNo-2 && !Enemy(GetHitVar(ChainID)%2),AnimElemTime(79)
x          = 18
y          = -10
ignorehitpause = 0
persistent = 0

[State ]
type       = SprPriority
trigger1   = NumEnemy > GetHitVar(ChainID)%2
trigger1   = Enemy(GetHitVar(ChainID)%2),Anim = StateNo-2
value      = 4*(Enemy(GetHitVar(ChainID)%2),AnimElemTime(3) < 0)
ignorehitpause = 0

[State ]
type       = ScreenBound
trigger1   = 1
value      = 1
movecamera = 1,!!Vel X
ignorehitpause = 0

[State ]
type       = VelAdd
trigger1   = Vel X
x          = 0
y          = GetHitVar(YAccel)
ignorehitpause = 0

[State ]
type       = ChangeState
trigger1   = Vel X && Vel Y > 0 && Pos Y >= 20
value      = 5111
ctrl       = 0
ignorehitpause = 0

[State ]
type       = SelfState
trigger1   = 0;Time >= 1000
value      = 5050
ctrl       = 1
ignorehitpause = 0


