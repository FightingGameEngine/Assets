physics         = U
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = -3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = Null
trigger1   = Name = "UMVC_Hulk" && AuthorName = "Rel"
trigger1   = Var(20) := GameTime
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = !Alive
ignorehitpause = 1

[State ]
type       = HitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = Alive
ignorehitpause = 1

[State ]
type       = DefenceMulSet
trigger1   = 0
value      = 1
ignorehitpause = 1

[State ]
type       = AngleDraw
trigger1   = !Time
value      = 0
;scale      = Const(Size.XScale),Const(Size.YScale)
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = S
movetype   = H
physics    = S
ignorehitpause = 1

[State ]
type       = PosAdd
trigger1   = Time < 21
x          = -11
y          = 0
ignorehitpause = 0
persistent = 6

[State ]
type       = PosAdd
trigger1   = Time > 20
x          = -2
y          = 0
ignorehitpause = 0
persistent = 6

[State ]
type       = ChangeAnim
trigger1   = !AnimTime
value      = 5005+(GetHitVar(GroundType) = 2)*10
elem       = 1
ignorehitpause = 1
persistent = 0

[State ]
type       = VelMul
trigger1   = Time >= GetHitVar(SlideTime)
x          = 0.6
ignorehitpause = 0

[State ]
type       = VelSet
trigger1   = HitOver
x          = 0
ignorehitpause = 0

[State ]
type       = SelfState
trigger1   = HitOver
value      = 0
ctrl       = 1
ignorehitpause = 0
persistent = 256


;===========================================================================
; 
;===========================================================================
[Statedef 15400]
type            = A
movetype        = H
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = -3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = HitFallSet
trigger1   = 1
value      = 1
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = 1
value      = 5010
elem       = 1
ignorehitpause = 1

[State ]
type       = VelAdd
trigger1   = Time > 60*(1+(GetHitvar(chainID) = 3202))
x          = 0
y          = .1
ignorehitpause = 1

[State ]
type           = PlaySnd
trigger1       = !Time
value          = s5100,0
volume         = 255
channel        = -1
lowpriority    = 0
freqmul        = 1.0
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0

[State ]
type           = Explod
trigger1       = !Time
ID             = 15400
anim           = 6403
pos            = 0,-50
postype        = P1
facing         = 1
vfacing        = 1
bindtime       = 1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = .5,.5
sprpriority    = 6
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 0
removetime     = -2
pausemovetime  = 0
supermovetime  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = Time > 2 && Vel Y >= 0 && Pos Y >= 0
value      = 5100
ctrl       = 0
ignorehitpause = 1


