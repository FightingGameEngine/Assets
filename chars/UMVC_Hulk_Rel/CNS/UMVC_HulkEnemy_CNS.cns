; HITA_FALL (knocked up, falling)
[Statedef 5350]
type            = U
movetype        = U
physics         = U
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
