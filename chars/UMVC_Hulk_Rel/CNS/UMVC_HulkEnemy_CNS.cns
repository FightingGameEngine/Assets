;---------------------------------------------------------------------------
; 通常投げ（地上）
; Throw (Ground) (Target)
[Statedef 264]
type            = A
movetype        = I
physics         = N
facep2          = 1
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = 2
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP
time       = 0
ignorehitpause = 1

[State ]
type       = HitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP
time       = 1
ignorehitpause = 1

[State ]
type       = AngleDraw
trigger1   = !Time
value      = 0
;scale      = Const(Size.XScale),Const(Size.YScale)
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = S
movetype   = H
physics    = N
ignorehitpause = 1

[State ]
type       = PowerAdd
triggerall = NumEnemy > GetHitVar(ChainID)%2
trigger1   = !Enemy(GetHitVar(ChainID)%2),AnimElemTime(04) && Enemy(GetHitVar(ChainID)%2),Anim = [StateNo-4,StateNo-3]
value      = Ceil(Ceil(100000*Enemy(GetHitVar(ChainID)%2),SysFVar(0))*1000./1000000*.650)
ignorehitpause = 1
persistent = 0

[State ]
type       = LifeAdd
triggerall = NumEnemy > GetHitVar(ChainID)%2
trigger1   = !Enemy(GetHitVar(ChainID)%2),AnimElemTime(04) && Enemy(GetHitVar(ChainID)%2),Anim = [StateNo-4,StateNo-3]
value      = -Ceil(Ceil(100000*Enemy(GetHitVar(ChainID)%2),SysFVar(0))*1000./1000000)
kill       = 1
absolute   = 0
ignorehitpause = 1
persistent = 0

[State ]
type       = ScreenBound
trigger1   = 1
value      = 1
movecamera = 1,!!Vel X
ignorehitpause = 0

[State ]
type       = ChangeAnim2
trigger1   = !Time
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = Command = "c" && (Command = "holdfwd" || Command = "holdback") && NumEnemy > GetHitVar(ChainID)%2
trigger1   = (Enemy(GetHitVar(ChainID)%2),Anim = [StateNo-4,StateNo-3]) && Enemy(GetHitVar(ChainID)%2),AnimElemTime(1) < 7 && (Enemy(GetHitVar(ChainID)%2),SysVar(2) & 16)
value      = StateNo+1
ctrl       = 0
ignorehitpause = 1

[State ]
type       = SprPriority
trigger1   = 1
value      = 4-7*(AnimElemNo(0) > 1)
ignorehitpause = 1

[State ]
type       = Turn
triggerall = NumEnemy > GetHitVar(ChainID)%2
trigger1   = !Enemy(GetHitVar(ChainID)%2),AnimElemTime(02) && Enemy(GetHitVar(ChainID)%2),Anim = StateNo-3
ignorehitpause = 1
persistent = 0

[State ]
type       = VelSet
trigger1   = 1
x          = 0
y          = 0
ignorehitpause = 1

[State ]
type       = ChangeState
triggerall = NumEnemy > GetHitVar(ChainID)%2
trigger1   = !Enemy(GetHitVar(ChainID)%2),AnimElemTime(04) && Enemy(GetHitVar(ChainID)%2),Anim = [StateNo-4,StateNo-3]
value      = 5111
ctrl       = 0
ignorehitpause = 1
persistent = 0


