;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground)
[Statedef 5105]
type            = A
movetype        = H
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = -3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = 0
ignorehitpause = 1

[State ]
type       = HitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = 1
ignorehitpause = 1

[State ]
type       = AngleDraw
trigger1   = !Time
value      = 0
;scale      = Const(Size.XScale),Const(Size.YScale)
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = A
movetype   = H
physics    = N
ignorehitpause = 1

[State ]
type       = FallEnvShake
trigger1   = !Time
ignorehitpause = 0

[State ]
type       = VelSet
trigger1   = !Time
x          = 0.75*IfElse(!GetHitVar(Fall.YVel)*(Vel X > 1),1,Vel X)
y          = 0
ignorehitpause = 0

[State ]
type       = ChangeAnim
trigger1   = !Time && (!(Anim=5051) || !(Anim=5061) && !SelfAnimExist(5100+(Anim%10)))
value      = 5100
elem       = 1
ignorehitpause = 0

[State ]
type       = PosSet
trigger1   = !Time
y          = 0
ignorehitpause = 0

[State ]
type       = ChangeState
trigger1   = !Time && !GetHitVar(Fall.YVel)
value      = 5111
ctrl       = 0
ignorehitpause = 0

[State ]
type       = GameMakeAnim
trigger1   = !Time
value      = 60+(Vel Y > 4)+(Vel Y > 13)
pos        = 0,0
under      = (Vel Y < 15)
ignorehitpause = 0

[State ]
type       = HitFallDamage
trigger1   = !Time
ignorehitpause = 0

[State ]
type           = PlaySnd
trigger1       = Name = "UMVC_Youmu" && AuthorName = "Rel" && !Time
value          = s5100,(Vel Y > 13)
volume         = 255
channel        = -1
lowpriority    = 0
freqmul        = 1.0
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0

[State ]
type       = PosFreeze
trigger1   = 1
ignorehitpause = 0

[State ]
type       = ChangeState
trigger1   = Time > 2 && !AnimTime
value      = StateNo+1
ctrl       = 0
ignorehitpause = 0


