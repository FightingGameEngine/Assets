;===========================================================================
; 吹っ飛び移行
; Shaking From the Hit
[Statedef 5400]
type            = U
movetype        = H
physics         = N
facep2          = 1-2*(GetHitVar(XVel) > 0)
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = 2
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
triggerall = NumEnemy > GetHitVar(ChainID)%2 && !Time
triggerall = (Enemy(GetHitVar(ChainID)%2),SysVar(2) & 32768)
trigger1   = !NumPartner
trigger2   = Partner,ID > ID
value      = StateNo+4
ctrl       = 0
ignorehitpause = 1

[State ]
type       = ChangeState
triggerall = NumEnemy > GetHitVar(ChainID)%2 && !Time
triggerall = (Enemy(GetHitVar(ChainID)%2),SysVar(2) & 65536)
trigger1   = NumPartner
trigger1   = Partner,ID < ID
value      = StateNo+4
ctrl       = 0
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = !Alive
ignorehitpause = 1

[State ]
type       = HitBy
trigger1   = 1
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP, AA, AT ,AP
time       = Alive
ignorehitpause = 1

[State ]
type       = DefenceMulSet
trigger1   = 0
value      = 1
ignorehitpause = 1

[State ]
type       = VelSet
triggerall = NumEnemy > GetHitVar(ChainID)%2 && (FrontEdgeBodyDist < 1 || BackEdgeBodyDist < 1 || Time > 800)
trigger1   = !NumPartner
trigger2   = Partner,ID > ID
y          = (Vel Y+GetHitVar(YAccel))*!!(Enemy(GetHitVar(ChainID)%2),SysVar(2) & 32768)
ignorehitpause = 1

[State ]
type       = VelSet
triggerall = NumEnemy > GetHitVar(ChainID)%2 && (FrontEdgeBodyDist < 1 || BackEdgeBodyDist < 1 || Time > 800)
trigger1   = NumPartner
trigger1   = Partner,ID < ID
