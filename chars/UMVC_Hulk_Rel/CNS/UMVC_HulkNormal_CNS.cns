;===========================================================================
; í èÌãZ
; Basic Attacks
;===========================================================================
; óßé„çUåÇ
; 5L
[Statedef 200]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = (SysVar(2) & 268435456)
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = (Var(23) := 0)
ignorehitpause = 1

[State ]
type       = Turn
trigger1   = NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = PosSet
trigger1   = Pos Y >= 0
y          = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = IfElse((SysVar(2) & 268435456),StateNo+1,5)
ctrl       = 0
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
; óßé„çUåÇ
; 5L
[Statedef 201]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 1
movehitpersist  = 1
hitcountpersist = 1

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1

[State ]
type       = HitAdd
trigger1   = MoveHit = 1 && !MoveReversed && HitPauseTime = 7
trigger1   = Var(25) := Anim || Var(26) := 1 || Var(30) := Var(30)+1
value      = 1
ignorehitpause = 1
persistent = 0

[State ]
type       = StateTypeSet
trigger1   = AnimElemTime(11) > 0 || MoveContact || MoveReversed
movetype   = I
ignorehitpause = 1

[State ]
type       = PosAdd
trigger1   = !(Var(23) & 2**00) && (AnimElemTime(01) = [0,1]) && FVar(0) :=  23 && FVar(05+10*(SysVar(2) & 1)) > 23
trigger1   = Var(23) := (Var(23) | 2**00)
trigger2   = !(Var(23) & 2**01) && (AnimElemTime(05) = [0,1]) && FVar(0) :=  10 && (Var(23) & 2**00)
trigger2   = Var(23) := (Var(23) | 2**01)
trigger3   = !(Var(23) & 2**02) && (AnimElemTime(09) = [0,1]) && FVar(0) :=   8 && (Var(23) & 2**01)
trigger3   = Var(23) := (Var(23) | 2**02)
trigger4   = !(Var(23) & 2**03) && (AnimElemTime(18) = [0,1]) && FVar(0) :=   1 && (Var(23) & 2**02)
trigger4   = Var(23) := (Var(23) | 2**03)
trigger5   = !(Var(23) & 2**04) && (AnimElemTime(21) = [0,1]) && FVar(0) := -29
trigger5   = Var(23) := (Var(23) | 2**04)
trigger6   = !(Var(23) & 2**05) && (AnimElemTime(24) = [0,1]) && FVar(0) := -13
trigger6   = Var(23) := (Var(23) | 2**05)
x          = FVar(0)
y          = 0
ignorehitpause = 1

[State ]
type           = PlaySnd
trigger1       = !(Var(23) & 2**10) && Random%2 && AnimElemTime(1) = [0,1]
trigger1       = Var(23) := (Var(23) | 2**10)
value          = s1,200+Random%3
volume         = 255
channel        = 0
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !(Var(23) & 2**0) && AnimElemTime(7) = [0,1]
trigger1       = Var(23) := (Var(23) | 2**0)
value          = s2,3
volume         = 0
channel        = -1
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type                       = HitDef
trigger1                   = !MoveContact && !MoveReversed && (!(SysVar(1) & 2**25) || AnimElemNo(0) = [9,11])
attr                       = S, NA
animtype                   = Light
priority                   = 4, Hit
damage                     = Ceil(Ceil(85000*SysFVar(4)*IfElse(.750**Var(30) > .300+.050*!!NumExplod(6410),.750**Var(30),.300+.050*!!NumExplod(6410)))*1000./1000000),0
hitflag                    = MAF
guardflag                  = MA
getpower                   = Ceil(Ceil(85000*SysFVar(1)*.80)*1000./1000000     *!Var(31)),Ceil(Ceil(85000*SysFVar(1)*.80)*1000./1000000*.625     *!Var(31))
givepower                  = Ceil(Ceil(85000*SysFVar(1)*.80)*1000./1000000*.650         ),Ceil(Ceil(85000*SysFVar(1)*.80)*1000./1000000*.650*.625         )
pausetime                  = 8,8
guard.pausetime            = 8,8
sparkno                    = -1
guard.sparkno              = -1
sparkxy                    = 0,0
hitsound                   = -1,0
guardsound                 = -1,0
ground.type                = High
ground.slidetime           = 1+(16-Var(29))*(Var(29) < 16)
ground.hittime             = 1+(16-Var(29))*(Var(29) < 16)
ground.velocity            = -5.0,0.0
guard.hittime              = 13+TeamSide
guard.ctrltime             = 13+TeamSide
guard.velocity             = -5.0
;air.type                   = Trip
air.hittime                = 1+(16-Var(29))*(Var(29) < 16)
air.velocity               = -2.0,-2.0
airguard.ctrltime          = 13+TeamSide
airguard.velocity          = -2.0,0
down.velocity              = 0,0
ground.cornerpush.veloff   = -5.0*4/3
air.cornerpush.veloff      = -2.0*4/3
down.cornerpush.veloff     = 0
guard.cornerpush.veloff    = -5.0*4/3
airguard.cornerpush.veloff = -2.0*4/3
yaccel                     = Const(Movement.YAccel)
sprpriority                = 3
;p1facing                   = 1
p1getp2facing              = 0
p2facing                   = 1
;p1stateno                  = 
;p2stateno                  = 5000
;p2getp1state               = 0
fall                       = 0
fall.xvelocity             = 0
fall.yvelocity             = 0
fall.recover               = 1
fall.recovertime           = 1+(16-Var(29))*(Var(29) < 16)
fall.damage                = 0
air.fall                   = 1
ID                         = StateNo-Var(50)
chainID                    = -1
nochainID                  = -1
hitonce                    = 0
kill                       = 1
guard.kill                 = 1
fall.kill                  = 1
numhits                    = 0
guard.dist                 = 0
ignorehitpause             = 0

[State ]
type       = HitDef
trigger1   = MoveContact || MoveReversed || AnimElemNo(0) != [9,11]
attr       = 
hitflag    = 
guardflag  = 
ignorehitpause = 1

[State ]
type       = AttackDist
trigger1   = 1
value      = Ceil(125*Const(Size.XScale)+60+Abs(FVar(15+(SysVar(2) & 1)*10)-FVar(37)))*(AnimElemTime(12) < 0)
ignorehitpause = 1

[State ]
type       = CtrlSet
trigger1   = 1
value      = (AnimTime > -2)
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !AnimTime
value      = 5
ctrl       = 0
ignorehitpause = 0


