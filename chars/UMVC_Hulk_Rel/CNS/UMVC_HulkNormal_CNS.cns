trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !(Anim = 224)
value      = 224
ctrl       = 0
ignorehitpause = 1

[State ]
