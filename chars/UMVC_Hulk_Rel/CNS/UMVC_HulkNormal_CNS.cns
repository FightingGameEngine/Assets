; Air Throw (Success)
[Statedef 271]
type            = A
movetype        = A
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 1

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = Var(25) := StateNo-1 || Var(26) := 1
sysfvar(4) = .5
ignorehitpause = 1

[State ]
type       = HitAdd
trigger1   = !AnimElemTime(4)
value      = !!(Var(30) := Var(30)+1)
ignorehitpause = 1
persistent = 0

[State ]
type       = ChangeState
trigger1   = NumTarget(StateNo-Var(50))
trigger1   = Target(StateNo-Var(50)),StateNo = StateNo+4
value      = StateNo+1
ctrl       = 0
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA, SA, HA, NT, ST, HT, NP, SP, HP, AA, AT, AP
time       = 1
ignorehitpause = 1

[State ]
type       = PosAdd
trigger1   = FrontEdgeDist < 60 && !AnimElemTime(1)
x          = FrontEdgeDist-60
ignorehitpause = 1

[State ]
type       = PosAdd
trigger1   = BackEdgeDist < 30 && !AnimElemTime(1)
x          = -BackEdgeDist+30
ignorehitpause = 1

[State ]
type       = PowerAdd
trigger1   = !AnimElemTime(4)
value      = Ceil(Ceil(100000*SysFVar(1))*1000./1000000*!Var(31))
ignorehitpause = 1
persistent = 0

[State ]
type       = Turn
trigger1   = !AnimElemTime(02) && Anim%2
ignorehitpause = 1
persistent = 0

[State ]
type       = TargetBind
triggerall = FVar(2) := 1 && AnimElemTime(4) < 1
trigger1   = AnimElemTime(02) < 0 && FVar(0) :=   93 && FVar(1) := 121
trigger2   = AnimElemTime(03) < 0 && FVar(0) := -074 && FVar(1) := 179
trigger3   = AnimElemTime(04) < 0 && FVar(0) := -002 && FVar(1) := 173
trigger4   = FVar(0) :=   59 && FVar(1) :=  21
time       = 1
ID         = StateNo-Var(50)
pos        = FVar(2)*FVar(0)*Const(Size.XScale),-FVar(2)*FVar(1)*Const(Size.YScale)
ignorehitpause = 1

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(2)
value          = s1,270
volume         = 255
channel        = 0
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 1
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(1)
value          = s260,0
volume         = 0
channel        = -1
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 1
persistent     = 0

[State ]
