trigger1   = (SysVar(2) & 268435456)
value      = StateNo+!!(Var(22) & 2**01)
elem       = 1
ignorehitpause = 1

[State ]
type       = TargetDrop
trigger1   = 1
excludeID  = StateNo+1-Var(50)
keepone    = 0
ignorehitpause = 1

