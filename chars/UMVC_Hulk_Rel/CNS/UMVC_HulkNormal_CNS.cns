ID             = 27000
anim           = 273
pos            = 0,0
postype        = P1
facing         = 1
vfacing        = 1
bindtime       = 1
vel            = 0
accel          = 0,0
random         = 0,0
scale          = Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290,Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290
sprpriority    = 5
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 1
removetime     = -2
pausemovetime  = 0
supermovetime  = 0
ignorehitpause = 1
persistent     = 0

