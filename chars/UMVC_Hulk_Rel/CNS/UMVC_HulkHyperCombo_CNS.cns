;===========================================================================
; ハイパーコンボ
; Hyper Combo
;===========================================================================
; ガンマツナミ
; Gamma Tsunami
[Statedef 400]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = -1000
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = (SysVar(2) & 268435456)
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = (Var(22) := (Var(23) := 0))
ignorehitpause = 1

[State ]
type       = Turn
trigger1   = NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = PosSet
trigger1   = Pos Y >= 0
y          = 0
ignorehitpause = 1

[State ]
type       = StopSnd
trigger1   = 1
channel    = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = IfElse((SysVar(2) & 268435456),StateNo+1,5)
ctrl       = 0
ignorehitpause = 1


;---------------------------------------------------------------------------
; ガンマツナミ
; Gamma Tsunami
[Statedef 401]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = NotHitBy
trigger1   = AnimElemTime(7) >= 0 && AnimElemTime(9) < -1
value      = SCA, NA, SA, HA, NT, ST, HT, NP, SP, HP, AA, AT, AP
time       = 1
ignorehitpause = 1

[State ]
type       = ScreenBound
trigger1   = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
value      = 0
movecamera = 0,0
ignorehitpause = 1

[State ]
type       = PlayerPush
trigger1   = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
value      = (Var(20) := 0)
ignorehitpause = 1

[State ]
type       = ModifyExplod
trigger1   = NumExplod(6410)
trigger1   = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
ID         = 6410
trans      = AddAlpha
alpha      = 0,256
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 0;AnimElemTime(133) > 0
movetype   = I
ignorehitpause = 1

[State ]
type              = Helper
trigger1          = !AnimElemTime(1)
helpertype        = Normal
name              = "Hyper Combo"
ID                = 15000
pos               = 0,0
postype           = P1
facing            = 1
stateno           = 15000
keyctrl           = 0
ownpal            = 1
supermovetime     = 2147483647
pausemovetime     = 2147483647
size.xscale       = 0
size.yscale       = 0
size.ground.back  = 0
size.ground.front = 0
size.air.back     = 0
size.air.front    = 0
size.height       = 0
size.proj.doscale = 0
size.head.pos     = 0,0
size.mid.pos      = 0,0
size.shadowoffset = 0
ignorehitpause    = 1
persistent        = 0

[State ]
type       = SuperPause
trigger1   = !AnimElemTime(7)
trigger1   = 1 || FVar(34) := Pos X
time       = -AnimElemTime(9)
sound      = -1,0
anim       = -1
pos        = 0,0
movetime   = -AnimElemTime(9)
darken     = 0
p2defmul   = 1
poweradd   = -1000*(NumExplod(2000)+NumExplod(3000))
unhittable = 1
ignorehitpause = 0
persistent = 0

[State ]
type       = AllPalFx
trigger1   = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
time       = 1
add        = -330,-330,-330
ignorehitpause = 1

[State ]
type       = BGPalFx
trigger1   = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
time       = 1
add        = 330,330,330
ignorehitpause = 1

[State ]
type       = PalFx
trigger1   = AnimElemTime(8) >= 0 && AnimElemTime(9) < 0
time       = 1
add        = 330,330,330
ignorehitpause = 1

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(1)
value          = s15000,0
volume         = 255
channel        = -1
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = Explod
trigger1       = !AnimElemTime(8)
ID             = 15100
anim           = 15100
pos            = (Facing < 0),0
postype        = Back
facing         = 1
vfacing        = 1
bindtime       = -1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = 1,1
sprpriority    = 3
ontop          = 0
shadow         = 0,0,0
ownpal         = 0
removeongethit = 1
removetime     = -2
pausemovetime  = 2147483647
supermovetime  = 2147483647
ignorehitpause = 1
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(8)
value          = s1,400
volume         = 255
channel        = 0
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(16)
value          = s1,401
volume         = 255
channel        = 0
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(12)
value          = s400,0
volume         = 0
channel        = 1
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !AnimElemTime(13)
value          = s400,1
volume         = 255
channel        = 1
lowpriority    = 7
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type              = Helper
trigger1          = !AnimElemTime(23)
helpertype        = Normal
name              = "Hyper Combo"
ID                = 6304
pos               = 0,0
postype           = P1
facing            = 1
stateno           = 6304
keyctrl           = 0
ownpal            = 1
supermovetime     = 0
pausemovetime     = 0
size.xscale       = 1.5*Const(Size.XScale)
size.yscale       = 1.5*Const(Size.YScale)
size.ground.back  = 0
size.ground.front = 0
size.air.back     = 0
size.air.front    = 0
size.height       = 0
size.proj.doscale = 0
size.head.pos     = 0,0
size.mid.pos      = 0,0
size.shadowoffset = 0
ignorehitpause    = 0
persistent        = 0

[State ]
type           = HitDef
trigger1       = 1
attr           = S, HP
hitflag        = 
guardflag      = 
ignorehitpause = 0

[State ]
type       = AttackDist
trigger1   = 1
value      = Ceil(100*Const(Size.XScale)+60+Abs(FVar(15+(SysVar(2) & 1)*10)-FVar(37)))*(AnimElemTime(51) < 0)
ignorehitpause = 1

[State ]
type       = CtrlSet
trigger1   = 1
value      = (AnimTime > -2)
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !AnimTime
value      = 5
ctrl       = 0
ignorehitpause = 0


