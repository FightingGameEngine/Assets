[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = (SysVar(3)+!(Parent,Anim = 910))*!!(Parent,SysVar(2) & 128)
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = StateNo+1
ctrl       = 0
ignorehitpause = 1
persistent = 256


;===========================================================================
; 
;===========================================================================
[Statedef 10001]
type            = U
movetype        = I
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 1
movehitpersist  = 1
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(IsHelper && Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = Root,Var(20)-GameTime && Root,Alive
value      = StateNo+1
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = RemoveExplod
trigger1   = NumExplod(6410) && !(Root,SysVar(2) & 128)
ID         = 6410
ignorehitpause = 1

[State ]
type           = Explod
trigger1       = !NumExplod(6410) && Root,NumExplod(6410)
ID             = 6410
anim           = 6410
pos            = 0,0
postype        = P1
facing         = 1
vfacing        = 1
bindtime       = -1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = .25*Root,Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290,.25*Root,Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290
sprpriority    = 4
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 0
removetime     = -1
pausemovetime  = 2147483647
supermovetime  = 2147483647
ignorehitpause = 1

[State ]
type       = ModifyExplod
trigger1   = NumExplod(6410) || 0 && Var(0) := Root,Anim && Var(1) := Root,AnimElemNo(0)
ID         = 6410
scale      = .6*Root,Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290,.6*Root,Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290
ignorehitpause = 1

