;===========================================================================
; ヘルパー用のステート
; States for Helpers
;===========================================================================
[Statedef 1]
type            = A
movetype        = I
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 0
hitdefpersist   = 1
movehitpersist  = 1
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(IsHelper && Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = AttackMulSet
trigger1   = 1
value      = IfElse((Root,SysVar(1) & 2**16),Root,SysFVar(0),1)*(1+.25*!!Root,Var(31))*(1+.8/3*Root,NumExplod(6410))
ignorehitpause = 1

[State ]
type       = ScreenBound
trigger1   = 1
value      = 0
movecamera = 0,0
ignorehitpause = 1

[State ]
type       = TargetDrop
trigger1   = MoveHit = 1 && NumTarget > 1
trigger1   = Var(0) := Target,GetHitVar(ChainID) && Var(1) := Var(0)-Var(0)%2 && !Target,IsHelper && NumEnemy < 2
;trigger1   = Var(1)-302
excludeID  = Var(0)
keepone    = 1
ignorehitpause = 1

[State ]
type       = TargetState
trigger1   = MoveHit = 1 && NumTarget = 1
trigger1   = Var(0) := Target,GetHitVar(ChainID) && Var(1) := Var(0)-Var(0)%2 && !Target,IsHelper
;trigger1   = Var(1)-302
value      = 5300
ID         = Var(0)
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = IsHelper(2000) || IsHelper(3000)
value      = 1998+1000*IsHelper(3000)
ctrl       = 0
ignorehitpause = 1

[State ]
type       = VarSet
triggerall = !IsHelper(10000)
triggerall = Var(53) := ((2**0)*(Root,StateType = S) | (2**1)*(Root,StateType = C) | (2**2)*(Root,StateType = A) | (2**3)*(Root,StateType = L))
triggerall = Var(53) := (Var(53) | (2**4)*(Root,MoveType = I) | (2**5)*(Root,MoveType = A) | (2**6)*(Root,MoveType = H))
triggerall = 1 || Var(56) := Root,Var(56) || Var(2) := (Root,SysVar(2) & (1 ^ -1)) || Var(29) := Root,Var(29) || Var(30) := Root,Var(30)
trigger1   = NumPartner && Var(50) := 1
trigger1   = 0 && Var(50) := (Root,ID <= Partner,ID)
trigger2   = NumEnemy
trigger2   = Var(53) := (Var(53) | (2**10)*(Enemy(0),StateType = S) | (2**11)*(Enemy(0),StateType = C) | (2**12)*(Enemy(0),StateType = A) | (2**13)*(Enemy(0),StateType = L))
trigger2   = Var(53) := (Var(53) | (2**14)*(Enemy(0),MoveType = I) | (2**15)*(Enemy(0),MoveType = A) | (2**16)*(Enemy(0),MoveType = H))
trigger2   = Var(53) := (Var(53) | (2**17)*(Enemy(0),HitDefAttr = SCA, NA, SA, HA || Enemy(0),HitDefAttr = , NA, SA, HA))
trigger2   = Var(53) := (Var(53) | (2**18)*(Enemy(0),HitDefAttr = SCA, NT, ST, HT || Enemy(0),HitDefAttr = , NT, ST, HT))
trigger2   = Var(53) := (Var(53) | (2**19)*(Enemy(0),HitDefAttr = SCA, NP, SP, HP || Enemy(0),HitDefAttr = , NP, SP, HP))
trigger2   = 1 || FVar(10) := (Enemy(0),Vel X-FVar(12))*!!Enemy(0),Vel X*IfElse(Enemy(0),Vel X>0,Enemy(0),FrontEdgeBodyDist>0,Enemy(0),BackEdgeBodyDist>0)*(1-2*!(Facing=Enemy(0),Facing))
trigger2   = 1 || FVar(11) := IfElse((Var(53) & 2**16)+(Enemy(0),StateNo=[120,155]),Enemy(0),GetHitVar(YAccel),Enemy(0),Const(Movement.YAccel))*!(Enemy(0),Pos Y < 0)*FVar(13)
trigger2   = 1 || FVar(12) := Enemy(0),Vel X*!Enemy(0),Ctrl*IfElse(Enemy(0),Vel X>0,Enemy(0),FrontEdgeBodyDist>0,Enemy(0),BackEdgeBodyDist>0)*!(Enemy(0),Anim=[20,21])
trigger2   = 1 || FVar(13) := Enemy(0),Vel Y
trigger2   = 1 || FVar(14) := Enemy(0),Vel Z
trigger2   = 1 || FVar(15) := IfElse(Facing=Enemy(0),Facing,IfElse((Var(53) & 2**12),Enemy(0),Const(Size.Air.Back),Enemy(0),Const(Size.Ground.Back)),-IfElse((Var(53) & 2**12),Enemy(0),Const(Size.Air.Front),Enemy(0),Const(Size.Ground.Front)))
trigger2   = 1 || FVar(15) := (FVar(15)+Enemy(0),Pos X-Pos X)*Facing
trigger2   = 1 || FVar(16) := Enemy(0),Pos Y-Pos Y
trigger2   = !Enemy(0),Alive
trigger2   = Var(53) := (Var(53) & ((2**10 | 2**11 | 2**12 | 2**13 | 2**14 | 2**15 | 2**16 | 2**17 | 2**18 | 2**19) ^ -1))
trigger2   = FVar(10) := (FVar(11) := (FVar(12) := (FVar(13) := (FVar(14) := (FVar(15) := (FVar(16) := 0))))))
trigger3   = NumEnemy > 1
trigger3   = Var(53) := (Var(53) | (2**20)*(Enemy(1),StateType = S) | (2**21)*(Enemy(1),StateType = C) | (2**22)*(Enemy(1),StateType = A) | (2**23)*(Enemy(1),StateType = L))
trigger3   = Var(53) := (Var(53) | (2**24)*(Enemy(1),MoveType = I) | (2**25)*(Enemy(1),MoveType = A) | (2**26)*(Enemy(1),MoveType = H))
trigger3   = Var(53) := (Var(53) | (2**27)*(Enemy(1),HitDefAttr = SCA, NA, SA, HA || Enemy(1),HitDefAttr = , NA, SA, HA))
trigger3   = Var(53) := (Var(53) | (2**28)*(Enemy(1),HitDefAttr = SCA, NT, ST, HT || Enemy(1),HitDefAttr = , NT, ST, HT))
trigger3   = Var(53) := (Var(53) | (2**29)*(Enemy(1),HitDefAttr = SCA, NP, SP, HP || Enemy(1),HitDefAttr = , NP, SP, HP))
trigger3   = 1 || FVar(20) := (Enemy(1),Vel X-FVar(22))*!!Enemy(1),Vel X*IfElse(Enemy(1),Vel X>0,Enemy(1),FrontEdgeBodyDist>0,Enemy(1),BackEdgeBodyDist>0)
trigger3   = 1 || FVar(21) := IfElse((Var(53) & 2**26)+(Enemy(1),StateNo=[120,155]),Enemy(1),GetHitVar(YAccel),Enemy(1),Const(Movement.YAccel))*!((Enemy(1),Pos Y < 0)*FVar(23))
trigger3   = 1 || FVar(22) := Enemy(1),Vel X*!Enemy(1),Ctrl*IfElse(Enemy(1),Vel X>0,Enemy(1),FrontEdgeBodyDist>0,Enemy(1),BackEdgeBodyDist>0)*!(Enemy(1),Anim=[20,21])
trigger3   = 1 || FVar(23) := Enemy(1),Vel Y
trigger3   = 1 || FVar(24) := Enemy(1),Vel Z
trigger3   = 1 || FVar(25) := IfElse(Facing=Enemy(1),Facing,IfElse((Var(53) & 2**22),Enemy(1),Const(Size.Air.Back),Enemy(1),Const(Size.Ground.Back)),-IfElse((Var(53) & 2**22),Enemy(1),Const(Size.Air.Front),Enemy(1),Const(Size.Ground.Front)))
trigger3   = 1 || FVar(25) := (FVar(25)+Enemy(1),Pos X-Pos X)*Facing
trigger3   = 1 || FVar(26) := Enemy(1),Pos Y-Pos Y
trigger3   = !Enemy(1),Alive || 0 && Var(2) := (Var(2) | ((Abs(FVar(25))<Abs(FVar(10))||!Enemy(0),Alive)&&Enemy(1),Alive))
trigger3   = Var(53) := (Var(53) & ((2**20 | 2**21 | 2**22 | 2**23 | 2**24 | 2**25 | 2**26 | 2**27 | 2**28 | 2**29) ^ -1))
trigger3   = FVar(20) := (FVar(21) := (FVar(22) := (FVar(23) := (FVar(24) := (FVar(25) := (FVar(26) := 0))))))
trigger4   = NumEnemy > (Var(2) & 1)
trigger4   = NumTarget || 0 && FVar(37) := Floor(Enemy(Var(2) & 1),Pos X-Pos X)*Facing && FVar(38) := Floor(Enemy(Var(2) & 1),Pos Y-Pos Y+Enemy(Var(2) & 1),Const(Size.Mid.Pos.Y))
trigger4   = Target,Alive
trigger4   = FVar(37) := Floor(Target,Pos X-Pos X)*Facing || FVar(38) := Floor(Target,Pos Y-Pos Y+Target,Const(Size.Mid.Pos.Y))
trigger5   = 1
sysvar(2)  = (Var(2) | (Root,SysVar(2) & 1073741824))
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = 1 || Var(0) :=        6300*IsHelper(6300)+6301*IsHelper(6301)+6302*IsHelper(6302)+6303*IsHelper(6303)+6304*IsHelper(6304)+6308*IsHelper(6308)
trigger1   = 1 || Var(0) := Var(0)+6500*IsHelper(6500)+6501*IsHelper(6501)+6502*IsHelper(6502)+6503*IsHelper(6503)+6504*IsHelper(6504)+6505*IsHelper(6505)+6506*IsHelper(6506)+6507*IsHelper(6507)+6508*IsHelper(6508)+6509*IsHelper(6509)+6510*IsHelper(6510)
trigger1   = 1 || Var(0) := Var(0)+6600*IsHelper(6600)+6601*IsHelper(6601)+6602*IsHelper(6602)+6603*IsHelper(6603)+6604*IsHelper(6604)+6605*IsHelper(6605)+6606*IsHelper(6606)+6607*IsHelper(6607)+6608*IsHelper(6608)+6609*IsHelper(6609)+6610*IsHelper(6610)
trigger1   = 1 || Var(0) := Var(0)+10000*IsHelper(10000)+10050*IsHelper(10050)+40000*IsHelper(40000)
trigger1   = SelfAnimExist(Abs(Var(0))) && Anim-Var(0)
value      = Var(0)
elem       = 1
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = Anim < 6000
value      = SCA, NA, SA, HA, NT, ST, HT, NP, SP, HP, AA, AT, AP
time       = -1
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = StateNo+1
ctrl       = (Var(29) := 0)
ignorehitpause = 1
persistent = 256


