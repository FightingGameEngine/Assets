removetime     = -2
pausemovetime  = 2147483647
supermovetime  = 2147483647
ignorehitpause = 1

[State ]
type           = Explod
trigger1       = !AnimElemTime(3)
ID             = StateNo+3
anim           = 15003
pos            = 0,0
postype        = Back
facing         = 1
vfacing        = 1
bindtime       = -1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = 2.14,1.16
sprpriority    = -5
ontop          = 0
shadow         = 0,0,0
ownpal         = 0
removeongethit = 0
removetime     = -1
pausemovetime  = 2147483647
supermovetime  = 2147483647
ignorehitpause = 1

[State ]
type       = ModifyExplod
trigger1   = NumExplod(StateNo+3)
trigger1   = 1 || Var(0) :=        (Root,AnimElemTime(08) >= 0 && Root,AnimElemTime(09) < 0 && Root,Anim = 400)
trigger1   = 1 || Var(0) := Var(0)+(Root,AnimElemTime(07) >= 0 && Root,AnimElemTime(08) < 0 && Root,Anim = 410)
trigger1   = 1 || Var(0) := Var(0)+(Root,AnimElemTime(08) >= 0 && Root,AnimElemTime(09) < 0 && Root,Anim = 430)
ID         = StateNo+3
trans      = AddAlpha
alpha      = 256,256*!Var(0)
ignorehitpause = 1

[State ]
type       = RemoveExplod
trigger1   = !AnimElemTime(5)
ID         = StateNo+3
ignorehitpause = 1

[State ]
type       = BGPalfx
trigger1   = AnimElemTime(5) >= 0
time       = 1
add        = 256-8*AnimElemTime(5),256-8*AnimElemTime(5),256-8*AnimElemTime(5)
invertall  = 0
color      = 256
ignorehitpause = 1

[State ]
type       = PalFx
trigger1   = 1
time       = 1
add        = -200,-200,80
ignorehitpause = 1

[State ]
type       = PalFx
trigger1   = Root,AnimElemTime(08) >= 0 && Root,AnimElemTime(09) < 0 && Root,Anim = 400
trigger2   = Root,AnimElemTime(07) >= 0 && Root,AnimElemTime(08) < 0 && Root,Anim = 410
trigger3   = Root,AnimElemTime(08) >= 0 && Root,AnimElemTime(09) < 0 && Root,Anim = 430
time       = 1
add        = 130,130,390
ignorehitpause = 1

[State ]
type       = DestroySelf
trigger1   = !AnimTime
ignorehitpause = 1


