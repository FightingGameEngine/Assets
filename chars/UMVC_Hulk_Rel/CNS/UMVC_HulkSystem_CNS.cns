size.ground.front = 0
size.air.back     = 0
size.air.front    = 0
size.height       = 0
size.proj.doscale = 0
size.head.pos     = 0,0
size.mid.pos      = 0,0
size.shadowoffset = 0
ignorehitpause    = 1

[State ]
