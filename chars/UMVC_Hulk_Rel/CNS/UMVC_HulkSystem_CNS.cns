triggerall        = Alive && RoundState < 3 && NumEnemy
trigger1          = !NumHelper(Var(0) := 13000+(NumHelper(13000) && NumEnemy > 1)) ; Anim
trigger2          = !NumHelper(Var(0) := 13010+(NumHelper(13010) && NumEnemy > 1)) ; StateNo
trigger3          = !NumHelper(Var(0) := 13020+(NumHelper(13020) && NumEnemy > 1)) ; AnimTime
trigger4          = !NumHelper(Var(0) := 13030+(NumHelper(13030) && NumEnemy > 1)) ; AnimTime
helpertype        = Normal
name              = "Learning"
