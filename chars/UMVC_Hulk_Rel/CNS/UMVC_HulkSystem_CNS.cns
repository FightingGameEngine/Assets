;===========================================================================
; 常時監視ステート（－３）
;===========================================================================
[Statedef -3]

[State ]
type       = SelfState
trigger1   = IsHelper
value      = 1
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = NotHitBy
trigger1   = !(SysVar(2) & 268435456)
value      = SCA, NA, SA, HA, NT, ST, HT, NP, SP, HP, AA, AT, AP
time       = 1
ignorehitpause = 1

[State ]
type       = VarRangeSet
trigger1   = !RoundsExisted && !RoundState && StateNo = 5900 && !Time
value      = 0
ignorehitpause = 1

[State ]
type       = VarRangeSet
trigger1   = !RoundsExisted && !RoundState && StateNo = 5900 && !Time
fvalue     = 0
ignorehitpause = 1

[State ]
type       = LifeSet
trigger1   = RoundState = 2 && Alive && Life < LifeMax && Var(35) > 0 && (SysVar(2) & 128) && (MoveType != H || StateNo = [150,155]) && Anim-910
value      = Life+1+0*(Var(35) := Var(35)-1)
ignorehitpause = 1

[State ]
type       = Null
trigger1   = Var(56) := 0 || Var(20) := GameTime
ignorehitpause = 1

[State ]
type       = VelAdd
trigger1   = PalNo > 6 && (SysVar(2) & 128) && StateType = A && Vel Y
x          = 0
y          = Const(Movement.YAccel)*.1*NumExplod(6410)
ignorehitpause = 1

[State ]
type       = ScreenBound
trigger1   = (SysVar(2) & 256)
value      = 1
movecamera = 1,0
ignorehitpause = 1

[State ]
type       = Width
trigger1   = MoveType != H
edge       = Ceil(20*Const(Size.XScale)),0
;player     = 5+IfElse(StateType = A,Const(Size.Air.Front),Const(Size.Ground.Front)),IfElse(StateType = A,Const(Size.Air.Back),Const(Size.Ground.Back))
ignorehitpause = 1

[State ]
type           = Explod
trigger1       = RoundState = 2 && TeamSide = 1 && !NumExplod(6411+3*!(Var(2) & 128)*!Var(37))
ID             = 6411+3*!(Var(2) & 128)*!Var(37)
anim           = 6411+3*!(Var(2) & 128)*!Var(37)
pos            = 140,25
postype        = Left
facing         = 1
vfacing        = 1
bindtime       = -1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = .75,1
sprpriority    = -1005
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 0
removetime     = -1
pausemovetime  = 0
supermovetime  = 0
ignorehitpause = 1

[State ]
type           = Explod
trigger1       = RoundState = 2 && TeamSide = 2 && !NumExplod(6411+3*!(Var(2) & 128)*!Var(37))
ID             = 6411+3*!(Var(2) & 128)*!Var(37)
anim           = 6411+3*!(Var(2) & 128)*!Var(37)
pos            = -140,25
postype        = Right
facing         = -1
vfacing        = 1
bindtime       = -1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = .75,1
sprpriority    = -1005
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 0
removetime     = -1
pausemovetime  = 0
supermovetime  = 0
ignorehitpause = 1

[State ]
type       = AngleDraw
trigger1   = 1
value      = 0
scale      = 1,1
ignorehitpause = 1

[State ]
type       = OffSet
trigger1   = 1
x          = 0
y          = 0
ignorehitpause = 0


;===========================================================================
; TargetState管理
;===========================================================================

[State ]
type       = TargetDrop
trigger1   = (MoveHit = 1 || ProjHit = 1) && NumTarget > 1
trigger1   = Var(0) := Target,GetHitVar(ChainID) && Var(1) := Var(0)-Var(0)%2 && !Target,IsHelper && NumEnemy < 2
excludeID  = Var(0)
keepone    = 1
ignorehitpause = 1

[State ]
type       = TargetState
trigger1   = (MoveHit = 1 || ProjHit = 1) && NumTarget
trigger1   = Var(0) := Target,GetHitVar(ChainID) && Var(1) := Var(0)-Var(0)%2 && !Target,IsHelper
trigger1   = Var(1)-204 && Var(1)-226 && Var(1)-260 && Var(1)-270 && Var(1)-342 && Var(1)-344
value      = 5300
ID         = Var(0)
ignorehitpause = 1

[State ]
type       = SelfState
trigger1   = Alive && (RoundState > 2 || (Var(59) & 1) && !Time) && (StateNo = 10 || StateNo = 20 || StateNo = 40)
value      = (RoundState > 3)*IfElse(Win,180,170+5*LoseTime)
ctrl       = 1
ignorehitpause = 1
persistent = 256


;===========================================================================
; 常時監視ステート（－２）
;===========================================================================

[Statedef -2]

[State ]
type       = SelfState
trigger1   = IsHelper
value      = 1
ignorehitpause = 1
persistent = 256


;===========================================================================
; X-Factorヘルパー
;===========================================================================
[State ]
type              = Helper
trigger1          = (SysVar(2) & 128) && NumExplod(6410) && RoundState = 2
trigger1          = !NumHelper(Var(0) := 11000+NumHelper(11000)+NumHelper(11001)+NumHelper(11002))
helpertype        = Normal
name              = "X-Factor"
ID                = Var(0)
pos               = 0,0
postype           = P1
facing            = 1
stateno           = 11000
keyctrl           = 0
ownpal            = 1
supermovetime     = 2147483647
pausemovetime     = 2147483647
size.xscale       = 1.1*Const(Size.XScale)
size.yscale       = 1.1*Const(Size.YScale)
size.ground.back  = 0
size.ground.front = 0
size.air.back     = 0
size.air.front    = 0
size.height       = 0
size.proj.doscale = 0
size.head.pos     = 0,0
size.mid.pos      = 0,0
size.shadowoffset = 0
ignorehitpause    = 1


