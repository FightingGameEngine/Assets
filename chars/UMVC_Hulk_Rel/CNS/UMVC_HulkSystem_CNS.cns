;===========================================================================
; 基本データ
;===========================================================================
[Data]
life              = 1200
power             = 5000
attack            = 100
defence           = 100
fall.defence_up   = 0
liedown.time      = 30
airjuggle         = 255
sparkno           = -1
guard.sparkno     = -1
KO.echo           = 0
volume            = 0
IntPersistIndex   = 0
FloatPersistIndex = 0


;===========================================================================
; サイズ
;===========================================================================
[Size]
xscale           =   0.900
yscale           =   1.100
ground.back      =  28
ground.front     =  28
air.back         =  28
air.front        =  28
height           = 80
attack.dist      = 000
proj.attack.dist = 000
proj.doscale     = 000
head.pos         = 000,-075
mid.pos          = 000,-035
shadowoffset     = 000
draw.offset      = 000, 008


;===========================================================================
; 移動速度
;===========================================================================
[Velocity]
walk.fwd     =  02.4
walk.back    = -02.4
run.fwd      =   7.0,-3.5
run.back     = -22.0, 0.0
jump.neu     =  00.0,-8.0
jump.back    = -03.0
jump.fwd     =  03.0
runjump.back = -04.0
runjump.fwd  =  04.0,-9.0
airjump.neu  =  00.0,-9.0
airjump.back = -04.0
airjump.fwd  =  04.0


;===========================================================================
; 運動関係
;===========================================================================
[Movement]
airjump.num     =  0
airjump.height  = 35
yaccel          =  0.40
stand.friction  =  0.85
crouch.friction =  0.78


;==============================================================================
; Win版専用パート
