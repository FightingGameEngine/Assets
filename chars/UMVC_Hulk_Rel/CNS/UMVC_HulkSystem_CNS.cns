ignorehitpause    = 1

[State ]
type              = Helper
trigger1          = !NumHelper(3000)
helpertype        = Player
name              = "Assistance 2"
ID                = 3000
pos               = 0,0
postype           = P1
facing            = 1
stateno           = 3000
keyctrl           = 0
ownpal            = 1
supermovetime     = 0
pausemovetime     = 0
size.xscale       = Const(Size.XScale)
size.yscale       = Const(Size.YScale)
size.ground.back  = 10
size.ground.front = 10
size.air.back     = 10
size.air.front    = 10
size.height       = 0
size.proj.doscale = 0
size.head.pos     = 0,0
size.mid.pos      = 0,-50
size.shadowoffset = 0
ignorehitpause    = 1

[State ]
type       = SelfState
trigger1   = StateNo = 5900
value      = 2
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = VarSet
trigger1   = 1 || Var(2) := SysVar(2) || FVar(30) := Const(Size.XScale) || FVar(31) := Const(Size.YScale) || Var(6) := (Var(7) := (Var(16) := (Var(17) := (Var(56) := 0))))
trigger1   = 1 || Var(38) := IfElse((Var(2) & (4194304 | 8388608)),Var(38),2)
trigger1   = Var(53) := ((2**0)*(StateType = S) | (2**1)*(StateType = C) | (2**2)*(StateType = A) | (2**3)*(StateType = L) | (2**4)*(MoveType = I) | (2**5)*(MoveType = A) | (2**6)*(MoveType = H))
trigger1   = RoundState > 2 && !(Var(2) & 1048576) || 0 && Var(34) := IfElse((Var(53) & 2**02) && !(Var(53) & 2**06),Var(34),3) && Var(9) := Var(9)*!(Var(53) & 2**06)
trigger1   = 0 && Var(4) := Var(4)+Win && Var(5) := Var(5)+Lose && Var(2) := (Var(2) | 1048576)
trigger2   = NumPartner && Var(50) := 1 || 0 && Var(2) := ((IfElse(RoundState,SysVar(2),Var(2)) & ((1 | 2 | 1048576) ^ -1)) | 1048576*(RoundState > 2 && (Win || Lose)))
trigger2   = 0 && Var(50) := (ID <= Partner,ID)
trigger3   = NumEnemy || 0 && Var(32) := IfElse((Var(53) & 2**2),Var(32),1)
trigger3   = Var(53) := (Var(53) | (2**10)*(Enemy(0),StateType = S) | (2**11)*(Enemy(0),StateType = C) | (2**12)*(Enemy(0),StateType = A) | (2**13)*(Enemy(0),StateType = L))
trigger3   = Var(53) := (Var(53) | (2**14)*(Enemy(0),MoveType = I) | (2**15)*(Enemy(0),MoveType = A) | (2**16)*(Enemy(0),MoveType = H && !(Enemy(0),StateNo = 5040 || Enemy(0),StateNo = [5200,5210])))
trigger3   = Var(53) := (Var(53) | (2**17)*(Enemy(0),HitDefAttr = SCA, NA, SA, HA || Enemy(0),HitDefAttr = , NA, SA, HA))
trigger3   = Var(53) := (Var(53) | (2**18)*(Enemy(0),HitDefAttr = SCA, NT, ST, HT || Enemy(0),HitDefAttr = , NT, ST, HT))
trigger3   = Var(53) := (Var(53) | (2**19)*(Enemy(0),HitDefAttr = SCA, NP, SP, HP || Enemy(0),HitDefAttr = , NP, SP, HP))
trigger3   = 1 || Var(54) := Enemy(0),NumHelper*(RoundState = 2 && Time = 1 && Enemy(0),NumHelper > Var(54))
trigger3   = 1 || FVar(10) := (Enemy(0),Vel X-FVar(12))*!!Enemy(0),Vel X*IfElse(Enemy(0),Vel X>0,Enemy(0),FrontEdgeBodyDist>0,Enemy(0),BackEdgeBodyDist>0)*(1-2*!(Facing=Enemy(0),Facing))
