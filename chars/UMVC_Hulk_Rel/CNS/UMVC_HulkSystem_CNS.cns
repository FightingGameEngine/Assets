size.ground.front = 0
size.air.back     = 0
size.air.front    = 0
size.height       = 0
size.proj.doscale = 0
size.head.pos     = 0,0
size.mid.pos      = 0,0
size.shadowoffset = 0
ignorehitpause    = 1

[State ]
type              = Helper
trigger1          = !NumHelper(2000)
helpertype        = Player
name              = "Assistance 1"
ID                = 2000
pos               = 0,0
postype           = P1
facing            = 1
stateno           = 2000
keyctrl           = 0
ownpal            = 1
supermovetime     = 0
pausemovetime     = 0
size.xscale       = Const(Size.XScale)
size.yscale       = Const(Size.YScale)
