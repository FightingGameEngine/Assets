trigger2   = Enemy(Var(22)),Name = "WolverineB"
trigger3   = Enemy(Var(22)),Name = "Wolverine COTA"
trigger4   = Enemy(Var(22)),Name = "MvC-EoH Wolverine"
trigger5   = Enemy(Var(22)),Name = "X-Men Arcade Wolverine"

ignorehitpause = 0
persistent = 0

[State IRONMAN]
