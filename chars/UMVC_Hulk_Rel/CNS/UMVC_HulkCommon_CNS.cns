;===========================================================================
; コモンステート
;===========================================================================
; 立ち
; Stand
[Statedef 0]
type            = U
movetype        = U
physics         = N
facep2          = 0
juggle          = 0
ctrl            = Ctrl
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = NotHitBy
trigger1   = MoveType = H
value      = , NT, ST, HT, AT
time       = 1
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 1
movetype   = I
ignorehitpause = 1

[State ]
type       = ChangeState
triggerall = Alive && !(SysVar(2) & 536870912)
trigger1   = Var(0) := Anim && (AnimTime && Anim = 12 || Anim = [10,11])
trigger2   = Var(0) := 50 && StateType = A
value      = Var(0)
ctrl       = 1
ignorehitpause = 1
persistent = 256

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = S
movetype   = I
physics    = S
ignorehitpause = 1

[State ]
type       = VelSet
trigger1   = 1
x          = Vel X*(Abs(Vel X) >= .8)
y          = 0
ignorehitpause = 1

[State ]
type       = AssertSpecial
trigger1   = RoundState > 2
flag       = NoWalk
flag2      = NoStandGuard
ignorehitpause = 1

[State ]
type       = CtrlSet
trigger1   = 1
value      = (RoundState > 2 || (SysVar(2) & 268435456))
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = !(Ctrl && (SysVar(2) & 268435456) && RoundState < 3)
trigger2   = NumEnemy
trigger2   = !Enemy(0),Alive && !Enemy(NumEnemy > 1),Alive
value      = SCA, NA ,SA ,HA ,NT ,ST ,HT ,NP ,SP ,HP ,AA ,AT ,AP
time       = 1
ignorehitpause = 1

[State ]
type       = Turn
trigger1   = RoundState < 3 && NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = IfElse(Anim = 5,!AnimTime,Anim)
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = Ctrl
sysvar(2)  = (SysVar(2) | 268435456 | 2*(SysVar(2) & 268435456))
ignorehitpause = 1

[State ]
type       = DestroySelf
trigger1   = IsHelper
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = PlayerIDExist(ID)
trigger1   = !Alive
value      = 5050
ctrl       = 0
ignorehitpause = 0


;---------------------------------------------------------------------------
[Statedef 5]
type            = S
movetype        = I
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = PlayerIDExist(ID)
value      = 0
ctrl       = ((SysVar(2) & 268435456) || RoundState > 2)
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
[Statedef 6]
type            = C
movetype        = I
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = PlayerIDExist(ID)
value      = 11
ctrl       = ((SysVar(2) & 268435456) || RoundState > 2)
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
; しゃがみ開始
; Stand to Crouch
[Statedef 10]
type            = C
movetype        = I
physics         = C
facep2          = 1
juggle          = 0
ctrl            = !!(SysVar(2) & 268435456)
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = Anim-StateNo
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !(AnimTime && (Var(9) & 2**3))
value      = 11
ctrl       = 0
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
; しゃがみ
; Crouching
[Statedef 11]
type            = C
movetype        = I
physics         = C
facep2          = 0
juggle          = 0
ctrl            = !!(SysVar(2) & 268435456)
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = !IfElse(Anim = 6,AnimTime,Anim = StateNo)
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = Turn
trigger1   = NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !(RoundState = 2 && (Var(9) & 2**3))
value      = 12
ctrl       = 0
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
; 立ち上がり
; Crouch to Stand
[Statedef 12]
type            = S
movetype        = I
physics         = C
facep2          = 0
juggle          = 0
ctrl            = !!(SysVar(2) & 268435456)
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = Anim-StateNo
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !AnimTime
value      = 5
ctrl       = 0
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
; 歩き
; Walk
[Statedef 20]
type            = S
movetype        = I
physics         = S
facep2          = 0
juggle          = 0
ctrl            = !!(SysVar(2) & 268435456)
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = VelSet
trigger1   = (Var(9) & (2**00 | 2**01))
x          = IfElse((Var(9) & 2**00),Const(Velocity.Walk.Fwd.X),Const(Velocity.Walk.Back.X))+(Var(23) := 0)
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = IfElse(Anim = 5,!AnimTime,IfElse(Vel X,Anim-StateNo-(Vel X < 0),0))
value      = StateNo+(Vel X < 0)
elem       = 1
ignorehitpause = 1

[State ]
type       = VelSet
trigger1   = 1;(Var(9) & (2**00 | 2**01))
x          = 0
ignorehitpause = 1

[State ]
type       = PosAdd
triggerall = Anim = 20
trigger1   = FVar(0) :=   2 && !(Var(23) & 2**10) && AnimElemTime(03) = [0,0]
trigger2   = FVar(0) :=  16 && !(Var(23) & 2**11) && AnimElemTime(08) = [0,0]
trigger3   = FVar(0) :=   8 && !(Var(23) & 2**12) && AnimElemTime(12) = [0,0]
trigger4   = FVar(0) :=  13 && !(Var(23) & 2**13) && AnimElemTime(17) = [0,0]
trigger5   = FVar(0) :=  20 && !(Var(23) & 2**14) && AnimElemTime(21) = [0,0]
trigger6   = FVar(0) :=  24 && !(Var(23) & 2**15) && AnimElemTime(26) = [0,0]
trigger7   = FVar(0) :=  10 && !(Var(23) & 2**16) && AnimElemTime(30) = [0,0]
trigger8   = FVar(0) :=   5 && !(Var(23) & 2**17) && AnimElemTime(35) = [0,0]
trigger9   = FVar(0) :=   5 && !(Var(23) & 2**18) && AnimElemTime(39) = [0,0]
trigger10  = FVar(0) :=  12 && !(Var(23) & 2**19) && AnimElemTime(44) = [0,0]
trigger11  = FVar(0) :=   7 && !(Var(23) & 2**20) && AnimElemTime(48) = [0,0]
trigger12  = FVar(0) :=  12 && !(Var(23) & 2**21) && AnimElemTime(53) = [0,0]
trigger13  = FVar(0) :=  21 && !(Var(23) & 2**22) && AnimElemTime(57) = [0,0]
trigger14  = FVar(0) :=  20 && !(Var(23) & 2**23) && AnimElemTime(62) = [0,0]
trigger15  = FVar(0) :=   4 && !(Var(23) & 2**24) && AnimElemTime(66) = [0,0]
trigger16  = FVar(0) :=   7 && !(Var(23) & 2**25) && AnimElemTime(71) = [0,0]
x          = FVar(0)*Const(Size.XScale)
ignorehitpause = 1

[State ]
type       = PosAdd
triggerall = Anim = 21
trigger1   = FVar(0) :=   4 && !(Var(23) & 2**10) && AnimElemTime(03) = [0,0]
trigger2   = FVar(0) :=  22 && !(Var(23) & 2**11) && AnimElemTime(08) = [0,0]
trigger3   = FVar(0) :=  22 && !(Var(23) & 2**12) && AnimElemTime(12) = [0,0]
trigger4   = FVar(0) :=  12 && !(Var(23) & 2**13) && AnimElemTime(17) = [0,0]
trigger5   = FVar(0) :=   6 && !(Var(23) & 2**14) && AnimElemTime(21) = [0,0]
trigger6   = FVar(0) :=  12 && !(Var(23) & 2**15) && AnimElemTime(26) = [0,0]
trigger7   = FVar(0) :=   6 && !(Var(23) & 2**16) && AnimElemTime(30) = [0,0]
trigger8   = FVar(0) :=   5 && !(Var(23) & 2**17) && AnimElemTime(35) = [0,0]
trigger9   = FVar(0) :=  10 && !(Var(23) & 2**18) && AnimElemTime(39) = [0,0]
trigger10  = FVar(0) :=  22 && !(Var(23) & 2**19) && AnimElemTime(44) = [0,0]
trigger11  = FVar(0) :=  20 && !(Var(23) & 2**20) && AnimElemTime(48) = [0,0]
trigger12  = FVar(0) :=  12 && !(Var(23) & 2**21) && AnimElemTime(53) = [0,0]
trigger13  = FVar(0) :=   6 && !(Var(23) & 2**22) && AnimElemTime(57) = [0,0]
trigger14  = FVar(0) :=  16 && !(Var(23) & 2**23) && AnimElemTime(62) = [0,0]
trigger15  = FVar(0) :=   2 && !(Var(23) & 2**24) && AnimElemTime(66) = [0,0]
trigger16  = FVar(0) :=   7 && !(Var(23) & 2**25) && AnimElemTime(71) = [0,0]
x          = -FVar(0)*Const(Size.XScale)
ignorehitpause = 1

[State ]
type           = PlaySnd
trigger1       = !(Var(23) & 2**00) && (AnimElemTime(32) = [0,1])
trigger2       = !(Var(23) & 2**01) && (AnimElemTime(68) = [0,1])
value          = s52,1
volume         = -200
channel        = -1
lowpriority    = 0
freqmul        = 1.0
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0

[State ]
type       = EnvShake
trigger1   = (AnimElemTime(32) = [0,1])
trigger1   = Var(23) := (Var(23) | 2**00)
trigger2   = (AnimElemTime(68) = [0,1])
trigger2   = Var(23) := (Var(23) | 2**01)
time       = 10
ampl       = -2
freq       = 60
phase      = 10
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !((Var(9) & (2**00 | 2**01)) && RoundState = 2)
value      = 5
ctrl       = 0
ignorehitpause = 1
persistent = 256


