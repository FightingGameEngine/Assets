;---------------------------------------------------------------------------
; アーマー
[Statedef 9999]
type            = U
movetype        = H
physics         = U
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
;sprpriority     = 3
hitdefpersist   = 1
movehitpersist  = 1
hitcountpersist = 1

[State ]
Type       = SelfState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
Ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeState
trigger1   = PrevStateNo = [120,155]
value      = PrevStateNo
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = 1
value      = Anim
elem       = AnimElemNo((AnimElemNo(0) = 1)-1)
ignorehitpause = 1

[State ]
type       = PosFreeze
trigger1   = 1
value      = 1
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 0 && Time
movetype   = I
ignorehitpause = 1
persistent = 0

[State ]
type       = StateTypeSet
trigger1   = 0 && Time && (Anim = [200,432])
movetype   = A
ignorehitpause = 1
persistent = 0

[State ]
type       = VelSet
trigger1   = PrevStateNo-StateNo
trigger1   = 1 || FVar(19) := Vel X || FVar(29) := Vel Y
x          = 0
y          = 0
ignorehitpause = 1
persistent = 0

[State ]
type       = VelSet
trigger1   = HitShakeOver && !HitOver
x          = FVar(19)
y          = FVar(29)
ignorehitpause = 0

[State ]
type       = LifeAdd
trigger1   = !Time && HitShakeOver
value      = -GetHitVar(Damage)
ignorehitpause = 0
persistent = 0

[State ]
type       = ChangeState
trigger1   = HitShakeOver && !Alive
value      = 5000
ctrl       = 0
ignorehitpause = 0

[State ]
type       = ChangeState
trigger1   = HitShakeOver && !HitOver
value      = Anim+(1-(Anim = 301 || Anim = 303 || Anim = 305))*(Anim = 20 || Anim = 40 || Anim = 45 || Anim = 48 || Anim = 52 || (Anim = [100,107]) || Anim = [200,410])-5*((Anim = 5)-(Anim = 6))
ctrl       = 0
ignorehitpause = 0


