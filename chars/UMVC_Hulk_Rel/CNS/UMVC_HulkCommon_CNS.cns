;---------------------------------------------------------------------------
; ハイジャンプ開始
; High Jump Start
[Statedef 48]
type            = S
movetype        = I
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = Turn
trigger1   = NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(2)  = (SysVar(2) | 8*((Anim = 206 || Anim = 346) && (SysVar(3) & (2**00 | 2**01))))
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = 1
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1 || Var(22) := (Var(9) & (2**0 | 2**1))
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = StateNo+1
ctrl       = 0
ignorehitpause = 1
persistent = 256


;---------------------------------------------------------------------------
; ハイジャンプ開始
; High Jump Start
[Statedef 49]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 1
movehitpersist  = 1
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = NotHitBy
trigger1   = 1
value      = , NT, ST, HT, AT
time       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(2)  = (SysVar(2) | 64)
ignorehitpause = 1

[State ]
type       = VelSet
trigger1   = 1 || Var(22) := IfElse((Var(9) & (2**00 | 2**01)),(Var(9) & (2**00 | 2**01)),Var(22))
trigger1   = !AnimTime
x          = IfElse((Var(22) & 2**00),Const(Velocity.Jump.Fwd.X),IfElse((Var(22) & 2**01),Const(Velocity.Jump.Back.X),Const(Velocity.Jump.Neu.X)))
y          = Const(Velocity.Jump.Y)*2.025
ignorehitpause = 1
persistent = 0

[State ]
type       = VelMul
trigger1   = !AnimTime
x          = 1+.1*NumExplod(6410)*(PalNo > 6)
y          = 1+.1*NumExplod(6410)*(PalNo > 6)
ignorehitpause = 1
persistent = 0

[State ]
type           = PlaySnd
trigger1       = !AnimTime
value          = s40,1
volume         = 0
channel        = -1
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0

[State ]
type           = Explod
trigger1       = !AnimTime
ID             = 6400
anim           = 6400
pos            = 0,20
postype        = P1
facing         = 1
vfacing        = 1
bindtime       = 1
vel            = 0,0
accel          = 0,0
random         = 0,0
scale          = Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290,Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290
sprpriority    = 4
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 0
removetime     = -2
pausemovetime  = 2147483647
supermovetime  = 2147483647
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = !AnimTime
value      = 50
ctrl       = 0
ignorehitpause = 1
persistent = 256


