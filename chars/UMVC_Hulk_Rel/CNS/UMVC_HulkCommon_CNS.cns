[Statedef 910]
type            = U
movetype        = A
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = Pos Y
statetype  = A
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = (SysVar(2) & 268435456)
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(2)  = SysVar(2)
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = 0
ignorehitpause = 1

[State ]
type       = Turn
trigger1   = NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = PosSet
trigger1   = Pos Y >= 0
y          = 0
ignorehitpause = 1

[State ]
type       = MoveHitReset
trigger1   = 1
ignorehitpause = 1

[State ]
type       = StopSnd
trigger1   = 1
channel    = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = IfElse((SysVar(2) & 268435456),StateNo+1,5)
ctrl       = 0
ignorehitpause = 1


