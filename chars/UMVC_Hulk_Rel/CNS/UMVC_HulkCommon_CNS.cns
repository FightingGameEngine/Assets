trigger2   = Enemy(Var(22)),Name = "Street Fighter II Haggar"
trigger3   = Enemy(Var(22)),Name = "Haggar"
trigger4   = Enemy(Var(22)),Name = "Mike Haggar"
trigger5   = Enemy(Var(22)),Name = "Mike Macho Haggar"
trigger6   = Enemy(Var(22)),Name = "Haggar Capcom Style"

ignorehitpause = 0
persistent = 0

