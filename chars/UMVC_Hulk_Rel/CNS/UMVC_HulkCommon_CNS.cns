trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5200
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = A
movetype   = H
physics    = N
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = Anim = 5035 && !AnimTime
value      = 5050
elem       = 1
ignorehitpause = 0

[State ]
type       = Gravity
trigger1   = 1
ignorehitpause = 0

[State ]
type       = SelfState
trigger1   = Vel Y > 0 && Pos Y >= -10
value      = 5201
ctrl       = 0
ignorehitpause = 0
persistent = 256


;---------------------------------------------------------------------------
; HIT_FALLRECOVER (on the ground)
[Statedef 5201]
type            = A
movetype        = H
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,-3.5
poweradd        = 0
sprpriority     = -3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = SelfState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = StateNo
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = A
movetype   = H
physics    = N
ignorehitpause = 1

[State ]
type       = ChangeAnim
trigger1   = Anim-5200
value      = 5200
elem       = 1
ignorehitpause = 0

[State ]
type       = Turn
trigger1   = !AnimElemTime(1) && NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < -5
ignorehitpause = 0

[State ]
type       = Gravity
trigger1   = 1
ignorehitpause = 0

[State ]
type       = VelSet
trigger1   = 1
x          = -.15
ignorehitpause = 0

[State ]
type       = PosSet
trigger1   = !Time
y          = 0
ignorehitpause = 0

[State ]
type       = NotHitBy
trigger1   = 1
value      = SCA, NA, SA, HA, NT, ST, HT, NP, SP, HP, AA, AT, AP
time       = 1
ignorehitpause = 1

[State ]
type       = PalFX
trigger1   = !AnimElemTime(1)
time       = 3
add        = 128,128,128
ignorehitpause = 0

[State ]
type       = GameMakeAnim
trigger1   = AnimElemTime(1) = 1
value      = 60
pos        = 0, 0
under      = 1
ignorehitpause = 0

[State ]
type       = SelfState
trigger1   = Vel Y > 0 && Pos Y >= 0
value      = 52
ctrl       = 0
ignorehitpause = 0
persistent = 256


;---------------------------------------------------------------------------
; HIT_AIRFALLRECOVER
[Statedef 5210]
type            = A
movetype        = I
physics         = N
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = -3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = SelfState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = StateNo
ctrl       = 0
ignorehitpause = 1

[State ]
type       = SelfState
trigger1   = !Alive
value      = 5050
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = Anim-StateNo
value      = StateNo
elem       = 1
ignorehitpause = 0

[State ]
type       = StateTypeSet
trigger1   = 1
statetype  = A
movetype   = I
physics    = N
ignorehitpause = 1

[State ]
type       = NotHitBy
trigger1   = AnimElemTime(1) < 19
value      = SCA, NA, SA, HA, NT, ST, HT, NP, SP, HP, AA, AT, AP
time       = 1
ignorehitpause = 1

[State ]
type       = PalFX
trigger1   = !AnimElemTime(1)
time       = 3
add        = 128,128,128
ignorehitpause = 0

[State ]
type       = PosFreeze
trigger1   = !AnimElemTime(1)
value      = 1
ignorehitpause = 0

[State ]
type       = Turn
trigger1   = AnimElemTime(1) = 4 && NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < -20
ignorehitpause = 0

[State ]
type       = VelSet
trigger1   = !AnimElemTime(1)
x          = 0
y          = -2
ignorehitpause = 0

[State ]
type       = VelSet
trigger1   = AnimElemTime(1) = 4
x          =  3*(1-2*!!(Var(9) & 2**01))*!!(Var(9) & (2**00 | 2**01))
y          = -4
ignorehitpause = 0

[State ]
type       = Gravity
trigger1   = AnimElemTime(1) > 4
ignorehitpause = 0

[State ]
type       = CtrlSet
trigger1   = 1
value      = (AnimElemTime(1) > 17)
ignorehitpause = 0

[State ]
type       = SelfState
trigger1   = Vel Y > 0 && Pos Y >= 0
value      = 52
ctrl       = 0
ignorehitpause = 0
persistent = 256


;---------------------------------------------------------------------------
; ラウンド開始時
; Initialize (At The Start of The Round)
[Statedef 5900]
type            = S
movetype        = I
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = 0,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = PowerSet
trigger1   = !RoundsExisted && Power < 1000
value      = 1000
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysfvar(4) = FVar(4)
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = NumEnemy
trigger1   = Var(2) := (Var(2) & (1073741824*!Enemy,RoundsExisted ^ -1))
trigger2   = 1
sysvar(2)  = (Var(2) & ((1 | 2 | 4 | 8 | 128 | 1048576 | 16777216 | 33554432 | 268435456 | 536870912) ^ -1))
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = 5+185*!(RoundNo-1 && RoundsExisted)
ctrl       = (Var(22) := 0)
ignorehitpause = 1
persistent = 256


