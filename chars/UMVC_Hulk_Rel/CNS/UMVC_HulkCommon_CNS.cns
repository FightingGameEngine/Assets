trigger2   = Enemy(Var(22)),Name = "Ironman"
trigger3   = Enemy(Var(22)),Name = "IronMan_ZEROGOU"
trigger4   = Enemy(Var(22)),Name = "Iron-Man"
trigger5   = Enemy(Var(22)),Name = "Iron Man"
trigger6   = Enemy(Var(22)),Name = "ironman/gunslinger"

ignorehitpause = 0
persistent = 0

[State SHE-HULK]
