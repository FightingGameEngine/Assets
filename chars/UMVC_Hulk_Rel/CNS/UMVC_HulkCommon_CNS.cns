ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeState
trigger1   = StateType = A
value      = StateNo+5
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = 1
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
