sysfvar(4) = .75
ignorehitpause = 1

[State ]
type       = HitAdd
trigger1   = AnimElemTime(10) >= 0 && AnimElemTime(70) < 0 && !(AnimElemTime(10)%6) || !AnimElemTime(79)
