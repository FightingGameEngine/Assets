;===========================================================================
; 必殺技
; Special Moves
;===========================================================================
; ガンマチャージ（弱）
; Gamma Charge (Light)
[Statedef 300]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,0
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = ChangeAnim
trigger1   = (SysVar(2) & 268435456)
value      = StateNo
elem       = 1
ignorehitpause = 1

[State ]
type       = VarSet
trigger1   = 1
sysvar(3)  = (Var(22) := (Var(23) := 0))
ignorehitpause = 1

[State ]
type       = Turn
trigger1   = NumEnemy
trigger1   = (EnemyNear(NumEnemy > 1 && !EnemyNear(0),Alive),Pos X-Pos X)*Facing < 0
ignorehitpause = 1

[State ]
type       = PosSet
trigger1   = Pos Y >= 0
y          = 0
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = 1
value      = IfElse((SysVar(2) & 268435456),StateNo+1,5)
ctrl       = 0
ignorehitpause = 1


;---------------------------------------------------------------------------
; ガンマチャージ（弱）
; Gamma Charge (Light)
[Statedef 301]
type            = S
movetype        = A
physics         = S
facep2          = 0
juggle          = 0
ctrl            = 0
anim            = -1
velset          = Vel X,Vel Y
poweradd        = 0
sprpriority     = 3
hitdefpersist   = 1
movehitpersist  = 1
hitcountpersist = 0

[State ]
type       = ChangeState
trigger1   = !(Name = "UMVC_Hulk" && AuthorName = "Rel")
value      = 5150
ctrl       = 0
ignorehitpause = 1
persistent = 256

[State ]
type       = HitAdd
trigger1   = MoveHit = 1 && !MoveReversed && HitPauseTime = 7
trigger1   = Var(25) := Anim || Var(26) := 1 || Var(30) := Var(30)+1
value      = 1
ignorehitpause = 1

[State ]
type       = Width
trigger1   = 1 || Var(22) := (Var(22) | (Var(9) & (2**23 | 2**24 | 2**25))*(AnimElemTime(8) > 0 && AnimElemTime(26) < 0))
edge       = 20-19*(AnimElemTime(15) < 0),0
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = 1
movetype   = A
physics    = N
ignorehitpause = 1

[State ]
type       = StateTypeSet
trigger1   = AnimElemTime(14) > 0
movetype   = I
ignorehitpause = 1

[State ]
type       = HitOverride
trigger1   = AnimElemTime(9) >= 0 && AnimElemTime(16) < 0 && PrevStateNo != 9999
attr       = SCA, NA, SA, HA, NP, SP, HP, AA, AP
slot       = 1
stateno    = 9999
time       = 1
forceair   = 0
ignorehitpause = 1

[State ]
type       = VelSet
trigger1   = !(Var(23) & 2**01) && AnimElemTime(9) = [0,1]
trigger1   = Var(23) := (Var(23) | 2**01)
x          = 15
y          = 0
ignorehitpause = 0

[State ]
type       = VelMul
trigger1   = AnimElemTime(14) > 0
x          = .95
y          = 1
ignorehitpause = 0

[State ]
type           = PlaySnd
trigger1       = !(Var(23) & 2**10) && AnimElemTime(1) = [0,1]
trigger1       = Var(23) := (Var(23) | 2**10)
value          = s1,300
volume         = 255
channel        = 0
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = PlaySnd
trigger1       = !(Var(23) & 2**00) && AnimElemTime(9) = [0,1]
trigger1       = Var(23) := (Var(23) | 2**00)
value          = s226,0
volume         = 255
channel        = -1
lowpriority    = 0
freqmul        = 1.00
loop           = 0
pan            = 0
;abspan         = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = Explod
trigger1       = !(Var(23) & 2**11) && AnimElemTime(9) = [0,1]
trigger1       = Var(23) := (Var(23) | 2**11)
ID             = 30000
anim           = 6301
pos            = Ceil(60*Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290),Ceil(-70*Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290)
postype        = P1
facing         = 1
vfacing        = 1
bindtime       = -1
vel            = 0
accel          = 0,0
random         = 0,0
scale          = Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290,Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290
sprpriority    = 5
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 1
removetime     = -AnimElemTime(30)
pausemovetime  = 0
supermovetime  = 0
ignorehitpause = 0
persistent     = 0

[State ]
type           = Explod
trigger1       = !(Var(23) & 2**12) && AnimElemTime(9) = [0,1]
trigger1       = Var(23) := (Var(23) | 2**12)
ID             = 30000
anim           = 6301
pos            = Ceil(20*Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290),Ceil(-70*Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290)
postype        = P1
facing         = 1
vfacing        = 1
bindtime       = -1
vel            = 0
accel          = 0,0
random         = 0,0
scale          = .85*Const(Size.XScale)/(FrontEdgeDist+BackEdgeDist)*290,.85*Const(Size.YScale)/(FrontEdgeDist+BackEdgeDist)*290
sprpriority    = 4
ontop          = 0
shadow         = 0,0,0
ownpal         = 1
removeongethit = 1
removetime     = -AnimElemTime(30)
pausemovetime  = 0
supermovetime  = 0
trans          = AddAlpha
alpha          = 50,256
ignorehitpause = 0
persistent     = 0

[State ]
type       = MoveHitReset
trigger1   = !(Var(23) & 2**05) && AnimElemTime(11) = [0,1]
trigger1   = Var(23) := (Var(23) | 2**05)
trigger2   = !(Var(23) & 2**06) && AnimElemTime(13) = [0,1]
trigger2   = Var(23) := (Var(23) | 2**06)
ignorehitpause = 0

[State ]
type                       = HitDef
trigger1                   = !MoveContact && !MoveReversed && (!(SysVar(1) & 2**25) || AnimElemNo(0) = [9,14])
attr                       = S, SA
animtype                   = Back
priority                   = 4, Hit
damage                     = Ceil(Ceil(50000*SysFVar(4)*IfElse(.900**Var(30) > .300+.050*!!NumExplod(6410),.900**Var(30),.300+.050*!!NumExplod(6410)))*1000./1000000),Ceil(Ceil(50000*SysFVar(4)*.30)*1000./1000000)
hitflag                    = MAF
guardflag                  = MA
getpower                   = Ceil(Ceil(50000*SysFVar(1)*.80)*1000./1000000     *!Var(31)),Ceil(Ceil(50000*SysFVar(1)*.80)*1000./1000000*.625     *!Var(31))
givepower                  = Ceil(Ceil(50000*SysFVar(1)*.80)*1000./1000000*.650         ),Ceil(Ceil(50000*SysFVar(1)*.80)*1000./1000000*.650*.625         )
pausetime                  = 8,8
guard.pausetime            = 8,8
sparkno                    = -1
guard.sparkno              = -1
sparkxy                    = 0,0
hitsound                   = -1,0
guardsound                 = -1,0
ground.type                = High
ground.slidetime           = 1+(38-Var(29))*(Var(29) < 38)
ground.hittime             = 1+(38-Var(29))*(Var(29) < 38)
ground.velocity            = -6.5,-9.3
guard.hittime              = 25+TeamSide
guard.ctrltime             = 25+TeamSide
guard.velocity             = -6.5
;air.type                   = Trip
air.hittime                = 1+(38-Var(29))*(Var(29) < 38)
air.velocity               = -6.5,-9.3
airguard.ctrltime          = 25+TeamSide
airguard.velocity          = -6.5,0
down.velocity              = 0,0
ground.cornerpush.veloff   = -11.5*4/3
air.cornerpush.veloff      = 0
down.cornerpush.veloff     = 0
guard.cornerpush.veloff    = 0
airguard.cornerpush.veloff = 0
yaccel                     = 1.60*Const(Movement.YAccel)
sprpriority                = 3
;p1facing                   = 1
p1getp2facing              = 0
p2facing                   = 1
;p1stateno                  = 
;p2stateno                  = 5000
;p2getp1state               = 0
fall                       = 1
fall.xvelocity             = 0
fall.yvelocity             = 0
fall.recover               = 1
fall.recovertime           = 1+(38-Var(29))*(Var(29) < 38)
fall.damage                = 0
air.fall                   = 1
ID                         = StateNo-Var(50)
chainID                    = -1
nochainID                  = -1
hitonce                    = 0
kill                       = 1
guard.kill                 = 1
fall.kill                  = 1
numhits                    = 0
guard.dist                 = 0
ignorehitpause             = 0

[State ]
type       = HitDef
trigger1   = MoveContact || MoveReversed || AnimElemNo(0) != [9,14]
attr       = 
hitflag    = 
guardflag  = 
ignorehitpause = 1

[State ]
type       = AttackDist
trigger1   = 1
value      = Ceil(125*Const(Size.XScale)+60+Abs(FVar(15+(SysVar(2) & 1)*10)-FVar(37)))*(AnimElemTime(15) < 0)
ignorehitpause = 1

[State ]
type       = CtrlSet
trigger1   = 1
value      = (AnimTime > -2)
ignorehitpause = 1

[State ]
type       = ChangeState
trigger1   = (Var(17) & (2**04 | 2**05 | 2**06))
value      = IfElse((Var(17) & 2**06),314,IfElse((Var(17) & 2**05),312,310))
ctrl       = 0
ignorehitpause = 0

[State ]
type       = ChangeState
trigger1   = !AnimTime
value      = 5
ctrl       = 0
ignorehitpause = 0


