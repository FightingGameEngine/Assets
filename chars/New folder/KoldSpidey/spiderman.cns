[Data]
;-----------------------------------------------------------------
; Diffictuly
;-----------------------------------------------------------------
;-1=No AI ;0=Breazy ;1=Simple ;2=Novice
;3=Very Easy ;4=Easy ;5=Normal ;6=Hard ;7=Amazing
;8=Spectacular ;9=Ultimate  ;10= Maximum AI
