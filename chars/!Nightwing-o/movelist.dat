;====================================================
; NIGHTWING - Complete Movelist
; PC Keyboard Controls (MUGEN Default Layout)
;====================================================
;
; KEYBOARD LEGEND
; ---------------
; PUNCH BUTTONS:
;   X = Light Punch    |   Y = Medium Punch    |   Z = Heavy Punch
; KICK BUTTONS:
;   A = Light Kick     |   B = Medium Kick     |   C = Heavy Kick
; START = Space Bar
;
; DIRECTIONAL INPUTS (use arrow keys or numpad):
;   F = Forward (toward opponent)   |   B = Back (away)
;   U = Up (jump)                   |   D = Down (crouch)
;
; COMMAND NOTATION:
;   ~ = hold briefly or release
;   / = hold the button while inputting direction
;   $ = hold direction for a moment (charge)
;   + = press both buttons simultaneously
;   , = sequence (e.g. D,DF,F,x = down, down-forward, forward, then x)
;
;====================================================

;-------------------------------------------------------------------
; SPECIAL MOVES (No Power Meter Required)
;-------------------------------------------------------------------

;========== Batrang (Projectile) ==========
[COMMAND]
name = "Batrang (Light)"
command = D, DF, F, x
;------------------------------------------
[COMMAND]
name = "Batrang (Medium)"
command = D, DF, F, y
;------------------------------------------
[COMMAND]
name = "Batrang (Heavy)"
command = D, DF, F, z
;------------------------------------------

;========== Justice Upper (Anti-Air) ==========
[COMMAND]
name = "Justice Upper (Light)"
command = F, D, DF, x
;----------------------------------------------
[COMMAND]
name = "Justice Upper (Medium)"
command = F, D, DF, y
;----------------------------------------------
[COMMAND]
name = "Justice Upper (Heavy)"
command = F, D, DF, z
;----------------------------------------------

;========== Spin Kick ==========
[COMMAND]
name = "Spin Kick (Light)"
command = D, DF, F, a
;-------------------------------
[COMMAND]
name = "Spin Kick (Medium)"
command = D, DF, F, b
;-------------------------------
[COMMAND]
name = "Spin Kick (Heavy)"
command = D, DF, F, c
;-------------------------------

;========== Teleport Attack ==========
[COMMAND]
name = "Teleport Attack (Light)"
command = D, DB, B, a
;------------------------------------
[COMMAND]
name = "Teleport Attack (Medium)"
command = D, DB, B, b
;------------------------------------
[COMMAND]
name = "Teleport Attack (Heavy)"
command = D, DB, B, c
;------------------------------------

;========== Reversal Batons ==========
[COMMAND]
name = "Reversal Batons (Light)"
command = D, DB, B, x
;-----------------------------------
[COMMAND]
name = "Reversal Batons (Medium)"
command = D, DB, B, y
;-----------------------------------
[COMMAND]
name = "Reversal Batons (Heavy)"
command = D, DB, B, z
;-----------------------------------

;========== Shock Batons (Requires Mode Change) ==========
[COMMAND]
name = "Shock Batons (Light)"
command = D, DB, B, x
;--------------------------------------------------------
[COMMAND]
name = "Shock Batons (Medium)"
command = D, DB, B, y
;--------------------------------------------------------
[COMMAND]
name = "Shock Batons (Heavy)"
command = D, DB, B, z
;--------------------------------------------------------
; NOTE: Activate Mode Change first (see below)

;========== Spinning Batons (Requires Mode Change) ==========
[COMMAND]
name = "Spinning Batons (Light)"
command = D, DB, B, x
;-----------------------------------------------------------
[COMMAND]
name = "Spinning Batons (Medium)"
command = D, DB, B, y
;-----------------------------------------------------------
[COMMAND]
name = "Spinning Batons (Heavy)"
command = D, DB, B, z
;-----------------------------------------------------------
; NOTE: Activate Mode Change first (see below)

;========== Mode Change (Switch Fighting Styles) ==========
[COMMAND]
name = "Mode Change 1 (DD + Punch)"
command = D, D, x
;---------------------------------------------------------
[COMMAND]
name = "Mode Change 2 (DD + Kick)"
command = D, D, a
;---------------------------------------------------------
; (You can also use D,D + any button - see Buster commands)

;========== Charge Moves (Back → Forward) ==========
[COMMAND]
name = "Charge Attack (Light Punch)"
command = ~40$B, F, x
;---------------------------------------------------
[COMMAND]
name = "Charge Attack (Medium Punch)"
command = ~40$B, F, y
;---------------------------------------------------
[COMMAND]
name = "Charge Attack (Heavy Punch)"
command = ~40$B, F, z
;---------------------------------------------------
[COMMAND]
name = "Charge Attack (Light Kick)"
command = ~40$B, F, a
;---------------------------------------------------
[COMMAND]
name = "Charge Attack (Medium Kick)"
command = ~40$B, F, b
;---------------------------------------------------
[COMMAND]
name = "Charge Attack (Heavy Kick)"
command = ~40$B, F, c
;---------------------------------------------------
; (Hold Back for ~40 frames then press Forward + button)

;-------------------------------------------------------------------
; HYPER / SUPER MOVES (Requires 1000+ Power)
;-------------------------------------------------------------------

;========== Batrang Barrage (Punch Hyper) ==========
[COMMAND]
name = "Batrang Barrage"
command = D, DF, F, x+y
;---------------------------------------------------
; (Can also use x+z or y+z – all punch button combos)

;========== Gotham Beatdown (Kick Hyper) ==========
[COMMAND]
name = "Gotham Beatdown"
command = D, DF, F, a+b
;---------------------------------------------------
; (Can also use a+c or b+c – all kick button combos)

;-------------------------------------------------------------------
; THROWS (Close Range)
;-------------------------------------------------------------------

;========== Ground Throw (Punch) ==========
[COMMAND]
name = "Ground Throw (Punch)"
command = F + z  (or B + z)
;------------------------------------------
; (Hold Forward/Back and press Heavy Punch)

;========== Ground Throw (Kick) ==========
[COMMAND]
name = "Ground Throw (Kick)"
command = F + c  (or B + c)
;-----------------------------------------
; (Hold Forward/Back and press Heavy Kick)

;========== Air Throw ==========
[COMMAND]
name = "Air Throw"
command = F + z  (or B + z)  (in air)
;--------------------------------------
; (Same input as ground throw but performed in mid-air)

;-------------------------------------------------------------------
; TEAM / TAG COMMANDS (If playing in MVC-style mode)
;-------------------------------------------------------------------

;========== Double Hyper (Team Hyper) ==========
[COMMAND]
name = "Double Hyper"
command = D, DF, F, c+z
;-----------------------------------------------
; (Only works if partner is alive and has enough meter)

;========== Assist Call ==========
[COMMAND]
name = "Assist"
command = y+b
;---------------------------------

;========== Tag Out ==========
[COMMAND]
name = "Tag"
command = z+c
;-----------------------------

;-------------------------------------------------------------------
; SYSTEM / DEFENSIVE COMMANDS
;-------------------------------------------------------------------

;========== Guard Push (Pushblock) ==========
[COMMAND]
name = "Guard Push"
command = x+y  (or y+z / x+z)
;-------------------------------------------
; (Press two punch buttons while blocking)

;========== Alpha Counter (Counter Attack) ==========
[COMMAND]
name = "Alpha Counter"
command = B + x  (or B + y / B + z)
;---------------------------------------------------
; (Press Back + any punch button while blocking)

;========== Recovery Roll Forward ==========
[COMMAND]
name = "Recovery Roll Forward"
command = F + a (or b / c)
;-----------------------------------------
; (Press Forward + any kick when knocked down)

;========== Recovery Roll Backward ==========
[COMMAND]
name = "Recovery Roll Backward"
command = B + a (or b / c)
;------------------------------------------
; (Press Back + any kick when knocked down)

;-------------------------------------------------------------------
; BASIC MOVEMENT & NORMALS
;-------------------------------------------------------------------

;========== Dash Forward ==========
[COMMAND]
name = "Dash Forward"
command = F, F
;----------------------------------

;========== Dash Backward ==========
[COMMAND]
name = "Dash Backward"
command = B, B
;-----------------------------------

;========== Air Dash ==========
[COMMAND]
name = "Air Dash Forward"
command = F, F  (in air)
;-------------------------
[COMMAND]
name = "Air Dash Backward"
command = B, B  (in air)
;-------------------------

;========== Super Jump ==========
[COMMAND]
name = "Super Jump"
command = D, U
;--------------------------------
; (Press Down then Up quickly)

;====================================================
; NOTES:
; - Some moves (Shock Batons, Spinning Batons) require
;   activating the "Mode Change" first via DD+button.
; - All hypers require 1000 power (1 bar).
; - Throws only work when very close to the opponent.
; - Hold commands (e.g., holdfwd, holdback) are used
;   for walking and blocking; they are not listed here.
;====================================================