;---------------------------------------------------------------------------
; Teletransporte
[Statedef 1700]
type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 1035
poweradd = -90
sprpriority = 2

[State 1700, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = 1000,9

[State 1700, PosSet]
type = PosSet
trigger1 = Pos Y > 0
y = 0

[State 1700, PosAddFwd]
type = PosAdd
triggerall = Time = 8
trigger1 = ((command = "holdfwd") || (command != "holdfwd")) && (command != "holdback") && (command != "holdup") && (command != "holddown")
x = 80
y = 0

[State 1700, PosAddBack]
type = PosAdd
triggerall = time = 8
trigger1 = (command = "holdback") && (command != "holdfwd") && (command != "holdup") && (command != "holddown")
x = -80
y = 0

[State 1700, PosAddUp]
type = PosAdd
triggerall = Time = 8
trigger1 = (command = "holdup") && (command != "holdfwd") && (command != "holdback") && (command != "holddown")
x = 0
y = -80

[State 1700, PosAddDown]
type = PosAdd
triggerall = Time = 8
trigger1 = (command = "holddown") && (command != "holdfwd") && (command != "holdback") && (command != "holdup")
x = 0
y = 80

[State 1700, PosAddFwdUp]
type = PosAdd
triggerall = Time = 8
trigger1 = (command = "holdfwd") && (command = "holdup") && (command != "holdback") && (command != "holddown")
x = 80
y = -80

[State 1700, PosAddFwdDown]
type = PosAdd
triggerall = Time = 8
trigger1 = (command = "holdfwd") && (command = "holddown") && (command != "holdback") && (command != "holdup")
x = 80
y = 80

[State 1700, PosAddbackup]
type = PosAdd
triggerall = Time = 8
trigger1 = (command = "holdback") && (command = "holdup") && (command != "holdfwd") && (command != "holddown")
x = -80
y = -80

[State 1700, PosAddBackDown]
type = PosAdd
triggerall = Time = 8
trigger1 = (command = "holdback") && (command = "holddown") && (command != "holdfwd") && (command != "holdup")
x = -80
y = 80

[State 1700, End]
type = ChangeState
trigger1 = Animtime = 0
value = ifelse(pos Y < 0,1500,0)
ctrl = 1

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
[State -2, Varset]
type = Varset
trigger1 = time >= 20
var(5) = 0
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
