;===============================================================================
;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
[Statedef -2]

[State -2]
type = VarSet
trigger1 = Life > 1
trigger1 = MoveType != H
trigger1 = StateNo != 9000
var(46) = StateNo
ignorehitpause = 1

[State -2]
type = VarSet
trigger1 = Life > 1
trigger1 = StateNo = [120,450]
trigger1 = StateNo != 9000
var(46) = StateNo
ignorehitpause = 1
;-------------------------------------------------------------------------------
; Movement SFX
;-------------------------------------------------------------------------------
[Statedef -3]

[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = time = 0
trigger1 = hitcount >= 4
value = .5

[State -3]
type = HitOverride
trigger1 = MoveType != H
trigger1 = Anim != 5300
trigger1 = StateNo != [120,159]
trigger1 = StateNo != [1000,1009]
trigger1 = StateNo != [3000,3010]
trigger1 = PrevStateNo != 9000
trigger1 = PrevStateNo != [200,450]
trigger1 = statetype != A
time = 1
slot = 7
attr = SCA,NA
stateno = 9000


[State -3]
type = HitOverride
trigger1 = MoveType != H
trigger1 = Anim != 5300
trigger1 = PrevStateNo != 9000
trigger1 = StateNo = [1000,1009]
time = 1
slot = 7
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 9000

[State -3, - Helper]
type = Helper
trigger1 = (WinKO) && (NumHelper(333) = 0)
helpertype = Normal
name = "winfx"
id = 333
pos = 0, 0
postype = p1
facing = 0
stateno = 333
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

[State -3, Get Hit Sounds]
type = PlaySnd
triggerall = alive && time = 1
trigger1 = (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080)
trigger1 = enemynear,hitdefattr = SCA,NA,SA,HA
value = 11, ifelse(random < 500, 2,1)
volume = 255
channel = -1

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = 0,21

[State -3, Rolling Sound]
type = PlaySnd
triggerall = animelem = 3
trigger1 = stateno = 105
value = 0,13

[State -3, Walking Sound]
