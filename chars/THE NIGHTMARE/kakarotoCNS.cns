;---------------------------------------------------------------------------
;Initialize
[Statedef 5900]
type 			= S
anim			= 5900

[State 5900:	AssertSpecial]
type			= AssertSpecial
trigger1		= (Time < 150) && (RoundNo = 1)
flag			= Intro
flag2			= NoBarDisplay

[State 5900: 	ChangeState] 
type 			= ChangeState
trigger1 		= (MatchNo = 1) && (RoundNo = 1) && (Time = 1)
value 		= 190

