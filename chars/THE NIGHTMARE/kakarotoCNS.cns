[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = s0,0

[State -3, Landing Explod]
type = Explod
anim = 8000
triggerall = Time = 1
trigger1 = stateno = 52
postype = P1
pos = 0,2
ownpal = 1

[State -3, LifeAdd]
type = lifeadd
trigger1 = Time >= 25
trigger1 = life >= 500
value = 1

