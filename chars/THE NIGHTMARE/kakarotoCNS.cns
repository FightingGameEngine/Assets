;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type 			= S
movetype		= I
physics		= S
;anim			= 0
;velset		= 0,0
ctrl			= 1
poweradd		= 25
lifeadd                 = 0.1
juggle		= 0
facep2		= 0
hitdefpersist	= 0
movehitpersist	= 0
hitcountpersist	= 0
sprpriority		= 0

[State 0: 		ChangeAnim]
type 			= ChangeAnim
trigger1 		= ((IfElse(Life > (Const(Data.Life)/4),Anim != 0,Anim != 5300)) && (Anim != 5)) || (Anim = 5 && AnimTime = 0)
value 		= IfElse(Life > (Const(Data.Life)/4),0,5300)

[State 0, LifeAdd]
type = lifeadd
trigger1 = Time >= 25
trigger1 = life >= 500
value = 1

[State 0:		ScreenBound]
type			= ScreenBound
trigger1		= (BackEdgeBodyDist <= -1)
value			= 0
movecamera		= 0,0

[State 0:		PlaySnd]
type			= PlaySnd
trigger1		= (Anim = 5300) && (AnimElem = 2) && (Random <= 249)
value			= S1,0

[State 0: 		VelSet]
type 			= VelSet
trigger1 		= (!Time)
y 			= 0

[State 0: 		VelSet] 
type 			= VelSet
trigger1 		= (Abs(Vel X) < 2) || (Time = 4)
x 			= 0

[State 0:		ChangeState]
type			= ChangeState
trigger1		= (BackEdgeBodyDist <= -1) && (Pos Y >= 0)
value			= 100

[State -3, LifeAdd]
type = lifeadd
trigger1 = Time >= 25
trigger1 = life >= 500
value = 1

