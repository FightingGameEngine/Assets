;zesensei@free.fr is proud to bring his first intro
;this is Gouki's (Akuma's) intro, ripped from the movie 'street fighter alpha'
;I hope you'll enjoy it
;made in november 2001 with sprmaker
;I put commentary to help everybody who wants make intros too

[SceneDef]
spr = intro.sff ;name of the sprite data
bgm = sound\015.mp3                    ;mettre la musique que vous voulez
startscene = 0 ; number of the scene to begin with

;this intro is typically a bad exemple of intro :-(
;'cause I ripp it from a movie i didn't take time to make it with sprites
;and with a single pal for exemple, so it's heavy (hope it's beauiful :-) )
;maybe the next one will be lighter and longer (maybe it'll be not be a movie anymore)
;I just put every frame of the movie one after another
;adjust time of presence for some
;and put a litle text (layer 2) in front of it

[Scene 0]
fadeout.time = 10
clearcolor = 0,0,0 ;color of background
layerall.pos = 0,0 ; absolute position of all layers
layer0.anim = 0 ; definition of the first animation
layer0.offset = 0,0 ; position of this animation
layer1.anim = 1 ;this layer is more classic 
layer1.offset = 15,0;the scrolling is made by playing with axis
layer1.starttime = 460;to show it at the end of the sequence
layer2.anim = 2; put ';' in front of this 3 lines if you don't
layer2.offset = 140,140; want My logo (tung fu ru) to be shown at the end
layer2.starttime = 490
end.time = 610
bgm = sound\015.mp3                    ;mettre la musique que vous voulez

