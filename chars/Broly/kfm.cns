;---------------------------------
; evolution of the guard gauge :
;---------------------------------
;Initialization
[State -2, VarSet]
type = VarSet
trigger1 = RoundState < 2
v = 58
value = 1000
ignorehitpause = 1

;-----------------
; Stay to 1000
[State -2, VarSet]
type = VarSet
trigger1 = var(58)>1000
v = 58
value = 1000
ignorehitpause = 1

;-----------------
; Stay to 0
[State -2, VarSet]
type = VarSet
trigger1 = var(58) < 0
v = 58
value = 0
ignorehitpause = 1

;-----------------
;evolution
[state -2, VarAdd]
type = VarAdd
triggerall = GetHitVar(Hitshaketime) = 6
trigger1 = stateno = 150
trigger2 = stateno = 152
trigger3 = stateno = 154
var(58) = -30
ignorehitpause = 1

[state -2, VarAdd]
type = VarAdd
triggerall = GetHitVar(Hitshaketime) = 12
trigger1 = stateno = 150
trigger2 = stateno = 152
trigger3 = stateno = 154
var(58) = -60
ignorehitpause = 1

[state -2, VarAdd]
type = VarAdd
triggerall = GetHitVar(Hitshaketime) = 18
trigger1 = stateno = 150
trigger2 = stateno = 152
trigger3 = stateno = 154
var(58) = -90
ignorehitpause = 1

[state -2, VarAdd]
type = VarAdd
triggerall = stateno != 14000
triggerall = stateno != 150
triggerall = stateno != 152
triggerall = stateno != 154
triggerall = var(58) < 1000
trigger1 = (gametime%10)=1
persistent = 0
var(58) = 4
ignorehitpause = 1

;---------------
; ModifyExplod :
;---------------
[State -2, ModifyExplod]
type = ModifyExplod
trigger1 = 1
ID = 19020
scale = (var(58)/1000.0*1),1
sprpriority = 3
pos = 22,220

[state -2, Change]
type = ChangeState
trigger1 = var(58) < 0
value = 160
ctrl = 0
ignorehitpause = 1
