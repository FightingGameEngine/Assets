victory5 = "Encontraras las respuestas que vuscas durante tu viaje amigo mio."
victory6 = "Todo combate no es sino una lucha contra uno mismo..."
victory7 = "Esa mirada... Nunca olvides ese espíritu de lucha que ahora sientes."
victory8 = "Tu narcisismo no tiene sentido... ¡ lucharás con hombres más fuertes que yo!"
victory9 = "¡parece que la victoria es mía, hasta que volvamos a encontrarnos !"

