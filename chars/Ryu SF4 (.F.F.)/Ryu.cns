trigger1 = AIlevel
sysvar(1) = ifelse((enemynear, movetype = A || backedgebodydist <= 20 || (Enemynear,backedgebodydist >0 && Enemynear,vel x <=0)), 1, ifelse((P2StateNo=[5000,5299]), -1, 0))

